in_pin:Input L
in_pin:Input R
out_pin:Front L
out_pin:Front R
out_pin:Center
out_pin:LFE
out_pin:Rear L
out_pin:Rear R

@init
PI = 3.14159265359;
TWO_PI = 2 * PI;
SR = srate;

function DC5_init() ( this.R1=this.R2=this.R3=this.R4=this.R5=0; );
function DC5_aProc(x0, x1) local(h0,h1,h3,h5,h5x0,h3x0,h1x0) (
  h0=0.5; h1=0.3; h3=-0.06; h5=0.013; 
  h5x0=h5*x0; h3x0=h3*x0; h1x0=h1*x0;
  this.R6=this.R5+h5x0; this.R5=this.R4+h3x0; this.R4=this.R3+h1x0;
  this.R3=this.R2+h1x0+h0*x1; this.R2=this.R1+h3x0; this.R1=h5x0;
  this.R6;
);

// PolyBLEP helpers
function poly_blep(t, dt) ( t<dt?(x=t/dt; x+x-x*x-1) : t>1-dt?(x=(t-1)/dt; x*x+x+x+1) : 0 );
function osc_saw(ph, dt) ( v=2*ph-1; v-=poly_blep(ph,dt); v );
function osc_square(ph, dt) ( v=ph<0.5?1:-1; v+=poly_blep(ph,dt); ph2=ph+0.5; ph2>=1?ph2-=1; v-=poly_blep(ph2,dt); v );
function osc_square_pwm(ph, dt, d) ( d=max(0.01,min(0.99,d)); v=ph<d?1:-1; v+=poly_blep(ph,dt); phd=ph-d; phd<0?phd+=1; v-=poly_blep(phd,dt); v );

function lim(x) ( max(-1.0, min(1.0, x)) );
function softlim(x) local(ax, sg) (
  ax = abs(x);
  ax <= 0.8 ? x : (
    sg = x < 0 ? -1 : 1;
    sg * (0.8 + 0.2 * (1 - exp(-(ax - 0.8) * 5)));
  );
);
function safe(x) ( (x!=x) ? 0 : max(-4.0, min(4.0, x)); );
function sat(x, drv) ( x * (1.0 + drv * 2.0) / (1.0 + abs(x * drv * 0.5)); );

// One-pole LPF for Air Absorption
function lpf_doppler(sig, freq) instance(y) (
    y += (sig - y) * (1 - exp(-2 * PI * freq / srate));
    y;
);

// Anti-Thump DC Blocker
function hp_thump_removal(x) instance(y, x_prev) (
    y = x - x_prev + 0.997 * y; 
    x_prev = x;
    y;
);

// VBAP panning: calculate gains for speaker pair
// Returns: g1 (gain for first speaker), g2 (gain for second speaker)
function vbap_gain(src_ang, spk1_ang, spk2_ang) local(ang_span, ang_rel, t_norm, g1, g2) (
    ang_span = spk2_ang - spk1_ang;
    ang_span < -180 ? ang_span += 360;
    ang_span > 180 ? ang_span -= 360;
    
    ang_rel = src_ang - spk1_ang;
    ang_rel < -180 ? ang_rel += 360;
    ang_rel > 180 ? ang_rel -= 360;
    
    ang_rel < 0 || ang_rel > abs(ang_span) ? (
        this.g1 = 0; this.g2 = 0;
    ) : (
        t_norm = ang_rel / ang_span;
        this.g1 = cos(t_norm * $pi * 0.5);
        this.g2 = sin(t_norm * $pi * 0.5);
    );
);

dc_x.DC5_init(); 
chua_v.x=0.1; chua_v.y=0; chua_v.z=0;
b0=b1=b2=b3=b4=b5=b6=0; // Pink Noise

// Full Circles phase accumulator
circle_phase = 0;

flange_len = srate*0.02; fl_buf=0; fl_idx=0;
rvb_len = srate*0.5; rv_bufL=fl_buf+flange_len+100; rv_bufR=rv_bufL+rvb_len+100; rv_idx=0;
wid_len = srate*0.05; wid_buf=rv_bufR+rvb_len+100; wid_idx=0;
dbl_len = srate*0.1; dbl_buf=wid_buf+wid_len+100; dbl_idx=0;
ap_len = srate*0.03; ap1_bufL=dbl_buf+dbl_len+100; ap1_bufR=ap1_bufL+ap_len+100;
ap2_bufL=ap1_bufR+ap_len+100; ap2_bufR=ap2_bufL+ap_len+100; ap_idx=0;

// Audio Pitch Buffer
ps_len = 32768; 
ps_grain = 1024; // Default init, overridden by slider
ps_wr = 0; ps_rd1 = 0; ps_rd2 = ps_grain; ps_ratio = 1; ps_ratio_t = 1;
ps_bufL = ap2_bufR + ap_len + 1000;

sm_coeff = 1 - exp(-1/(srate*0.005));
param_sm_coeff = 1 - exp(-1/(srate*0.02)); 
amp_sm_coeff = 1 - exp(-1/(srate*0.005)); 
gate_sm_coeff = 1 - exp(-1/(srate*0.01)); 
gate_fx_coeff = 1 - exp(-1/(srate*0.12));
gate_fx = 0;

// Hit Engine
hit_trigger_prev = 0;
hit_trans_env = hit_body_env = hit_sub_env = hit_crack_env = hit_crash_env = hit_attack_env = 0;
hit_body_phase = hit_sub_phase = hit_crash_phase1 = hit_crash_phase2 = 0;
hit_crack_lp = hit_crack_smooth = hit_crash_lp = 0;

// Pre-calculate Noise Tone pole
piv_hz = 2000; pole = exp(-2 * PI * piv_hz / srate);

// Cubic Interpolation
function interpolate_cubic(buf, idx, len) local(i0, i1, i2, i3, fr, a0, a1, a2, a3) (
    i1 = floor(idx); fr = idx - i1;
    i0 = (i1 - 1 + len) % len;
    i2 = (i1 + 1) % len;
    i3 = (i1 + 2) % len;
    a0 = buf[i3] - buf[i2] - buf[i0] + buf[i1];
    a1 = buf[i0] - buf[i1] - a0;
    a2 = buf[i2] - buf[i0];
    a3 = buf[i1];
    (a0 * fr * fr * fr) + (a1 * fr * fr) + (a2 * fr) + a3;
);

@block
play_state == 1 && beat_position == 0 ? (
    sub_ph=0; fl_ph=0; osc_ph1=0; osc_ph2=0; fm_ph=0.173; crackle_env=0; chop_ph=0;
    tri_int1=0; tri_int2=0; chua_v.x=0.1;
    cur_env=0; gate_env=0; note_on=0;
    memset(fl_buf, 0, flange_len); memset(dbl_buf, 0, dbl_len);
    memset(rv_bufL, 0, rvb_len); memset(rv_bufR, 0, rvb_len); memset(wid_buf, 0, wid_len);
    memset(ap1_bufL, 0, ap_len); memset(ap1_bufR, 0, ap_len);
    memset(ap2_bufL, 0, ap_len); memset(ap2_bufR, 0, ap_len);
    memset(ps_bufL, 0, ps_len);
    fl_idx=0; dbl_idx=0; rv_idx=0; wid_idx=0; ap_idx=0;
    // Note: circle_phase NOT reset here to allow loop continuation
);
play_state != 1 ? ( cur_env=0; gate_env=0; );

while (midirecv(offset, msg1, msg2, msg3)) (
    status = msg1 & 0xF0;
    status == 0x90 && msg3 > 0 ? ( 
        note_on = 1;
        circle_phase = 0; // Reset phase on note trigger for Full Circles mode
        osc_ph1=0; osc_ph2=rand(1) * osc_phase_random; fm_ph=0.173;
        b0=b1=b2=b3=b4=b5=b6=0; tri_int1=0; tri_int2=0;
        chua_v.x=0.1; chua_v.y=0; chua_v.z=0; 
    ) : status == 0x80 || (status == 0x90 && msg3 == 0) ? ( note_on = 0; );
    midisend(offset, msg1, msg2, msg3);
);

@slider
t_env_val = slider1;
pitch_shift = slider2;
master_gain = 10^(slider3/20);
out_mode = slider4;
pitch_mode = slider5; 
audio_pitch = slider52;
ps_ratio_t = 2 ^ (audio_pitch / 12);
noise_routing = slider54;
doppler_air = slider55;
sur_mode = slider57;
sur_path_x = slider58;
sur_path_y = slider59;
sur_arc_len = slider60;
sur_arc_off = slider61;
sur_full_rotations = slider62;
sur_direction = slider63;
sur_full_offset = slider64;
effect_duration = max(0.01, slider65);
hit_trigger = slider66; hit_enable = slider67; hit_level = slider68;
hit_body = slider69; hit_sub = slider70; hit_crack = slider71;
hit_decay = max(0.05, slider72); hit_tone = slider73;
hit_drive = slider74; hit_duck = slider75; hit_chop_bypass = slider76; hit_pan_bypass = slider77; rv_position = slider78;
osc_phase_random = slider81; osc_drift = slider82; osc_fm_amount = slider83; osc_fm_source = slider84; osc_fm_shape = slider85; osc_fm_ratio = slider86; noise_crackle_density = slider87; ring_freq = slider88; ring_shape = slider89; hit_crash = slider90;
hit_body_coef = exp(-1 / (srate * hit_decay));
hit_sub_coef = exp(-1 / (srate * hit_decay * 1.25));
hit_crack_coef = exp(-1 / (srate * max(0.012, min(0.08, hit_decay * 0.18))));
// Crash is deliberately longer than the click-like Crack, yet still follows
// the main Hit decay so it cannot build up between generated impacts.
hit_crash_coef = exp(-1 / (srate * hit_decay * (0.40 + hit_crash * 0.70)));
hit_trans_coef = exp(-1 / (srate * 0.004));
hit_attack_coeff = 1 - exp(-1 / (srate * 0.002));
hit_cut = 80 * (250 ^ ((hit_tone + 1) * 0.5));
hit_cut = max(80, min(20000, hit_cut));
hit_tone_coeff = 1 - exp(-2 * PI * hit_cut / srate);

// Grain Size Selection
slider56 == 0 ? ps_grain = 512 :
slider56 == 1 ? ps_grain = 1024 :
slider56 == 2 ? ps_grain = 2048 :
ps_grain = 4096;

// Gens
t_v_wn = slider6; noise_type = slider7; noise_tone = slider8;
t_v_osc = slider9; osc_shape = slider10; osc_pwm = slider11; osc_detune = slider12; osc_drive = slider13; osc_octave = slider51; osc_tone = slider53; osc_unison_mix = slider79; osc_voice2_ratio = slider80;
t_v_ch = slider14; c_k = slider15; c_be = slider16; c_ga = slider17; c_al = slider18;
t_v_sub = slider19; sub_hz = slider20; sub_sat = slider21; t_v_ext = slider22;

// Filt
t_mx = slider23; t_my = slider24; f_sc = slider25; t_res = slider26;

// FX
fl_mix = slider27; fl_feed = slider28; dbl_mix = slider29; dbl_time_ms = slider30; dbl_wide = slider31;
rv_mix = slider32; rv_size = 0.2 + slider33*0.75; rv_damp = slider34; rv_tail = slider35;
sat_drive = slider36; crush_mix = slider37; crush_rate = slider38; punch_amt = slider39;
ring_metal = slider50;
gate_fx_release = 0.05 + rv_tail * 0.25;
gate_fx_coeff = 1 - exp(-1/(srate*gate_fx_release));

// Chop
chop_depth = slider40; chop_rate_norm = slider41; chop_shape = slider42;

// Out
t_p_x = slider43; t_p_y = slider44; wid = slider45;

// Trims
trim_w = slider46; trim_o = slider47; trim_c = slider48; trim_e = slider49;

// Calcs
t_cut = 20 * (1000 ^ f_sc); t_cut = max(20, min(20000, t_cut));
doppler_ratio = (pitch_mode < 0.5) ? (2 ^ (pitch_shift / 12)) : 1;
// Mode 1 is a post-generator frequency shift. The Pad's -12..+12 range
// maps to ±420 Hz, while Pitch Shift keeps its musical ratio behavior.
freq_shift_hz = (pitch_mode >= 0.5 && pitch_mode < 1.5) ? pitch_shift * 35 : 0;
base_hz = max(10, sub_hz * doppler_ratio);
ring_step = (ring_freq * TWO_PI) / srate;
sub_step = (base_hz * TWO_PI) / srate;

detune_factor = 2 ^ (osc_detune / 1200);
osc_octave_mult = 2 ^ (osc_octave / 12);
t_osc_step1 = (base_hz * osc_octave_mult) / srate; 
t_osc_step2 = (base_hz * detune_factor * osc_octave_mult * osc_voice2_ratio) / srate;

c_beta_base = 28.58; c_a = -1.14; c_b = -0.71;
piv_hz = 2000; pole = exp(-2 * PI * piv_hz / srate);

@sample
gate_target = note_on ? 1 : 0;
gate_env += (gate_target - gate_env) * gate_sm_coeff;
gate_fx += (gate_env - gate_fx) * gate_fx_coeff;
rv_activity = abs(last_rL) + abs(last_rR) + abs(last_rv_inL) + abs(last_rv_inR);

hit_rising = hit_enable >= 0.5 && hit_trigger >= 0.5 && hit_trigger_prev < 0.5;
hit_trigger_prev = hit_trigger;
hit_rising ? (
    hit_trans_env = hit_body_env = hit_sub_env = hit_crack_env = hit_crash_env = 1;
    hit_attack_env = 0;
    hit_body_phase = hit_sub_phase = hit_crash_phase1 = hit_crash_phase2 = 0;
    hit_crack_lp = hit_crack_smooth = hit_crash_lp = 0;
);
hit_activity = max(max(hit_trans_env * hit_crack, hit_body_env * hit_body), max(hit_sub_env * hit_sub, max(hit_crack_env * hit_crack, hit_crash_env * hit_crash))) * hit_level;

(note_on || gate_fx > 0.00003 || rv_activity > 0.00005 || hit_activity > 0.00003) ? (

    cur_env += (t_env_val - cur_env) * amp_sm_coeff; 
    v_wn += (t_v_wn - v_wn) * param_sm_coeff;
    v_osc += (t_v_osc - v_osc) * param_sm_coeff;
    v_ch += (t_v_ch - v_ch) * param_sm_coeff;
    v_ext += (t_v_ext - v_ext) * param_sm_coeff;
    v_sub += (t_v_sub - v_sub) * param_sm_coeff;
    osc_step1 += (t_osc_step1 - osc_step1) * param_sm_coeff;
    osc_step2 += (t_osc_step2 - osc_step2) * param_sm_coeff;
    p_x += (t_p_x - p_x) * param_sm_coeff;
    p_y += (t_p_y - p_y) * param_sm_coeff;
    sur_x += (sur_path_x - sur_x) * param_sm_coeff;
    sur_y += (sur_path_y - sur_y) * param_sm_coeff;
    cut_hz += (t_cut - cut_hz) * sm_coeff;
    res += (t_res - res) * sm_coeff;
    mx += (t_mx - mx) * sm_coeff;
    my += (t_my - my) * sm_coeff;

    // --- 1. GENERATORS ---
    // NOISE
    raw_white = (rand(2)-1);
    noise_type == 0 ? noise_sig = raw_white : 
    noise_type == 1 ? ( 
        b0 = 0.99886 * b0 + raw_white * 0.0555179; b1 = 0.99332 * b1 + raw_white * 0.0750759; b2 = 0.96900 * b2 + raw_white * 0.1538520;
        b3 = 0.86650 * b3 + raw_white * 0.3104856; b4 = 0.55000 * b4 + raw_white * 0.5329522; b5 = -0.7616 * b5 - raw_white * 0.0168980;
        noise_sig = (b0+b1+b2+b3+b4+b5+b6+raw_white*0.5362)*0.11; b6 = raw_white * 0.115926;
    ) : (
        // Sparse micro-bursts instead of single-sample spikes: this reads as
        // controllable crackle and avoids the hard digital clicks of the old mode.
        crackle_prob = 0.00012 + noise_crackle_density * 0.00288;
        rand(1) < crackle_prob ? crackle_env = max(crackle_env, 0.35 + rand(1) * 0.65);
        crackle_decay = exp(-1 / (srate * (0.00045 + noise_crackle_density * 0.00155)));
        crackle_env *= crackle_decay;
        noise_sig = (rand(2) - 1) * crackle_env * 1.6;
    );
    tilt = max(-1, min(1, noise_tone));
    last_nf += (noise_sig - last_nf) * (1 - pole);
    low = last_nf; high = noise_sig - low;
    w_low = 0.5 - 0.5 * tilt; w_high = 0.5 + 0.5 * tilt;
    noise_filt = (low * w_low + high * w_high) / (w_low + w_high);
    noise_filt *= 1.0 / (0.75 + abs(tilt) * 0.35);
    // The shared envelope is applied once after the filter (linearity across sources).
    wn_out = noise_filt * v_wn * trim_w;

    // SUB
    sub_ph += sub_step; sub_ph > TWO_PI ? sub_ph -= TWO_PI;
    // Level-compensated sub drive: the control adds audible upper harmonics
    // without simply increasing the LFE level or erasing the fundamental.
    sub_dry = sin(sub_ph);
    sub_wet = sat(sub_dry, sub_sat * 3.0) / (1 + sub_sat * 2.5);
    sub_sig = (sub_dry * (1 - sub_sat) + sub_wet * sub_sat) * v_sub;

    // OSC
    osc_ph1 += osc_step1; osc_ph1 >= 1 ? osc_ph1 -= 1;
    osc_drift_ph += (0.06 + osc_drift * 0.24) / srate; osc_drift_ph >= 1 ? osc_drift_ph -= 1;
    osc_drift_cents = sin(osc_drift_ph * TWO_PI) * osc_drift * 18;
    osc_step2_drift = osc_step2 * (2 ^ (osc_drift_cents / 1200));
    osc_ph2 += osc_step2_drift; osc_ph2 >= 1 ? osc_ph2 -= 1;
    // Dedicated oscillator for the OSC 2x FM source.  It must not reuse the
    // carrier phase: in a one-note whoosh both phases otherwise restart in
    // lockstep and can make the source appear inactive.
    fm_ph += osc_step1 * osc_fm_ratio;
    fm_ph >= 1 ? fm_ph -= 1;
    dt1 = osc_step1; dt2 = osc_step2_drift;
    osc_shape == 0 ? (
        // Keep the original 2:1 carrier multiplier; it was accidentally
        // omitted when FM source selection was added.
        oct = 2;
        // Treat the menu value as a discrete index.  Slider values can arrive
        // fractionally while REAPER updates the FX, so threshold comparisons
        // made the three modes collapse to the same behaviour in practice.
        fm_shape_index = floor(osc_fm_shape + 0.5);
        // This is phase deviation (in cycles), not an amplitude mix.  A larger
        // range makes the waveform selection clearly audible at useful levels.
        fm_depth = osc_fm_amount * 1.35;
        osc_fm_source < 0.5 ? (
            fm_phase = fm_ph;
            // Deliberately different modulation contours:
            // sine = rounded partials, triangle = odd-harmonic sweep,
            // square = two fixed pitch states per cycle.
            fm_shape_index == 0 ? (
                fm_wave = sin(fm_phase * TWO_PI);
            ) : fm_shape_index == 1 ? (
                fm_wave = 1 - 4 * abs(fm_phase - 0.5);
            ) : (
                fm_wave = fm_phase < 0.5 ? 1 : -1;
            );
        ) : osc_fm_source < 1.5 ? (
            // Sub uses its native sine phase; waveform selection is hidden in UI.
            fm_wave = sin(sub_ph);
        ) : (
            // Noise source is deliberately smoothed to avoid zipper/alias clicks.
            fm_noise += ((rand(2) - 1) - fm_noise) * 0.012;
            fm_wave = fm_noise;
        );
        fm = fm_depth * fm_wave;
        osc_raw = sin((osc_ph1*oct + fm) * TWO_PI) * (1-osc_unison_mix) + sin((osc_ph2*oct + fm) * TWO_PI) * osc_unison_mix;
    ) : osc_shape == 1 ? (
        gamma = 0.2 + 1.6 * osc_pwm;
        s1 = osc_saw(osc_ph1, dt1); s2 = osc_saw(osc_ph2, dt2);
        s1 = s1 >= 0 ? pow(s1, gamma) : -pow(-s1, gamma); s2 = s2 >= 0 ? pow(s2, gamma) : -pow(-s2, gamma);
        osc_raw = (s1 * (1-osc_unison_mix) + s2 * osc_unison_mix) * 1.15;
    ) : osc_shape == 2 ? (
        duty = 0.5 + (osc_pwm - 0.5) * 0.98;
        osc_raw = osc_square_pwm(osc_ph1, dt1, duty) * (1-osc_unison_mix) + osc_square_pwm(osc_ph2, dt2, duty) * osc_unison_mix;
        osc_raw *= 0.707 / sqrt(max(0.05, min(0.95, duty)));
    ) : (
        sq1 = osc_square(osc_ph1, dt1); sq2 = osc_square(osc_ph2, dt2);
        tri_int1 += (sq1 - tri_int1) * dt1; tri_int2 += (sq2 - tri_int2) * dt2;
        shape_gamma = 0.2 + 1.6 * osc_pwm;
        tri_sum = tri_int1 * (1-osc_unison_mix) + tri_int2 * osc_unison_mix;
        tri_shaped = tri_sum >= 0 ? pow(tri_sum, shape_gamma) : -pow(-tri_sum, shape_gamma);
        osc_raw = tri_shaped * 1.35;
    );
    osc_tone_amt = max(-1, min(1, osc_tone));
    last_osc_lp += (osc_raw - last_osc_lp) * (1 - pole);
    osc_low = last_osc_lp; osc_high = osc_raw - osc_low;
    osc_w_low = 0.5 - 0.5 * osc_tone_amt; osc_w_high = 0.5 + 0.5 * osc_tone_amt;
    osc_tilt = (osc_low * osc_w_low + osc_high * osc_w_high) / (osc_w_low + osc_w_high);
    osc_tilt *= 1.0 / (0.75 + abs(osc_tone_amt) * 0.35);
    osc_out = sat(osc_tilt, osc_drive) * v_osc * trim_o;

    // CHUA
    k_mod = min(c_k * doppler_ratio, 0.5); 
    // Alpha is a positive Chua-system coefficient.  Keep it bounded at the
    // point of use, without overwriting the user parameter every sample.
    chua_alpha = max(5, min(20, c_al));
    dx=k_mod*chua_alpha*(chua_v.y-chua_v.x-c_b*chua_v.x-0.5*(c_a-c_b)*(abs(chua_v.x+1)-abs(chua_v.x-1)));
    dy=k_mod*(chua_v.x-chua_v.y+chua_v.z);
    dz=k_mod*(-c_be*chua_v.y-c_ga*chua_v.z);
    chua_v.x+=dx; chua_v.y+=dy; chua_v.z+=dz;
    chua_v.x=max(-10,min(10,chua_v.x)); chua_v.y=max(-10,min(10,chua_v.y)); chua_v.z=max(-10,min(10,chua_v.z));
    chua_raw = safe(dc_x.DC5_aProc(fch, chua_v.x)*0.3);
    chua_sig = chua_raw - last_chua + 0.995 * chua_sig; last_chua = chua_raw;
    chua_out = chua_sig * v_ch * trim_c;

    // External Input shares the standard JSFX input pair (pins 1/2).
    // Surround output channels are only written later in @sample.
    ext = (spl0+spl1)*0.5 * v_ext * trim_e;

    // === AUDIO PITCH ENGINE ===
    sig_noise_clean = wn_out;
    sig_mix_pre_ps = osc_out + chua_out + ext;

    // Determine routing
    // [FIXED] Routing should respect noise_routing even in Doppler Mode.
    // However, if we pitch shift Ext/Osc/Chua, they always go to buffer.
    
    ps_input_base = sig_mix_pre_ps;
    
    // Add noise to pitch buffer ONLY if routing is set to 1 (Pitched)
    ps_input = ps_input_base + (noise_routing == 1 ? sig_noise_clean : 0);

    // Audio Pitch Buffer Write
    ps_ratio += (ps_ratio_t - ps_ratio) * param_sm_coeff;
    ps_wr = (ps_wr + 1) % ps_len;
    ps_bufL[ps_wr] = ps_input;

    // Read Heads
    ps_rd1 += ps_ratio; ps_rd2 += ps_ratio;
    ps_rd1 >= ps_grain ? ( ps_rd1 -= ps_grain; ps_rd1 += (rand(20)-10); );
    ps_rd2 >= ps_grain ? ( ps_rd2 -= ps_grain; ps_rd2 += (rand(20)-10); );

    // CUBIC INTERPOLATION
    idx1 = (ps_wr - ps_grain + ps_rd1 + ps_len) % ps_len;
    out1 = interpolate_cubic(ps_bufL, idx1, ps_len);
    win1 = 0.5 - 0.5 * cos(ps_rd1 / ps_grain * TWO_PI);
    
    idx2 = (ps_wr - ps_grain + ps_rd2 + ps_len) % ps_len;
    out2 = interpolate_cubic(ps_bufL, idx2, ps_len);
    win2 = 0.5 - 0.5 * cos(ps_rd2 / ps_grain * TWO_PI);

    sig_pitched = (out1 * win1) + (out2 * win2);
    
    // Anti-Thump
    sig_pitched = fix_thump.hp_thump_removal(sig_pitched);

    // MUX: Combine Signals
    sig_in = 0;
    
    // If noise is CLEAN, we need to add it back separately.
    dry_noise_signal = (noise_routing == 0 ? sig_noise_clean : 0);
    // Exact dry source for 0-semitone Audio Pitch / Physical Doppler. This
    // prevents the granular reader (and therefore Grain Size) from colouring
    // External Input when the pitch pad is centred.
    sig_direct = sig_mix_pre_ps + sig_noise_clean;
    
    pitch_mode == 3 ? ( 
        // === MODE 3: PHYSICAL DOPPLER ===
        abs(audio_pitch) < 0.01 ? (
            sig_in = safe(sig_direct);
        ) : (
            dist_f = min(1.0, abs(audio_pitch) / 12);
            dop_min = 200 + (1-doppler_air) * 10000;
            dop_cut = 20000 - (20000 - dop_min) * dist_f;
            dop_cut = max(100, dop_cut);

            // Filter the pitched signal (Osc/Chua/Ext + maybe Noise)
            // Add Dry Noise (if any) bypassing the filter
            sig_in = dp_filt.lpf_doppler(sig_pitched, dop_cut) + dry_noise_signal;
        );
        
    ) : pitch_mode == 2 ? (
        // === MODE 2: AUDIO PITCH ===
        abs(audio_pitch) < 0.01 ? (
            sig_in = safe(sig_direct);
        ) : (
            sig_in = safe(sig_pitched + dry_noise_signal);
        );

    ) : pitch_mode == 1 ? (
        // === MODE 1: FREQUENCY SHIFT ===
        // A phase-continuous frequency translator. Unlike Pitch Shift, its
        // offset is measured in Hz and therefore creates inharmonic sidebands.
        // This deliberately avoids a high-order Hilbert network: that design
        // can ring or overload when a ReaScript pad updates in coarse steps.
        fs_input = sig_mix_pre_ps + (noise_routing == 1 ? sig_noise_clean : 0);

        // ~7 ms smoothing prevents clicks when the Doppler Pad is moved.
        fs_shift_smooth += (freq_shift_hz - fs_shift_smooth) * 0.003;
        fs_phase += TWO_PI * fs_shift_smooth / srate;
        fs_phase > TWO_PI ? fs_phase -= TWO_PI : fs_phase < -TWO_PI ? fs_phase += TWO_PI;
        fs_shifted = fs_input * cos(fs_phase);
        // Centred Pad remains an exact bypass. The short blend avoids an
        // abrupt timbral jump around the centre position.
        fs_blend = min(1, abs(fs_shift_smooth) / 12);
        sig_in = safe(fs_input * (1 - fs_blend) + fs_shifted * fs_blend + dry_noise_signal);
        
    ) : (
        // === MODE 0: SYNTH PITCH SHIFT ===
        // Bypass Audio PS completely
        sig_in = safe(sig_noise_clean + sig_mix_pre_ps);
    );

    // === FX CHAIN START ===

    // FILTER
    // The Lua Filter bypass sends cutoff=max and resonance=0. Treat that
    // state as a genuine bypass: running full-range external audio through
    // the nonlinear SVF otherwise colours it even when the pad is disabled.
    f_sc >= 0.999 && t_res < 0.001 ? (
        sig_filt = sig_in;
    ) : (
        g = tan(PI * cut_hz / (srate*2)); k_damp = 2 - 2*res;
        os_loop = 0;
        loop(2,
            in_s = sig_in - 0.1 * (z1 * abs(z1));
            v_hp = (in_s - k_damp*z1 - z2) / (1 + g*k_damp + g*g);
            v_bp = g*v_hp + z1; v_lp = g*v_bp + z2;
            z1 = safe(g*v_hp + v_bp); z2 = safe(g*v_bp + v_lp);
            ls = v_lp * (1-my) + v_hp * my;
            rs = v_bp * (1-my) + (v_hp+v_lp) * my;
            out_os = ls * (1-mx) + rs * mx;
            os_loop == 0 ? samp1 = out_os : samp2 = out_os;
            os_loop += 1;
        );
        sig_filt = (samp1 + samp2) * 0.5;
    );

    // Ring Metal: a true dry/wet ring modulator with continuously variable
    // carrier shape.  Frequency is independent from Sub, so it remains
    // predictable while the whoosh pitch moves.
    ring_metal > 0.001 ? (
        ring_ph += ring_step; ring_ph > TWO_PI ? ring_ph -= TWO_PI;
        ring_sine = sin(ring_ph);
        ring_square = ring_sine >= 0 ? 1 : -1;
        ring_mod_val = ring_sine * (1 - ring_shape) + ring_square * ring_shape;
        sig_filt = sig_filt * (1 - ring_metal) + (sig_filt * ring_mod_val) * ring_metal;
    );

    // HIT ENGINE (post-filter, pre-FX/reverb)
    hit_body_hi = max(70, 155 + hit_tone * 65);
    hit_body_lo = max(35, 58 + hit_tone * 22);
    hit_body_freq = hit_body_lo + (hit_body_hi - hit_body_lo) * hit_body_env;
    hit_body_phase += TWO_PI * hit_body_freq / srate; hit_body_phase > TWO_PI ? hit_body_phase -= TWO_PI;
    hit_body_signal = sin(hit_body_phase) * hit_body_env * hit_body;

    hit_sub_freq = 32 + 38 * hit_sub_env;
    hit_sub_phase += TWO_PI * hit_sub_freq / srate; hit_sub_phase > TWO_PI ? hit_sub_phase -= TWO_PI;
    hit_sub_signal = sin(hit_sub_phase) * hit_sub_env * hit_sub;

    hit_noise = rand(2) - 1;
    hit_crack_lp += (hit_noise - hit_crack_lp) * hit_tone_coeff;
    hit_crack_smooth += (hit_crack_lp - hit_crack_smooth) * 0.08;
    hit_crack_signal = (hit_crack_lp - hit_crack_smooth) * hit_crack_env * hit_crack;
    // Transient is intentionally tied to Crack: setting Crack to zero removes all noise content.
    hit_trans_signal = (hit_noise * 0.75 + sin(hit_body_phase * 3) * 0.25) * hit_trans_env * hit_crack;

    // Metallic, high-passed noise plus two inharmonic resonances: a compact
    // crash layer rather than another broadband click.
    // Tone is shared with Crack: negative values damp the cymbal-like top end,
    // positive values open it and raise its inharmonic partials.
    hit_crash_tone = (hit_tone + 1) * 0.5;
    hit_crash_lp += (hit_noise - hit_crash_lp) * (0.17 - hit_crash_tone * 0.12);
    hit_crash_hi = hit_noise - hit_crash_lp;
    hit_crash_phase1 += TWO_PI * (2600 + hit_crash_tone * 3100) / srate; hit_crash_phase1 > TWO_PI ? hit_crash_phase1 -= TWO_PI;
    hit_crash_phase2 += TWO_PI * (4300 + hit_crash_tone * 4800) / srate; hit_crash_phase2 > TWO_PI ? hit_crash_phase2 -= TWO_PI;
    hit_crash_signal = (hit_crash_hi * (0.35 + hit_crash_tone * 0.24) + sin(hit_crash_phase1) * 0.17 + sin(hit_crash_phase2) * 0.11) * hit_crash_env * hit_crash;

    hit_attack_env += (1 - hit_attack_env) * hit_attack_coeff;
    hit_duck_env = max(hit_body_env * hit_body, hit_sub_env * hit_sub);
    hit_mix = (hit_body_signal * 0.75 + hit_sub_signal * 0.65 + hit_crack_signal * 0.22 + hit_trans_signal * 0.12 + hit_crash_signal * 0.42) * hit_level * hit_attack_env;
    hit_mix = sat(hit_mix, hit_drive * 2.5);
    hit_lfe = hit_sub_signal * hit_level * hit_attack_env * 0.22;

    hit_trans_env *= hit_trans_coef;
    hit_body_env *= hit_body_coef;
    hit_sub_env *= hit_sub_coef;
    hit_crack_env *= hit_crack_coef;
    hit_crash_env *= hit_crash_coef;

    // ENVELOPE: Hit is independent; Whoosh/Rise is ducked around impact.
    sig_shaped = sig_filt * cur_env * (1 - hit_duck * hit_duck_env) + hit_mix;
    // Level-compensated saturation: colour the rise without forcing the final
    // limiter to flatten its peak at high Drive settings.
    sat_drive > 0.001 ? (
        sat_dry = sig_shaped;
        sat_wet = sat(sat_dry, sat_drive * 3.0) / (1 + sat_drive * 2.2);
        sig_shaped = sat_dry * (1 - sat_drive) + sat_wet * sat_drive;
    );

    // BITCRUSH
    crush_mix > 0.001 ? (
        c_step = (1.0 / crush_rate); c_cnt += 1;
        c_cnt >= c_step ? ( c_cnt = 0; c_held = floor(sig_shaped * 256 + 0.5) / 256; );
        sig_shaped = sig_shaped * (1-crush_mix) + c_held * crush_mix;
    );

    // FLANGER
    fl_mix > 0.001 ? (
        fl_ph += (TWO_PI*0.2)/srate; fl_ph>TWO_PI ? fl_ph-=TWO_PI;
        fl_d = (sin(fl_ph)+1)*0.5*0.005*srate;
        rd = (fl_idx - fl_d + flange_len)%flange_len; ri=floor(rd); rf=rd-ri;
        val_d = fl_buf[ri]*(1-rf) + fl_buf[(ri+1)%flange_len]*rf;
        // Keep feedback below the self-resonant zone on bright/noisy sources.
        fl_buf[fl_idx] = sig_shaped + val_d * min(0.65, fl_feed * 0.65); fl_idx = (fl_idx+1)%flange_len;
        s_fL = sig_shaped*(1-fl_mix) + val_d*fl_mix; s_fR = sig_shaped*(1-fl_mix) + val_d*fl_mix;
    ) : (
        s_fL = sig_shaped; s_fR = sig_shaped; 
        fl_buf[fl_idx] = sig_shaped; fl_idx = (fl_idx+1)%flange_len;
    );

    // DOUBLER
    dbl_mix > 0.001 ? (
        // Short, bounded micro-delays widen without becoming a second hit.
        dbl_s = min(0.035, max(0.008, dbl_time_ms * 0.001)) * srate;
        rdL = (dbl_idx - dbl_s + dbl_len)%dbl_len;
        rdR = (dbl_idx - dbl_s * (1.0 + dbl_wide*0.5) + dbl_len)%dbl_len;
        dbl_buf[dbl_idx] = s_fL; dbl_idx = (dbl_idx+1)%dbl_len; 
        dbl_dL = dbl_buf[floor(rdL)]; dbl_dR = dbl_buf[floor(rdR)];
        s_dL = s_fL * (1 - dbl_mix * 0.35) + dbl_dL * (dbl_mix * 0.55);
        s_dR = s_fR * (1 - dbl_mix * 0.35) + dbl_dR * (dbl_mix * 0.55);
    ) : (
        s_dL = s_fL; s_dR = s_fR; dbl_buf[dbl_idx] = s_fL; dbl_idx = (dbl_idx+1)%dbl_len;
    );

    // WIDTH
    wid > 0.001 ? (
        mid_sig = (s_dL + s_dR)*0.5;
        side_sig = (s_dL - s_dR)*0.5;
        wid_buf[wid_idx] = mid_sig;
        rdL = (wid_idx - (srate*0.005) + wid_len)%wid_len; rdR = (wid_idx - (srate*0.013) + wid_len)%wid_len;
        wid_side = (wid_buf[floor(rdL)] - wid_buf[floor(rdR)]) * 0.5;
        side_sig = side_sig * (1 + wid * 0.65) + wid_side * (wid * 0.35);
        L_base = mid_sig + side_sig; R_base = mid_sig - side_sig;
        wid_idx = (wid_idx+1)%wid_len;
    ) : ( L_base = s_dL; R_base = s_dR; );

    // REVERB (POST-FILTER, STEREO)
    rv_mix > 0.001 ? (
        rv_mod_phL += (TWO_PI * (0.11 + rv_size * 0.14)) / srate; rv_mod_phL > TWO_PI ? rv_mod_phL -= TWO_PI;
        rv_mod_phR += (TWO_PI * (0.13 + rv_size * 0.16)) / srate; rv_mod_phR > TWO_PI ? rv_mod_phR -= TWO_PI;

        // Reverb v2: Size changes diffusion scale, not an obvious slap-delay.
        rv_mod_depth = srate * (0.00008 + rv_size * 0.00018);
        // Keep the two core lines below the audible double/slap zone.
        rv_rtL = srate * (0.012 + rv_size * 0.024);
        rv_rtR = srate * (0.017 + rv_size * 0.029);
        rv_rtL += sin(rv_mod_phL) * rv_mod_depth;
        rv_rtR += sin(rv_mod_phR) * rv_mod_depth;
        // Conservative stability margins: feedback and cross-feed must leave
        // headroom for the two diffusion stages at every Size/Tail setting.
        rv_fb = min(0.56, 0.18 + rv_tail * 0.36);
        rv_cross = 0.04 + rv_size * 0.05;

        rv_dryL = L_base; rv_dryR = R_base;
        rv_position < 0.5 ? ( rv_inL = L_base; rv_inR = R_base; rv_out_gain = 1; ) :
        rv_position < 1.5 ? ( rv_inL = sig_filt; rv_inR = sig_filt; rv_out_gain = cur_env; ) :
        ( rv_inL = sig_in; rv_inR = sig_in; rv_out_gain = cur_env; );

        rdL = (rv_idx - rv_rtL + rvb_len) % rvb_len;
        riL = floor(rdL); rfL = rdL - riL;
        rv_outL = rv_bufL[riL] * (1 - rfL) + rv_bufL[(riL + 1) % rvb_len] * rfL;

        rdR = (rv_idx - rv_rtR + rvb_len) % rvb_len;
        riR = floor(rdR); rfR = rdR - riR;
        rv_outR = rv_bufR[riR] * (1 - rfR) + rv_bufR[(riR + 1) % rvb_len] * rfR;

        // Diffusion all-pass stages to reduce comb ringing
        ap_g1 = 0.38 + rv_damp * 0.10;
        ap_g2 = 0.24 + rv_damp * 0.08;

        ap_d1L = floor(srate * (0.0031 + rv_size * 0.0034));
        ap_d1R = floor(srate * (0.0039 + rv_size * 0.0030));
        ap_d2L = floor(srate * (0.0017 + rv_size * 0.0022));
        ap_d2R = floor(srate * (0.0023 + rv_size * 0.0019));

        ap_d1L = max(4, min(ap_len - 4, ap_d1L)); ap_d1R = max(4, min(ap_len - 4, ap_d1R));
        ap_d2L = max(4, min(ap_len - 4, ap_d2L)); ap_d2R = max(4, min(ap_len - 4, ap_d2R));

        ap_rd = (ap_idx - ap_d1L + ap_len) % ap_len;
        ap_z = ap1_bufL[ap_rd];
        ap_y = -ap_g1 * rv_outL + ap_z;
        ap1_bufL[ap_idx] = rv_outL + ap_g1 * ap_y;
        rv_outL = ap_y;

        ap_rd = (ap_idx - ap_d1R + ap_len) % ap_len;
        ap_z = ap1_bufR[ap_rd];
        ap_y = -ap_g1 * rv_outR + ap_z;
        ap1_bufR[ap_idx] = rv_outR + ap_g1 * ap_y;
        rv_outR = ap_y;

        ap_rd = (ap_idx - ap_d2L + ap_len) % ap_len;
        ap_z = ap2_bufL[ap_rd];
        ap_y = -ap_g2 * rv_outL + ap_z;
        ap2_bufL[ap_idx] = rv_outL + ap_g2 * ap_y;
        rv_outL = ap_y;

        ap_rd = (ap_idx - ap_d2R + ap_len) % ap_len;
        ap_z = ap2_bufR[ap_rd];
        ap_y = -ap_g2 * rv_outR + ap_z;
        ap2_bufR[ap_idx] = rv_outR + ap_g2 * ap_y;
        rv_outR = ap_y;
        ap_idx = (ap_idx + 1) % ap_len;

        rv_outL = rv_outL + (last_rL - rv_outL) * (1.0 - rv_damp); last_rL = rv_outL;
        rv_outR = rv_outR + (last_rR - rv_outR) * (1.0 - rv_damp); last_rR = rv_outR;

        rv_outL = sat(rv_outL, 0.3);
        rv_outR = sat(rv_outR, 0.3);

        fb_inL = rv_inL + rv_outL * rv_fb + rv_outR * rv_cross;
        fb_inR = rv_inR + rv_outR * rv_fb + rv_outL * rv_cross;

        rv_dcL = fb_inL - last_rv_inL + 0.995 * rv_dcL; last_rv_inL = fb_inL;
        rv_dcR = fb_inR - last_rv_inR + 0.995 * rv_dcR; last_rv_inR = fb_inR;

        rv_satL = rv_dcL * (1 + rv_dcL * rv_dcL * 0.1) / (1 + abs(rv_dcL) * 0.5);
        rv_satR = rv_dcR * (1 + rv_dcR * rv_dcR * 0.1) / (1 + abs(rv_dcR) * 0.5);

        rv_bufL[rv_idx] = max(-1.5, min(1.5, rv_satL));
        rv_bufR[rv_idx] = max(-1.5, min(1.5, rv_satR));
        rv_idx = (rv_idx + 1) % rvb_len;

        L_base = safe(rv_dryL + rv_outL * rv_mix * rv_out_gain);
        R_base = safe(rv_dryR + rv_outR * rv_mix * rv_out_gain);
    );

    // PUNCH
    punch_amt > 0.0001 ? (
        punch_gain = min(2.0, 1 + punch_amt * pow(cur_env, 0.5));
        L_base *= punch_gain; R_base *= punch_gain;
    );

    // CHOPPER
    chop_depth > 0.001 ? (
        chop_rate = 1.0 + chop_rate_norm * 39.0;
        chop_ph += chop_rate / srate; chop_ph > 1.0 ? chop_ph -= 1.0;
        gate_raw = (chop_ph < 0.5) ? 1.0 : 0.0;
        // Never step gain in one sample: long Hit tails expose these edges as clicks.
        // Shape still controls softness, from 1.5 ms (Hard) to 6.5 ms (Soft).
        chop_fade_sec = 0.0015 + chop_shape * 0.005;
        chop_alpha = 1 - exp(-1 / (srate * chop_fade_sec));
        gate_smooth += (gate_raw - gate_smooth) * chop_alpha;
        // Keep the chopper fully active on the Whoosh.  Hit bypass is handled
        // as a dry post-chopper compensation below, so it cannot weaken the
        // chopper on the surrounding design or leak through at the Hit tail.
        gain_mod = 1.0 - (chop_depth * (1.0 - gate_smooth));
        L_base *= gain_mod; R_base *= gain_mod;
        hit_chop_restore = hit_chop_bypass * hit_mix * (1.0 - gain_mod) * (punch_amt > 0.0001 ? punch_gain : 1);
        L_base += hit_chop_restore; R_base += hit_chop_restore;
    ) : gain_mod = 1.0;

    // DC BLOCK & OUT
    dc_L = L_base - dc_l_s + 0.995*dc_L; dc_l_s=L_base; L_base=dc_L;
    dc_R = R_base - dc_r_s + 0.995*dc_R; dc_r_s=R_base; R_base=dc_R;
    
    // Sub bypasses the main FX path, so apply the shared envelope here exactly once.
    sub_sig *= cur_env * gate_env;

    // The impact's low component needs the same Chopper decision as its body.
    // Previously it was always injected after Chopper, which made the Hit
    // bypass switch sound ineffective (especially on kick-heavy impacts).
    hit_lfe_out = hit_lfe * (hit_chop_bypass >= 0.5 ? 1.0 : gain_mod);
    sub_out = sat(sub_sig * 0.25, 0.1);
    hit_pan_activity = max(max(hit_body_env * hit_body, hit_sub_env * hit_sub), max(hit_crack_env * hit_crack, hit_crash_env * hit_crash));
    hit_pan_center = hit_pan_bypass * hit_pan_activity;

    out_mode < 0.5 ? ( 
        // Keep Doppler Pad on the Whoosh.  Center only the dry, direct Hit
        // component by compensating its own constant-power pan gains.
        ang = p_x * PI * 0.5;
        spl0 = (L_base * cos(ang)) + sub_out; spl1 = (R_base * sin(ang)) + sub_out;
        // Do not scale the correction by a decaying activity estimate: that
        // left part of the Hit following the Doppler Pad.  The signal itself
        // is already zero when no Hit is present.
        hit_pan_bypass >= 0.5 ? (
            hit_center_sig = hit_mix;
            spl0 += hit_center_sig * (1 - cos(ang));
            spl1 += hit_center_sig * (1 - sin(ang));
        );
        // The former LFE reinforcement was permanently centred.  Route it
        // with Doppler when Panning bypass is off, and centre it only when the
        // user explicitly requests the bypass.
        hit_pan_bypass >= 0.5 ? (
            spl0 += hit_lfe_out; spl1 += hit_lfe_out;
        ) : (
            spl0 += hit_lfe_out * cos(ang); spl1 += hit_lfe_out * sin(ang);
        );
        spl2=spl3=spl4=spl5=0;
    ) : (
        // Surround 5.1: Use sur_x/sur_y from automation (both Vector and Circle modes)
        
        // Mode 2: Full Circles - use internal phase accumulator
        sur_mode >= 1.5 ? (
            // Full Circles mode: exact rotations over the selected effect duration.
            // The amplitude envelope must not alter the requested rotation count.
            note_on ? (
                phase_step = (sur_full_rotations * TWO_PI) / (srate * effect_duration);
                // Positive speaker angles move toward R (clockwise).
                direction = sur_direction >= 0.5 ? 1 : -1;
                circle_phase += phase_step * direction;
            );
            
            // Apply offset and calculate position
            angle_rad = circle_phase + (sur_full_offset * TWO_PI);
            
            // Speaker-view convention: 0 degrees is Center/front, positive angles
            // move toward R. This matches atan2(dx, dy) below and the UI view.
            path_r = 0.42;
            p_x_sur = 0.5 + path_r * sin(angle_rad);
            p_y_sur = 0.5 + path_r * cos(angle_rad);
        ) : (
            // Mode 0/1: Vector or Circle Arc - use automation values
            p_x_sur = max(0, min(1, sur_x));
            p_y_sur = max(0, min(1, sur_y));
        );

        // While Hit is active, move the surround source toward Center/front.
        // This mirrors the stereo Bypass Panning behavior.
        p_x_sur = p_x_sur * (1 - hit_pan_center) + 0.5 * hit_pan_center;
        p_y_sur = p_y_sur * (1 - hit_pan_center) + 1.0 * hit_pan_center;

        // Convert normalized X/Y to angle (-180 to +180, 0=front)
        dx_pos = p_x_sur - 0.5;
        dy_pos = p_y_sur - 0.5;
        src_angle = atan2(dx_pos, dy_pos) * 180 / $pi;
        
        // Create mono source for proper VBAP panning
        mono_src = (L_base + R_base) * 0.5;
        
        // ITU-R BS.775 speaker angles
        ang_C = 0;  ang_L = -30;  ang_R = 30;
        ang_Ls = -110;  ang_Rs = 110;
        
        // Normalize source angle to [0, 360) for sector detection
        src_norm = src_angle;
        src_norm < 0 ? src_norm += 360;
        
        // Normalize speaker angles to [0, 360)
        norm_C = 0;  norm_R = 30;  norm_Rs = 110;
        norm_Ls = 250;  norm_L = 330;
        
        // Initialize gains
        g_L = 0; g_R = 0; g_C = 0; g_Ls = 0; g_Rs = 0;
        
        // Find active speaker pair and calculate gains (proper VBAP)
        // Only TWO adjacent speakers should be active at any time
        
        src_norm >= 0 && src_norm < 30 ? (
            // Sector: C -> R (0° to 30°)
            t = src_norm / 30;
            g_C = cos(t * $pi * 0.5);
            g_R = sin(t * $pi * 0.5);
        ) :
        src_norm >= 30 && src_norm < 110 ? (
            // Sector: R -> Rs (30° to 110°)
            t = (src_norm - 30) / 80;
            g_R = cos(t * $pi * 0.5);
            g_Rs = sin(t * $pi * 0.5);
        ) :
        src_norm >= 110 && src_norm < 250 ? (
            // Sector: Rs -> Ls (110° to 250°, rear arc)
            t = (src_norm - 110) / 140;
            g_Rs = cos(t * $pi * 0.5);
            g_Ls = sin(t * $pi * 0.5);
        ) :
        src_norm >= 250 && src_norm < 330 ? (
            // Sector: Ls -> L (250° to 330°)
            t = (src_norm - 250) / 80;
            g_Ls = cos(t * $pi * 0.5);
            g_L = sin(t * $pi * 0.5);
        ) :
        (
            // Sector: L -> C (330° to 360°/0°, wraps around)
            t = (src_norm - 330) / 30;
            g_L = cos(t * $pi * 0.5);
            g_C = sin(t * $pi * 0.5);
        );
        
        // Distribute mono signal to all speakers
        spl0 = mono_src * g_L;   // Front L
        spl1 = mono_src * g_R;   // Front R
        spl2 = mono_src * g_C;   // Center
        spl3 = sub_out + hit_lfe_out; // LFE
        spl4 = mono_src * g_Ls;  // Rear L
        spl5 = mono_src * g_Rs;  // Rear R
    );

    m_dec = 0.9998;
    gmem[0] = max(gmem[0]*m_dec, abs(wn_out));
    gmem[1] = max(gmem[1]*m_dec, abs(osc_out));
    gmem[2] = max(gmem[2]*m_dec, abs(chua_out));
    gmem[3] = max(gmem[3]*m_dec, abs(ext));

    out_mode < 0.5 ? (
        ch0 = abs(spl0 * master_gain); ch1 = abs(spl1 * master_gain); ch2 = 0; ch3 = abs(sub_out * master_gain); ch4 = 0; ch5 = 0;
    ) : (
        ch0 = abs(spl0 * master_gain); ch1 = abs(spl1 * master_gain); ch2 = abs(spl2 * master_gain);
        ch3 = abs(spl3 * master_gain); ch4 = abs(spl4 * master_gain); ch5 = abs(spl5 * master_gain);
    );
    gmem[4] = max(gmem[4]*m_dec, ch0); gmem[5] = max(gmem[5]*m_dec, ch1);
    gmem[6] = max(gmem[6]*m_dec, ch2); gmem[7] = max(gmem[7]*m_dec, ch3);
    gmem[8] = max(gmem[8]*m_dec, ch4); gmem[9] = max(gmem[9]*m_dec, ch5);

    gmem[10] = spl0; gmem[11] = spl1;

    spl0 = softlim(spl0 * master_gain); spl1 = softlim(spl1 * master_gain);
    spl2 = softlim(spl2 * master_gain); spl3 = softlim(spl3 * master_gain);
    spl4 = softlim(spl4 * master_gain); spl5 = softlim(spl5 * master_gain);

) : (
    spl0=spl1=spl2=spl3=spl4=spl5=0;
    gmem[0]*=0.99; gmem[1]*=0.99; gmem[2]*=0.99; gmem[3]*=0.99;
    gmem[4]*=0.99; gmem[5]*=0.99; gmem[6]*=0.99; gmem[7]*=0.99; gmem[8]*=0.99; gmem[9]*=0.99;
);
