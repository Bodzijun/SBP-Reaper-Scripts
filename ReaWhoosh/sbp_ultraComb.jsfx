  value=result=input;
  i=0;
  // Run all stages even in bypass, keeping newly selected stages warm.
  loop(128,
    coefficients>0 ? (
      coeff=coefficients+i*2;
      b0=coeff[0]; b1=coeff[1];
    );
    ptr=memory+i*4;
    x1=ptr[0]; x2=ptr[1]; y1=ptr[2]; y2=ptr[3];
    value=b0*value+b1*x1+x2-b1*y1-b0*y2;
    abs(value)<0.000000001 ? value=0;
    ptr[1]=x1; ptr[0]=input;
    ptr[3]=y1; ptr[2]=value;
    input=value;
    weight=max(0,min(1,stages-i));
    result+=(value-result)*weight;
    i+=1;
  );
  result;
);

function uc_disp_process(input_l, input_r, stages, resonance, b0_l, b1_l, b0_r, b1_r, enabled)
instance(state, configured, slew, current_stages, current_res, current_mix, out_l, out_r)
local(extraction, dispersed_l, dispersed_r, i, current, target, coefficients) global()
(
  current_stages+=(max(0,min(128,stages))-current_stages)*slew;
  current_res+=(max(0,min(1,resonance))-current_res)*slew;
  current_mix+=(max(0,min(1,enabled))-current_mix)*slew;
  i=0;
  loop(128,
    current=state+1024+i*2; target=state+1280+i*2;
    current[0]+=(target[0]-current[0])*slew;
    current[1]+=(target[1]-current[1])*slew;
    i+=1;
  );
  coefficients=configured ? state+1024 : 0;
  dispersed_l=uc_disp_channel(input_l,state,current_stages,b0_l,b1_l,coefficients);
  dispersed_r=uc_disp_channel(input_r,state+512,current_stages,b0_r,b1_r,coefficients);
  // Extraction fades with the first stage; zero stages must preserve the input.
  extraction=current_res*max(0,min(1,current_stages));
  out_l=input_l+(dispersed_l-input_l-input_l*extraction)*current_mix;
  out_r=input_r+(dispersed_r-input_r-input_r*extraction)*current_mix;
);
// End Disperser DSP module.

// Comb Motion control module: independent stereo delay trajectory.
function uc_comb_motion_init(rate, initial_rate, initial_depth_ms, initial_stereo, enabled)
instance(sample_rate, phase, lfo_rate, depth, stereo, random_l, random_r, value_l, value_r, slew, read_l, read_r, center, effective_depth)
local() global()
(
  sample_rate=max(1,rate); phase=0;
  lfo_rate=max(0.02,min(20,initial_rate));
  depth=max(0,min(10,initial_depth_ms))*sample_rate/1000*max(0,min(1,enabled));
  stereo=max(0,min(180,initial_stereo))/360;
  random_l=random_r=value_l=value_r=0;
  slew=1-exp(-1/(0.01*sample_rate));
  read_l=read_r=center=1; effective_depth=0;
);
function uc_comb_motion_wave(p, shape, random_value)
instance() local(wave) global()
(
  wave=shape==0 ? sin(2*$pi*p) :
    shape==1 ? 1-4*abs(p-0.5) :
    shape==2 ? (p<0.5 ? 1 : -1) : random_value;
  wave;
);
function uc_comb_motion_process(base_samples, buffer_size, target_rate, depth_ms, stereo_degrees, shape, enabled)
instance(sample_rate, phase, lfo_rate, depth, stereo, random_l, random_r, value_l, value_r, slew, read_l, read_r, center, effective_depth)
local(wrapped, phase_r, target_l, target_r, wave_slew, max_delay) global()
(
  lfo_rate+=(max(0.02,min(20,target_rate))-lfo_rate)*slew;
  depth+=(max(0,min(10,depth_ms))*sample_rate/1000*max(0,min(1,enabled))-depth)*slew;
  stereo+=(max(0,min(180,stereo_degrees))/360-stereo)*slew;
  phase+=lfo_rate/sample_rate;
  wrapped=phase>=1;
  phase-=floor(phase);
  random_l=wrapped ? rand(2)-1 : random_l;
  random_r=wrapped ? rand(2)-1 : random_r;
  phase_r=phase+stereo; phase_r-=floor(phase_r);
  target_l=this.uc_comb_motion_wave(phase,shape,random_l);
  target_r=this.uc_comb_motion_wave(phase_r,shape,random_l+(random_r-random_l)*stereo*2);
  // Short smoothing preserves periodic depth; random motion gets a gentler glide.
  wave_slew=1-exp(-1/((shape==3 ? 0.01 : shape==2 ? 0.002 : 0.0005)*sample_rate));
  value_l+=(target_l-value_l)*wave_slew;
  value_r+=(target_r-value_r)*wave_slew;
  max_delay=max(1,buffer_size-2);
  effective_depth=min(depth,(max_delay-1)*0.5);
  // Shift the center instead of silently reducing the requested excursion.
  center=max(1+effective_depth,min(max_delay-effective_depth,base_samples));
  read_l=max(1,min(max_delay,center+value_l*effective_depth));
  read_r=max(1,min(max_delay,center+value_r*effective_depth));
);
// End Comb Motion control module.

// Dry delay DSP module: exclusive raw-input stereo history, never feedback.
function uc_dry_init(memory, size, rate, initial_ms)
instance(buffer, buffer_size, sample_rate, write_pos, delay_samples, slew, out_l, out_r)
local() global()
(
  buffer=memory; buffer_size=max(4,floor(size)); sample_rate=max(1,rate);
  memset(buffer,0,buffer_size*2);
  write_pos=out_l=out_r=0;
  delay_samples=max(0,min(buffer_size-2,initial_ms*sample_rate/1000));
  slew=1-exp(-1/(0.05*sample_rate));
);
function uc_dry_read(memory, size, position, delay_samples, channel)
instance() local(read_pos, index, fraction, output) global()
(
  read_pos=(position-max(0,min(size-2,delay_samples))+size)%size;
  index=floor(read_pos); fraction=read_pos-index;
  output=memory[2*index+channel]*(1-fraction)+memory[2*((index+1)%size)+channel]*fraction;
  output;
);
function uc_dry_process(input_l, input_r, delay_ms)
instance(buffer, buffer_size, sample_rate, write_pos, delay_samples, slew, out_l, out_r)
local() global()
(
  delay_samples+=(max(0,min(buffer_size-2,delay_ms*sample_rate/1000))-delay_samples)*slew;
  buffer[2*write_pos]=input_l; buffer[2*write_pos+1]=input_r;
  out_l=this.uc_dry_read(buffer,buffer_size,write_pos,delay_samples,0);
  out_r=this.uc_dry_read(buffer,buffer_size,write_pos,delay_samples,1);
  write_pos=(write_pos+1)%buffer_size;
);
// End Dry delay DSP module.

// Comb history DSP module: causal read followed by feedback commit.
function uc_comb_history_init(left_memory, right_memory, size)
instance(buffer_l, buffer_r, buffer_size, write_pos, wet_l, wet_r, tap_delay, tap_l, tap_r)
local() global()
(
  buffer_l=left_memory; buffer_r=right_memory; buffer_size=max(4,floor(size));
  memset(buffer_l,0,buffer_size); memset(buffer_r,0,buffer_size);
  write_pos=wet_l=wet_r=0;
  tap_delay=1; tap_l=tap_r=0;
);
function uc_comb_history_read_channel(memory, size, position, delay)
instance() local(read_pos, index, fraction, output) global()
(
  read_pos=(position-max(1,min(size-2,delay))+size)%size;
  index=floor(read_pos); fraction=read_pos-index;
  output=memory[index]*(1-fraction)+memory[(index+1)%size]*fraction;
  output;
);
function uc_comb_history_read(delay_l, delay_r)
instance(buffer_l, buffer_r, buffer_size, write_pos, wet_l, wet_r)
local() global()
(
  wet_l=this.uc_comb_history_read_channel(buffer_l,buffer_size,write_pos,delay_l);
  wet_r=this.uc_comb_history_read_channel(buffer_r,buffer_size,write_pos,delay_r);
);
function uc_comb_history_tap(delay_samples, slew)
instance(buffer_l, buffer_r, buffer_size, write_pos, tap_delay, tap_l, tap_r)
local() global()
(
  tap_delay+=(max(1,min(buffer_size-2,delay_samples))-tap_delay)*slew;
  tap_l=this.uc_comb_history_read_channel(buffer_l,buffer_size,write_pos,tap_delay);
  tap_r=this.uc_comb_history_read_channel(buffer_r,buffer_size,write_pos,tap_delay);
);
function uc_comb_history_commit(input_l, input_r, feedback_l, feedback_r, feedback)
instance(buffer_l, buffer_r, buffer_size, write_pos, wet_l, wet_r)
local(gain) global()
(
  gain=max(0,min(0.95,feedback));
  buffer_l[write_pos]=max(-4,min(4,input_l+feedback_l*gain));
  buffer_r[write_pos]=max(-4,min(4,input_r+feedback_r*gain));
  write_pos=(write_pos+1)%buffer_size;
);
// End Comb history DSP module.

MAX_STAGES = 128;
// Metal Resonator DSP module: caller supplies exclusive state and delay memories.
function uc_metal_configure(size, decay_seconds, tone)
instance(state_memory, target_memory, ratio_memory, buffer_memory, buffer_size, sample_rate, write_pos, mix_value, slew, meter, meter_release, out_l, out_r, wet_l, wet_r)
local(i, ptr, length, decay, reference_decay, cutoff, brightness) global()
(
  brightness=max(0,min(1,tone));
  cutoff=min(sample_rate*0.45,500*pow(32,brightness));
  i=0;
  loop(6,
    ptr=target_memory+i*5;
    length=max(2,min(buffer_size-2,sample_rate*0.0015*max(0.25,min(4,size))*ratio_memory[i]));
    decay=max(0.03,min(3,decay_seconds))/(1+i*0.08);
    reference_decay=min(max(0.03,min(3,decay_seconds)),0.15)/(1+i*0.08);
    ptr[0]=length;
    ptr[1]=exp(-log(1000)*length/(decay*sample_rate));
    ptr[2]=1-exp(-2*$pi*cutoff/sample_rate);
    ptr[3]=exp(-i*(1-brightness)*0.25);
    // Keep excitation at the 150 ms reference above that decay, not progressively quieter.
    ptr[4]=sqrt(max(0,1-exp(-2*log(1000)*length/(reference_decay*sample_rate))));
    i+=1;
  );
);
function uc_metal_init(state_base, target_base, ratio_base, buffer_base, length, rate, size, decay, tone, enabled, mix)
instance(state_memory, target_memory, ratio_memory, buffer_memory, buffer_size, sample_rate, write_pos, mix_value, slew, meter, meter_release, out_l, out_r, wet_l, wet_r)
local(i) global()
(
  state_memory=state_base; target_memory=target_base; ratio_memory=ratio_base;
  buffer_memory=buffer_base; buffer_size=max(4,floor(length)); sample_rate=max(1,rate);
  memset(state_memory,0,6*12); memset(target_memory,0,6*5);
  memset(buffer_memory,0,6*2*buffer_size);
  ratio_memory[0]=1; ratio_memory[1]=1.37; ratio_memory[2]=1.91;
  ratio_memory[3]=2.63; ratio_memory[4]=3.79; ratio_memory[5]=5.17;
  write_pos=meter=out_l=out_r=wet_l=wet_r=0;
  mix_value=max(0,min(1,enabled))*max(0,min(1,mix));
  slew=1-exp(-1/(0.01*sample_rate));
  meter_release=exp(-1/(0.2*sample_rate));
  this.uc_metal_configure(size,decay,tone);
  i=0;
  loop(6, memcpy(state_memory+i*12+4,target_memory+i*5,5); i+=1;);
);
function uc_metal_limit(input)
instance() local(magnitude, shaped) global()
(
  magnitude=abs(input);
  shaped=magnitude<=0.908 ? magnitude : 0.908+0.092*(1-exp(-(magnitude-0.908)/0.092));
  shaped=input<0 ? -shaped : shaped;
  shaped;
);
function uc_metal_process(input_l, input_r, enabled, mix)
instance(state_memory, target_memory, ratio_memory, buffer_memory, buffer_size, sample_rate, write_pos, mix_value, slew, meter, meter_release, out_l, out_r, wet_l, wet_r)
local(i, ptr, target, read_pos, index, fraction, next_index, left_memory, right_memory, delayed_l, delayed_r, weights, normalization) global()
(
  mix_value+=(max(0,min(1,enabled))*max(0,min(1,mix))-mix_value)*slew;
  wet_l=wet_r=weights=0; i=0;
  // All modes remain warm in bypass and own their coefficient histories.
  loop(6,
    ptr=state_memory+i*12; target=target_memory+i*5;
    ptr[4]+=(target[0]-ptr[4])*slew;
    ptr[5]+=(target[1]-ptr[5])*slew;
    ptr[6]+=(target[2]-ptr[6])*slew;
    ptr[7]+=(target[3]-ptr[7])*slew;
    ptr[8]+=(target[4]-ptr[8])*slew;
    read_pos=(write_pos-ptr[4]+buffer_size)%buffer_size;
    index=floor(read_pos); fraction=read_pos-index; next_index=(index+1)%buffer_size;
    left_memory=buffer_memory+i*buffer_size*2; right_memory=left_memory+buffer_size;
    delayed_l=left_memory[index]*(1-fraction)+left_memory[next_index]*fraction;
    delayed_r=right_memory[index]*(1-fraction)+right_memory[next_index]*fraction;
    ptr[0]+=(delayed_l-ptr[0])*ptr[6];
    ptr[1]+=(delayed_r-ptr[1])*ptr[6];
    left_memory[write_pos]=input_l*ptr[8]+ptr[0]*ptr[5];
    right_memory[write_pos]=input_r*ptr[8]+ptr[1]*ptr[5];
    wet_l+=delayed_l*ptr[7]; wet_r+=delayed_r*ptr[7]; weights+=ptr[7]*ptr[7];
    i+=1;
  );
  write_pos=(write_pos+1)%buffer_size;
  normalization=1/sqrt(max(1,weights));
  wet_l=this.uc_metal_limit(wet_l*normalization);
  wet_r=this.uc_metal_limit(wet_r*normalization);
  meter=max(max(abs(wet_l),abs(wet_r)),meter*meter_release);
  out_l=input_l+(wet_l-input_l)*mix_value;
  out_r=input_r+(wet_r-input_r)*mix_value;
);
// End Metal Resonator DSP module.

METAL_OFFSET = 4000;
METAL_TARGET = 4200;
METAL_RATIOS = 4300;
METAL_MODES = 6;
METAL_BUFFER = 120000;
METAL_BUF_SIZE = 8192;
ultra_metal.uc_metal_init(METAL_OFFSET,METAL_TARGET,METAL_RATIOS,METAL_BUFFER,METAL_BUF_SIZE,srate,slider34,slider35,slider36,slider33,slider37);
atomic_set(ui_metal_on, slider33);
atomic_set(ui_metal_size, slider34);
atomic_set(ui_metal_decay, slider35);
atomic_set(ui_metal_tone, slider36);
atomic_set(ui_metal_mix, slider37);
atomic_set(ui_metal_level, 0);
atomic_set(ui_metal_contribution, 0);

// Memory layout: Disperser instance owns cells 0..1023.
ultra_disp.uc_disp_init(0, srate, slider10, slider11);

// Delay Buffer
BUF_L_START = 10000;
BUF_R_START = 60000;
BUF_SIZE = 50000;
ultra_comb_history.uc_comb_history_init(BUF_L_START,BUF_R_START,BUF_SIZE);
ultra_comb_history.tap_delay=max(1,min(BUF_SIZE-2,slider4*srate/1000));

// Wet delay trajectory initialization.
delay2_samps = 0;

ring_phase = 0;
sm_ring_freq = slider25;
sm_ring_depth = slider26;
sm_ring_mix = slider24*slider27;
ultra_comb_motion.uc_comb_motion_init(srate,slider29,slider30,slider31,slider28);
fs_rand_phase = 0;
disp_rand_phase = 0;
fs_rand_target = 0;
disp_rand_target = 0;
fs_rand_value = 0;
disp_rand_value = 0;
control_counter = 0;
CONTROL_INTERVAL = 32;
param_slew = 1 - exp(-1 / (0.01 * srate));
ultra_shift.uc_shift_init(srate, slider12, 1);
atomic_set(ui_fs_active, ultra_shift.current_hz);
smooth_ready = 0;
// @gfx has its own execution thread. Keep the LFO controls in atomic cells so
// a click is audible/visible immediately and does not wait for the next @slider.
atomic_set(ui_fs_lfo_on, slider14);
atomic_set(ui_fs_lfo_rate, slider15);
atomic_set(ui_fs_lfo_depth, slider16);
atomic_set(ui_fs_lfo_shape, slider20);
atomic_set(ui_disp_lfo_on, slider17);
atomic_set(ui_disp_lfo_rate, slider18);
atomic_set(ui_disp_lfo_depth, slider19);
atomic_set(ui_disp_lfo_shape, slider21);
atomic_set(ui_fb_tap, slider22);
atomic_set(ui_fb_extra, slider47);
atomic_set(ui_fb_saturation, slider23);
atomic_set(ui_fs_base, slider12);
atomic_set(ui_disp_base, slider7);
atomic_set(ui_plot_center, slider7);
atomic_set(ui_plot_tap_l, max(1,slider4*srate/1000));
atomic_set(ui_plot_tap_r, max(1,slider4*srate/1000));
atomic_set(ui_plot_fx, max(1,slider5*srate/1000));
atomic_set(ui_mix, slider3);
// Playback reinitialization must preserve the user's slider visibility choice.
ui_native_visible = 0;
hide_native_sliders();
ui_drag = ui_extra_drag = ui_mix_drag = ui_fb_drag = ui_was_down = ui_was_right_down = 0;
ui_touch_mask = 0;
ui_metal_touch = 0;

// Recalculate the all-pass coefficients whenever the randomized Disperser
// frequency changes. This runs at control rate, not per audio sample.
function update_disperser_coeffs() (
  freq_mod = freq_base * max(0.05, 1 + disp_rand_value * disp_rand_depth);
  atomic_set(ui_plot_center,freq_mod);
  ultra_disp.uc_disp_config(freq_mod,slider9,Q,num_stages,!smooth_ready);
  // Legacy scalar coefficients remain a neutral fallback for unconfigured instances.
  freq_l = freq_mod;
  freq_r = freq_mod;
  freq_l = max(20, min(freq_l, srate * 0.49));
  freq_r = max(20, min(freq_r, srate * 0.49));

  omega_l = 2 * $pi * freq_l / srate;
  sn_l = sin(omega_l);
  cs_l = cos(omega_l);
  alpha_l = sn_l / (2 * Q);
  a0_l = 1 + alpha_l;
  a1_l = -2 * cs_l;
  a2_l = 1 - alpha_l;
  inv_a0_l = 1.0 / a0_l;
  target_b0_l = a2_l * inv_a0_l;
  target_b1_l = a1_l * inv_a0_l;

  omega_r = 2 * $pi * freq_r / srate;
  sn_r = sin(omega_r);
  cs_r = cos(omega_r);
  alpha_r = sn_r / (2 * Q);
  a0_r = 1 + alpha_r;
  a1_r = -2 * cs_r;
  a2_r = 1 - alpha_r;
  inv_a0_r = 1.0 / a0_r;
  target_b0_r = a2_r * inv_a0_r;
  target_b1_r = a1_r * inv_a0_r;
);

// Feedback safety: transparent below the threshold, then progressively
// compresses peaks. Post-FX feedback can become self-oscillating otherwise.
function feedback_saturate(x, amount) (
  threshold = max(0.08, 1 - amount * 0.92);
  magnitude = abs(x);
  amount > 0.000001 && magnitude > threshold ? (
    shaped = threshold + (1-threshold) * (1-exp(-(magnitude-threshold)/(1-threshold)));
    x < 0 ? -shaped : shaped;
  ) : x;
);

// Unity small-signal gain keeps saturation from increasing feedback loop gain.
// Remove the added drive after shaping; SAT=0 is an exact bypass.
function feedback_color(x, amount) local(drive, magnitude, exponential, shaped) (
  amount = max(0, min(1, amount));
  drive = pow(10, amount*24/20);
  magnitude = abs(x)*drive;
  exponential = exp(-2*magnitude);
  shaped = (1-exponential)/(1+exponential)/drive;
  x < 0 ? shaped = -shaped;
  x += (shaped-x)*amount;
  feedback_saturate(x, amount);
);

// Wet saturation DSP module: linked stereo RMS compensation, outside feedback coloring.
function uc_sat_init(rate, initial_amount)
instance(amount, slew, power_slew, input_power, shaped_power, compensation, out_l, out_r)
local() global()
(
  amount=max(0,min(1,initial_amount));
  slew=1-exp(-1/(0.01*max(1,rate)));
  power_slew=1-exp(-1/(0.02*max(1,rate)));
  input_power=shaped_power=0; compensation=1;
  out_l=out_r=0;
);
function uc_sat_shape(input, drive)
instance() local(exponential, output) global()
(
  exponential=exp(-2*abs(input)*drive);
  output=(1-exponential)/(1+exponential);
  output=input<0 ? -output : output;
  output;
);
function uc_sat_process(input_l, input_r, target_amount)
instance(amount, slew, power_slew, input_power, shaped_power, compensation, out_l, out_r)
local(drive, shaped_l, shaped_r) global()
(
  amount+=(max(0,min(1,target_amount))-amount)*slew;
  drive=pow(10,amount*30/20);
  shaped_l=this.uc_sat_shape(input_l,drive);
  shaped_r=this.uc_sat_shape(input_r,drive);
  input_power+=((input_l*input_l+input_r*input_r)*0.5-input_power)*power_slew;
  shaped_power+=((shaped_l*shaped_l+shaped_r*shaped_r)*0.5-shaped_power)*power_slew;
  compensation=max(1/drive,min(1,sqrt((input_power+0.000000000000000000000001)/(shaped_power+0.000000000000000000000001))));
  out_l=input_l+(shaped_l*compensation-input_l)*amount;
  out_r=input_r+(shaped_r*compensation-input_r)*amount;
);
// End Wet saturation DSP module.

// Filter DSP module: Cytomic TPT SVF, Andrew Simper's equivalent-current form.
// https://www.cytomic.com/files/dsp/SvfLinearTrapOptimised2.pdf
function uc_filter_channel_reset()
instance(ic1,ic2,lp,hp,bp,notch) local() global()
(
  ic1=ic2=lp=hp=bp=notch=0;
);
function uc_filter_channel(input,a1,a2,a3,k)
instance(ic1,ic2,lp,hp,bp,notch) local(v1,v2,v3) global()
(
  v3=input-ic2; v1=a1*ic1+a2*v3; v2=ic2+a2*ic1+a3*v3;
  ic1=2*v1-ic1; ic2=2*v2-ic2;
  abs(ic1)<0.000000000001 ? ic1=0;
  abs(ic2)<0.000000000001 ? ic2=0;
  lp=v2; hp=input-k*v1-v2; bp=k*v1; notch=input-k*v1;
);
function uc_filter_init(rate,cutoff,resonance,mode)
instance(sample_rate,slew,phase,random_value,lfo_value,cut_log,res,drive,mix_value,wlp,whp,wbp,wnotch,active_hz,out_l,out_r)
local() global()
(
  sample_rate=max(1,rate); slew=1-exp(-1/(0.01*sample_rate));
  phase=random_value=lfo_value=drive=mix_value=out_l=out_r=0;
  cut_log=log(max(20,min(sample_rate*0.45,cutoff)));
  res=max(0,min(1,resonance)); active_hz=exp(cut_log);
  wlp=mode==0; whp=mode==1; wbp=mode==2; wnotch=mode==3;
  this.left.uc_filter_channel_reset(); this.right.uc_filter_channel_reset();
);
function uc_filter_process(input_l,input_r,enabled,mode,cutoff,resonance,drive_db,mix,lfo_rate,lfo_depth,lfo_shape)
instance(sample_rate,slew,phase,random_value,lfo_value,cut_log,res,drive,mix_value,wlp,whp,wbp,wnotch,active_hz,out_l,out_r)
local(target,glide,g,k,a1,a2,a3,gain,blend,shaped_l,shaped_r,wet_l,wet_r) global()
(
  phase+=max(0.02,min(20,lfo_rate))/sample_rate;
  phase>=1 ? (phase-=floor(phase); random_value=rand(2)-1;);
  target=0;
  lfo_shape==1 ? target=sin(2*$pi*phase);
  lfo_shape==2 ? target=1-4*abs(phase-0.5);
  lfo_shape==3 ? target=2*phase-1;
  lfo_shape==4 ? target=phase<0.5 ? 1 : -1;
  lfo_shape==5 ? target=random_value;
  glide=lfo_shape==1 || lfo_shape==2 ? 1 :
    1-exp(-1/((lfo_shape==3 || lfo_shape==4 ? 0.002 : 0.01)*sample_rate));
  lfo_value+=(target-lfo_value)*glide;
  cut_log+=(log(max(20,min(20000,cutoff)))-cut_log)*slew;
  active_hz=max(20,min(sample_rate*0.45,exp(cut_log)*pow(2,lfo_value*max(0,min(6,lfo_depth)))));
  res+=(max(0,min(1,resonance))-res)*slew;
  drive+=(max(0,min(24,drive_db))-drive)*slew;
  mix_value+=(max(0,min(1,enabled))*max(0,min(1,mix))-mix_value)*slew;
  wlp+=((mode==0)-wlp)*slew; whp+=((mode==1)-whp)*slew;
  wbp+=((mode==2)-wbp)*slew; wnotch+=((mode==3)-wnotch)*slew;
  g=tan($pi*active_hz/sample_rate); k=2/pow(40,res);
  a1=1/(1+g*(g+k)); a2=g*a1; a3=g*a2;
  gain=pow(10,drive/20); blend=min(1,drive/3);
  shaped_l=input_l*gain/sqrt(1+input_l*input_l*gain*gain);
  shaped_r=input_r*gain/sqrt(1+input_r*input_r*gain*gain);
  shaped_l=input_l+(shaped_l-input_l)*blend;
  shaped_r=input_r+(shaped_r-input_r)*blend;
  this.left.uc_filter_channel(shaped_l,a1,a2,a3,k);
  this.right.uc_filter_channel(shaped_r,a1,a2,a3,k);
  wet_l=this.left.lp*wlp+this.left.hp*whp+this.left.bp*wbp+this.left.notch*wnotch;
  wet_r=this.right.lp*wlp+this.right.hp*whp+this.right.bp*wbp+this.right.notch*wnotch;
  out_l=input_l+(wet_l-input_l)*mix_value;
  out_r=input_r+(wet_r-input_r)*mix_value;
);
// End Filter DSP module.
ultra_filter.uc_filter_init(srate,slider76,slider77,slider75);
atomic_set(ui_filter_hz,ultra_filter.active_hz);
ultra_sat.uc_sat_init(srate,slider23);

// Output clipper DSP module: final output only, never part of the feedback loop.
function uc_clip_init(rate,enabled,ceiling_db,soft)
instance(mix_value,ceiling,soft_mix,slew,ceiling_slew,out_l,out_r) local() global()
(
  mix_value=max(0,min(1,enabled)); soft_mix=max(0,min(1,soft));
  ceiling=pow(10,max(-24,min(0,ceiling_db))/20);
  slew=1-exp(-1/(0.002*max(1,rate)));
  ceiling_slew=1-exp(-1/(0.01*max(1,rate)));
  out_l=out_r=0;
);
function uc_clip_shape(input,ceiling,soft)
instance() local(normal,magnitude,hard,shaped) global()
(
  normal=input/ceiling; magnitude=abs(normal);
  hard=min(1,magnitude);
  shaped=magnitude<=0.8 ? magnitude : 0.8+0.2*(1-exp(-(magnitude-0.8)/0.2));
  shaped=hard+(shaped-hard)*soft;
  shaped=(input<0 ? -1 : 1)*shaped*ceiling;
  shaped;
);
function uc_clip_process(input_l,input_r,enabled,ceiling_db,soft)
instance(mix_value,ceiling,soft_mix,slew,ceiling_slew,out_l,out_r) local() global()
(
  mix_value+=(max(0,min(1,enabled))-mix_value)*slew;
  ceiling+=(pow(10,max(-24,min(0,ceiling_db))/20)-ceiling)*ceiling_slew;
  soft_mix+=(max(0,min(1,soft))-soft_mix)*slew;
  out_l=input_l+(this.uc_clip_shape(input_l,ceiling,soft_mix)-input_l)*mix_value;
  out_r=input_r+(this.uc_clip_shape(input_r,ceiling,soft_mix)-input_r)*mix_value;
);
// End Output clipper DSP module.
ultra_clip.uc_clip_init(srate,slider85,slider86,slider87);

function notify_ui_slider(mask) local(new_index) (
  sync_pitch_controls();
  // Publish custom-panel edits to the same atomic targets used by host automation.
  atomic_set(ui_mix, slider3);
  atomic_set(ui_disp_base, slider7);
  atomic_set(ui_fs_base, slider12);
  atomic_set(ui_fs_lfo_on, slider14);
  atomic_set(ui_fs_lfo_rate, slider15);
  atomic_set(ui_fs_lfo_depth, slider16);
  atomic_set(ui_disp_lfo_on, slider17);
  atomic_set(ui_disp_lfo_rate, slider18);
  atomic_set(ui_disp_lfo_depth, slider19);
  atomic_set(ui_fs_lfo_shape, slider20);
  atomic_set(ui_disp_lfo_shape, slider21);
  atomic_set(ui_fb_tap, slider22);
  atomic_set(ui_fb_extra, slider47);
  atomic_set(ui_fb_saturation, slider23);
  atomic_set(ui_metal_on, slider33);
  atomic_set(ui_metal_size, slider34);
  atomic_set(ui_metal_decay, slider35);
  atomic_set(ui_metal_tone, slider36);
  atomic_set(ui_metal_mix, slider37);
  // Use slider references for parameters above 32, independent of mask width.
  mask == 2^32 ? (sliderchange(slider33); slider_automate(slider33););
  mask == 2^33 ? (sliderchange(slider34); slider_automate(slider34););
  mask == 2^34 ? (sliderchange(slider35); slider_automate(slider35););
  mask == 2^35 ? (sliderchange(slider36); slider_automate(slider36););
  mask == 2^36 ? (sliderchange(slider37); slider_automate(slider37););
  mask == 2^37 ? (sliderchange(slider38); slider_automate(slider38););
  mask == 2^38 ? (sliderchange(slider39); slider_automate(slider39););
  mask == 2^39 ? (sliderchange(slider40); slider_automate(slider40););
  mask == 2^40 ? (sliderchange(slider41); slider_automate(slider41););
  mask == 2^41 ? (sliderchange(slider42); slider_automate(slider42););
  mask == 2^42 ? (sliderchange(slider43); slider_automate(slider43););
  mask == 2^43 ? (sliderchange(slider44); slider_automate(slider44););
  mask == 2^44 ? (sliderchange(slider45); slider_automate(slider45););
  mask == 2^45 ? (sliderchange(slider46); slider_automate(slider46););
  mask == 2^46 ? (sliderchange(slider47); slider_automate(slider47););
  mask == 2^47 ? (sliderchange(slider48); slider_automate(slider48););
  mask == 2^48 ? (sliderchange(slider49); slider_automate(slider49););
  mask == 2^49 ? (sliderchange(slider50); slider_automate(slider50););
  mask == 2^50 ? (sliderchange(slider51); slider_automate(slider51););
  mask == 2^51 ? (sliderchange(slider52); slider_automate(slider52););
  mask == 2^52 ? (sliderchange(slider53); slider_automate(slider53););
  mask == 2^53 ? (sliderchange(slider54); slider_automate(slider54););
  mask == 2^54 ? (sliderchange(slider55); slider_automate(slider55););
  mask == 2^55 ? (sliderchange(slider56); slider_automate(slider56););
  mask == 2^56 ? (sliderchange(slider57); slider_automate(slider57););
  mask == 2^57 ? (sliderchange(slider58); slider_automate(slider58););
  mask == 2^58 ? (sliderchange(slider59); slider_automate(slider59););
  mask == 2^59 ? (sliderchange(slider60); slider_automate(slider60););
  mask == 2^60 ? (sliderchange(slider61); slider_automate(slider61););
  mask == 2^61 ? (sliderchange(slider62); slider_automate(slider62););
  mask == 2^62 ? (sliderchange(slider63); slider_automate(slider63););
  mask == 2^63 ? (sliderchange(slider64); slider_automate(slider64););
  mask == 2^64 ? (sliderchange(slider65); slider_automate(slider65););
  mask == 2^65 ? (sliderchange(slider66); slider_automate(slider66););
  mask == 2^66 ? (sliderchange(slider67); slider_automate(slider67););
  mask == 2^67 ? (sliderchange(slider68); slider_automate(slider68););
  mask == 2^68 ? (sliderchange(slider69); slider_automate(slider69););
  mask == 2^69 ? (sliderchange(slider70); slider_automate(slider70););
  mask == 2^70 ? (sliderchange(slider71); slider_automate(slider71););
  mask == 2^71 ? (sliderchange(slider72); slider_automate(slider72););
  new_index=74;
  loop(14,
    mask==2^(new_index-1) ? (sliderchange(slider(new_index)); slider_automate(slider(new_index)););
    new_index+=1;
  );
  mask < 2^32 ? (
    sliderchange(mask);
    slider_automate(mask);
    ui_touch_mask |= mask;
  ) : ui_metal_touch = mask;
);

function reset_ui_parameter(index) (
  slider(index) != UI_DEFAULT[index-1] ? (
    slider(index)=UI_DEFAULT[index-1];
    notify_ui_slider(2^(index-1));
    slider_automate(slider(index), 1);
    sliderchange(-1);
  );
);

function panel_slider(index, lo, hi, step, x, y, width, label, unit, decimals)
local(value, next_value, norm, track_x, track_w, mask, value_x, label_w, label_h) (
  value = slider(index);
  track_x = x + 175;
  track_w = width - 195;
  value_x = x+104;
  index <= 3 || index == 13 || index == 86 ? (
    gfx_setfont(2, "Arial", 12);
    gfx_measurestr(label, label_w, label_h);
    value_x = x+label_w+8;
    track_x = value_x+60;
    track_w = max(24, x+width-18-track_x);
  );
  mouse_right_clicked && !mouse_down && mouse_x >= x && mouse_x <= track_x+track_w &&
    mouse_y >= y-4 && mouse_y <= y+17 ? (
    reset_ui_parameter(index);
    value=slider(index);
  );
  mouse_clicked && mouse_x >= track_x && mouse_x <= track_x+track_w &&
    mouse_y >= y-4 && mouse_y <= y+17 ? ui_extra_drag = index;
  mouse_down && ui_extra_drag == index ? (
    norm = max(0, min(1, (mouse_x-track_x)/track_w));
    index == 12 ? (
      norm=2*norm-1;
      next_value=hi*norm*norm*norm;
      next_value=floor(next_value/step+0.5)*step;
    ) : index == 7 || index == 25 || index == 71 || index == 76 ? (
      next_value = lo*pow(hi/lo, norm);
      next_value = floor(next_value/step+0.5)*step;
    ) : next_value = lo + floor((hi-lo)*norm/step+0.5)*step;
    next_value = max(lo, min(hi, next_value));
    next_value != value ? (
      slider(index) = next_value;
      mask = 2^(index-1);
      notify_ui_slider(mask);
      value = next_value;
    );
  );
  norm = index == 7 || index == 25 || index == 71 || index == 76 ? log(max(lo,value)/lo)/log(hi/lo) : (value-lo)/(hi-lo);
  index==12 ? norm=0.5+0.5*(value<0 ? -1 : 1)*pow(abs(value)/hi,1/3);
  norm = max(0, min(1, norm));
  gfx_setfont(2, "Arial", 12);
  gfx_set(0.70, 0.82, 0.93, 1);
  gfx_x=x; gfx_y=y; gfx_drawstr(label);
  gfx_set(0.16, 0.22, 0.29, 1);
  gfx_rect(track_x, y+5, track_w, 7, 1);
  gfx_set(ui_accent_r, ui_accent_g, ui_accent_b, 1);
  gfx_rect(track_x, y+5, track_w*norm, 7, 1);
  gfx_circle(track_x+track_w*norm, y+8.5, 4, 1);
  gfx_x=value_x; gfx_y=y;
  gfx_set(0.46, 0.65, 0.76, 1);
  (index==70 && value<=0) || (index==71 && value>=20000) ? gfx_drawstr("OFF") : (
    gfx_drawnumber(value, decimals); gfx_drawstr(unit);
  );
);

function panel_toggle(index, x, y) local(value) (
  value = slider(index) > 0.5;
  mouse_clicked && mouse_x >= x && mouse_x <= x+58 &&
    mouse_y >= y && mouse_y <= y+22 ? (
    value = !value;
    slider(index) = value;
    notify_ui_slider(2^(index-1));
  );
  gfx_set(value ? ui_accent_r*0.65 : 0.12, value ? ui_accent_g*0.65 : 0.16, value ? ui_accent_b*0.65 : 0.20, 1);
  gfx_rect(x, y, 58, 22, 1);
  gfx_setfont(2, "Arial", 12, 'b'); gfx_set(0.93, 0.98, 1, 1);
  gfx_x=x+17; gfx_y=y+5;
  value ? gfx_drawstr("ON") : gfx_drawstr("OFF");
);

function panel_heading(x, y, width, label, r, g, b) (
  ui_accent_r = r; ui_accent_g = g; ui_accent_b = b;
  gfx_set(0.17, 0.21, 0.25, 1); gfx_rect(x, y-10, width, 1, 1);
  gfx_setfont(1, "Arial", 15, 'b'); gfx_set(r, g, b, 1);
  gfx_x=x; gfx_y=y; gfx_drawstr(label);
);

// Plot math uses gfx-owned coefficient memory, never the live audio state.
function uc_plot_prepare(center, spread, q, stages, rate)
local(i, position, frequency, omega, alpha, ptr) (
  i=0;
  loop(128,
    position=max(-1,min(1,2*i/max(1,stages-1)-1));
    stages<=1 ? position=0;
    frequency=max(20,min(rate*0.49,center*pow(2,position*spread/100)));
    omega=2*$pi*frequency/rate; alpha=sin(omega)/(2*max(0.1,q));
    ptr=242000+3*i;
    ptr[0]=(1-alpha)/(1+alpha); ptr[1]=-2*cos(omega)/(1+alpha); ptr[2]=frequency;
    i+=1;
  );
);

function uc_plot_db(frequency, rate, stages, subtract, tap_delay, fx_delay, mix, level)
local(w, c1, s1, c2, s2, i, ptr, nr, ni, dr, di, denom, ar, ai,
  hr, hi, next_r, next_i, weight, phase, fraction, tr, ti, fr, fi, real, imag) (
  w=2*$pi*frequency/rate;
  c1=cos(w); s1=-sin(w); c2=cos(2*w); s2=-sin(2*w);
  hr=1; hi=0; i=0;
  loop(min(128,ceil(stages)),
    ptr=242000+3*i;
    nr=ptr[0]+ptr[1]*c1+c2; ni=ptr[1]*s1+s2;
    dr=1+ptr[1]*c1+ptr[0]*c2; di=ptr[1]*s1+ptr[0]*s2;
    denom=max(0.00000000000000000001,dr*dr+di*di);
    ar=(nr*dr+ni*di)/denom; ai=(ni*dr-nr*di)/denom;
    next_r=hr*ar-hi*ai; next_i=hr*ai+hi*ar;
    weight=max(0,min(1,stages-i));
    hr+=(next_r-hr)*weight; hi+=(next_i-hi)*weight;
    i+=1;
  );
  hr-=subtract*max(0,min(1,stages));
  // Match the fractional linear interpolation used by both history taps.
  phase=-w*floor(tap_delay); fraction=tap_delay-floor(tap_delay);
  tr=cos(phase)*(1-fraction+fraction*c1)-sin(phase)*fraction*s1;
  ti=sin(phase)*(1-fraction+fraction*c1)+cos(phase)*fraction*s1;
  phase=-w*floor(fx_delay); fraction=fx_delay-floor(fx_delay);
  fr=cos(phase)*(1-fraction+fraction*c1)-sin(phase)*fraction*s1;
  fi=sin(phase)*(1-fraction+fraction*c1)+cos(phase)*fraction*s1;
  real=tr*(1-mix)+(fr*hr-fi*hi)*level*mix;
  imag=ti*(1-mix)+(fr*hi+fi*hr)*level*mix;
  10*log10(max(0.00000001,real*real+imag*imag));
);

function panel_disp_plot(x, y, width)
local(center, spread, q, stages, subtract, rate, tap_l, tap_r, fx, mix, level,
  high, span, plot_y, plot_h, plot_w, i, frequency, px, py, last_x, last_y,
  ptr, db, channel, marker, center_x, hover_hz, text_w, text_h) (
  center=max(20,atomic_get(ui_plot_center)); spread=slider9;
  q=slider8; stages=max(0,min(128,slider10)); subtract=slider11;
  rate=max(8000,srate); high=min(20000,rate*0.49); span=log(high/20);
  tap_l=slider28>0.5 ? max(1,atomic_get(ui_plot_tap_l)) : max(1,slider4*rate/1000);
  tap_r=slider28>0.5 ? max(1,atomic_get(ui_plot_tap_r)) : tap_l;
  fx=max(1,slider5*rate/1000); mix=slider3; level=slider13;
  uc_plot_prepare(center,spread,q,stages,rate);
  plot_y=y+16; plot_h=60; plot_w=max(1,width-1);
  gfx_setfont(2,"Arial",10); gfx_set(0.55,0.66,0.71,1);
  gfx_x=x; gfx_y=y;
  abs(atomic_get(ui_fs_active))>0.001 || slider14>0.5 || abs(slider12)>0.001 ?
    gfx_drawstr("NO SHIFT / NO FB") : gfx_drawstr("CORE / NO FB");
  gfx_x=x+width-58; gfx_drawstr("+6..-48 dB");
  gfx_set(0.04,0.065,0.08,1); gfx_rect(x,plot_y,width,plot_h,1);
  i=0;
  loop(4,
    frequency=20*pow(10,i);
    px=x+log(frequency/20)/span*plot_w;
    gfx_set(0.14,0.20,0.23,1); gfx_line(px,plot_y,px,plot_y+plot_h);
    i+=1;
  );
  gfx_line(x,plot_y+plot_h*6/54,x+plot_w,plot_y+plot_h*6/54);
  i=0;
  loop(ceil(stages),
    ptr=242000+3*i; marker=ptr[2];
    marker>=20 && marker<=high ? (
      px=x+log(marker/20)/span*plot_w;
      gfx_set(0.63,0.82,0.42,0.45); gfx_line(px,plot_y,px,plot_y+8);
    );
    i+=1;
  );
  channel=0;
  loop(abs(tap_l-tap_r)>0.01 ? 2 : 1,
    channel==0 ? gfx_set(0.26,0.83,0.89,1) : gfx_set(0.95,0.65,0.43,0.85);
    i=0;
    loop(193,
      frequency=20*exp(span*i/192);
      db=uc_plot_db(frequency,rate,stages,subtract,channel==0 ? tap_l : tap_r,fx,mix,level);
      px=x+plot_w*i/192; py=plot_y+plot_h*(6-max(-48,min(6,db)))/54;
      i>0 ? gfx_line(last_x,last_y,px,py);
      last_x=px; last_y=py; i+=1;
    );
    channel+=1;
  );
  center_x=x+max(0,min(1,log(center/20)/span))*plot_w;
  gfx_set(0.85,0.95,0.68,0.8); gfx_line(center_x,plot_y,center_x,plot_y+plot_h);
  gfx_set(0.55,0.66,0.71,1); gfx_x=x; gfx_y=plot_y+plot_h+3; gfx_drawstr("20 Hz");
  gfx_x=x+width-28; gfx_drawstr(high>=19999 ? "20k" : "Hz");
  mouse_x>=x && mouse_x<=x+plot_w && mouse_y>=plot_y && mouse_y<=plot_y+plot_h ? (
    hover_hz=20*exp(span*(mouse_x-x)/plot_w);
    gfx_set(0.9,0.95,1,0.5); gfx_line(mouse_x,plot_y,mouse_x,plot_y+plot_h);
    gfx_x=x+55; gfx_y=plot_y+plot_h+3;
    gfx_drawnumber(hover_hz,0); gfx_drawstr(" Hz  ");
    gfx_drawnumber(uc_plot_db(hover_hz,rate,stages,subtract,tap_l,fx,mix,level),1); gfx_drawstr(" dB L");
  );
);

function panel_route(x,y,width) local(slot,cell,module,choice,other,found,temp,rank,position,count) (
  route_decode_full(slider73+720*slider83,ROUTE_UI);
  gfx_set(0.12,0.23,0.23,1); gfx_rect(x,y,69,20,1);
  gfx_setfont(2,"Arial",11,'b'); gfx_set(0.52,0.88,0.87,1);
  gfx_x=x+12; gfx_y=y+4; gfx_drawstr("CORE");
  x+=72; width-=72;
  cell=width/7; slot=0;
  loop(7,
    module=ROUTE_UI[slot];
    module==0 ? strcpy(#route_label,"FREEZE");
    module==1 ? strcpy(#route_label,"PITCH");
    module==2 ? strcpy(#route_label,"DOUBLE");
    module==3 ? strcpy(#route_label,"RING");
    module==4 ? strcpy(#route_label,"METAL");
    module==5 ? strcpy(#route_label,"SAT");
    module==6 ? strcpy(#route_label,"FILTER");
    gfx_set(0.10,0.16,0.19,1); gfx_rect(x+slot*cell,y,cell-3,20,1);
    gfx_setfont(2,"Arial",11); gfx_set(0.70,0.82,0.93,1);
    gfx_x=x+slot*cell+5; gfx_y=y+4;
    gfx_drawnumber(slot+1,0); gfx_drawstr("  "); gfx_drawstr(#route_label);
    mouse_clicked && mouse_x>=x+slot*cell && mouse_x<x+(slot+1)*cell-3 && mouse_y>=y && mouse_y<=y+20 ? (
      gfx_x=x+slot*cell; gfx_y=y+20;
      choice=gfx_showmenu("Freeze|Pitch|Double|Ring|Metal|SAT|Filter");
      choice>0 ? (
        other=0; found=slot;
        loop(7,
          ROUTE_UI[other]==choice-1 ? found=other;
          other+=1;
        );
        temp=ROUTE_UI[slot]; ROUTE_UI[slot]=choice-1; ROUTE_UI[found]=temp;
        other=0; count=0; position=6;
        loop(7,
          ROUTE_UI[other]==6 ? position=other : (
            ROUTE_UI[count+8]=ROUTE_UI[other]; count+=1;
          );
          other+=1;
        );
        rank=route_encode(ROUTE_UI+8);
        rank!=slider73 ? (slider73=rank; sliderchange(slider73); slider_automate(slider73); slider_automate(slider73,1););
        position!=slider83 ? (slider83=position; sliderchange(slider83); slider_automate(slider83); slider_automate(slider83,1););
      );
    );
    mouse_right_clicked && mouse_x>=x && mouse_x<x+width && mouse_y>=y && mouse_y<=y+20 ? (
      slider73=0; sliderchange(slider73); slider_automate(slider73); slider_automate(slider73,1);
      slider83=6; sliderchange(slider83); slider_automate(slider83); slider_automate(slider83,1);
    );
    slot+=1;
  );
);

function panel_feedback_menu(x, y, width) local(mode, choice) (
  mode = slider84>0.5 ? 9 : slider59 > 0.5 ? (slider59 < 1.5 ? 1 : 3) : slider47 > 0.5 ? (
    slider47 < 1.5 ? 2 : slider47 < 2.5 ? 4 : slider47 < 3.5 ? 7 : 8;
  ) : (slider22 < 0.5 ? 0 : slider22 < 1.5 ? 5 : 6);
  mode == 0 ? strcpy(#fb_label, "PRE FX");
  mode == 1 ? strcpy(#fb_label, "POST FREEZE");
  mode == 2 ? strcpy(#fb_label, "POST PITCH");
  mode == 3 ? strcpy(#fb_label, "POST DOUBLE");
  mode == 4 ? strcpy(#fb_label, "POST RING");
  mode == 5 ? strcpy(#fb_label, "POST DISPERSER");
  mode == 6 ? strcpy(#fb_label, "POST SHIFT");
  mode == 7 ? strcpy(#fb_label, "POST METAL");
  mode == 8 ? strcpy(#fb_label, "POST SAT");
  mode == 9 ? strcpy(#fb_label, "POST FILTER");
  gfx_set(0.10, 0.15, 0.18, 1); gfx_rect(x, y, width, 22, 1);
  gfx_setfont(2, "Arial", 11, 'b'); gfx_set(0.82, 0.93, 0.95, 1);
  gfx_x=x+10; gfx_y=y+5; gfx_drawstr(#fb_label);
  gfx_x=x+width-18; gfx_drawstr("v");
  mouse_clicked && mouse_x >= x && mouse_x <= x+width && mouse_y >= y && mouse_y < y+22 ? (
    sprintf(#fb_menu, "%sPRE FX|%sPOST FREEZE|%sPOST PITCH|%sPOST DOUBLE|%sPOST RING|%sPOST DISPERSER|%sPOST SHIFT|%sPOST METAL|%sPOST SAT|%sPOST FILTER",
      mode == 0 ? "!" : "", mode == 1 ? "!" : "", mode == 2 ? "!" : "",
      mode == 3 ? "!" : "", mode == 4 ? "!" : "", mode == 5 ? "!" : "", mode == 6 ? "!" : "",
      mode == 7 ? "!" : "", mode == 8 ? "!" : "", mode == 9 ? "!" : "");
    gfx_x=x; gfx_y=y+22;
    choice = gfx_showmenu(#fb_menu)-1;
    choice >= 0 ? (
      slider84=choice==9; notify_ui_slider(2^83);
      choice<9 ? (
      slider59 = choice == 1 ? 1 : choice == 3 ? 2 : 0;
      choice == 0 || choice == 5 || choice == 6 ? (
        slider47 = 0;
        slider22 = choice == 0 ? 0 : choice == 5 ? 1 : 2;
        notify_ui_slider(2^21);
      ) : (choice != 1 && choice != 3 ? slider47 = choice == 2 ? 1 : choice == 4 ? 2 : choice == 7 ? 3 : 4;);
      );
      notify_ui_slider(2^46);
      notify_ui_slider(2^58);
    );
  );
);

function panel_choices(index, x, y, width, count, labels)
local(i, bx, bw, selected, text_width, text_height, text_length) (
  bw = width/count;
  i = 0;
  loop(count,
    bx = x+i*bw;
    mouse_clicked && mouse_x >= bx && mouse_x < bx+bw-3 &&
      mouse_y >= y && mouse_y < y+22 ? (
      index == 20 && count == 5 ? (
        slider14 = i > 0;
        i > 0 ? (
          slider20 = i-1;
          notify_ui_slider(2^19);
        );
        notify_ui_slider(2^13);
      ) : (
        slider(index) = i;
        notify_ui_slider(2^(index-1));
      );
    );
    selected = index == 20 && count == 5 ?
      (slider14 > 0.5 ? floor(slider20+0.5)+1 : 0) == i :
      floor(slider(index)+0.5) == i;
    gfx_set(selected ? ui_accent_r*0.55 : 0.10, selected ? ui_accent_g*0.55 : 0.13, selected ? ui_accent_b*0.55 : 0.17, 1);
    gfx_rect(bx, y, bw-3, 22, 1);
    gfx_setfont(2, "Arial", 11, 'b'); gfx_set(0.88, 0.93, 0.97, 1);
    text_length=9;
    while(text_length > 0 && str_getchar(labels, i*9+text_length-1) == 32) (text_length-=1;);
    strcpy_substr(#ui_choice_text, labels, i*9, text_length);
    gfx_measurestr(#ui_choice_text, text_width, text_height);
    gfx_x=bx+(bw-3-text_width)*0.5; gfx_y=y+5;
    gfx_drawstr(#ui_choice_text);
    i += 1;
  );
);

function ui_button(x, y, width, label, enabled) local(hit, tw, th) (
  hit = mouse_x >= x && mouse_x <= x+width && mouse_y >= y && mouse_y < y+22;
  gfx_set(enabled ? (hit ? 0.22 : 0.14) : 0.09, enabled ? 0.20 : 0.12, enabled ? 0.24 : 0.14, 1);
  gfx_rect(x, y, width, 22, 1);
  gfx_setfont(2, "Arial", 11, 'b');
  gfx_set(enabled ? 0.89 : 0.42, enabled ? 0.95 : 0.48, enabled ? 0.97 : 0.51, 1);
  gfx_measurestr(label, tw, th);
  gfx_x=x+(width-tw)*0.5; gfx_y=y+5; gfx_drawstr(label);
  mouse_clicked && hit && enabled;
);

function finish_bulk_touch() local(i) (
  i=0;
  loop(84,
    MORPH_CHANGED[i] ? slider_automate(slider(i+1), 1);
    MORPH_CHANGED[i]=0;
    i+=1;
  );
  ui_bulk_touch=0;
);

function store_morph_snapshot(destination) local(i) (
  i=0; loop(84, destination[i]=slider(i+1); i+=1;);
  destination == MORPH_A ? morph_a_ready=1 : morph_b_ready=1;
  morph_last_applied=slider65;
  sliderchange(-1);
);

function set_bulk_slider(index, value, publish) local(i, step) (
  i=index-1; step=MORPH_STEP[i];
  value = max(MORPH_LO[i], min(MORPH_HI[i], value));
  value = MORPH_LO[i]+floor((value-MORPH_LO[i])/step+0.5)*step;
  value = max(MORPH_LO[i], min(MORPH_HI[i], value));
  abs(value-slider(index)) > step*0.001 ? (
    slider(index)=value;
    sliderchange(slider(index));
    publish ? (
      slider_automate(slider(index));
      MORPH_CHANGED[i]=1; ui_bulk_touch=1;
    );
  );
);

function interpolate_parameter(index, a, b, position) (
  MORPH_LOG[index] && a > 0 && b > 0 ?
    a*pow(b/a, position) : a+(b-a)*position;
);

function apply_morph(position, publish) local(i, value) (
  morph_a_ready && morph_b_ready ? (
    morph_position=max(0, min(1, position));
    slider65=morph_position; morph_last_applied=morph_position;
    i=0;
    loop(84,
      MORPH_ALLOWED[i] ? (
        value=interpolate_parameter(i, MORPH_A[i], MORPH_B[i], morph_position);
        set_bulk_slider(i+1, value, publish);
      );
      i+=1;
    );
    notify_ui_slider(0);
    publish ? notify_ui_slider(2^64);
  );
);

function randomize_parameters() local(i, value, group_mask) (
  random_strength=max(0, min(1, slider66));
  random_scope=max(0, min(3, floor(slider67+0.5)));
  group_mask=2^random_scope;
  i=0;
  loop(84,
    MORPH_ALLOWED[i] && (RANDOM_GROUP[i] & group_mask) ? (
      value = MORPH_LOG[i] && RANDOM_LO[i] > 0 ?
        RANDOM_LO[i]*pow(RANDOM_HI[i]/RANDOM_LO[i], rand(1)) :
        RANDOM_LO[i]+rand(1)*(RANDOM_HI[i]-RANDOM_LO[i]);
      value=interpolate_parameter(i, slider(i+1), value, random_strength);
      // A gentle variation must not turn on modules or replace enum modes.
      (random_strength >= 0.5 || MORPH_STEP[i] < 1 || (MORPH_HI[i] > 4 && i!=81)) ?
        set_bulk_slider(i+1, value, 1);
    );
    i+=1;
  );
  notify_ui_slider(0);
  finish_bulk_touch();
  sliderchange(-1);
);

function panel_random_morph(x, y, width) local(bw, tx, tw, next_value) (
  random_strength=slider66; random_scope=floor(slider67+0.5); morph_position=slider65;
  panel_heading(x, y, width, "RANDOMIZE / MORPH", 0.73, 0.81, 0.94);
  bw=(width-12)/3;
  ui_button(x, y+28, bw, "STORE A", 1) ? store_morph_snapshot(MORPH_A);
  ui_button(x+bw+6, y+28, bw, "STORE B", 1) ? store_morph_snapshot(MORPH_B);
  ui_button(x+2*(bw+6), y+28, bw, "RANDOMIZE", random_strength > 0) ? randomize_parameters();
  gfx_setfont(2, "Arial", 11); gfx_set(0.70, 0.82, 0.93, 1);
  gfx_x=x; gfx_y=y+61; gfx_drawstr("SCOPE");
  random_scope == 0 ? strcpy(#random_scope_name, "ALL");
  random_scope == 1 ? strcpy(#random_scope_name, "PITCH");
  random_scope == 2 ? strcpy(#random_scope_name, "TONE");
  random_scope == 3 ? strcpy(#random_scope_name, "MOTION");
  ui_button(x+75, y+56, width-75, #random_scope_name, 1) ? (
    gfx_x=x+75; gfx_y=y+78;
    sprintf(#random_scope_menu, "%sALL|%sPITCH|%sTONE|%sMOTION",
      random_scope == 0 ? "!" : "", random_scope == 1 ? "!" : "",
      random_scope == 2 ? "!" : "", random_scope == 3 ? "!" : "");
    next_value=gfx_showmenu(#random_scope_menu)-1;
    next_value >= 0 ? (
      random_scope=next_value; slider67=next_value;
      notify_ui_slider(2^66); slider_automate(slider67, 1); sliderchange(-1);
    );
  );
  tx=x+150; tw=width-168;
  mouse_right_clicked && !mouse_down && mouse_x >= x && mouse_x <= tx+tw &&
    mouse_y >= y+82 && mouse_y < y+103 ? (
    reset_ui_parameter(66); random_strength=slider66;
  );
  gfx_x=x; gfx_y=y+87; gfx_drawstr("AMOUNT");
  gfx_x=x+90; gfx_drawnumber(random_strength*100, 0); gfx_drawstr("%");
  mouse_clicked && mouse_x >= tx && mouse_x <= tx+tw && mouse_y >= y+82 && mouse_y < y+103 ? ui_random_drag=1;
  ui_random_drag && mouse_down ? (
    next_value=max(0, min(1, (mouse_x-tx)/tw));
    abs(next_value-random_strength) > 0.0001 ? (
      random_strength=next_value; slider66=next_value; notify_ui_slider(2^65);
    );
  );
  gfx_set(0.16, 0.22, 0.29, 1); gfx_rect(tx, y+92, tw, 7, 1);
  gfx_set(0.73, 0.81, 0.94, 1); gfx_rect(tx, y+92, tw*random_strength, 7, 1);
  gfx_circle(tx+tw*random_strength, y+95.5, 4, 1);
  ui_button(x, y+112, 40, "A", morph_a_ready && morph_b_ready) ? (
    apply_morph(0, 1); finish_bulk_touch(); slider_automate(slider65, 1); sliderchange(-1);
  );
  ui_button(x+width-40, y+112, 40, "B", morph_a_ready && morph_b_ready) ? (
    apply_morph(1, 1); finish_bulk_touch(); slider_automate(slider65, 1); sliderchange(-1);
  );
  tx=x+54; tw=width-108;
  mouse_right_clicked && !mouse_down && mouse_x >= tx && mouse_x <= tx+tw &&
    mouse_y >= y+108 && mouse_y < y+136 ? (
    slider65=UI_DEFAULT[64];
    apply_morph(UI_DEFAULT[64], 1);
    notify_ui_slider(2^64);
    finish_bulk_touch(); slider_automate(slider65, 1);
    sliderchange(-1);
  );
  mouse_clicked && morph_a_ready && morph_b_ready && mouse_x >= tx && mouse_x <= tx+tw &&
    mouse_y >= y+108 && mouse_y < y+136 ? ui_morph_drag=1;
  ui_morph_drag && mouse_down ? (
    next_value=max(0, min(1, (mouse_x-tx)/tw));
    abs(next_value-morph_position) > 0.0001 ? apply_morph(next_value, 1);
  );
  gfx_set(0.16, 0.22, 0.29, 1); gfx_rect(tx, y+120, tw, 7, 1);
  gfx_set(morph_a_ready && morph_b_ready ? 0.73 : 0.35, 0.65, 0.87, 1);
  gfx_rect(tx, y+120, tw*morph_position, 7, 1);
  gfx_circle(tx+tw*morph_position, y+123.5, 4, 1);
  gfx_setfont(2, "Arial", 11); gfx_set(0.48, 0.60, 0.65, 1);
  gfx_x=x; gfx_y=y+144; gfx_drawstr(morph_a_ready ? "A: STORED" : "A: EMPTY");
  gfx_x=x+width-76; gfx_drawstr(morph_b_ready ? "B: STORED" : "B: EMPTY");
);


// Host controls stay outside the independently owned resonator.
function update_metal_coeffs() (
  ultra_metal.uc_metal_configure(atomic_get(ui_metal_size)*pow(2,env_metal*2),
    atomic_get(ui_metal_decay),atomic_get(ui_metal_tone));
);

function update_pitch_controls() local(grain_target) (
  grain_target = max(10, min(100, atomic_get(ui_pitch_grain)));
  pitch_grain += (grain_target-pitch_grain)*(1-exp(-32/(0.05*srate)));
  ultra_double.voice.crossFadeSamples = min(DOUBLE_PITCH_SIZE/8,2*pitch_grain*srate/1000);
);

function panel_output_clip() local(choice,x) (
  x=gfx_w-374;
  gfx_setfont(2,"Arial",11,'b'); gfx_set(0.70,0.82,0.93,1);
  gfx_x=gfx_w-420; gfx_y=22; gfx_drawstr("CLIP");
  gfx_set(0.10,0.15,0.18,1); gfx_rect(x,15,60,22,1);
  gfx_set(0.88,0.93,0.97,1); gfx_x=x+9; gfx_y=20;
  gfx_drawstr(slider87>0.5 ? "SOFT" : "HARD");
  mouse_clicked && mouse_x>=x && mouse_x<=x+60 && mouse_y>=15 && mouse_y<37 ? (
    gfx_x=x; gfx_y=37; choice=gfx_showmenu("Hard|Soft")-1;
    choice>=0 ? (slider87=choice; notify_ui_slider(2^86););
  );
  mouse_right_clicked && mouse_x>=x && mouse_x<=x+60 && mouse_y>=15 && mouse_y<37 ? reset_ui_parameter(87);
  ui_accent_r=0.95; ui_accent_g=0.65; ui_accent_b=0.43;
  panel_slider(86,-24,0,0.1,gfx_w-300,18,210,"CEILING"," dB",1);
  panel_toggle(85,gfx_w-80,15);
);

function panel_utility(x,y,width) local(i,cell,hit) (
  gfx_set(0.16,0.22,0.25,1); gfx_line(x,y-10,x+width,y-10);
  ui_utility_view=min(1,max(0,ui_utility_view));
  cell=width/2; i=0;
  loop(2,
    i==0 ? strcpy(#utility_label,"FILTER");
    i==1 ? strcpy(#utility_label,"LFO");
    hit=mouse_x>=x+i*cell && mouse_x<x+(i+1)*cell-3 && mouse_y>=y && mouse_y<y+22;
    mouse_clicked && hit ? ui_utility_view=i;
    gfx_set(ui_utility_view==i ? 0.18 : 0.10,ui_utility_view==i ? 0.29 : 0.15,0.23,1);
    gfx_rect(x+i*cell,y,cell-3,22,1);
    gfx_setfont(2,"Arial",11,'b'); gfx_set(0.88,0.93,0.97,1);
    gfx_x=x+i*cell+5; gfx_y=y+5; gfx_drawstr(#utility_label);
    i+=1;
  );
  ui_accent_r=0.50; ui_accent_g=0.90; ui_accent_b=0.74;
  panel_choices(75,x,y+34,width-66,4,"LP       HP       BP       NOTCH    ");
  panel_toggle(74,x+width-58,y+34);
  ui_utility_view==0 ? (
    panel_slider(76,20,20000,1,x,y+64,width,"CUTOFF"," Hz",0);
    panel_slider(77,0,1,0.01,x,y+86,width,"RESONANCE","",2);
    panel_slider(78,0,24,0.1,x,y+108,width,"DRIVE"," dB",1);
    panel_slider(79,0,1,0.01,x,y+130,width,"MIX","",2);
  );
  ui_utility_view==1 ? (
    panel_choices(82,x,y+64,width,6,"NONE     SIN      TRI      SAW      SQR      RND      ");
    panel_slider(80,0.02,20,0.01,x,y+94,width,"RATE"," Hz",2);
    panel_slider(81,0,6,0.01,x,y+116,width,"DEPTH"," oct",2);
  );
    gfx_setfont(2,"Arial",11); gfx_set(0.55,0.66,0.71,1);
    gfx_x=x; gfx_y=y+152; gfx_drawstr("ACTIVE ");
    gfx_drawnumber(max(20,atomic_get(ui_filter_hz)),0); gfx_drawstr(" Hz");
);

@slider
pdc_delay=slider38>0.5 ? SPECTRAL_SIZE : 0;
pdc_bot_ch=0; pdc_top_ch=2;
slider65 != morph_last_applied ? (
  morph_last_applied=slider65;
  // Host morph automation must also work with @gfx closed, without recording itself.
  apply_morph(slider65, 0);
);
sync_pitch_controls();
update_pitch_controls();
atomic_set(ui_metal_on, slider33);
atomic_set(ui_metal_size, slider34);
atomic_set(ui_metal_decay, slider35);
atomic_set(ui_metal_tone, slider36);
atomic_set(ui_metal_mix, slider37);
// --- 1. GAIN & MIX ---
drive_lin = 10 ^ (slider1 / 20); 
out_lin = 10 ^ (slider2 / 20);
// Crossfade behavior:
// 0.0 = D1 only
// 0.5 = D1 + D2
// 1.0 = D2 only
// Typical "Equal Power" or Linear mix? Linear is fine for parallel.
global_mix_pos = slider3;
dry_vol = 1.0 - global_mix_pos;
wet_vol = global_mix_pos;
// If we want equal gain at center (0.5 + 0.5 = 1.0), linear is ok.

// --- 2. DELAYS ---
delay2_ms = slider5;
fb_amt = slider6;

// Delay Targets

delay2_target = (delay2_ms / 1000) * srate;
delay2_target = max(1, min(delay2_target, BUF_SIZE - 2));

(delay2_samps < 1) ? delay2_samps = delay2_target;

// Slew rate
delay_slew = 1.0 - exp(-1.0 / (0.05 * srate));

// --- 3. DISPERSER ENGINE ---
// Parameters
freq_base = max(20, min(slider7, srate * 0.49)); 
Q = max(0.1, slider8); 
num_stages = min(slider10, MAX_STAGES);

// --- 4. EFFECTS ---
res_mix = slider11;
fs_freq = slider12;
wet_return_gain = slider13;
fs_rand_enabled = slider14;
fs_rand_rate = slider15;
fs_rand_depth = slider16;
disp_rand_enabled = slider17;
disp_rand_rate = slider18;
disp_rand_depth = slider19 / 100;
fs_lfo_shape = floor(slider20 + 0.5);
disp_lfo_shape = floor(slider21 + 0.5);
fb_tap = floor(slider22 + 0.5);
fb_extra = slider59 > 0.5 ? floor(slider59+0.5)+4 : floor(slider47 + 0.5);
slider84>0.5 ? fb_extra=7;
fb_saturation = slider23;
atomic_set(ui_fs_lfo_on, fs_rand_enabled);
atomic_set(ui_fs_lfo_rate, fs_rand_rate);
atomic_set(ui_fs_lfo_depth, fs_rand_depth);
atomic_set(ui_fs_lfo_shape, fs_lfo_shape);
atomic_set(ui_disp_lfo_on, disp_rand_enabled);
atomic_set(ui_disp_lfo_rate, disp_rand_rate);
// Store GUI depth in percent (0..100). DSP converts it to 0..1 only when
// calculating coefficients; storing the normalized value here caused it to
// shrink by 100× again after playback restarted.
atomic_set(ui_disp_lfo_depth, slider19);
atomic_set(ui_disp_lfo_shape, disp_lfo_shape);
atomic_set(ui_fb_tap, fb_tap);
atomic_set(ui_fb_extra, slider47);
atomic_set(ui_fb_saturation, fb_saturation);
atomic_set(ui_fs_base, fs_freq);
atomic_set(ui_disp_base, freq_base);
atomic_set(ui_mix, global_mix_pos);

// --- COEFFICIENTS CALCULATION ---
update_disperser_coeffs();
update_metal_coeffs();
!smooth_ready ? (
  sm_drive = drive_lin; sm_out = out_lin; sm_mix = global_mix_pos;
  sm_fb = fb_amt; sm_level = wet_return_gain;
  sm_sat = fb_saturation;
  sm_tap_disp = fb_extra == 0 && fb_tap == 1;
  sm_tap_shift = fb_extra == 0 && fb_tap == 2;
  sm_tap_pitch = fb_extra == 1; sm_tap_ring = fb_extra == 2;
  sm_tap_metal = fb_extra == 3; sm_tap_sat = fb_extra == 4;
  sm_tap_freeze = fb_extra == 5; sm_tap_double = fb_extra == 6;
  sm_tap_filter = fb_extra == 7;
  sm_clip = slider1 > 0.1;
  c_b0_l = target_b0_l; c_b1_l = target_b1_l;
  c_b0_r = target_b0_r; c_b1_r = target_b1_r;
  smooth_ready = 1;
);

@sample
// Detect the raw input, before drive, delays and feedback can influence the envelope.
env_input = max(abs(spl0), abs(spl1));
env_level += (env_input-env_level)*(env_input > env_level ? env_attack_coeff : env_release_coeff);
env_amount = min(1, max(0, env_level*env_sensitivity))*env_depth;
env_pitch += ((env_target == 1 ? env_amount : 0)-env_pitch)*param_slew;
env_shift += ((env_target == 2 ? env_amount : 0)-env_shift)*param_slew;
env_metal += ((env_target == 3 ? env_amount : 0)-env_metal)*param_slew;
env_double += ((env_target == 4 ? env_amount : 0)-env_double)*param_slew;
// --- RANDOM SAMPLE-AND-HOLD LFOS (CONTROL RATE) ---
// A short, rate-dependent glide prevents abrupt filter-coefficient and
// frequency-shifter jumps from producing clicks.
control_counter += 1;
control_counter >= CONTROL_INTERVAL ? (
  control_counter = 0;
  update_pitch_controls();
  env_attack_coeff = 1-exp(-1/(max(1, atomic_get(ui_extra63))*0.001*srate));
  env_release_coeff = 1-exp(-1/(max(10, atomic_get(ui_extra64))*0.001*srate));
  env_sensitivity = pow(10, atomic_get(ui_extra62)/20);
  env_depth = atomic_get(ui_extra61); env_target = floor(atomic_get(ui_extra60)+0.5);
  atomic_set(ui_env_level, min(1, max(0, env_level*env_sensitivity)));
  atomic_set(ui_pitch_active, ultra_motion.semi);
  atomic_set(ui_fs_active, ultra_shift.current_hz);
  atomic_set(ui_metal_level, ultra_metal.meter);
  atomic_set(ui_metal_contribution, ultra_metal.mix_value);
  atomic_set(ui_plot_tap_l, ultra_comb_motion.read_l);
  atomic_set(ui_plot_tap_r, ultra_comb_motion.read_r);
  atomic_set(ui_plot_fx, delay2_samps);
  atomic_set(ui_double_delay_l, ultra_double.latency_l);
  atomic_set(ui_double_delay_r, ultra_double.latency_r);
  atomic_set(ui_filter_hz,ultra_filter.active_hz);
  // Native sliders and custom controls feed the same smoothed DSP targets.
  drive_lin = 10^(slider1/20);
  out_lin = 10^(slider2/20);
  delay2_target = max(1, min(slider5*srate/1000, BUF_SIZE-2));
  fb_amt = slider6;
  Q = max(0.1, slider8);
  num_stages = max(0, min(MAX_STAGES, slider10));
  res_mix = slider11;
  wet_return_gain = slider13;
  update_metal_coeffs();
  // Pull GUI changes directly. Host automation still arrives via @slider and
  // updates these same cells, so both paths remain in sync.
  fs_rand_enabled = atomic_get(ui_fs_lfo_on);
  fs_rand_rate = atomic_get(ui_fs_lfo_rate);
  fs_rand_depth = atomic_get(ui_fs_lfo_depth);
  fs_lfo_shape = floor(atomic_get(ui_fs_lfo_shape) + 0.5);
  disp_rand_enabled = atomic_get(ui_disp_lfo_on);
  disp_rand_rate = atomic_get(ui_disp_lfo_rate);
  disp_rand_depth = atomic_get(ui_disp_lfo_depth) / 100;
  disp_lfo_shape = floor(atomic_get(ui_disp_lfo_shape) + 0.5);
  fb_tap = floor(atomic_get(ui_fb_tap) + 0.5);
  fb_extra = floor(atomic_get(ui_fb_extra) + 0.5);
  atomic_get(ui_extra59) > 0.5 ? fb_extra = floor(atomic_get(ui_extra59)+0.5)+4;
  slider84>0.5 ? fb_extra=7;
  fb_saturation = atomic_get(ui_fb_saturation);
  fs_freq = atomic_get(ui_fs_base);
  freq_base = max(20, min(atomic_get(ui_disp_base), srate * 0.49));
  global_mix_pos = max(0, min(1, atomic_get(ui_mix)));
  dry_vol = 1.0 - global_mix_pos;
  wet_vol = global_mix_pos;

  fs_rand_enabled ? (
    fs_rand_phase += fs_rand_rate * CONTROL_INTERVAL / srate;
    fs_rand_phase >= 1 ? (
      fs_rand_phase -= floor(fs_rand_phase);
      fs_rand_target = rand(2) - 1;
    );
    fs_lfo_shape == 0 ? fs_rand_target = sin(2*$pi*fs_rand_phase);
    fs_lfo_shape == 1 ? fs_rand_target = 2*fs_rand_phase - 1;
    fs_lfo_shape == 2 ? fs_rand_target = (fs_rand_phase < 0.5 ? 1 : -1);
  ) : fs_rand_target = 0;
  // Continuous sine needs no extra glide; discontinuous shapes use fixed times.
  fs_rand_glide = fs_rand_enabled && fs_lfo_shape==0 ? 1 :
    1-exp(-CONTROL_INTERVAL/((fs_rand_enabled && fs_lfo_shape!=3 ? 0.002 : 0.010)*srate));
  fs_rand_value += (fs_rand_target - fs_rand_value) * fs_rand_glide;

  disp_rand_enabled ? (
    disp_rand_phase += disp_rand_rate * CONTROL_INTERVAL / srate;
    disp_rand_phase >= 1 ? (
      disp_rand_phase -= floor(disp_rand_phase);
      disp_rand_target = rand(2) - 1;
    );
    disp_lfo_shape == 0 ? disp_rand_target = sin(2*$pi*disp_rand_phase);
    disp_lfo_shape == 1 ? disp_rand_target = 2*disp_rand_phase - 1;
    disp_lfo_shape == 2 ? disp_rand_target = (disp_rand_phase < 0.5 ? 1 : -1);
  ) : disp_rand_target = 0;
  disp_rand_glide = disp_rand_enabled && disp_lfo_shape==0 ? 1 :
    1-exp(-CONTROL_INTERVAL/((disp_rand_enabled && disp_lfo_shape!=3 ? 0.002 : 0.010)*srate));
  disp_rand_value += (disp_rand_target - disp_rand_value) * disp_rand_glide;

  update_disperser_coeffs();
);

// Smooth audio-path controls per sample, including GUI and host changes.
sm_drive += (drive_lin-sm_drive)*param_slew;
sm_out += (out_lin-sm_out)*param_slew;
sm_mix += (global_mix_pos-sm_mix)*param_slew;
sm_fb += (fb_amt-sm_fb)*param_slew;
sm_level += (wet_return_gain-sm_level)*param_slew;
sm_sat += (fb_saturation-sm_sat)*param_slew;
sm_tap_disp += ((fb_extra == 0 && fb_tap == 1)-sm_tap_disp)*param_slew;
sm_tap_shift += ((fb_extra == 0 && fb_tap == 2)-sm_tap_shift)*param_slew;
sm_tap_pitch += ((fb_extra == 1)-sm_tap_pitch)*param_slew;
sm_tap_ring += ((fb_extra == 2)-sm_tap_ring)*param_slew;
sm_tap_metal += ((fb_extra == 3)-sm_tap_metal)*param_slew;
sm_tap_sat += ((fb_extra == 4)-sm_tap_sat)*param_slew;
sm_tap_freeze += ((fb_extra == 5)-sm_tap_freeze)*param_slew;
sm_tap_double += ((fb_extra == 6)-sm_tap_double)*param_slew;
sm_tap_filter += ((fb_extra == 7)-sm_tap_filter)*param_slew;
sm_clip += ((slider1 > 0.1)-sm_clip)*param_slew;
c_b0_l += (target_b0_l-c_b0_l)*param_slew;
c_b1_l += (target_b1_l-c_b1_l)*param_slew;
c_b0_r += (target_b0_r-c_b0_r)*param_slew;
c_b1_r += (target_b1_r-c_b1_r)*param_slew;
in_l = spl0 * sm_drive;
in_r = spl1 * sm_drive;

// Soft clip input
function soft_clip(x) (
  x = max(-2.0, min(2.0, x));
  x / (1 + abs(x));
);

in_l += (soft_clip(in_l)-in_l)*sm_clip;
in_r += (soft_clip(in_r)-in_r)*sm_clip;

cur_l = in_l;
cur_r = in_r;

// --- COMB / FLANGER SECTION (Input Stage) ---
delay2_samps += (delay2_target - delay2_samps) * delay_slew;

delay2_samps = max(1, delay2_samps);

// Core branches share feedback history; creative modules run after their sum.
ultra_comb_history.uc_comb_history_tap(slider4*srate/1000,delay_slew);
// Move the delay-only branch; the all-pass branch keeps its independent FX delay.
ultra_comb_motion.uc_comb_motion_process(ultra_comb_history.tap_delay,BUF_SIZE,slider29,slider30,slider31,floor(slider32+0.5),slider28);
comb_tap_l=ultra_comb_history.uc_comb_history_read_channel(ultra_comb_history.buffer_l,BUF_SIZE,ultra_comb_history.write_pos,ultra_comb_motion.read_l);
comb_tap_r=ultra_comb_history.uc_comb_history_read_channel(ultra_comb_history.buffer_r,BUF_SIZE,ultra_comb_history.write_pos,ultra_comb_motion.read_r);
ultra_comb_history.uc_comb_history_read(delay2_samps,delay2_samps);
wet_path_l=ultra_comb_history.wet_l; wet_path_r=ultra_comb_history.wet_r;
// The core FX branch contains only Disperser and Frequency Shift.
pre_disp_l = wet_path_l;
pre_disp_r = wet_path_r;

ultra_disp.uc_disp_process(pre_disp_l, pre_disp_r, num_stages, res_mix,
  c_b0_l, c_b1_l, c_b0_r, c_b1_r, 1);
post_disp_l=ultra_disp.out_l; post_disp_r=ultra_disp.out_r;
fs_freq_active = fs_freq + fs_rand_value * fs_rand_depth + env_shift*200;
ultra_shift.uc_shift_process(post_disp_l, post_disp_r, fs_freq_active, 1);
post_shift_l=ultra_shift.out_l; post_shift_r=ultra_shift.out_r;

// Complete the parallel core before any creative processing.
core_l = comb_tap_l*(1-sm_mix) + post_shift_l*sm_level*sm_mix;
core_r = comb_tap_r*(1-sm_mix) + post_shift_r*sm_level*sm_mix;
route_target=max(0,min(719,floor(slider73+0.5)))+720*max(0,min(6,floor(slider83+0.5)));
route_target!=active_route ? (
  route_gain=max(0,route_gain-1/(0.005*srate));
  route_gain<=0 ? (active_route=route_target; route_decode_full(active_route,ROUTE_AUDIO););
) : route_gain=min(1,route_gain+1/(0.005*srate));
pre_disp_l=core_l; pre_disp_r=core_r;
route_slot=0;
loop(7,
route_module=ROUTE_AUDIO[route_slot];
route_module==0 ? (

// Freeze control glue; the module records its own incoming stereo signal.
ultra_freeze.uc_freeze_process(pre_disp_l, pre_disp_r, atomic_get(ui_extra48),
  atomic_get(ui_extra49), atomic_get(ui_extra50), atomic_get(ui_extra51));
pre_disp_l=ultra_freeze.out_l; pre_disp_r=ultra_freeze.out_r;

post_freeze_l = pre_disp_l; post_freeze_r = pre_disp_r;
);
route_module==1 ? (
// Main Pitch uses fixed-hop spectral processing; Double keeps independent read heads.
ultra_motion.uc_pitch_motion_process(max(abs(pre_disp_l),abs(pre_disp_r)),
  atomic_get(ui_pitch_base), atomic_get(ui_pitch_depth), atomic_get(ui_pitch_rate),
  atomic_get(ui_pitch_glide), floor(atomic_get(ui_pitch_mode)+0.5),
  atomic_get(ui_pitch_threshold), atomic_get(ui_pitch_fire), env_pitch*24);
ultra_pitch.uc_spectral_process(pre_disp_l,pre_disp_r,atomic_get(ui_pitch_on),
  atomic_get(ui_pitch_mix),ultra_motion.semi,atomic_get(ui_pitch_grain));
pre_disp_l=ultra_pitch.outL; pre_disp_r=ultra_pitch.outR;
post_pitch_l = pre_disp_l; post_pitch_r = pre_disp_r;
);
route_module==2 ? (
// Double receives the current chain output, including the main Pitch.
ultra_double.uc_double_process(pre_disp_l,pre_disp_r,atomic_get(ui_extra52),atomic_get(ui_extra55),
  atomic_get(ui_extra53),atomic_get(ui_extra54),atomic_get(ui_extra56),
  atomic_get(ui_extra57),atomic_get(ui_extra58),env_double*24,
  atomic_get(ui_extra68),atomic_get(ui_extra69),atomic_get(ui_extra70),atomic_get(ui_extra71),atomic_get(ui_extra72));
pre_disp_l=ultra_double.out_l; pre_disp_r=ultra_double.out_r;
post_double_l = pre_disp_l; post_double_r = pre_disp_r;
);
route_module==3 ? (

// Ring modulation processes the completed core, after Freeze, Pitch and Double.
sm_ring_freq += (slider25-sm_ring_freq)*param_slew;
sm_ring_depth += (slider26-sm_ring_depth)*param_slew;
sm_ring_mix += (slider24*slider27-sm_ring_mix)*param_slew;
ring_phase += min(sm_ring_freq, srate*0.45)/srate;
ring_phase -= floor(ring_phase);
ring_carrier = sin(2*$pi*ring_phase);
ring_gain = 1+sm_ring_mix*sm_ring_depth*(ring_carrier-1);
pre_disp_l *= ring_gain;
pre_disp_r *= ring_gain;
post_ring_l = pre_disp_l; post_ring_r = pre_disp_r;
);
route_module==4 ? (

cur_l=pre_disp_l; cur_r=pre_disp_r;
// The metal tail enters the external feedback loop only when its tap is selected.
// Metal control glue: consumes the current chain output.
ultra_metal.uc_metal_process(cur_l,cur_r,atomic_get(ui_metal_on),atomic_get(ui_metal_mix));
cur_l=ultra_metal.out_l; cur_r=ultra_metal.out_r;
post_metal_l = cur_l; post_metal_r = cur_r;
pre_disp_l=cur_l; pre_disp_r=cur_r;
);
route_module==5 ? (

// SAT colors the completed creative chain, even when Feedback is zero.
ultra_sat.uc_sat_process(pre_disp_l,pre_disp_r,fb_saturation);
cur_l=ultra_sat.out_l; cur_r=ultra_sat.out_r;
post_sat_l=cur_l; post_sat_r=cur_r;
pre_disp_l=cur_l; pre_disp_r=cur_r;
);
route_module==6 ? (
  ultra_filter.uc_filter_process(pre_disp_l,pre_disp_r,slider74,slider75,slider76,slider77,
    slider78,slider79,slider80,slider81,slider82);
  pre_disp_l=ultra_filter.out_l; pre_disp_r=ultra_filter.out_r;
  post_filter_l=pre_disp_l; post_filter_r=pre_disp_r;
);
route_slot+=1;
);
cur_l=pre_disp_l; cur_r=pre_disp_r;

// Feedback captures use this sample's stage outputs.
fb_pre_weight = max(0, 1-sm_tap_disp-sm_tap_shift-sm_tap_pitch-sm_tap_ring-sm_tap_metal-sm_tap_sat-sm_tap_freeze-sm_tap_double-sm_tap_filter);
fb_source_l = wet_path_l*fb_pre_weight + post_disp_l*sm_tap_disp + post_shift_l*sm_tap_shift +
  post_pitch_l*sm_tap_pitch + post_ring_l*sm_tap_ring + post_metal_l*sm_tap_metal + post_sat_l*sm_tap_sat + post_freeze_l*sm_tap_freeze + post_double_l*sm_tap_double + post_filter_l*sm_tap_filter;
fb_source_r = wet_path_r*fb_pre_weight + post_disp_r*sm_tap_disp + post_shift_r*sm_tap_shift +
  post_pitch_r*sm_tap_pitch + post_ring_r*sm_tap_ring + post_metal_r*sm_tap_metal + post_sat_r*sm_tap_sat + post_freeze_r*sm_tap_freeze + post_double_r*sm_tap_double + post_filter_r*sm_tap_filter;
fb_loop_l = feedback_color(fb_source_l, sm_sat);
fb_loop_r = feedback_color(fb_source_r, sm_sat);
// Commit selected feedback to the history shared by Comb Tap and FX Feed.
ultra_comb_history.uc_comb_history_commit(in_l,in_r,fb_loop_l,fb_loop_r,sm_fb*route_gain);

// The core mix is already complete; do not blend an unprocessed tap back in.
out_l = cur_l;
out_r = cur_r;

spl0 = out_l * sm_out * route_gain;
spl1 = out_r * sm_out * route_gain;
ultra_clip.uc_clip_process(spl0,spl1,slider85,slider86,slider87);
spl0=ultra_clip.out_l; spl1=ultra_clip.out_r;

@serialize
// A non-empty serialize section also preserves variables across playback @init.
file_avail(0) != 0 ? (
  file_var(0, ui_native_visible);
  // Consume the old visibility slot without restoring the expanded native UI.
  ui_native_visible = 0;
  file_avail(0) != 0 ? (
    morph_state_version=2;
    file_var(0, morph_state_version);
    morph_state_version == 1 || morph_state_version == 2 ? (
      file_var(0, morph_a_ready); file_var(0, morph_b_ready);
      file_var(0, morph_position); file_var(0, random_strength); file_var(0, random_scope);
      morph_state_version == 1 ? (
        file_mem(0, MORPH_A, 64); file_mem(0, MORPH_B, 64);
        // Legacy snapshots have no Filter values: preserve the loaded settings
        // at both endpoints until the user stores new A/B snapshots.
        morph_seed_index=64;
        loop(20,
          MORPH_A[morph_seed_index]=MORPH_B[morph_seed_index]=slider(morph_seed_index+1);
          morph_seed_index+=1;
        );
      ) : (
        file_mem(0, MORPH_A, 84); file_mem(0, MORPH_B, 84);
      );
      morph_snapshot_size=84;
      morph_storage_initialized=1;
      morph_position=max(0, min(1, morph_position));
      random_strength=max(0, min(1, random_strength));
      random_scope=max(0, min(3, floor(random_scope+0.5)));
    );
  ) : (
    // Older presets contain only the native-slider visibility flag.
    morph_a_ready=morph_b_ready=0;
  );
);
hide_native_sliders();

@gfx 1140 840
mouse_down = (mouse_cap & 1) != 0;
mouse_clicked = mouse_down && !ui_was_down;
mouse_right_down = (mouse_cap & 2) != 0;
mouse_right_clicked = mouse_right_down && !ui_was_right_down;
!mouse_down ? (
  ui_bulk_touch ? finish_bulk_touch();
  ui_morph_drag || ui_random_drag ? sliderchange(-1);
  ui_morph_drag = ui_random_drag = 0;
  ui_extra_drag = 0;
  ui_touch_mask ? slider_automate(ui_touch_mask, 1);
  ui_touch_mask = 0;
  ui_metal_touch == 2^32 ? slider_automate(slider33, 1);
  ui_metal_touch == 2^33 ? slider_automate(slider34, 1);
  ui_metal_touch == 2^34 ? slider_automate(slider35, 1);
  ui_metal_touch == 2^35 ? slider_automate(slider36, 1);
  ui_metal_touch == 2^36 ? slider_automate(slider37, 1);
  ui_metal_touch == 2^37 ? slider_automate(slider38, 1);
  ui_metal_touch == 2^38 ? slider_automate(slider39, 1);
  ui_metal_touch == 2^39 ? slider_automate(slider40, 1);
  ui_metal_touch == 2^40 ? slider_automate(slider41, 1);
  ui_metal_touch == 2^41 ? slider_automate(slider42, 1);
  ui_metal_touch == 2^42 ? slider_automate(slider43, 1);
  ui_metal_touch == 2^43 ? slider_automate(slider44, 1);
  ui_metal_touch == 2^44 ? slider_automate(slider45, 1);
  ui_metal_touch == 2^45 ? slider_automate(slider46, 1);
  ui_metal_touch == 2^46 ? slider_automate(slider47, 1);
  ui_metal_touch == 2^47 ? slider_automate(slider48, 1);
  ui_metal_touch == 2^48 ? slider_automate(slider49, 1);
  ui_metal_touch == 2^49 ? slider_automate(slider50, 1);
  ui_metal_touch == 2^50 ? slider_automate(slider51, 1);
  ui_metal_touch == 2^51 ? slider_automate(slider52, 1);
  ui_metal_touch == 2^52 ? slider_automate(slider53, 1);
  ui_metal_touch == 2^53 ? slider_automate(slider54, 1);
  ui_metal_touch == 2^54 ? slider_automate(slider55, 1);
  ui_metal_touch == 2^55 ? slider_automate(slider56, 1);
  ui_metal_touch == 2^56 ? slider_automate(slider57, 1);
  ui_metal_touch == 2^57 ? slider_automate(slider58, 1);
  ui_metal_touch == 2^58 ? slider_automate(slider59, 1);
  ui_metal_touch == 2^59 ? slider_automate(slider60, 1);
  ui_metal_touch == 2^60 ? slider_automate(slider61, 1);
  ui_metal_touch == 2^61 ? slider_automate(slider62, 1);
  ui_metal_touch == 2^62 ? slider_automate(slider63, 1);
  ui_metal_touch == 2^63 ? slider_automate(slider64, 1);
  ui_metal_touch == 2^64 ? slider_automate(slider65, 1);
  ui_metal_touch == 2^65 ? slider_automate(slider66, 1);
  ui_metal_touch == 2^66 ? slider_automate(slider67, 1);
  ui_metal_touch == 2^67 ? slider_automate(slider68, 1);
  ui_metal_touch == 2^68 ? slider_automate(slider69, 1);
  ui_metal_touch == 2^69 ? slider_automate(slider70, 1);
  ui_metal_touch == 2^70 ? slider_automate(slider71, 1);
  ui_metal_touch == 2^71 ? slider_automate(slider72, 1);
  ui_release_index=74;
  loop(14,
    ui_metal_touch==2^(ui_release_index-1) ? slider_automate(slider(ui_release_index),1);
    ui_release_index+=1;
  );
  ui_metal_touch = 0;
);

gfx_set(0.035, 0.045, 0.055, 1); gfx_rect(0, 0, gfx_w, gfx_h, 1);
gfx_set(0.075, 0.09, 0.105, 1); gfx_rect(0, 0, gfx_w, 68, 1);
gfx_setfont(1, "Arial", 24, 'b'); gfx_set(0.89, 0.95, 0.98, 1);
gfx_x=20; gfx_y=15; gfx_drawstr("SBP ULTRACOMB");
gfx_setfont(2, "Arial", 11); gfx_set(0.48, 0.60, 0.65, 1);
panel_route(22,43,gfx_w-44);
panel_output_clip();

left_x = 22;
panel_w = (gfx_w-88)/3;
mid_x = left_x+panel_w+22;
right_x = mid_x+panel_w+22;
global_w = (gfx_w-60)/3;
ui_accent_r=0.72; ui_accent_g=0.82; ui_accent_b=0.87;
panel_slider(1, 0, 12, 0.1, 22, 84, global_w, "DRIVE", " dB", 1);
panel_slider(2, -12, 12, 0.1, 22+global_w+8, 84, global_w, "OUTPUT", " dB", 1);
panel_slider(13, 0.1, 2, 0.01, 22+2*(global_w+8), 84, global_w, "FX RETURN", "", 2);

// Column 1: complete parallel core.
gfx_set(0.055,0.080,0.080,1);
gfx_rect(left_x-10,106,panel_w+20,722,1);
panel_heading(left_x, 116, panel_w, "01  COMB / DELAYS", 0.26, 0.83, 0.89);
panel_slider(4, 0, 50, 0.1, left_x, 144, panel_w, "TAP DELAY", " ms", 1);
panel_slider(5, 0, 50, 0.1, left_x, 166, panel_w, "FX FEED DELAY", " ms", 1);
panel_slider(6, 0, 0.95, 0.01, left_x, 188, panel_w, "FEEDBACK", "", 2);
panel_slider(23, 0, 1, 0.01, left_x, 210, panel_w, "SATURATION", "", 2);
gfx_setfont(2, "Arial", 11); gfx_set(0.70, 0.82, 0.93, 1);
gfx_x=left_x; gfx_y=240; gfx_drawstr("FEEDBACK TAP");
panel_feedback_menu(left_x+100, 234, panel_w-100);
gfx_setfont(2, "Arial", 12, 'b'); gfx_set(0.26, 0.83, 0.89, 1);
gfx_x=left_x; gfx_y=274; gfx_drawstr("MOTION LFO");
panel_toggle(28, left_x+panel_w-58, 270);
panel_slider(29, 0.02, 20, 0.01, left_x, 302, panel_w, "RATE", " Hz", 2);
panel_slider(30, 0, 10, 0.01, left_x, 324, panel_w, "DEPTH", " ms", 2);
panel_slider(31, 0, 180, 1, left_x, 346, panel_w, "STEREO PHASE", " deg", 0);
gfx_setfont(2, "Arial", 11); gfx_set(0.70, 0.82, 0.93, 1);
gfx_x=left_x; gfx_y=374; gfx_drawstr("SHAPE");
panel_choices(32, left_x+90, 368, panel_w-90, 4, "SIN      TRI      SQR      RND      ");

panel_heading(left_x, 416, panel_w, "02  DISPERSER", 0.63, 0.82, 0.42);
ui_button(left_x+panel_w-94,412,44,"MAIN",1) ? ui_disp_view=0;
ui_button(left_x+panel_w-47,412,47,"LFO",1) ? ui_disp_view=1;
gfx_set(0.63,0.82,0.42,1);
gfx_rect(left_x+panel_w-(ui_disp_view==0 ? 94 : 47),432,ui_disp_view==0 ? 44 : 47,2,1);
// Disperser main view.
ui_disp_view==0 ? (
panel_slider(7, 40, 18000, 1, left_x, 444, panel_w, "CENTER", " Hz", 0);
panel_slider(8, 0.1, 20, 0.01, left_x, 466, panel_w, "Q / PINCH", "", 2);
panel_slider(9, 0, 200, 1, left_x, 488, panel_w, "SPREAD", " %", 0);
panel_slider(10, 0, 128, 1, left_x, 510, panel_w, "STAGES", "", 0);
panel_slider(11, 0, 1, 0.01, left_x, 532, panel_w, "PHASE SUB", "", 2);
);
// Disperser LFO view.
ui_disp_view==1 ? (
gfx_setfont(2,"Arial",12,'b'); gfx_set(0.63,0.82,0.42,1);
gfx_x=left_x; gfx_y=449; gfx_drawstr("FREQUENCY LFO");
panel_toggle(17,left_x+panel_w-58,440);
panel_slider(18,0.02,12,0.01,left_x,474,panel_w,"RATE"," Hz",2);
panel_slider(19,0,100,0.1,left_x,496,panel_w,"DEPTH"," %",1);
panel_choices(21,left_x,518,panel_w,4,"SIN      SAW      SQR      RND      ");
gfx_setfont(2,"Arial",11); gfx_set(0.48,0.60,0.65,1);
gfx_x=left_x; gfx_y=546; gfx_drawstr("ACTIVE ");
gfx_drawnumber(atomic_get(ui_plot_center),0); gfx_drawstr(" Hz");
);
// Disperser shared plot.
panel_disp_plot(left_x,558,panel_w);
ui_accent_r=0.26; ui_accent_g=0.83; ui_accent_b=0.89;
panel_slider(3, 0, 1, 0.01, left_x, 650, panel_w, "TAP / FX", "", 2);

panel_heading(left_x, 680, panel_w, "03  FREQUENCY SHIFT", 0.72, 0.63, 0.91);
panel_slider(12, -5000, 5000, 0.1, left_x, 708, panel_w, "BASE SHIFT", " Hz", 1);
panel_slider(15, 0.02, 12, 0.01, left_x, 730, panel_w, "LFO RATE", " Hz", 2);
panel_slider(16, 0, 500, 0.1, left_x, 752, panel_w, "LFO DEPTH", " Hz", 1);
gfx_setfont(2, "Arial", 11); gfx_set(0.70, 0.82, 0.93, 1);
panel_choices(20, left_x, 774, panel_w, 5, "NONE     SIN      SAW      SQR      RND      ");
gfx_setfont(2, "Arial", 11); gfx_set(0.48, 0.60, 0.65, 1);
gfx_x=left_x; gfx_y=804; gfx_drawstr("ACTIVE  ");
gfx_drawnumber(atomic_get(ui_fs_active), 1); gfx_drawstr(" Hz");

// Column 2: pitched voices and input-driven motion.
