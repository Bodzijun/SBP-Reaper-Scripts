// @description SBP UltraComb (Sci-Fi dress)
// @version 1.4
// @author SBP & AI
// @about
//   Implementation of chain of effects (UltraComb) represent by AU5
//   Input -> Comb Filter -> Disperser -> FreqShiter -> mix Delay Output

desc: SBP UltraComb (Disperser)

slider1:0<0,12,0.1>Input Drive (dB)
slider2:0<-12,12,0.1>Output Gain (dB)
slider3:0.5<0,1,0.01>Mix: Delay 1 (Dry) / Delay 2 (Wet)
slider4:0<0,50,0.1>Delay 1 Time (Dry) ms
slider5:3<0,50,0.1>Delay 2 Time (Wet) ms
slider6:0.3<0,0.95,0.01>Delay 2 Feedback
slider7:200<40,4000,1>Disperser Freq
slider8:2.0<0.1,20,0.01>Disperser Q (Pinch)
slider9:100<0,200,1>Disperser Spread
slider10:48<0,128,1>Disperser Stages
slider11:0.5<0,1,0.01>Resonance Amount (Invert Mix)
slider12:0<-200,200,0.1>Freq Shift (Hz)
slider13:1.0<0.1,2,0.01>Disperser Level (Wet Gain)
slider14:0<0,1,1{Off,On}>Freq Shift Random LFO
slider15:0.35<0.02,12,0.01>Freq Shift Random Rate (Hz)
slider16:8<0,500,0.1>Freq Shift Random Depth (Hz)
slider17:0<0,1,1{Off,On}>Disperser Freq Random LFO
slider18:0.25<0.02,12,0.01>Disperser Freq Random Rate (Hz)
slider19:0<0,100,0.1>Disperser Freq Random Depth (%)
slider20:3<0,3,1{Sine,Saw,Square,Random}>Freq Shift LFO Shape
slider21:3<0,3,1{Sine,Saw,Square,Random}>Disperser Freq LFO Shape
slider22:0<0,2,1{Pre FX,Post Disperser,Post Shift}>Feedback Tap
slider23:0<0,1,0.01>Feedback Saturation

@init
MAX_STAGES = 128;

// Memory layout: 
// Disperser History
L_OFFSET = 0;
R_OFFSET = MAX_STAGES * 4;

// Hilbert History (8 filters * 2 states = 16 slots)
HILB_OFFSET = 2000;

// Delay Buffer
BUF_L_START = 10000;
BUF_R_START = 60000;
BUF_SIZE = 50000;

// Write pointers
buf_w_l = 0;
buf_w_r = 0;

// Initialize memory (clear)
// Clear Disperser State
i = 0;
loop(MAX_STAGES * 8,
  i[0] = 0;
  i += 1;
);

// Hilbert Filter State Allocation
hilb_l_a1 = HILB_OFFSET;
hilb_l_a2 = HILB_OFFSET + 2;
hilb_l_b1 = HILB_OFFSET + 4;
hilb_l_b2 = HILB_OFFSET + 6;

hilb_r_a1 = HILB_OFFSET + 8;
hilb_r_a2 = HILB_OFFSET + 10;
hilb_r_b1 = HILB_OFFSET + 12;
hilb_r_b2 = HILB_OFFSET + 14;

fs_phase = 0;
fs_rand_phase = 0;
disp_rand_phase = 0;
fs_rand_target = 0;
disp_rand_target = 0;
fs_rand_value = 0;
disp_rand_value = 0;
control_counter = 0;
CONTROL_INTERVAL = 32;
// @gfx has its own execution thread. Keep the LFO controls in atomic cells so
// a click is audible/visible immediately and does not wait for the next @slider.
atomic_set(ui_fs_lfo_on, slider14);
atomic_set(ui_fs_lfo_rate, slider15);
atomic_set(ui_fs_lfo_depth, slider16);
atomic_set(ui_fs_lfo_shape, slider20);
atomic_set(ui_disp_lfo_on, slider17);
atomic_set(ui_disp_lfo_rate, slider18);
atomic_set(ui_disp_lfo_depth, slider19);
atomic_set(ui_disp_lfo_shape, slider21);
atomic_set(ui_fb_tap, slider22);
atomic_set(ui_fb_saturation, slider23);
atomic_set(ui_fs_base, slider12);
atomic_set(ui_disp_base, slider7);
atomic_set(ui_mix, slider3);
// These controls live in the custom @gfx panel. They remain normal JSFX
// sliders internally, so project recall and automation work as expected.
slider_show(2^6, 0);   // Disperser frequency
slider_show(2^11, 0);  // Frequency shift
slider_show(2^13, 0); slider_show(2^14, 0); slider_show(2^15, 0);
slider_show(2^16, 0); slider_show(2^17, 0); slider_show(2^18, 0);
slider_show(2^19, 0); slider_show(2^20, 0);
slider_show(2^21, 0); slider_show(2^22, 0);
// Clear Hilbert Memory
i = 0;
loop(32,
  (HILB_OFFSET+i)[0] = 0;
  i += 1;
);

// Clear Delay Buffers (Critical to prevent noise)
i = 0;
loop(BUF_SIZE,
  BUF_L_START[i] = 0;
  BUF_R_START[i] = 0;
  i += 1;
);

// Recalculate the all-pass coefficients whenever the randomized Disperser
// frequency changes. This runs at control rate, not per audio sample.
function update_disperser_coeffs() (
  freq_mod = freq_base * max(0.05, 1 + disp_rand_value * disp_rand_depth);
  freq_l = freq_mod / sqrt(spread_factor);
  freq_r = freq_mod * sqrt(spread_factor);
  freq_l = max(20, min(freq_l, srate * 0.49));
  freq_r = max(20, min(freq_r, srate * 0.49));

  omega_l = 2 * $pi * freq_l / srate;
  sn_l = sin(omega_l);
  cs_l = cos(omega_l);
  alpha_l = sn_l / (2 * Q);
  a0_l = 1 + alpha_l;
  a1_l = -2 * cs_l;
  a2_l = 1 - alpha_l;
  inv_a0_l = 1.0 / a0_l;
  c_b0_l = a2_l * inv_a0_l;
  c_b1_l = a1_l * inv_a0_l;
  c_b2_l = 1.0;
  c_a1_l = a1_l * inv_a0_l;
  c_a2_l = a2_l * inv_a0_l;

  omega_r = 2 * $pi * freq_r / srate;
  sn_r = sin(omega_r);
  cs_r = cos(omega_r);
  alpha_r = sn_r / (2 * Q);
  a0_r = 1 + alpha_r;
  a1_r = -2 * cs_r;
  a2_r = 1 - alpha_r;
  inv_a0_r = 1.0 / a0_r;
  c_b0_r = a2_r * inv_a0_r;
  c_b1_r = a1_r * inv_a0_r;
  c_b2_r = 1.0;
  c_a1_r = a1_r * inv_a0_r;
  c_a2_r = a2_r * inv_a0_r;
);

// Feedback safety: transparent below the threshold, then progressively
// compresses peaks. Post-FX feedback can become self-oscillating otherwise.
function feedback_saturate(x, amount) (
  threshold = max(0.08, 1 - amount * 0.92);
  magnitude = abs(x);
  magnitude > threshold ? (
    shaped = threshold + (1-threshold) * (1-exp(-(magnitude-threshold)/(1-threshold)));
    x < 0 ? -shaped : shaped;
  ) : x;
);

@slider
// --- 1. GAIN & MIX ---
drive_lin = 10 ^ (slider1 / 20); 
out_lin = 10 ^ (slider2 / 20);
// Crossfade behavior:
// 0.0 = D1 only
// 0.5 = D1 + D2
// 1.0 = D2 only
// Typical "Equal Power" or Linear mix? Linear is fine for parallel.
global_mix_pos = slider3;
dry_vol = 1.0 - global_mix_pos;
wet_vol = global_mix_pos;
// If we want equal gain at center (0.5 + 0.5 = 1.0), linear is ok.

// --- 2. DELAYS ---
delay1_ms = slider4;
delay2_ms = slider5;
fb_amt = slider6;

// Delay Targets
delay1_target = (delay1_ms / 1000) * srate;
delay1_target = max(1, min(delay1_target, BUF_SIZE - 2));

delay2_target = (delay2_ms / 1000) * srate;
delay2_target = max(1, min(delay2_target, BUF_SIZE - 2));

(delay1_samps < 1) ? delay1_samps = delay1_target;
(delay2_samps < 1) ? delay2_samps = delay2_target;

// Slew rate
delay_slew = 1.0 - exp(-1.0 / (0.05 * srate));

// --- 3. DISPERSER ENGINE ---
// Parameters
freq_base = max(20, min(slider7, srate * 0.49)); 
Q = max(0.1, slider8); 
spread_semitones = slider9 / 100 * 12; 
num_stages = min(slider10, MAX_STAGES);

// Frequency Spread Calc
spread_factor = pow(2, spread_semitones / 12); 

// --- 4. EFFECTS ---
res_mix = slider11;
fs_freq = slider12;
disperser_level = slider13;
fs_rand_enabled = slider14;
fs_rand_rate = slider15;
fs_rand_depth = slider16;
disp_rand_enabled = slider17;
disp_rand_rate = slider18;
disp_rand_depth = slider19 / 100;
fs_lfo_shape = floor(slider20 + 0.5);
disp_lfo_shape = floor(slider21 + 0.5);
fb_tap = floor(slider22 + 0.5);
fb_saturation = slider23;
atomic_set(ui_fs_lfo_on, fs_rand_enabled);
atomic_set(ui_fs_lfo_rate, fs_rand_rate);
atomic_set(ui_fs_lfo_depth, fs_rand_depth);
atomic_set(ui_fs_lfo_shape, fs_lfo_shape);
atomic_set(ui_disp_lfo_on, disp_rand_enabled);
atomic_set(ui_disp_lfo_rate, disp_rand_rate);
// Store GUI depth in percent (0..100). DSP converts it to 0..1 only when
// calculating coefficients; storing the normalized value here caused it to
// shrink by 100× again after playback restarted.
atomic_set(ui_disp_lfo_depth, slider19);
atomic_set(ui_disp_lfo_shape, disp_lfo_shape);
atomic_set(ui_fb_tap, fb_tap);
atomic_set(ui_fb_saturation, fb_saturation);
atomic_set(ui_fs_base, fs_freq);
atomic_set(ui_disp_base, freq_base);
atomic_set(ui_mix, global_mix_pos);

// --- COEFFICIENTS CALCULATION ---
update_disperser_coeffs();

// --- POLYPHASE HILBERT COEFFICIENTS ---
// 4-pole design approx
a1 = 0.161758^2; a2 = 0.733029^2;
b1 = 0.479401^2; b2 = 0.876218^2;

@sample
// --- RANDOM SAMPLE-AND-HOLD LFOS (CONTROL RATE) ---
// A short, rate-dependent glide prevents abrupt filter-coefficient and
// frequency-shifter jumps from producing clicks.
control_counter += 1;
control_counter >= CONTROL_INTERVAL ? (
  control_counter = 0;
  // Pull GUI changes directly. Host automation still arrives via @slider and
  // updates these same cells, so both paths remain in sync.
  fs_rand_enabled = atomic_get(ui_fs_lfo_on);
  fs_rand_rate = atomic_get(ui_fs_lfo_rate);
  fs_rand_depth = atomic_get(ui_fs_lfo_depth);
  fs_lfo_shape = floor(atomic_get(ui_fs_lfo_shape) + 0.5);
  disp_rand_enabled = atomic_get(ui_disp_lfo_on);
  disp_rand_rate = atomic_get(ui_disp_lfo_rate);
  disp_rand_depth = atomic_get(ui_disp_lfo_depth) / 100;
  disp_lfo_shape = floor(atomic_get(ui_disp_lfo_shape) + 0.5);
  fb_tap = floor(atomic_get(ui_fb_tap) + 0.5);
  fb_saturation = atomic_get(ui_fb_saturation);
  fs_freq = atomic_get(ui_fs_base);
  freq_base = max(20, min(atomic_get(ui_disp_base), srate * 0.49));
  global_mix_pos = max(0, min(1, atomic_get(ui_mix)));
  dry_vol = 1.0 - global_mix_pos;
  wet_vol = global_mix_pos;

  fs_rand_enabled ? (
    fs_rand_phase += fs_rand_rate * CONTROL_INTERVAL / srate;
    fs_rand_phase >= 1 ? (
      fs_rand_phase -= floor(fs_rand_phase);
      fs_rand_target = rand(2) - 1;
    );
    fs_lfo_shape == 0 ? fs_rand_target = sin(2*$pi*fs_rand_phase);
    fs_lfo_shape == 1 ? fs_rand_target = 2*fs_rand_phase - 1;
    fs_lfo_shape == 2 ? fs_rand_target = (fs_rand_phase < 0.5 ? 1 : -1);
  ) : fs_rand_target = 0;
  fs_rand_glide = 1 - exp(-CONTROL_INTERVAL / (max(0.004, 0.20 / max(0.02, fs_rand_rate)) * srate));
  fs_rand_value += (fs_rand_target - fs_rand_value) * fs_rand_glide;

  disp_rand_enabled ? (
    disp_rand_phase += disp_rand_rate * CONTROL_INTERVAL / srate;
    disp_rand_phase >= 1 ? (
      disp_rand_phase -= floor(disp_rand_phase);
      disp_rand_target = rand(2) - 1;
    );
    disp_lfo_shape == 0 ? disp_rand_target = sin(2*$pi*disp_rand_phase);
    disp_lfo_shape == 1 ? disp_rand_target = 2*disp_rand_phase - 1;
    disp_lfo_shape == 2 ? disp_rand_target = (disp_rand_phase < 0.5 ? 1 : -1);
  ) : disp_rand_target = 0;
  disp_rand_glide = 1 - exp(-CONTROL_INTERVAL / (max(0.004, 0.20 / max(0.02, disp_rand_rate)) * srate));
  disp_rand_value += (disp_rand_target - disp_rand_value) * disp_rand_glide;

  update_disperser_coeffs();
);

in_l = spl0 * drive_lin;
in_r = spl1 * drive_lin;

// Soft clip input
function soft_clip(x) (
  x = max(-2.0, min(2.0, x));
  x / (1 + abs(x));
);

(slider1 > 0.1) ? (
  in_l = soft_clip(in_l);
  in_r = soft_clip(in_r);
);

cur_l = in_l;
cur_r = in_r;

// --- COMB / FLANGER SECTION (Input Stage) ---
delay1_samps += (delay1_target - delay1_samps) * delay_slew;
delay2_samps += (delay2_target - delay2_samps) * delay_slew;

delay1_samps = max(1, delay1_samps);
delay2_samps = max(1, delay2_samps);

// Read Delay 1 (Dry Path)
r_pos_d1 = buf_w_l - delay1_samps;
(r_pos_d1 < 0) ? r_pos_d1 += BUF_SIZE;
ridx = floor(r_pos_d1); frac = r_pos_d1 - ridx;
val_d1_l = BUF_L_START[ridx] * (1-frac) + BUF_L_START[(ridx+1)%BUF_SIZE] * frac;

r_pos_d1 = buf_w_r - delay1_samps;
(r_pos_d1 < 0) ? r_pos_d1 += BUF_SIZE;
ridx = floor(r_pos_d1); frac = r_pos_d1 - ridx;
val_d1_r = BUF_R_START[ridx] * (1-frac) + BUF_R_START[(ridx+1)%BUF_SIZE] * frac;

// Read Delay 2 (Wet/Disperser Path)
r_pos_d2 = buf_w_l - delay2_samps;
(r_pos_d2 < 0) ? r_pos_d2 += BUF_SIZE;
ridx = floor(r_pos_d2); frac = r_pos_d2 - ridx;
val_d2_l = BUF_L_START[ridx] * (1-frac) + BUF_L_START[(ridx+1)%BUF_SIZE] * frac;

r_pos_d2 = buf_w_r - delay2_samps;
(r_pos_d2 < 0) ? r_pos_d2 += BUF_SIZE;
ridx = floor(r_pos_d2); frac = r_pos_d2 - ridx;
val_d2_r = BUF_R_START[ridx] * (1-frac) + BUF_R_START[(ridx+1)%BUF_SIZE] * frac;


// Prepare Signals
dry_path_l = val_d1_l;
dry_path_r = val_d1_r;

wet_path_l = val_d2_l; 
wet_path_r = val_d2_r;
// Save a copy of wet_path pre-disperser for the subtraction trick
pre_disp_l = wet_path_l;
pre_disp_r = wet_path_r;

// --- DISPERSER SECTION (Output Stage) ---

// Left Disperser (Processes wet_path_l)
cur_l = wet_path_l; 
i = 0;
loop(num_stages, 
  mem_idx = L_OFFSET + i * 4;
  x1 = mem_idx[0];
  x2 = mem_idx[1];
  y1 = mem_idx[2];
  y2 = mem_idx[3];
  
  out_samp = c_b0_l * cur_l + c_b1_l * x1 + c_b2_l * x2 - c_a1_l * y1 - c_a2_l * y2;
  (abs(out_samp) < 0.000000001) ? out_samp = 0; // Denormal fix

  mem_idx[1] = x1;
  mem_idx[0] = cur_l;
  mem_idx[3] = y1;
  mem_idx[2] = out_samp;
  
  cur_l = out_samp;
  i += 1;
);

// Right Disperser
cur_r = wet_path_r;
i = 0;
loop(num_stages,
  mem_idx = R_OFFSET + i * 4;
  x1 = mem_idx[0];
  x2 = mem_idx[1];
  y1 = mem_idx[2];
  y2 = mem_idx[3];
  
  out_samp = c_b0_r * cur_r + c_b1_r * x1 + c_b2_r * x2 - c_a1_r * y1 - c_a2_r * y2;
  (abs(out_samp) < 0.000000001) ? out_samp = 0;

  mem_idx[1] = x1;
  mem_idx[0] = cur_r;
  mem_idx[3] = y1;
  mem_idx[2] = out_samp;
  
  cur_r = out_samp;
  i += 1;
);

// Apply Resonance Extraction (Subtract original from dispersed if desired)
// "Phase Invert to get pure resonances"
cur_l = cur_l - (pre_disp_l * res_mix);
cur_r = cur_r - (pre_disp_r * res_mix);
post_disp_l = cur_l;
post_disp_r = cur_r;

// --- FREQUENCY SHIFTER SECTION ---
fs_freq_active = fs_freq + fs_rand_value * fs_rand_depth;
(abs(fs_freq_active) > 0.000001) ? (
  // Update phase
  fs_phase += fs_freq_active / srate;
  fs_phase -= floor(fs_phase);
  
  // Oscillator (Complex / Quadrature)
  // cos(x) and sin(x)
  osc_cos = cos(2 * $pi * fs_phase);
  osc_sin = sin(2 * $pi * fs_phase);
  
  // --- LEFT HILBERT ---
  // Branch A (Allpass cascade)
  // AP1
  in = cur_l;
  out = a1 * (in - hilb_l_a1[1]) + hilb_l_a1[0];
  hilb_l_a1[1] = out; hilb_l_a1[0] = in;
  tmp = out;
  // AP2
  in = tmp;
  out = a2 * (in - hilb_l_a2[1]) + hilb_l_a2[0];
  hilb_l_a2[1] = out; hilb_l_a2[0] = in;
  out_a = out;
  
  // Branch B
  // AP1
  in = cur_l;
  out = b1 * (in - hilb_l_b1[1]) + hilb_l_b1[0];
  hilb_l_b1[1] = out; hilb_l_b1[0] = in;
  tmp = out;
  // AP2
  in = tmp;
  out = b2 * (in - hilb_l_b2[1]) + hilb_l_b2[0];
  hilb_l_b2[1] = out; hilb_l_b2[0] = in;
  out_b = out;
  
  // Single Sideband Calculation
  cur_l = out_a * osc_cos - out_b * osc_sin;
  
  // --- RIGHT HILBERT ---
  // Branch A
  in = cur_r;
  out = a1 * (in - hilb_r_a1[1]) + hilb_r_a1[0];
  hilb_r_a1[1] = out; hilb_r_a1[0] = in;
  tmp = out;
  in = tmp;
  out = a2 * (in - hilb_r_a2[1]) + hilb_r_a2[0];
  hilb_r_a2[1] = out; hilb_r_a2[0] = in;
  out_a = out;
  
  // Branch B
  in = cur_r;
  out = b1 * (in - hilb_r_b1[1]) + hilb_r_b1[0];
  hilb_r_b1[1] = out; hilb_r_b1[0] = in;
  tmp = out;
  in = tmp;
  out = b2 * (in - hilb_r_b2[1]) + hilb_r_b2[0];
  hilb_r_b2[1] = out; hilb_r_b2[0] = in;

  cur_r = out_a * osc_cos - out_b * osc_sin;
);

// --- SELECTABLE FEEDBACK LOOP ---
// Pre FX is the original stable comb loop. The other two return the evolving
// disperser/shifted signal, with an optional soft safety stage.
fb_tap == 0 ? (
  fb_source_l = wet_path_l;
  fb_source_r = wet_path_r;
) : fb_tap == 1 ? (
  fb_source_l = post_disp_l;
  fb_source_r = post_disp_r;
) : (
  fb_source_l = cur_l;
  fb_source_r = cur_r;
);
fb_loop_l = feedback_saturate(fb_source_l, fb_saturation);
fb_loop_r = feedback_saturate(fb_source_r, fb_saturation);
buf_in_l = in_l + fb_loop_l * fb_amt;
buf_in_r = in_r + fb_loop_r * fb_amt;
buf_in_l = max(-4.0, min(4.0, buf_in_l));
buf_in_r = max(-4.0, min(4.0, buf_in_r));
buf_l_ptr = BUF_L_START + buf_w_l;
buf_r_ptr = BUF_R_START + buf_w_r;
buf_l_ptr[0] = buf_in_l;
buf_r_ptr[0] = buf_in_r;
buf_w_l = (buf_w_l + 1) % BUF_SIZE;
buf_w_r = (buf_w_r + 1) % BUF_SIZE;


// Output Mix
// Mix the "Dry Path" (Delay 1) з "Wet Path" (Dispersed Chain)
out_l = dry_path_l * dry_vol + (cur_l * disperser_level) * wet_vol;
out_r = dry_path_r * dry_vol + (cur_r * disperser_level) * wet_vol;

spl0 = out_l * out_lin;
spl1 = out_r * out_lin;

@gfx 760 410
// --- ULTRACOMB PERFORMANCE PANEL ---
// The standard REAPER sliders remain automation-friendly but these compact
// performance controls are edited directly here.
panel_w = (gfx_w - 52) * 0.5;
left_x = 18;
right_x = left_x + panel_w + 16;
panel_y = 104;
panel_h = 205;
button_y = panel_y + 61;
button_w = 58;
button_h = 22;
ui_control_x = left_x + 128;
ui_right_control_x = right_x + 128;
ui_control_w = panel_w - 148;
ui_row_base = panel_y + 46;
ui_row_rate = panel_y + 115;
ui_row_depth = panel_y + 142;
ui_shape_x = left_x + 55;
ui_right_shape_x = right_x + 55;
ui_shape_w = 41;
ui_shape_gap = 3;
ui_fb_y = 360;
ui_fb_tap_x = 121;
ui_fb_tap_w = 78;
ui_fb_tap_gap = 4;
ui_fb_sat_x = 470;
ui_fb_sat_w = 145;
ui_mix_x = 57;
ui_mix_y = 89;
ui_mix_w = 152;
gfx_mix = atomic_get(ui_mix);
gfx_fs_lfo_on = atomic_get(ui_fs_lfo_on);
gfx_fs_lfo_rate = atomic_get(ui_fs_lfo_rate);
gfx_fs_lfo_depth = atomic_get(ui_fs_lfo_depth);
gfx_fs_lfo_shape = floor(atomic_get(ui_fs_lfo_shape) + 0.5);
gfx_disp_lfo_on = atomic_get(ui_disp_lfo_on);
gfx_disp_lfo_rate = atomic_get(ui_disp_lfo_rate);
gfx_disp_lfo_depth = atomic_get(ui_disp_lfo_depth);
gfx_disp_lfo_shape = floor(atomic_get(ui_disp_lfo_shape) + 0.5);
gfx_fb_tap = floor(atomic_get(ui_fb_tap) + 0.5);
gfx_fb_saturation = atomic_get(ui_fb_saturation);

mouse_down = ((mouse_cap & 1) != 0);
mouse_clicked = mouse_down && !ui_was_down;
mouse_clicked && mouse_x >= left_x+panel_w-button_w-16 && mouse_x <= left_x+panel_w-16 && mouse_y >= button_y && mouse_y <= button_y+button_h ? (
  gfx_fs_lfo_on = 1-gfx_fs_lfo_on;
  slider14 = gfx_fs_lfo_on;
  atomic_set(ui_fs_lfo_on, gfx_fs_lfo_on);
  sliderchange(2^13);
);
mouse_clicked && mouse_x >= right_x+panel_w-button_w-16 && mouse_x <= right_x+panel_w-16 && mouse_y >= button_y && mouse_y <= button_y+button_h ? (
  gfx_disp_lfo_on = 1-gfx_disp_lfo_on;
  slider17 = gfx_disp_lfo_on;
  atomic_set(ui_disp_lfo_on, gfx_disp_lfo_on);
  sliderchange(2^16);
);
mouse_clicked && mouse_x >= ui_shape_x && mouse_x <= ui_shape_x+4*(ui_shape_w+ui_shape_gap)-ui_shape_gap && mouse_y >= button_y && mouse_y <= button_y+button_h ? (
  gfx_fs_lfo_shape = min(3, floor((mouse_x-ui_shape_x)/(ui_shape_w+ui_shape_gap)));
  slider20 = gfx_fs_lfo_shape;
  atomic_set(ui_fs_lfo_shape, gfx_fs_lfo_shape);
  sliderchange(2^19);
);
mouse_clicked && mouse_x >= ui_right_shape_x && mouse_x <= ui_right_shape_x+4*(ui_shape_w+ui_shape_gap)-ui_shape_gap && mouse_y >= button_y && mouse_y <= button_y+button_h ? (
  gfx_disp_lfo_shape = min(3, floor((mouse_x-ui_right_shape_x)/(ui_shape_w+ui_shape_gap)));
  slider21 = gfx_disp_lfo_shape;
  atomic_set(ui_disp_lfo_shape, gfx_disp_lfo_shape);
  sliderchange(2^20);
);
mouse_clicked && mouse_x >= ui_mix_x && mouse_x <= ui_mix_x+ui_mix_w && mouse_y >= ui_mix_y-6 && mouse_y <= ui_mix_y+14 ? ui_mix_drag = 1;
mouse_clicked && mouse_x >= ui_fb_tap_x && mouse_x <= ui_fb_tap_x+3*(ui_fb_tap_w+ui_fb_tap_gap)-ui_fb_tap_gap && mouse_y >= ui_fb_y && mouse_y <= ui_fb_y+20 ? (
  gfx_fb_tap = min(2, floor((mouse_x-ui_fb_tap_x)/(ui_fb_tap_w+ui_fb_tap_gap)));
  slider22 = gfx_fb_tap;
  atomic_set(ui_fb_tap, gfx_fb_tap);
  sliderchange(2^21);
);
mouse_clicked && mouse_x >= ui_fb_sat_x && mouse_x <= ui_fb_sat_x+ui_fb_sat_w && mouse_y >= ui_fb_y && mouse_y <= ui_fb_y+20 ? ui_fb_drag = 1;
mouse_clicked ? (
  ui_drag = 0;
  mouse_x >= ui_control_x && mouse_x <= ui_control_x+ui_control_w ? (
    mouse_y >= ui_row_base-7 && mouse_y <= ui_row_base+14 ? (
      ui_drag = 1;
    );
    mouse_y >= ui_row_rate-7 && mouse_y <= ui_row_rate+14 ? (
      ui_drag = 2;
    );
    mouse_y >= ui_row_depth-7 && mouse_y <= ui_row_depth+14 ? (
      ui_drag = 3;
    );
  );
  mouse_x >= ui_right_control_x && mouse_x <= ui_right_control_x+ui_control_w ? (
    mouse_y >= ui_row_base-7 && mouse_y <= ui_row_base+14 ? (
      ui_drag = 4;
    );
    mouse_y >= ui_row_rate-7 && mouse_y <= ui_row_rate+14 ? (
      ui_drag = 5;
    );
    mouse_y >= ui_row_depth-7 && mouse_y <= ui_row_depth+14 ? (
      ui_drag = 6;
    );
  );
);
mouse_down && ui_drag ? (
  ui_norm = ui_drag <= 3 ? (mouse_x-ui_control_x)/ui_control_w : (mouse_x-ui_right_control_x)/ui_control_w;
  ui_norm = max(0, min(1, ui_norm));
  ui_drag == 1 ? (slider12 = -200 + 400*ui_norm; atomic_set(ui_fs_base, slider12); sliderchange(2^11););
  ui_drag == 2 ? (gfx_fs_lfo_rate = 0.02 + 11.98*ui_norm; slider15 = gfx_fs_lfo_rate; atomic_set(ui_fs_lfo_rate, gfx_fs_lfo_rate); sliderchange(2^14););
  ui_drag == 3 ? (gfx_fs_lfo_depth = 500*ui_norm; slider16 = gfx_fs_lfo_depth; atomic_set(ui_fs_lfo_depth, gfx_fs_lfo_depth); sliderchange(2^15););
  ui_drag == 4 ? (slider7 = 40*pow(100, ui_norm); atomic_set(ui_disp_base, slider7); sliderchange(2^6););
  ui_drag == 5 ? (gfx_disp_lfo_rate = 0.02 + 11.98*ui_norm; slider18 = gfx_disp_lfo_rate; atomic_set(ui_disp_lfo_rate, gfx_disp_lfo_rate); sliderchange(2^17););
  ui_drag == 6 ? (gfx_disp_lfo_depth = 100*ui_norm; slider19 = gfx_disp_lfo_depth; atomic_set(ui_disp_lfo_depth, gfx_disp_lfo_depth); sliderchange(2^18););
);
!mouse_down ? ui_drag = 0;
mouse_down && ui_mix_drag ? (
  gfx_mix = max(0, min(1, (mouse_x-ui_mix_x)/ui_mix_w));
  slider3 = gfx_mix;
  atomic_set(ui_mix, gfx_mix);
  sliderchange(2^2);
);
!mouse_down ? ui_mix_drag = 0;
mouse_down && ui_fb_drag ? (
  gfx_fb_saturation = max(0, min(1, (mouse_x-ui_fb_sat_x)/ui_fb_sat_w));
  slider23 = gfx_fb_saturation;
  atomic_set(ui_fb_saturation, gfx_fb_saturation);
  sliderchange(2^22);
);
