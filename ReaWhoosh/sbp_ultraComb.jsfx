@init
// Factoradic order: every value encodes exactly one permutation of six modules.
function route_decode(rank, memory) local(slot, factor, digit, used, candidate, seen) (
  rank=max(0,min(719,floor(rank+0.5))); slot=0; factor=120; used=0;
  loop(6,
    digit=floor(rank/factor); rank-=digit*factor;
    candidate=0; seen=0;
    while((used & (1<<candidate)) || seen<digit) (
      !(used & (1<<candidate)) ? seen+=1;
      candidate+=1;
    );
    memory[slot]=candidate; used |= 1<<candidate;
    factor=max(1,factor/max(1,5-slot)); slot+=1;
  );
);
function route_encode(memory) local(slot, factor, rank, used, candidate, digit) (
  slot=0; factor=120; rank=0; used=0;
  loop(6,
    candidate=0; digit=0;
    loop(memory[slot], !(used & (1<<candidate)) ? digit+=1; candidate+=1;);
    rank+=digit*factor; used |= 1<<memory[slot];
    factor=max(1,factor/max(1,5-slot)); slot+=1;
  );
  rank;
);
function route_decode_full(code,memory) local(position,i) (
  code=max(0,min(5039,floor(code+0.5)));
  route_decode(code%720,memory);
  position=floor(code/720); i=5;
  loop(6-position, memory[i+1]=memory[i]; i-=1;);
  memory[position]=6;
);
ROUTE_AUDIO=243000; ROUTE_UI=243016;
active_route=max(0,min(719,floor(slider73+0.5)))+720*max(0,min(6,floor(slider83+0.5))); route_gain=1;
route_decode_full(active_route,ROUTE_AUDIO);
// Saike WSOLA pitch shifting library, Joep Vanlier, 2020.
// Source: https://github.com/JoepVanlier/JSFX/blob/master/Basics/saike_pitchlib.jsfx-inc
