@slider
slider88=reaweb_jsfx_handshake(slider88);
pdc_delay=slider38>0.5 ? SPECTRAL_SIZE : 0;
pdc_bot_ch=0; pdc_top_ch=2;
slider65 != morph_last_applied ? (
  morph_last_applied=slider65;
  // Host morph automation must also work with @gfx closed, without recording itself.
  apply_morph(slider65, 0);
);
sync_pitch_controls();
atomic_set(ui_metal_on, slider33);
atomic_set(ui_metal_size, slider34);
atomic_set(ui_metal_decay, slider35);
atomic_set(ui_metal_tone, slider36);
atomic_set(ui_metal_mix, slider37);
// --- 1. GAIN & MIX ---
drive_lin = 10 ^ (slider1 / 20);
out_lin = 10 ^ (slider2 / 20);
// Crossfade behavior:
// 0.0 = D1 only
// 0.5 = D1 + D2
// 1.0 = D2 only
// Typical "Equal Power" or Linear mix? Linear is fine for parallel.
global_mix_pos = slider3;
dry_vol = 1.0 - global_mix_pos;
wet_vol = global_mix_pos;
// If we want equal gain at center (0.5 + 0.5 = 1.0), linear is ok.

// --- 2. DELAYS ---
delay2_ms = slider5;
fb_amt = slider6;

// Delay Targets

delay2_target = (delay2_ms / 1000) * srate;
delay2_target = max(1, min(delay2_target, BUF_SIZE - 2));

(delay2_samps < 1) ? delay2_samps = delay2_target;

// Slew rate
delay_slew = 1.0 - exp(-1.0 / (0.05 * srate));

// --- 3. DISPERSER ENGINE ---
// Parameters
freq_base = max(20, min(slider7, srate * 0.49));
Q = uc_mod_octaves(slider8,20,3,0.1,20);
num_stages = min(slider10, MAX_STAGES);

// --- 4. EFFECTS ---
res_mix = uc_mod_linear(slider11,22,1,0,1);
fs_freq = slider12;
wet_return_gain = uc_mod_linear(slider13,18,1.9,0.1,2);
fs_rand_enabled = slider14;
fs_rand_rate = slider15;
fs_rand_depth = slider16;
disp_rand_enabled = slider17;
disp_rand_rate = slider18;
disp_rand_depth = slider19 / 100;
fs_lfo_shape = floor(slider20 + 0.5);
disp_lfo_shape = floor(slider21 + 0.5);
fb_tap = floor(slider22 + 0.5);
fb_extra = slider59 > 0.5 ? floor(slider59+0.5)+4 : floor(slider47 + 0.5);
slider84>0.5 ? fb_extra=7;
slider123>0.5 ? fb_extra=8;
fb_saturation = slider124;
atomic_set(ui_fs_lfo_on, fs_rand_enabled);
atomic_set(ui_fs_lfo_rate, fs_rand_rate);
atomic_set(ui_fs_lfo_depth, fs_rand_depth);
atomic_set(ui_fs_lfo_shape, fs_lfo_shape);
atomic_set(ui_disp_lfo_on, disp_rand_enabled);
atomic_set(ui_disp_lfo_rate, disp_rand_rate);
// Store GUI depth in percent (0..100). DSP converts it to 0..1 only when
// calculating coefficients; storing the normalized value here caused it to
// shrink by 100× again after playback restarted.
atomic_set(ui_disp_lfo_depth, slider19);
atomic_set(ui_disp_lfo_shape, disp_lfo_shape);
atomic_set(ui_fb_tap, fb_tap);
atomic_set(ui_fb_extra, slider47);
atomic_set(ui_fb_saturation, fb_saturation);
atomic_set(ui_fs_base, fs_freq);
atomic_set(ui_disp_base, freq_base);
atomic_set(ui_mix, global_mix_pos);

// --- COEFFICIENTS CALCULATION ---
update_disperser_coeffs();
update_metal_coeffs();
!smooth_ready ? (
  sm_drive = drive_lin; sm_out = out_lin; sm_mix = global_mix_pos;
  sm_fb = fb_amt; sm_level = wet_return_gain;
  sm_sat = fb_saturation;
  sm_tap_disp = fb_extra == 0 && fb_tap == 1;
  sm_tap_shift = fb_extra == 0 && fb_tap == 2;
  sm_tap_pitch = fb_extra == 1; sm_tap_ring = fb_extra == 2;
  sm_tap_metal = fb_extra == 3; sm_tap_sat = fb_extra == 4;
  sm_tap_freeze = fb_extra == 5; sm_tap_double = fb_extra == 6;
  sm_tap_filter = fb_extra == 7;
  sm_tap_chorus = fb_extra == 8;
  sm_clip = slider1 > 0.1;
  c_b0_l = target_b0_l; c_b1_l = target_b1_l;
  c_b0_r = target_b0_r; c_b1_r = target_b1_r;
  smooth_ready = 1;
);

@block
sync_bpm=tempo>0 ? tempo : 120;sync_num=ts_num>0 ? ts_num : 4;sync_den=ts_denom>0 ? ts_denom : 4;sync_bars=sync_num*4/sync_den;
sync_beat=beat_position;sync_running=(play_state&1)!=0;sync_sample=0;
VIS_LOW[12]=slider192>0.5 ? 0.000001 : 0.02;VIS_HIGH[12]=slider192>0.5 ? 512 : 12;
VIS_LOW[14]=slider193>0.5 ? 0.000001 : 0.02;VIS_HIGH[14]=slider193>0.5 ? 512 : 12;
VIS_HIGH[53]=VIS_HIGH[54]=VIS_HIGH[56]=slider194>0.5 ? 3600000 : 30000;
VIS_HIGH[71]=VIS_HIGH[72]=VIS_HIGH[74]=slider211>0.5 ? 3600000 : 30000;
// ADR MIDI capture: preserve every short message and its original bus/offset.
adr_midi_span=max(1,min(samplesblock,8388608-ADR_MIDI));
memset(ADR_MIDI,0,adr_midi_span);adr_midi_position=0;
while(midirecv(adr_midi_offset,adr_midi_msg1,adr_midi_msg2,adr_midi_msg3)) (
  midisend(adr_midi_offset,adr_midi_msg1,adr_midi_msg2,adr_midi_msg3);
  (slider140==4 || slider200==4) && slider113>0.5 && uc_adr_midi_note(adr_midi_msg1,adr_midi_msg3) ? (
    ADR_MIDI[max(0,min(adr_midi_span-1,floor(adr_midi_offset)))]+=1;
  );
);
// End ADR MIDI capture.
slider88=reaweb_jsfx_handshake(slider88);
web_command_kind=reaweb_jsfx_service();
web_command_kind==1 ? (
  reaweb_jsfx_id==0 ? atomic_add(ui_pitch_fire,1);
  reaweb_jsfx_id==3 ? atomic_add(ui_adr_fire,1);
  reaweb_jsfx_id==4 ? atomic_add(ui_adr2_fire,1);
  reaweb_jsfx_id==1 || reaweb_jsfx_id==2 ? (
    web_snapshot=reaweb_jsfx_id==1 ? MORPH_A : MORPH_B;
    web_copy_index=0;
    loop(MORPH_COUNT,web_snapshot[web_copy_index]=slider(web_copy_index+1);web_copy_index+=1;);
    reaweb_jsfx_id==1 ? morph_a_ready=1 : morph_b_ready=1;
  );
  WEB_REPLY[0]=1;
  reaweb_jsfx_reply(0,WEB_REPLY,1);
);
web_capture=reaweb_jsfx_stream_active(0)||reaweb_jsfx_stream_active(1)||reaweb_jsfx_stream_active(3)||reaweb_jsfx_stream_active(4);
!web_capture ? web_capture_pos=0;
web_mod_clock+=samplesblock;
!reaweb_jsfx_stream_active(2) ? (web_motion_peak=web_adr_peak=web_adr2_peak=0;);
reaweb_jsfx_stream_active(2) && web_mod_clock>=srate/30 ? (
  web_mod_clock=0;
  WEB_MOD[0]=ultra_comb_motion.phase; WEB_MOD[1]=ultra_comb_motion.value_l; WEB_MOD[2]=slider28;
  WEB_MOD[3]=disp_rand_phase; WEB_MOD[4]=disp_rand_value; WEB_MOD[5]=slider17;
  WEB_MOD[6]=slider113>0.5 ? fs_effective_phase : fs_rand_phase;
  WEB_MOD[7]=fs_rand_value*(slider113>0.5 ? fs_shared_depth : 1); WEB_MOD[8]=slider14;
  WEB_MOD[9]=slider45>1.5 ? min(1,ultra_motion.attack_age/(max(0.005,slider42*0.001)+0.005)) : ultra_motion.phase;
  WEB_MOD[10]=ultra_motion.visual_motion; WEB_MOD[11]=slider113>0.5 ? slider45>1.5 : slider38>0.5 && slider45>0.5;
  WEB_MOD[12]=ultra_double.phase; WEB_MOD[13]=sin(2*$pi*ultra_double.phase); WEB_MOD[14]=slider52>0.5 && slider58>0;
  WEB_MOD[15]=ultra_filter.phase; WEB_MOD[16]=ultra_filter.lfo_value; WEB_MOD[17]=slider74>0.5 && slider82>0;
  WEB_MOD[18]=0; WEB_MOD[19]=min(1,max(0,env_level*env_sensitivity)); WEB_MOD[20]=slider113>0.5 || slider60>0;
  WEB_MOD[21]=ultra_double.latency_l; WEB_MOD[22]=ultra_double.latency_r;
  WEB_MOD[23]=ultra_double.semi; WEB_MOD[24]=ultra_double.amount;
  WEB_MOD[25]=ultra_double.width; WEB_MOD[26]=ultra_double.gain;
  WEB_MOD[27]=ultra_double.polarity; WEB_MOD[28]=ultra_double.extra_delay*1000/srate;
  WEB_MOD[29]=ultra_lfo2.effective_phase; WEB_MOD[30]=ultra_lfo2.output; WEB_MOD[31]=slider113>0.5 && slider131>0.5;
  WEB_MOD[32]=max(0,ultra_motion.envelope);WEB_MOD[33]=web_motion_peak;
  WEB_MOD[34]=ultra_adr.phase;WEB_MOD[35]=ultra_adr.output;WEB_MOD[36]=slider113>0.5 && slider140>0;
  WEB_MOD[37]=max(0,ultra_adr.detector);WEB_MOD[38]=web_adr_peak;WEB_MOD[39]=max(0,ultra_motion.attack_age);
  WEB_MOD[40]=motion_threshold_target;WEB_MOD[41]=adr_threshold_target;
  // Flat control vector, not PCM; one transport channel respects SDK limits.
  uc_visual_snapshot();
  reaweb_jsfx_publish(2,WEB_MOD,542,1,web_sample_clock);
  web_motion_peak=web_adr_peak=web_adr2_peak=0;
);

@sample
sync_sample+=1;
// ADR MIDI sample: chords coalesce at the same sample; held notes do not repeat.
adr_midi_position<adr_midi_span ? (
  slider140==4 && slider113>0.5 && ADR_MIDI[adr_midi_position]>0 ? atomic_add(ui_adr_fire,ADR_MIDI[adr_midi_position]);
  slider200==4 && slider113>0.5 && ADR_MIDI[adr_midi_position]>0 ? atomic_add(ui_adr2_fire,ADR_MIDI[adr_midi_position]);
);
adr_midi_position+=1;
// End ADR MIDI sample.
web_capture ? (
  WEB_INPUT[web_capture_pos*2]=spl0;
  WEB_INPUT[web_capture_pos*2+1]=spl1;
);
// Detect the raw input, before drive, delays and feedback can influence the envelope.
detector_internal=max(abs(spl0),abs(spl1));
detector_external=max(abs(spl2),abs(spl3));
motion_input=slider116>0.5 ? detector_external : detector_internal;
env_input=slider117>0.5 ? detector_external : detector_internal;
adr_input=slider141>0.5 ? detector_external : detector_internal;
adr2_input=slider201>0.5 ? detector_external : detector_internal;
web_motion_peak=max(web_motion_peak,motion_input);web_adr_peak=max(web_adr_peak,adr_input);web_adr2_peak=max(web_adr2_peak,adr2_input);
env_level += (env_input-env_level)*(env_input > env_level ? env_attack_coeff : env_release_coeff);
env_amount = min(1, max(0, env_level*env_sensitivity))*env_depth;
env_pitch += ((env_target == 1 ? env_amount : 0)-env_pitch)*param_slew;
env_shift += ((env_target == 2 ? env_amount : 0)-env_shift)*param_slew;
env_metal += ((env_target == 3 ? env_amount : 0)-env_metal)*param_slew;
env_double += ((env_target == 4 ? env_amount : 0)-env_double)*param_slew;
slider113>0.5 ? (
  ultra_motion.uc_pitch_motion_process(motion_input,0,1,0.5,motion_decay_target,slider45>1.5 ? 2 : 0,motion_threshold_target,atomic_get(ui_pitch_fire),0);
  matrix_i=1;loop(78,MATRIX[matrix_i]+=(MATRIX_TARGET[matrix_i]-MATRIX[matrix_i])*param_slew;matrix_i+=1;);
);
// --- RANDOM SAMPLE-AND-HOLD LFOS (CONTROL RATE) ---
// A short, rate-dependent glide prevents abrupt filter-coefficient and
// frequency-shifter jumps from producing clicks.
control_counter += 1;
control_counter >= CONTROL_INTERVAL ? (
  control_counter = 0;
  env_attack_coeff = 1-exp(-1/(uc_mod_octaves(atomic_get(ui_extra63),64,4,1,200)*0.001*srate));
  env_release_coeff = 1-exp(-1/(uc_mod_octaves(atomic_get(ui_extra64),65,4,10,2000)*0.001*srate));
  env_sensitivity = pow(10,uc_mod_linear(atomic_get(ui_extra62),63,48,-24,24)/20);
  env_depth = uc_mod_linear(atomic_get(ui_extra61),62,2,-1,1); env_target = floor(atomic_get(ui_extra60)+0.5);
  atomic_set(ui_env_level, min(1, max(0, env_level*env_sensitivity)));
  atomic_set(ui_pitch_active, ultra_motion.semi);
  atomic_set(ui_fs_active, ultra_shift.current_hz);
  atomic_set(ui_metal_level, ultra_metal.meter);
  atomic_set(ui_metal_contribution, ultra_metal.mix_value);
  atomic_set(ui_plot_tap_l, ultra_comb_motion.read_l);
  atomic_set(ui_plot_tap_r, ultra_comb_motion.read_r);
  atomic_set(ui_plot_fx, delay2_samps);
  atomic_set(ui_double_delay_l, ultra_double.latency_l);
  atomic_set(ui_double_delay_r, ultra_double.latency_r);
  atomic_set(ui_filter_hz,ultra_filter.active_hz);
  // Native sliders and custom controls feed the same smoothed DSP targets.
  drive_lin = 10^(uc_mod_linear(slider1,16,12,0,12)/20);
  out_lin = 10^(max(-24,min(24,slider2+(slider113>0.5 ? MATRIX[11]*12 : 0)))/20);
  delay2_target = max(1, min(max(0,min(200,slider5+(slider113>0.5 ? MATRIX[2]*200 : 0)))*srate/1000, BUF_SIZE-2));
  fb_amt = max(0,min(0.95,slider6+(slider113>0.5 ? MATRIX[10]*0.5 : 0)));
  Q = uc_mod_octaves(slider8,20,3,0.1,20);
  num_stages = max(0, min(MAX_STAGES, slider10));
