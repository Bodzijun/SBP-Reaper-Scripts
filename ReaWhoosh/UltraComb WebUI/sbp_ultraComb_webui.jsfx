  this.right.uc_shift_channel_process(input_r);
  // +1 = original signed sideband; 0 = equal sides / ring; -1 = opposite.
  // This is a convex sideband blend, so there is no added feedback-loop gain.
  shifted_l=this.left.real*cosine-this.left.imag*sine*current_sideband;
  shifted_r=this.right.real*cosine_r-this.right.imag*sine_r*current_sideband;
  out_l=input_l+(shifted_l-input_l)*current_mix*wet_mix;
  out_r=input_r+(shifted_r-input_r)*current_mix_r*wet_mix;
);
// End Frequency Shift DSP module.

// Disperser DSP module: caller reserves 1536 cells exclusively for this instance.
function uc_disp_init(memory, rate, stages, resonance)
instance(state, sample_rate, configured, slew, current_stages, current_res, current_mix, out_l, out_r, config_center, config_spread, config_q, config_stages)
local() global()
(
  state=memory;
  sample_rate=rate; configured=0;
  memset(state, 0, 1536);
  slew=1-exp(-1/(0.01*max(1,rate)));
  current_stages=max(0,min(128,stages));
  current_res=max(0,min(1,resonance));
  current_mix=1;
  out_l=out_r=0;
);

function uc_disp_config(center, spread, q, stages, curve, immediate)
instance(state, sample_rate, configured, config_center, config_spread, config_q, config_stages, config_curve)
local(i, position, frequency, omega, alpha, target, current, exponent) global()
(
  curve=max(-1,min(1,curve));
  immediate || !configured || center!=config_center || spread!=config_spread || q!=config_q || stages!=config_stages || curve!=config_curve ? (
  exponent=pow(4,curve);
  i=0;
  loop(128,
    position=max(-1,min(1,2*i/max(1,stages-1)-1));
    stages<=1 ? position=0;
    position=curve==0 ? position : (position<0 ? -1 : 1)*pow(abs(position),exponent);
    frequency=max(20,min(sample_rate*0.49,center*pow(2,position*max(0,min(200,spread))/100)));
    omega=2*$pi*frequency/sample_rate;
    alpha=sin(omega)/(2*max(0.1,q));
    target=state+1280+i*2;
    target[0]=(1-alpha)/(1+alpha);
    target[1]=-2*cos(omega)/(1+alpha);
    immediate ? (
      current=state+1024+i*2;
      current[0]=target[0]; current[1]=target[1];
    );
    i+=1;
  );
  configured=1;
  config_center=center; config_spread=spread; config_q=q; config_stages=stages; config_curve=curve;
  );
);

function uc_disp_channel(input, memory, stages, b0, b1, coefficients)
local(i, ptr, coeff, x1, x2, y1, y2, value, result, weight) global()
(
  value=result=input;
  i=0;
  // Run all stages even in bypass, keeping newly selected stages warm.
  loop(128,
    coefficients>0 ? (
      coeff=coefficients+i*2;
      b0=coeff[0]; b1=coeff[1];
    );
    ptr=memory+i*4;
    x1=ptr[0]; x2=ptr[1]; y1=ptr[2]; y2=ptr[3];
    value=b0*value+b1*x1+x2-b1*y1-b0*y2;
    abs(value)<0.000000001 ? value=0;
    ptr[1]=x1; ptr[0]=input;
    ptr[3]=y1; ptr[2]=value;
    input=value;
    weight=max(0,min(1,stages-i));
    result+=(value-result)*weight;
    i+=1;
  );
  result;
);

function uc_disp_process(input_l, input_r, stages, resonance, b0_l, b1_l, b0_r, b1_r, enabled)
instance(state, configured, slew, current_stages, current_res, current_mix, out_l, out_r)
local(extraction, dispersed_l, dispersed_r, i, current, target, coefficients) global()
(
  current_stages+=(max(0,min(128,stages))-current_stages)*slew;
  current_res+=(max(0,min(1,resonance))-current_res)*slew;
  current_mix+=(max(0,min(1,enabled))-current_mix)*slew;
  i=0;
  loop(128,
    current=state+1024+i*2; target=state+1280+i*2;
    current[0]+=(target[0]-current[0])*slew;
    current[1]+=(target[1]-current[1])*slew;
    i+=1;
  );
  coefficients=configured ? state+1024 : 0;
  dispersed_l=uc_disp_channel(input_l,state,current_stages,b0_l,b1_l,coefficients);
  dispersed_r=uc_disp_channel(input_r,state+512,current_stages,b0_r,b1_r,coefficients);
  // Extraction fades with the first stage; zero stages must preserve the input.
  extraction=current_res*max(0,min(1,current_stages));
  out_l=input_l+(dispersed_l-input_l-input_l*extraction)*current_mix;
  out_r=input_r+(dispersed_r-input_r-input_r*extraction)*current_mix;
);
// End Disperser DSP module.

// Comb Motion control module: independent stereo delay trajectory.
function uc_comb_motion_init(rate, initial_rate, initial_depth_ms, initial_stereo, enabled)
instance(sample_rate, phase, lfo_rate, depth, stereo, random_l, random_r, value_l, value_r, slew, read_l, read_r, center, effective_depth)
local() global()
(
  sample_rate=max(1,rate); phase=0;
  lfo_rate=max(0.02,min(20,initial_rate));
  depth=max(0,min(10,initial_depth_ms))*sample_rate/1000*max(0,min(1,enabled));
  stereo=max(0,min(180,initial_stereo))/360;
  random_l=random_r=value_l=value_r=0;
  slew=1-exp(-1/(0.01*sample_rate));
  read_l=read_r=center=1; effective_depth=0;
);
function uc_comb_motion_wave(p, shape, random_value)
instance() local(wave) global()
(
  wave=shape==0 ? sin(2*$pi*p) :
    shape==1 ? 1-4*abs(p-0.5) :
    shape==2 ? (p<0.5 ? 1 : -1) : random_value;
  wave;
);
function uc_comb_motion_process(base_samples, buffer_size, target_rate, depth_ms, stereo_degrees, shape, enabled)
instance(sample_rate, phase, lfo_rate, depth, stereo, random_l, random_r, value_l, value_r, slew, read_l, read_r, center, effective_depth)
local(wrapped, phase_r, target_l, target_r, wave_slew, max_delay) global()
(
  lfo_rate+=(max(0.02,min(20,target_rate))-lfo_rate)*slew;
  depth+=(max(0,min(10,depth_ms))*sample_rate/1000*max(0,min(1,enabled))-depth)*slew;
  stereo+=(max(0,min(180,stereo_degrees))/360-stereo)*slew;
  phase+=lfo_rate/sample_rate;
  wrapped=phase>=1;
  phase-=floor(phase);
  random_l=wrapped ? rand(2)-1 : random_l;
  random_r=wrapped ? rand(2)-1 : random_r;
  phase_r=phase+stereo; phase_r-=floor(phase_r);
  target_l=this.uc_comb_motion_wave(phase,shape,random_l);
  target_r=this.uc_comb_motion_wave(phase_r,shape,random_l+(random_r-random_l)*stereo*2);
  // Short smoothing preserves periodic depth; random motion gets a gentler glide.
  wave_slew=1-exp(-1/((shape==3 ? 0.01 : shape==2 ? 0.002 : 0.0005)*sample_rate));
  value_l+=(target_l-value_l)*wave_slew;
  value_r+=(target_r-value_r)*wave_slew;
  max_delay=max(1,buffer_size-2);
  effective_depth=min(depth,(max_delay-1)*0.5);
  // Shift the center instead of silently reducing the requested excursion.
  center=max(1+effective_depth,min(max_delay-effective_depth,base_samples));
  read_l=max(1,min(max_delay,center+value_l*effective_depth));
  read_r=max(1,min(max_delay,center+value_r*effective_depth));
);
// End Comb Motion control module.

// Dry delay DSP module: exclusive raw-input stereo history, never feedback.
function uc_dry_init(memory, size, rate, initial_ms)
instance(buffer, buffer_size, sample_rate, write_pos, delay_samples, slew, out_l, out_r)
local() global()
(
  buffer=memory; buffer_size=max(4,floor(size)); sample_rate=max(1,rate);
  memset(buffer,0,buffer_size*2);
  write_pos=out_l=out_r=0;
  delay_samples=max(0,min(buffer_size-2,initial_ms*sample_rate/1000));
  slew=1-exp(-1/(0.05*sample_rate));
);
function uc_dry_read(memory, size, position, delay_samples, channel)
instance() local(read_pos, index, fraction, output) global()
(
  read_pos=position-max(0,min(size-2,delay_samples));
  read_pos-=floor(read_pos/size)*size;
  index=floor(read_pos); fraction=read_pos-index;
  output=memory[2*index+channel]*(1-fraction)+memory[2*((index+1)%size)+channel]*fraction;
  output;
);
function uc_dry_process(input_l, input_r, delay_ms)
instance(buffer, buffer_size, sample_rate, write_pos, delay_samples, slew, out_l, out_r)
local() global()
(
  delay_samples+=(max(0,min(buffer_size-2,delay_ms*sample_rate/1000))-delay_samples)*slew;
  buffer[2*write_pos]=input_l; buffer[2*write_pos+1]=input_r;
  out_l=this.uc_dry_read(buffer,buffer_size,write_pos,delay_samples,0);
  out_r=this.uc_dry_read(buffer,buffer_size,write_pos,delay_samples,1);
  write_pos=(write_pos+1)%buffer_size;
);
// End Dry delay DSP module.

// Comb history DSP module: causal read followed by feedback commit.
function uc_comb_history_init(left_memory, right_memory, size)
instance(buffer_l, buffer_r, buffer_size, write_pos, wet_l, wet_r, tap_delay, tap_l, tap_r)
local() global()
(
  buffer_l=left_memory; buffer_r=right_memory; buffer_size=max(4,floor(size));
  memset(buffer_l,0,buffer_size); memset(buffer_r,0,buffer_size);
  write_pos=wet_l=wet_r=0;
  tap_delay=1; tap_l=tap_r=0;
);
function uc_comb_history_read_channel(memory, size, position, delay)
instance() local(read_pos, index, fraction, output) global()
(
  read_pos=position-max(1,min(size-2,delay));
  read_pos-=floor(read_pos/size)*size;
  index=floor(read_pos); fraction=read_pos-index;
  output=memory[index]*(1-fraction)+memory[(index+1)%size]*fraction;
  output;
);
function uc_comb_history_read_smooth_channel(memory, size, position, delay)
instance() local(read_pos, index, fraction, a, b, c, d, linear, cubic, support, output) global() (
  // EEL '%' truncates to integers. Wrap with floor so interpolation keeps phase.
  read_pos=position-max(1,min(size-2,delay));
  read_pos-=floor(read_pos/size)*size;
  index=floor(read_pos); fraction=read_pos-index;
  a=memory[(index+size-1)%size]; b=memory[index];
  c=memory[(index+1)%size]; d=memory[(index+2)%size];
  linear=b+(c-b)*fraction;
  cubic=b+0.5*fraction*(c-a+fraction*(2*a-5*b+4*c-d+fraction*(3*(b-c)+d-a)));
  // Fade in the four-point kernel only where every contributing sample is past.
  support=max(0,min(1,delay-2));
  output=linear+(cubic-linear)*support;
  output;
);
function uc_comb_history_read(delay_l, delay_r)
instance(buffer_l, buffer_r, buffer_size, write_pos, wet_l, wet_r)
local() global()
(
  wet_l=this.uc_comb_history_read_smooth_channel(buffer_l,buffer_size,write_pos,delay_l);
  wet_r=this.uc_comb_history_read_smooth_channel(buffer_r,buffer_size,write_pos,delay_r);
);
function uc_comb_history_tap(delay_samples, slew)
instance(buffer_l, buffer_r, buffer_size, write_pos, tap_delay, tap_l, tap_r)
local() global()
(
  tap_delay+=(max(1,min(buffer_size-2,delay_samples))-tap_delay)*slew;
  tap_l=this.uc_comb_history_read_channel(buffer_l,buffer_size,write_pos,tap_delay);
  tap_r=this.uc_comb_history_read_channel(buffer_r,buffer_size,write_pos,tap_delay);
);
function uc_comb_history_commit(input_l, input_r, feedback_l, feedback_r, feedback)
instance(buffer_l, buffer_r, buffer_size, write_pos, wet_l, wet_r)
local(gain) global()
(
  gain=max(0,min(0.95,feedback));
  buffer_l[write_pos]=max(-4,min(4,input_l+feedback_l*gain));
  buffer_r[write_pos]=max(-4,min(4,input_r+feedback_r*gain));
  write_pos=(write_pos+1)%buffer_size;
);
// End Comb history DSP module.

// Two 25 ms stages retain roughly the old 50 ms glide while smoothing velocity.
// Initialize both stages at the requested value; playback must not sweep from zero.
function uc_comb_feed_init(initial_delay, rate)
instance(stage, position, slew) local() global() (
  stage=position=max(1,initial_delay);
  slew=1-exp(-1/(0.025*max(1,rate)));
);
function uc_comb_feed_process(target)
instance(stage, position, slew) local() global() (
  stage+=(max(1,target)-stage)*slew;
  position+=(stage-position)*slew;
  position;
);

MAX_STAGES = 128;
// Metal Resonator DSP module: caller supplies exclusive state and delay memories.
function uc_metal_configure(size, decay_seconds, tone)
instance(state_memory, target_memory, ratio_memory, buffer_memory, buffer_size, sample_rate, write_pos, mix_value, slew, meter, meter_release, out_l, out_r, wet_l, wet_r, config_ready, config_size, config_decay, config_tone)
local(i, ptr, length, decay, reference_decay, cutoff, brightness) global()
(
  !config_ready || size!=config_size || decay_seconds!=config_decay || tone!=config_tone ? (
  brightness=max(0,min(1,tone));
  cutoff=min(sample_rate*0.45,500*pow(32,brightness));
  i=0;
  loop(6,
    ptr=target_memory+i*5;
    length=max(2,min(buffer_size-2,sample_rate*0.0015*max(0.25,min(4,size))*ratio_memory[i]));
    decay=max(0.03,min(3,decay_seconds))/(1+i*0.08);
    reference_decay=min(max(0.03,min(3,decay_seconds)),0.15)/(1+i*0.08);
    ptr[0]=length;
    ptr[1]=exp(-log(1000)*length/(decay*sample_rate));
    ptr[2]=1-exp(-2*$pi*cutoff/sample_rate);
    ptr[3]=exp(-i*(1-brightness)*0.25);
    // Keep excitation at the 150 ms reference above that decay, not progressively quieter.
    ptr[4]=sqrt(max(0,1-exp(-2*log(1000)*length/(reference_decay*sample_rate))));
    i+=1;
  );
  config_ready=1; config_size=size; config_decay=decay_seconds; config_tone=tone;
  );
);
function uc_metal_init(state_base, target_base, ratio_base, buffer_base, length, rate, size, decay, tone, enabled, mix)
instance(state_memory, target_memory, ratio_memory, buffer_memory, buffer_size, sample_rate, write_pos, mix_value, slew, meter, meter_release, out_l, out_r, wet_l, wet_r, dc_coeff, dc_input_l, dc_input_r, dc_output_l, dc_output_r, config_ready)
local(i) global()
(
  state_memory=state_base; target_memory=target_base; ratio_memory=ratio_base;
  buffer_memory=buffer_base; buffer_size=max(4,floor(length)); sample_rate=max(1,rate);
  memset(state_memory,0,6*12); memset(target_memory,0,6*5);
  memset(buffer_memory,0,6*2*buffer_size);
  ratio_memory[0]=1; ratio_memory[1]=1.37; ratio_memory[2]=1.91;
  ratio_memory[3]=2.63; ratio_memory[4]=3.79; ratio_memory[5]=5.17;
  write_pos=meter=out_l=out_r=wet_l=wet_r=0;
  mix_value=max(0,min(1,enabled))*max(0,min(1,mix));
  slew=1-exp(-1/(0.01*sample_rate));
  meter_release=exp(-1/(0.2*sample_rate));
  dc_coeff=exp(-2*$pi*20/sample_rate);
  dc_input_l=dc_input_r=dc_output_l=dc_output_r=0;
  config_ready=0;
  this.uc_metal_configure(size,decay,tone);
  i=0;
  loop(6, memcpy(state_memory+i*12+4,target_memory+i*5,5); i+=1;);
);
function uc_metal_limit(input)
instance() local(magnitude, shaped) global()
(
  magnitude=abs(input);
  shaped=magnitude<=0.908 ? magnitude : 0.908+0.092*(1-exp(-(magnitude-0.908)/0.092));
  shaped=input<0 ? -shaped : shaped;
  shaped;
);
function uc_metal_process(input_l, input_r, enabled, mix)
instance(state_memory, target_memory, ratio_memory, buffer_memory, buffer_size, sample_rate, write_pos, mix_value, slew, meter, meter_release, out_l, out_r, wet_l, wet_r, dc_coeff, dc_input_l, dc_input_r, dc_output_l, dc_output_r)
local(i, ptr, target, read_pos, index, fraction, next_index, left_memory, right_memory, delayed_l, delayed_r, weights, normalization) global()
(
  mix_value+=(max(0,min(1,enabled))*max(0,min(1,mix))-mix_value)*slew;
  wet_l=wet_r=weights=0; i=0;
  // All modes remain warm in bypass and own their coefficient histories.
  loop(6,
    ptr=state_memory+i*12; target=target_memory+i*5;
    ptr[4]+=(target[0]-ptr[4])*slew;
    ptr[5]+=(target[1]-ptr[5])*slew;
    ptr[6]+=(target[2]-ptr[6])*slew;
    ptr[7]+=(target[3]-ptr[7])*slew;
    ptr[8]+=(target[4]-ptr[8])*slew;
    read_pos=write_pos-ptr[4];
    read_pos-=floor(read_pos/buffer_size)*buffer_size;
    index=floor(read_pos); fraction=read_pos-index; next_index=(index+1)%buffer_size;
    left_memory=buffer_memory+i*buffer_size*2; right_memory=left_memory+buffer_size;
    delayed_l=left_memory[index]*(1-fraction)+left_memory[next_index]*fraction;
    delayed_r=right_memory[index]*(1-fraction)+right_memory[next_index]*fraction;
    ptr[0]+=(delayed_l-ptr[0])*ptr[6];
    ptr[1]+=(delayed_r-ptr[1])*ptr[6];
    // Block DC inside each recursive mode, before it can accumulate with Decay.
    ptr[2]=(ptr[0]-ptr[9])*(1+dc_coeff)*0.5+dc_coeff*ptr[2];
    ptr[3]=(ptr[1]-ptr[10])*(1+dc_coeff)*0.5+dc_coeff*ptr[3];
    ptr[9]=ptr[0]; ptr[10]=ptr[1];
    left_memory[write_pos]=input_l*ptr[8]+ptr[2]*ptr[5];
    right_memory[write_pos]=input_r*ptr[8]+ptr[3]*ptr[5];
    wet_l+=delayed_l*ptr[7]; wet_r+=delayed_r*ptr[7]; weights+=ptr[7]*ptr[7];
    i+=1;
  );
  write_pos=(write_pos+1)%buffer_size;
  normalization=1/sqrt(max(1,weights));
  wet_l*=normalization; wet_r*=normalization;
  // Protect the wet limiter from being pinned by a DC-biased external loop.
  dc_output_l=(wet_l-dc_input_l)*(1+dc_coeff)*0.5+dc_coeff*dc_output_l;
  dc_output_r=(wet_r-dc_input_r)*(1+dc_coeff)*0.5+dc_coeff*dc_output_r;
  dc_input_l=wet_l; dc_input_r=wet_r;
  wet_l=this.uc_metal_limit(dc_output_l);
  wet_r=this.uc_metal_limit(dc_output_r);
  meter=max(max(abs(wet_l),abs(wet_r)),meter*meter_release);
  out_l=input_l+(wet_l-input_l)*mix_value;
  out_r=input_r+(wet_r-input_r)*mix_value;
);
// End Metal Resonator DSP module.

METAL_OFFSET = 4000;
METAL_TARGET = 4200;
METAL_RATIOS = 4300;
METAL_MODES = 6;
METAL_BUFFER = 120000;
METAL_BUF_SIZE = 8192;
ultra_metal.uc_metal_init(METAL_OFFSET,METAL_TARGET,METAL_RATIOS,METAL_BUFFER,METAL_BUF_SIZE,srate,slider34,slider35,slider36,slider33,slider37);
atomic_set(ui_metal_on, slider33);
atomic_set(ui_metal_size, slider34);
atomic_set(ui_metal_decay, slider35);
atomic_set(ui_metal_tone, slider36);
atomic_set(ui_metal_mix, slider37);
atomic_set(ui_metal_level, 0);
atomic_set(ui_metal_contribution, 0);

// Memory layout: Disperser instance owns cells 0..1023.
ultra_disp.uc_disp_init(0, srate, slider10, slider11);

// Delay Buffer
// Comb buffers and initial delay trajectories are allocated after SDK/Chorus memory.

ring_phase = 0;
sm_ring_freq = slider25;
sm_ring_depth = slider26;
sm_ring_mix = slider24*slider27;
ultra_comb_motion.uc_comb_motion_init(srate,slider29,slider30,slider31,slider28);
fs_rand_phase = 0;
fs_phase_offset=0; fs_shared_depth=1; fs_effective_phase=0; fs_previous_phase=0;
disp_rand_phase = 0;
fs_rand_target = 0;
disp_rand_target = 0;
fs_rand_value = 0;
disp_rand_value = 0;
control_counter = 0;
CONTROL_INTERVAL = 32;
param_slew = 1 - exp(-1 / (0.01 * srate));
ultra_shift.uc_shift_init(srate, slider12, 1, slider137, slider138, slider139);
atomic_set(ui_fs_active, ultra_shift.current_hz);
smooth_ready = 0;
// @gfx has its own execution thread. Keep the LFO controls in atomic cells so
// a click is audible/visible immediately and does not wait for the next @slider.
atomic_set(ui_fs_lfo_on, slider14);
atomic_set(ui_fs_lfo_rate, slider15);
atomic_set(ui_fs_lfo_depth, slider16);
atomic_set(ui_fs_lfo_shape, slider20);
atomic_set(ui_disp_lfo_on, slider17);
atomic_set(ui_disp_lfo_rate, slider18);
atomic_set(ui_disp_lfo_depth, slider19);
atomic_set(ui_disp_lfo_shape, slider21);
atomic_set(ui_fb_tap, slider22);
atomic_set(ui_fb_extra, slider47);
atomic_set(ui_fb_saturation, slider124);
atomic_set(ui_fs_base, slider12);
atomic_set(ui_disp_base, slider7);
atomic_set(ui_plot_center, slider7);
atomic_set(ui_plot_tap_l, max(1,slider4*srate/1000));
atomic_set(ui_plot_tap_r, max(1,slider4*srate/1000));
atomic_set(ui_plot_fx, max(1,slider5*srate/1000));
atomic_set(ui_mix, slider3);
// Playback reinitialization must preserve the user's slider visibility choice.
ui_native_visible = 0;
hide_native_sliders();
ui_drag = ui_extra_drag = ui_mix_drag = ui_fb_drag = ui_was_down = ui_was_right_down = 0;
ui_touch_mask = 0;
ui_metal_touch = 0;

// Recalculate the all-pass coefficients whenever the randomized Disperser
// frequency changes. This runs at control rate, not per audio sample.
// Both LFOs consume audio-smoothed matrix values from the preceding control tick.
// Self/cross modulation is causal; parameter bases are never overwritten.
function uc_mod_linear(base,destination,scale,low,high)
(
  max(low,min(high,base+(slider113>0.5 ? MATRIX[destination]*scale : 0)));
);
function uc_mod_octaves(base,destination,scale,low,high)
(
  max(low,min(high,base*pow(2,slider113>0.5 ? MATRIX[destination]*scale : 0)));
);
function uc_matrix_lfo_init(rate,sample_rate)
instance(phase,offset,rate_hz,depth,value,output,effective_phase,previous_phase,active,random_value,sr)
global()
(
  sr=sample_rate; phase=offset=value=output=effective_phase=previous_phase=active=0;
  rate_hz=rate; depth=1; random_value=0;
);
function uc_matrix_lfo_process(enabled,target_rate,target_depth,degrees,shape,interval)
instance(phase,offset,rate_hz,depth,value,output,effective_phase,previous_phase,active,random_value,sr)
local(slew,target,glide)
global()
(
  slew=1-exp(-interval/(0.01*sr));
  rate_hz+=(max(0.000001,min(512,target_rate))-rate_hz)*slew;
  depth+=(max(0,min(100,target_depth))/100-depth)*slew;
  offset+=(max(0,min(360,degrees))/360-offset)*slew;
  phase+=enabled*rate_hz*interval/sr; phase-=floor(phase);
  effective_phase=phase+offset; effective_phase-=floor(effective_phase);
  random_value=enabled && (!active || effective_phase<previous_phase) ? rand(2)-1 : random_value;
  previous_phase=effective_phase; active=enabled;
  target=shape==0 ? sin(2*$pi*effective_phase) : shape==1 ? 2*effective_phase-1 : shape==2 ? (effective_phase<0.5 ? 1 : -1) : random_value;
  target=enabled ? target : 0;
  glide=enabled && shape==0 ? 1 : 1-exp(-interval/((enabled && shape!=3 ? 0.002 : 0.01)*sr));
  value+=(target-value)*glide; output=value*depth;
);

function update_disperser_coeffs() (
  freq_mod = slider113>0.5 ? max(20,min(srate*0.45,freq_base*pow(2,MATRIX[3]*4))) : freq_base * max(0.05, 1 + disp_rand_value * disp_rand_depth);
  atomic_set(ui_plot_center,freq_mod);
  ultra_disp.uc_disp_config(freq_mod,uc_mod_linear(slider9,21,200,0,200),Q,num_stages,uc_mod_linear(slider136,49,1,-1,1),!smooth_ready);
  // Legacy scalar coefficients remain a neutral fallback for unconfigured instances.
  freq_l = freq_mod;
  freq_r = freq_mod;
  freq_l = max(20, min(freq_l, srate * 0.49));
  freq_r = max(20, min(freq_r, srate * 0.49));

  omega_l = 2 * $pi * freq_l / srate;
  sn_l = sin(omega_l);
  cs_l = cos(omega_l);
  alpha_l = sn_l / (2 * Q);
  a0_l = 1 + alpha_l;
  a1_l = -2 * cs_l;
  a2_l = 1 - alpha_l;
  inv_a0_l = 1.0 / a0_l;
  target_b0_l = a2_l * inv_a0_l;
  target_b1_l = a1_l * inv_a0_l;

  omega_r = 2 * $pi * freq_r / srate;
  sn_r = sin(omega_r);
  cs_r = cos(omega_r);
  alpha_r = sn_r / (2 * Q);
  a0_r = 1 + alpha_r;
  a1_r = -2 * cs_r;
  a2_r = 1 - alpha_r;
  inv_a0_r = 1.0 / a0_r;
  target_b0_r = a2_r * inv_a0_r;
  target_b1_r = a1_r * inv_a0_r;
);

// Feedback safety: transparent below the threshold, then progressively
// compresses peaks. Post-FX feedback can become self-oscillating otherwise.
function feedback_saturate(x, amount) (
  threshold = max(0.08, 1 - amount * 0.92);
  magnitude = abs(x);
  amount > 0.000001 && magnitude > threshold ? (
    shaped = threshold + (1-threshold) * (1-exp(-(magnitude-threshold)/(1-threshold)));
    x < 0 ? -shaped : shaped;
  ) : x;
);

// Unity small-signal gain keeps saturation from increasing feedback loop gain.
// Remove the added drive after shaping; SAT=0 is an exact bypass.
function feedback_color(x, amount) local(drive, magnitude, exponential, shaped) (
  amount = max(0, min(1, amount));
  drive = pow(10, amount*24/20);
  magnitude = abs(x)*drive;
  exponential = exp(-2*magnitude);
  shaped = (1-exponential)/(1+exponential)/drive;
  x < 0 ? shaped = -shaped;
  x += (shaped-x)*amount;
  feedback_saturate(x, amount);
);

// Wet saturation DSP module: linked stereo RMS compensation, outside feedback coloring.
function uc_sat_init(rate, initial_amount)
instance(amount, slew, power_slew, input_power, shaped_power, compensation, out_l, out_r, drive_db, mix_value, tone, asymmetry, wsoft, wcubic, wrational, whard, tone_alpha, low_l, low_r, dc_alpha, dc_in_l, dc_in_r, dc_out_l, dc_out_r)
local() global()
(
  amount=max(0,min(1,initial_amount));
  slew=1-exp(-1/(0.01*max(1,rate)));
  power_slew=1-exp(-1/(0.02*max(1,rate)));
  input_power=shaped_power=0; compensation=1;
  out_l=out_r=0;
  drive_db=tone=asymmetry=wcubic=wrational=whard=0;mix_value=wsoft=1;
  tone_alpha=1-exp(-2*$pi*min(1500,rate*0.4)/max(1,rate));
  dc_alpha=exp(-2*$pi*10/max(1,rate));
  low_l=low_r=dc_in_l=dc_in_r=dc_out_l=dc_out_r=0;
);
function uc_sat_shape(input, drive)
instance() local(exponential, output) global()
(
  exponential=exp(-2*abs(input)*drive);
  output=(1-exponential)/(1+exponential);
  output=input<0 ? -output : output;
  output;
);
function uc_sat_transfer(input, soft_weight, cubic_weight, rational_weight, hard_weight)
instance() local(curve_x,curve_e,curve_soft,curve_cubic,curve_rational,curve_hard) global()
(
  curve_e=exp(-2*abs(input));curve_soft=(1-curve_e)/(1+curve_e);curve_soft=input<0 ? -curve_soft : curve_soft;
  curve_x=max(-1,min(1,input));curve_cubic=1.5*curve_x-0.5*curve_x*curve_x*curve_x;
  curve_rational=input/(1+abs(input));curve_hard=curve_x;
  curve_soft*soft_weight+curve_cubic*cubic_weight+curve_rational*rational_weight+curve_hard*hard_weight;
);
function uc_sat_process(input_l, input_r, target_amount, enabled, extra_drive, mix, target_tone, target_asymmetry, curve)
instance(amount, slew, power_slew, input_power, shaped_power, compensation, out_l, out_r, drive_db, mix_value, tone, asymmetry, wsoft, wcubic, wrational, whard, tone_alpha, low_l, low_r, dc_alpha, dc_in_l, dc_in_r, dc_out_l, dc_out_r)
local(drive, shaped_l, shaped_r, bias, bias_shape, dc_l, dc_r, low_gain, high_gain, blend) global()
(
  amount+=(max(0,min(1,target_amount))*max(0,min(1,enabled))-amount)*slew;
  drive_db+=(max(0,min(24,extra_drive))-drive_db)*slew;
  mix_value+=(max(0,min(1,mix))-mix_value)*slew;
  tone+=(max(-1,min(1,target_tone))-tone)*slew;
  asymmetry+=(max(-1,min(1,target_asymmetry))-asymmetry)*slew;
  wsoft+=((curve==0)-wsoft)*slew;wcubic+=((curve==1)-wcubic)*slew;
  wrational+=((curve==2)-wrational)*slew;whard+=((curve==3)-whard)*slew;
  drive=pow(10,(amount*30+drive_db)/20);bias=asymmetry*0.35;
  bias_shape=this.uc_sat_transfer(bias,wsoft,wcubic,wrational,whard);
  shaped_l=this.uc_sat_transfer(input_l*drive+bias,wsoft,wcubic,wrational,whard)-bias_shape;
  shaped_r=this.uc_sat_transfer(input_r*drive+bias,wsoft,wcubic,wrational,whard)-bias_shape;
  dc_l=shaped_l-dc_in_l+dc_alpha*dc_out_l;dc_r=shaped_r-dc_in_r+dc_alpha*dc_out_r;
  dc_in_l=shaped_l;dc_in_r=shaped_r;dc_out_l=dc_l;dc_out_r=dc_r;
  shaped_l+=(dc_l-shaped_l)*min(1,abs(asymmetry)*10);shaped_r+=(dc_r-shaped_r)*min(1,abs(asymmetry)*10);
  low_l+=(shaped_l-low_l)*tone_alpha;low_r+=(shaped_r-low_r)*tone_alpha;
  low_gain=pow(10,-tone*6/20);high_gain=pow(10,tone*6/20);
  shaped_l=low_l*low_gain+(shaped_l-low_l)*high_gain;
  shaped_r=low_r*low_gain+(shaped_r-low_r)*high_gain;
  input_power+=((input_l*input_l+input_r*input_r)*0.5-input_power)*power_slew;
  shaped_power+=((shaped_l*shaped_l+shaped_r*shaped_r)*0.5-shaped_power)*power_slew;
  compensation=max(1/drive,min(1,sqrt((input_power+0.000000000000000000000001)/(shaped_power+0.000000000000000000000001))));
  blend=amount*mix_value;
  out_l=input_l+(shaped_l*compensation-input_l)*blend;
  out_r=input_r+(shaped_r*compensation-input_r)*blend;
);
// End Wet saturation DSP module.

// Filter DSP module: Cytomic TPT SVF, Andrew Simper's equivalent-current form.
// https://www.cytomic.com/files/dsp/SvfLinearTrapOptimised2.pdf
function uc_filter_channel_reset()
instance(ic1,ic2,lp,hp,bp,notch) local() global()
(
  ic1=ic2=lp=hp=bp=notch=0;
);
function uc_filter_channel(input,a1,a2,a3,k)
instance(ic1,ic2,lp,hp,bp,notch) local(v1,v2,v3) global()
(
  v3=input-ic2; v1=a1*ic1+a2*v3; v2=ic2+a2*ic1+a3*v3;
  ic1=2*v1-ic1; ic2=2*v2-ic2;
  abs(ic1)<0.000000000001 ? ic1=0;
  abs(ic2)<0.000000000001 ? ic2=0;
  lp=v2; hp=input-k*v1-v2; bp=k*v1; notch=input-k*v1;
);
// Private feed-forward comb history: convex wet sum, no extra feedback pole.
function uc_filter_comb_read(memory,size,position,delay)
instance() local(read_pos,index,fraction,output) global()
(
  read_pos=position-max(1,min(size-2,delay));
  read_pos-=floor(read_pos/size)*size;
  // A sub-ULP negative address can round to exactly size during wrapping.
  read_pos>=size ? read_pos=0;
  index=floor(read_pos);fraction=read_pos-index;
  output=memory[index]*(1-fraction)+memory[(index+1)%size]*fraction;
  output;
);
function uc_filter_comb_init(memory,size)
instance(buffer_l,buffer_r,buffer_size,write_pos,comb_p_l,comb_p_r,comb_n_l,comb_n_r,sample_rate,active_hz)
local() global()
(
  buffer_l=memory;buffer_r=memory+size;buffer_size=size;write_pos=0;
  comb_p_l=comb_p_r=comb_n_l=comb_n_r=0;
  memset(memory,0,size*2);
  this.comb_motion.uc_comb_feed_init(sample_rate/active_hz,sample_rate);
);
function uc_filter_comb_process(input_l,input_r,target_delay,amount)
instance(buffer_l,buffer_r,buffer_size,write_pos,comb_p_l,comb_p_r,comb_n_l,comb_n_r)
local(delay,delayed_l,delayed_r,depth,normalization) global()
(
  delay=this.comb_motion.uc_comb_feed_process(max(1,min(buffer_size-2,target_delay)));
  delayed_l=this.uc_filter_comb_read(buffer_l,buffer_size,write_pos,delay);
  delayed_r=this.uc_filter_comb_read(buffer_r,buffer_size,write_pos,delay);
  depth=0.98*max(0,min(1,amount));normalization=1/(1+depth);
  comb_p_l=(input_l+depth*delayed_l)*normalization;
  comb_p_r=(input_r+depth*delayed_r)*normalization;
  comb_n_l=(input_l-depth*delayed_l)*normalization;
  comb_n_r=(input_r-depth*delayed_r)*normalization;
  buffer_l[write_pos]=input_l;buffer_r[write_pos]=input_r;
  write_pos+=1;write_pos>=buffer_size ? write_pos=0;
);
function uc_filter_init(rate,cutoff,resonance,mode)
instance(sample_rate,slew,phase,random_value,lfo_value,cut_log,res,drive,mix_value,wlp,whp,wbp,wnotch,wpeak,wvowel,wcombp,wcombn,comb_p_l,comb_p_r,comb_n_l,comb_n_r,active_hz,out_l,out_r)
local() global()
(
  sample_rate=max(1,rate); slew=1-exp(-1/(0.01*sample_rate));
  phase=random_value=lfo_value=drive=mix_value=out_l=out_r=0;
  cut_log=log(max(20,min(sample_rate*0.45,cutoff)));
  res=max(0,min(1,resonance)); active_hz=exp(cut_log);
  wlp=mode==0; whp=mode==1; wbp=mode==2; wnotch=mode==3;
  wpeak=mode==4;wvowel=mode==5;wcombp=mode==6;wcombn=mode==7;
  this.left.uc_filter_channel_reset(); this.right.uc_filter_channel_reset();
  this.vowel_left.uc_filter_channel_reset();this.vowel_right.uc_filter_channel_reset();
);
function uc_filter_process(input_l,input_r,enabled,mode,cutoff,resonance,drive_db,mix,lfo_rate,lfo_depth,lfo_shape)
instance(sample_rate,slew,phase,random_value,lfo_value,cut_log,res,drive,mix_value,wlp,whp,wbp,wnotch,wpeak,wvowel,wcombp,wcombn,comb_p_l,comb_p_r,comb_n_l,comb_n_r,active_hz,out_l,out_r)
local(target,glide,g,k,a1,a2,a3,gain,blend,shaped_l,shaped_r,wet_l,wet_r,g2,b1,b2,b3,vowel_l,vowel_r,peak_l,peak_r) global()
(
  phase+=max(0.02,min(20,lfo_rate))/sample_rate;
  phase>=1 ? (phase-=floor(phase); random_value=rand(2)-1;);
  target=0;
  lfo_shape==1 ? target=sin(2*$pi*phase);
  lfo_shape==2 ? target=1-4*abs(phase-0.5);
  lfo_shape==3 ? target=2*phase-1;
  lfo_shape==4 ? target=phase<0.5 ? 1 : -1;
  lfo_shape==5 ? target=random_value;
  glide=lfo_shape==1 || lfo_shape==2 ? 1 :
    1-exp(-1/((lfo_shape==3 || lfo_shape==4 ? 0.002 : 0.01)*sample_rate));
  lfo_value+=(target-lfo_value)*glide;
  cut_log+=(log(max(20,min(20000,cutoff)))-cut_log)*slew;
  active_hz=max(20,min(sample_rate*0.45,exp(cut_log)*pow(2,lfo_value*max(0,min(6,lfo_depth)))));
  res+=(max(0,min(1,resonance))-res)*slew;
  drive+=(max(0,min(24,drive_db))-drive)*slew;
  mix_value+=(max(0,min(1,enabled))*max(0,min(1,mix))-mix_value)*slew;
  wlp+=((mode==0)-wlp)*slew; whp+=((mode==1)-whp)*slew;
  wbp+=((mode==2)-wbp)*slew; wnotch+=((mode==3)-wnotch)*slew;
  wpeak+=((mode==4)-wpeak)*slew;wvowel+=((mode==5)-wvowel)*slew;
  wcombp+=((mode==6)-wcombp)*slew;wcombn+=((mode==7)-wcombn)*slew;
  g=tan($pi*active_hz/sample_rate); k=2/pow(40,res);
  a1=1/(1+g*(g+k)); a2=g*a1; a3=g*a2;
  gain=pow(10,drive/20); blend=min(1,drive/3);
  shaped_l=input_l*gain/sqrt(1+input_l*input_l*gain*gain);
  shaped_r=input_r*gain/sqrt(1+input_r*input_r*gain*gain);
  shaped_l=input_l+(shaped_l-input_l)*blend;
  shaped_r=input_r+(shaped_r-input_r)*blend;
  this.left.uc_filter_channel(shaped_l,a1,a2,a3,k);
  this.right.uc_filter_channel(shaped_r,a1,a2,a3,k);
  g2=tan($pi*min(sample_rate*0.45,active_hz*2.4)/sample_rate);
  b1=1/(1+g2*(g2+k));b2=g2*b1;b3=g2*b2;
  this.vowel_left.uc_filter_channel(shaped_l,b1,b2,b3,k);
  this.vowel_right.uc_filter_channel(shaped_r,b1,b2,b3,k);
  vowel_l=1.2*(this.left.bp+0.7*this.vowel_left.bp);
  vowel_r=1.2*(this.right.bp+0.7*this.vowel_right.bp);
  peak_l=shaped_l+3*res*this.left.bp;peak_r=shaped_r+3*res*this.right.bp;
  this.uc_filter_comb_process(shaped_l,shaped_r,sample_rate/active_hz,res);
  wet_l=this.left.lp*wlp+this.left.hp*whp+this.left.bp*wbp+this.left.notch*wnotch+peak_l*wpeak+vowel_l*wvowel+comb_p_l*wcombp+comb_n_l*wcombn;
  wet_r=this.right.lp*wlp+this.right.hp*whp+this.right.bp*wbp+this.right.notch*wnotch+peak_r*wpeak+vowel_r*wvowel+comb_p_r*wcombp+comb_n_r*wcombn;
  out_l=input_l+(wet_l-input_l)*mix_value;
  out_r=input_r+(wet_r-input_r)*mix_value;
);
// End Filter DSP module.
ultra_filter.uc_filter_init(srate,slider76,slider77,slider75);
atomic_set(ui_filter_hz,ultra_filter.active_hz);
ultra_sat.uc_sat_init(srate,slider23*slider125);

// Output clipper DSP module: final output only, never part of the feedback loop.
function uc_clip_init(rate,enabled,ceiling_db,soft)
instance(mix_value,ceiling,soft_mix,slew,ceiling_slew,out_l,out_r) local() global()
(
  mix_value=max(0,min(1,enabled)); soft_mix=max(0,min(1,soft));
  ceiling=pow(10,max(-24,min(0,ceiling_db))/20);
  slew=1-exp(-1/(0.002*max(1,rate)));
  ceiling_slew=1-exp(-1/(0.01*max(1,rate)));
  out_l=out_r=0;
);
function uc_clip_shape(input,ceiling,soft)
instance() local(normal,magnitude,hard,shaped) global()
(
  normal=input/ceiling; magnitude=abs(normal);
  hard=min(1,magnitude);
  shaped=magnitude<=0.8 ? magnitude : 0.8+0.2*(1-exp(-(magnitude-0.8)/0.2));
  shaped=hard+(shaped-hard)*soft;
  shaped=(input<0 ? -1 : 1)*shaped*ceiling;
  shaped;
);
function uc_clip_process(input_l,input_r,enabled,ceiling_db,soft)
instance(mix_value,ceiling,soft_mix,slew,ceiling_slew,out_l,out_r) local() global()
(
  mix_value+=(max(0,min(1,enabled))-mix_value)*slew;
  ceiling+=(pow(10,max(-24,min(0,ceiling_db))/20)-ceiling)*ceiling_slew;
  soft_mix+=(max(0,min(1,soft))-soft_mix)*slew;
  out_l=input_l+(this.uc_clip_shape(input_l,ceiling,soft_mix)-input_l)*mix_value;
  out_r=input_r+(this.uc_clip_shape(input_r,ceiling,soft_mix)-input_r)*mix_value;
);
// End Output clipper DSP module.
ultra_clip.uc_clip_init(srate,slider85,slider86,slider87);

function notify_ui_slider(mask) local(new_index) (
  sync_pitch_controls();
  // Publish custom-panel edits to the same atomic targets used by host automation.
  atomic_set(ui_mix, slider3);
  atomic_set(ui_disp_base, slider7);
  atomic_set(ui_fs_base, slider12);
  atomic_set(ui_fs_lfo_on, slider14);
  atomic_set(ui_fs_lfo_rate, slider15);
  atomic_set(ui_fs_lfo_depth, slider16);
  atomic_set(ui_disp_lfo_on, slider17);
  atomic_set(ui_disp_lfo_rate, slider18);
  atomic_set(ui_disp_lfo_depth, slider19);
  atomic_set(ui_fs_lfo_shape, slider20);
  atomic_set(ui_disp_lfo_shape, slider21);
  atomic_set(ui_fb_tap, slider22);
  atomic_set(ui_fb_extra, slider47);
  atomic_set(ui_fb_saturation, slider124);
  atomic_set(ui_metal_on, slider33);
  atomic_set(ui_metal_size, slider34);
  atomic_set(ui_metal_decay, slider35);
  atomic_set(ui_metal_tone, slider36);
  atomic_set(ui_metal_mix, slider37);
  // Use slider references for parameters above 32, independent of mask width.
  mask == 2^32 ? (sliderchange(slider33); slider_automate(slider33););
  mask == 2^33 ? (sliderchange(slider34); slider_automate(slider34););
  mask == 2^34 ? (sliderchange(slider35); slider_automate(slider35););
  mask == 2^35 ? (sliderchange(slider36); slider_automate(slider36););
  mask == 2^36 ? (sliderchange(slider37); slider_automate(slider37););
  mask == 2^37 ? (sliderchange(slider38); slider_automate(slider38););
  mask == 2^38 ? (sliderchange(slider39); slider_automate(slider39););
  mask == 2^39 ? (sliderchange(slider40); slider_automate(slider40););
  mask == 2^40 ? (sliderchange(slider41); slider_automate(slider41););
  mask == 2^41 ? (sliderchange(slider42); slider_automate(slider42););
  mask == 2^42 ? (sliderchange(slider43); slider_automate(slider43););
  mask == 2^43 ? (sliderchange(slider44); slider_automate(slider44););
  mask == 2^44 ? (sliderchange(slider45); slider_automate(slider45););
  mask == 2^45 ? (sliderchange(slider46); slider_automate(slider46););
  mask == 2^46 ? (sliderchange(slider47); slider_automate(slider47););
  mask == 2^47 ? (sliderchange(slider48); slider_automate(slider48););
  mask == 2^48 ? (sliderchange(slider49); slider_automate(slider49););
