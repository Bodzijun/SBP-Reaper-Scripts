// UltraComb registers streams and commands, but no durable SDK state/resource
// banks. Keep the SDK's empty v2 record compatible without taking its state-bank
// gate: there are no banks to copy, and recompilation may interrupt a gate owner.
function uc_web_serialize() local(reading, valid) (
  reaweb_jsfx_state_count>0 || reaweb_jsfx_resource_count>0 ? (
    reaweb_jsfx_serialize(0,0,0);
  ) : (
    reading=file_avail(0)>=0;
    !reading ? (
      #uc_web_serial="";
      str_setchar(#uc_web_serial,0,1381452337,'Iu');
      str_setchar(#uc_web_serial,4,2,'Iu');
      str_setchar(#uc_web_serial,8,0,'Iu');
    );
    file_string(0,#uc_web_serial);
    valid=strlen(#uc_web_serial)==12 && str_getchar(#uc_web_serial,0,'Iu')==1381452337 &&
      str_getchar(#uc_web_serial,4,'Iu')==2 && str_getchar(#uc_web_serial,8,'Iu')==0;
    reading ? (
      reaweb_jsfx_reply_pending=0;
      reaweb_jsfx_epoch=atomic_add(gmem[reaweb_jsfx_base+1],1);
    );
    reaweb_jsfx_serialize_error=!valid;
    valid;
  );
);

function sync_pitch_controls() (
  atomic_set(ui_extra60, slider60);
  atomic_set(ui_extra61, slider61);
  atomic_set(ui_extra62, slider62);
  atomic_set(ui_extra63, slider63);
  atomic_set(ui_extra64, slider64);
  atomic_set(ui_extra59, slider59);
  atomic_set(ui_extra48, slider48);
  atomic_set(ui_extra49, slider49);
  atomic_set(ui_extra50, slider50);
  atomic_set(ui_extra51, slider51);
  atomic_set(ui_extra52, slider52);
  atomic_set(ui_extra53, slider53);
  atomic_set(ui_extra54, slider54);
  atomic_set(ui_extra55, slider55);
  atomic_set(ui_extra56, slider56);
  atomic_set(ui_extra57, slider57);
  atomic_set(ui_extra58, slider58);
  atomic_set(ui_extra68, slider68);
  atomic_set(ui_extra69, slider69);
  atomic_set(ui_extra70, slider70);
  atomic_set(ui_extra71, slider71);
  atomic_set(ui_extra72, slider72);
  atomic_set(ui_pitch_on, slider38);
  atomic_set(ui_pitch_base, slider39);
  atomic_set(ui_pitch_depth, slider40);
  atomic_set(ui_pitch_rate, slider41);
  atomic_set(ui_pitch_glide, slider42);
  atomic_set(ui_pitch_grain, slider43);
  atomic_set(ui_pitch_mix, slider44);
  atomic_set(ui_pitch_mode, slider45);
  atomic_set(ui_pitch_threshold, slider46);
);
sync_pitch_controls();
env_level = env_pitch = env_shift = env_metal = env_double = 0;
env_attack_coeff = 1-exp(-1/(max(1, slider63)*0.001*srate));
env_release_coeff = 1-exp(-1/(max(10, slider64)*0.001*srate));
env_sensitivity = pow(10, slider62/20);
env_depth = slider61; env_target = floor(slider60+0.5);
PITCH_BUFFER = 262144;
PITCH_BUF_SIZE = max(8192, ceil(srate*0.8/64)*64);
memset(PITCH_BUFFER, 0, PITCH_BUF_SIZE);
// Pitch Motion control module: owns modulation and detector state, not host controls.
function uc_pitch_motion_init(rate, initial_semi, initial_depth, initial_rate, trigger)
instance(sample_rate, base, depth, lfo_rate, phase, envelope, armed, attack_age, fire_seen, semi, control_slew, output_slew, env_attack, env_release)
local() global()
(
  sample_rate=max(1,rate);
  base=semi=max(-24,min(24,initial_semi));
  depth=max(-24,min(24,initial_depth));
  lfo_rate=max(0.02,min(12,initial_rate));
  phase=envelope=0; armed=1; attack_age=10; fire_seen=trigger;
  control_slew=1-exp(-1/(0.01*sample_rate));
  output_slew=1-exp(-1/(0.0005*sample_rate));
  env_attack=1-exp(-1/(0.001*sample_rate));
  env_release=1-exp(-1/(0.025*sample_rate));
);
function uc_pitch_motion_process(level, target_base, target_depth, target_rate, glide_ms, mode, threshold_db, trigger, envelope_semi)
instance(sample_rate, base, depth, lfo_rate, phase, envelope, armed, attack_age, fire_seen, semi, control_slew, output_slew, env_attack, env_release, visual_motion)
local(duration, threshold, fired, motion, attack_shape, target) global()
(
  duration=max(0.005,min(1,glide_ms*0.001));
  base+=(max(-24,min(24,target_base))-base)*(1-exp(-1/(duration*sample_rate)));
  depth+=(max(-24,min(24,target_depth))-depth)*control_slew;
  lfo_rate+=(max(0.000001,min(512,target_rate))-lfo_rate)*control_slew;
  phase+=lfo_rate/sample_rate; phase-=floor(phase);
  threshold=pow(10,max(-60,min(0,threshold_db))/20);
  envelope+=(max(0,level)-envelope)*(level>envelope ? env_attack : env_release);
  armed=envelope<threshold*0.5 ? 1 : armed;
  fired=(mode==2 && armed && envelope>=threshold) || trigger!=fire_seen;
  armed=fired ? 0 : armed;
  attack_age=fired ? 0 : attack_age+1/sample_rate;
  fire_seen=trigger;
  // 2 ms rise and 3 ms plateau let even short attacks reach the requested depth.
  attack_shape=attack_age<0.002 ? attack_age/0.002 :
    attack_age<0.005 ? 1 : max(0,1-(attack_age-0.005)/duration);
  motion=mode==1 ? sin(2*$pi*phase) : mode==2 ? attack_shape : 0;
  visual_motion=motion;
  target=max(-24,min(24,base+depth*motion+envelope_semi));
  semi+=(target-semi)*output_slew;
);
// End Pitch Motion control module.

function uc_adr_midi_note(status,velocity)
local() global() instance()
(
  (status & $xF0)==$x90 && velocity>0;
);
// Three-segment ADR control source: 0 -> peak -> bend level -> 0, no held sustain.
function uc_adr_init(rate, attack_ms, decay_ms, bend, release_ms, attack_curve, decay_curve, release_curve, trigger)
instance(sample_rate, attack, decay, knee, release, exponent_a, exponent_d, exponent_r, slew, stage, elapsed, age, start_value, release_start, output, phase, detector, armed, fire_seen, last_mode, last_ping_pong, env_attack, env_release, threshold_cached, threshold_level)
local() global()
(
  sample_rate=max(1,rate);slew=1-exp(-1/(0.01*sample_rate));
  attack=max(1,min(3600000,attack_ms))*0.001;decay=max(1,min(3600000,decay_ms))*0.001;
  knee=max(0,min(1,bend));release=max(1,min(3600000,release_ms))*0.001;
  exponent_a=pow(4,max(-1,min(1,attack_curve)));
  exponent_d=pow(4,max(-1,min(1,decay_curve)));
  exponent_r=pow(4,max(-1,min(1,release_curve)));
  stage=elapsed=age=start_value=release_start=output=phase=detector=last_mode=last_ping_pong=0;
  armed=1;fire_seen=trigger;
  threshold_cached=999;threshold_level=0;
  env_attack=1-exp(-1/(0.001*sample_rate));env_release=1-exp(-1/(0.025*sample_rate));
);
function uc_adr_process(level, mode, threshold_db, attack_ms, decay_ms, bend, release_ms, attack_exponent, decay_exponent, release_exponent, loop_direction, trigger)
instance(sample_rate, attack, decay, knee, release, exponent_a, exponent_d, exponent_r, slew, stage, elapsed, age, start_value, release_start, output, phase, detector, armed, fire_seen, last_mode, last_ping_pong, env_attack, env_release, threshold_cached, threshold_level)
local(threshold, fired, progress, shaped, total, ping_pong) global()
(
  attack+=(max(1,min(3600000,attack_ms))*0.001-attack)*slew;
  decay+=(max(1,min(3600000,decay_ms))*0.001-decay)*slew;
  knee+=(max(0,min(1,bend))-knee)*slew;
  release+=(max(1,min(3600000,release_ms))*0.001-release)*slew;
  exponent_a+=(max(0.25,min(4,attack_exponent))-exponent_a)*slew;
  exponent_d+=(max(0.25,min(4,decay_exponent))-exponent_d)*slew;
  exponent_r+=(max(0.25,min(4,release_exponent))-exponent_r)*slew;
  detector+=(max(0,level)-detector)*(level>detector ? env_attack : env_release);
  threshold_db!=threshold_cached ? (threshold_cached=threshold_db;threshold_level=pow(10,max(-60,min(0,threshold_db))/20););
  threshold=threshold_level;
  detector<threshold*0.5 ? armed=1;
  ping_pong=mode==3 && loop_direction>0.5;
  mode!=last_mode || ping_pong!=last_ping_pong ? (stage=0;elapsed=age=output=0;);
  fired=(mode==1 && armed && detector>=threshold) || (mode>0 && trigger!=fire_seen) || (mode==3 && stage==0);
  fired ? (start_value=output;stage=1;elapsed=age=0;armed=0;);
  fire_seen=trigger;last_mode=mode;last_ping_pong=ping_pong;
  mode==0 ? (stage=0;output=phase=age=0;) : (
    stage==1 ? (
      progress=max(0,min(1,elapsed/attack));
      shaped=abs(exponent_a-1)<0.000001 ? progress : pow(progress,exponent_a);
      output=start_value+(1-start_value)*shaped;
      elapsed+=1/sample_rate;
      elapsed>=attack ? (stage=2;elapsed=0;);
    ) : stage==2 ? (
      progress=max(0,min(1,elapsed/decay));
      shaped=abs(exponent_d-1)<0.000001 ? progress : pow(progress,exponent_d);
      output=1+(knee-1)*shaped;
      elapsed+=1/sample_rate;
      elapsed>=decay ? (stage=3;elapsed=0;release_start=knee;);
    ) : stage==3 ? (
      progress=max(0,min(1,elapsed/release));
      shaped=abs(exponent_r-1)<0.000001 ? progress : pow(progress,exponent_r);
      output=release_start*(1-shaped);
      elapsed+=1/sample_rate;
      elapsed>=release ? (stage=ping_pong ? 4 : 0;elapsed=0;output=0;);
    ) : stage==4 ? (
      // Read Release backwards with its original curve (not an inverted output).
      progress=max(0,min(1,1-elapsed/release));
      shaped=abs(exponent_r-1)<0.000001 ? progress : pow(progress,exponent_r);
      output=release_start*(1-shaped);
      elapsed+=1/sample_rate;
      elapsed>=release ? (stage=5;elapsed=0;);
    ) : stage==5 ? (
      progress=max(0,min(1,1-elapsed/decay));
      shaped=abs(exponent_d-1)<0.000001 ? progress : pow(progress,exponent_d);
      output=1+(knee-1)*shaped;
      elapsed+=1/sample_rate;
      elapsed>=decay ? (stage=6;elapsed=0;);
    ) : stage==6 ? (
      progress=max(0,min(1,1-elapsed/attack));
      shaped=abs(exponent_a-1)<0.000001 ? progress : pow(progress,exponent_a);
      output=shaped;
      elapsed+=1/sample_rate;
      elapsed>=attack ? (stage=1;elapsed=age=start_value=output=0;);
    );
    total=attack+decay+release;
    age=stage>0 ? min(ping_pong ? 2*total : total,age+1/sample_rate) : age;
    phase=stage>0 ? max(0,min(1,(ping_pong && stage>=4 ? 2*total-age : age)/max(0.003,total))) : 1;
  );
  output=max(0,min(1,output));
);
// End ADR control source.

// Spectral Pitch DSP module: duration-preserving STFT, adapted from smbPitchShift.
// Copyright 1999-2009 Stephan M. Bernsee.
// Source: https://github.com/zonble/ZBSimplePlayer/blob/master/SimplePlayer/smbPitchShift.cpp
// The Wide Open License (WOL)
// Permission to use, copy, modify, distribute and sell this software and its
// documentation for any purpose is hereby granted without fee, provided that
// the above copyright notice and this license appear in all source copies.
// THIS SOFTWARE IS PROVIDED "AS IS" WITHOUT EXPRESS OR IMPLIED WARRANTY OF
// ANY KIND. See http://www.dspguru.com/wol.htm for more information.
function uc_spectral_init(memory, size, rate)
instance(n, hop, bins, sample_rate, input_mem, ola_mem, fft_mem, last_phase,
  sum_phase, syn_mag, syn_freq, syn_re, syn_im, prev_mag, window_mem,
  input_pos, output_pos, clock, level, dry, output)
local(k) global()
(
  n=size; hop=n/8; bins=n/2+1; sample_rate=rate;
  input_mem=memory; ola_mem=memory+n;
  // Each FFT workspace starts on its own 65536-item page.
  fft_mem=memory+65536;
  last_phase=memory+3*n; sum_phase=last_phase+bins;
  syn_mag=sum_phase+bins; syn_freq=syn_mag+bins;
  syn_re=syn_freq+bins; syn_im=syn_re+bins;
  prev_mag=syn_im+bins; window_mem=prev_mag+bins;
  memset(memory,0,16*n);
  memset(fft_mem,0,2*n);
  k=0; loop(n,window_mem[k]=0.5-0.5*cos(2*$pi*k/n); k+=1;);
  input_pos=output_pos=clock=level=dry=output=0;
);
function uc_spectral_frame(ratio, recovery_ms)
instance(n, hop, bins, sample_rate, input_mem, ola_mem, fft_mem, last_phase,
  sum_phase, syn_mag, syn_freq, syn_re, syn_im, prev_mag, window_mem,
  input_pos, output_pos, level)
local(k, pos, real, imag, magnitude, phase, delta, frequency, target,
  expected, total, flux, onset, angle)
global()
(
  k=0;
  loop(n,
    pos=(input_pos+k)%n;
    fft_mem[2*k]=input_mem[pos]*window_mem[k]; fft_mem[2*k+1]=0;
    k+=1;
  );
  fft(fft_mem,n); fft_permute(fft_mem,n);
  memset(syn_mag,0,4*bins);
  expected=2*$pi*hop/n; total=flux=0; k=0;
  loop(bins,
    real=fft_mem[2*k]; imag=fft_mem[2*k+1];
    magnitude=sqrt(real*real+imag*imag); phase=atan2(imag,real);
    delta=phase-last_phase[k]-k*expected;
    delta-=2*$pi*floor((delta+$pi)/(2*$pi));
    last_phase[k]=phase;
    frequency=(k+delta/expected)*ratio;
    target=floor(k*ratio);
    target<bins ? (
      syn_mag[target]+=magnitude;
      syn_freq[target]+=magnitude*frequency;
      syn_re[target]+=real; syn_im[target]+=imag;
    );
    total+=magnitude; flux+=max(0,magnitude-prev_mag[k]);
    prev_mag[k]=magnitude; k+=1;
  );
  onset=total>0.000001 && flux>total*0.6 && total>level*1.5;
  level+=(total-level)*(1-exp(-hop/(sample_rate*max(10,min(100,recovery_ms))*0.001)));
  k=0;
  loop(bins,
    magnitude=syn_mag[k];
    frequency=magnitude>0.000000000001 ? syn_freq[k]/magnitude : k;
    angle=sum_phase[k]+frequency*expected;
    onset ? angle=atan2(syn_im[k],syn_re[k]);
    angle-=2*$pi*floor((angle+$pi)/(2*$pi)); sum_phase[k]=angle;
    fft_mem[2*k]=magnitude*cos(angle); fft_mem[2*k+1]=magnitude*sin(angle);
    k+=1;
  );
  fft_mem[1]=0; fft_mem[n+1]=0;
  k=1;
  loop(n/2-1,
    fft_mem[2*(n-k)]=fft_mem[2*k];
    fft_mem[2*(n-k)+1]=-fft_mem[2*k+1]; k+=1;
  );
  fft_ipermute(fft_mem,n); ifft(fft_mem,n);
  // Eight overlapping Hann^2 windows sum to three; inverse FFT is unnormalized.
  k=0; loop(n,
    pos=(output_pos+k)%(2*n);
    ola_mem[pos]+=fft_mem[2*k]*window_mem[k]*sqrt(max(1,ratio))/(3*n); k+=1;
  );
);
function uc_spectral_sample(input, ratio, recovery_ms)
instance(n, hop, input_mem, ola_mem, input_pos, output_pos, clock, dry, output)
local() global()
(
  dry=input_mem[input_pos]; input_mem[input_pos]=input;
  input_pos=(input_pos+1)%n;
  output=ola_mem[output_pos]; ola_mem[output_pos]=0;
  output_pos=(output_pos+1)%(2*n);
  clock+=1;
  clock>=hop ? (clock=0; this.uc_spectral_frame(ratio,recovery_ms););
);
function uc_spectral_stereo_init(memory, size, rate)
instance(enable, mix, neutral, slew, outL, outR, latency)
local() global()
(
  this.left.uc_spectral_init(memory,size,rate);
  this.right.uc_spectral_init(memory+131072,size,rate);
  enable=mix=outL=outR=0; neutral=1; latency=size;
  slew=1-exp(-1/(0.01*rate));
);
function uc_spectral_process(input_l, input_r, enabled, amount, semi, recovery_ms)
instance(enable, mix, neutral, slew, outL, outR)
local(ratio, wet_l, wet_r) global()
(
  ratio=pow(2,max(-24,min(24,semi))/12);
  this.left.uc_spectral_sample(input_l,ratio,recovery_ms);
  this.right.uc_spectral_sample(input_r,ratio,recovery_ms);
  enable+=(max(0,min(1,enabled))-enable)*slew;
  mix+=(max(0,min(1,amount))-mix)*slew;
  // Exact zero-pitch reconstruction uses the same fixed delay as the wet branch.
  neutral+=((abs(semi)<0.000001)-neutral)*slew;
  wet_l=this.left.output+(this.left.dry-this.left.output)*neutral;
  wet_r=this.right.output+(this.right.dry-this.right.output)*neutral;
  outL=input_l+(this.left.dry+(wet_l-this.left.dry)*mix-input_l)*enable;
