// @description SBP UltraComb WebUI 3
// @version 3.13.2
// @author SBP & AI
// @changelog
//   Use yellow feedback slider/capture/return accents and normal dark feedback text.
// @provides
//   sbp_ultraComb_webui.json
//   reaweb_jsfx.jsfx-inc
//   webui/packed.html
// @link
//   Source https://github.com/Bodzijun/SBP-Reaper-Scripts/tree/main/ReaWhoosh/UltraComb%20WebUI
//   ReaWebAPI https://github.com/zaibuyidao/ReaWebAPI
// @about
//   Creative stereo sound-design processor inspired by AU5's parallel-delay comb.
//   Comb / Disperser / Frequency Shift core with reorderable creative modules,
//   two assignable LFOs, Envelope/ADR sources, Morph/Randomize and live spectrograms.
//   WebUI requires ReaWebAPI 0.3.8.31 or newer, installed separately, then a REAPER restart.
//   Import https://raw.githubusercontent.com/zaibuyidao/ReaScripts/master/index.xml
//   in ReaPack and install "ReaWebAPI: Web Runtime for REAPER".
//   Keep the complete package directory together. UltraComb 2.40 is not replaced.

desc: SBP UltraComb WebUI 3
in_pin:Input L
in_pin:Input R
in_pin:Sidechain L
in_pin:Sidechain R
out_pin:Output L
out_pin:Output R
options:gmem=SBP_UltraComb_WebUI_v1
import reaweb_jsfx.jsfx-inc

