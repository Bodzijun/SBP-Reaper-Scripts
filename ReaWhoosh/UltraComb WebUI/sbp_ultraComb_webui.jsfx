      file_mem(0,MORPH_A,morph_saved_count); file_mem(0,MORPH_B,morph_saved_count);
      // New controls inherit the loaded setting at both endpoints in older projects.
      morph_seed_index=morph_saved_count;
      loop(MORPH_COUNT-morph_saved_count,
        MORPH_A[morph_seed_index]=MORPH_B[morph_seed_index]=slider(morph_seed_index+1);
        morph_seed_index+=1;
      );
      morph_state_version<8 ? (
        slider189=slider190=slider147;
        MORPH_A[188]=MORPH_A[189]=MORPH_A[146];
        MORPH_B[188]=MORPH_B[189]=MORPH_B[146];
      );
      morph_state_version<9 ? (
        slider191=0;
        MORPH_A[190]=MORPH_B[190]=0;
      );
      morph_snapshot_size=MORPH_COUNT;
      morph_storage_initialized=1;
      morph_position=max(0, min(1, morph_position));
      random_strength=max(0, min(1, random_strength));
      random_scope=max(0, min(21, floor(random_scope+0.5)));
    );
  ) : (
    // Older presets contain only the native-slider visibility flag.
    morph_a_ready=morph_b_ready=0;
  );
);
