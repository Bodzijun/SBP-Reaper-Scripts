// Read-only display feedback; never writes a slider, matrix accumulator or DSP state.
// Tempo conversions return native control targets; free sliders are never rewritten.
function uc_sync_beats(index,bars)
local(value)
(
 index=max(0,min(21,floor(index+0.5)));
 value=index==0 ? 0.041666666666666664 : index==1 ? 0.0625 : index==2 ? 0.08333333333333333 : index==3 ? 0.09375 : index==4 ? 0.125 : index==5 ? 0.16666666666666666 : index==6 ? 0.1875 : index==7 ? 0.25 : index==8 ? 0.3333333333333333 : index==9 ? 0.375 : index==10 ? 0.5 : index==11 ? 0.6666666666666666 : index==12 ? 0.75 : index==13 ? 1 : index==14 ? 1.3333333333333333 : index==15 ? 1.5 : index==16 ? 2 : index==17 ? 3 : index==18 ? 1*bars : index==19 ? 2*bars : index==20 ? 4*bars : index==21 ? 8*bars : 1;
 max(0.000001,value);
);
function uc_sync_rate(index,bpm,bars)
local(value)
(
 value=max(0.000001,min(512,bpm/(60*uc_sync_beats(index,bars))));
 value;
);
function uc_sync_ms(index,bpm,bars)
local(value)
(
 value=max(1,min(3600000,60000*uc_sync_beats(index,bars)/max(0.000001,bpm)));
 value;
);
function uc_matrix_lfo_timing(enabled,free_rate,target_depth,degrees,shape,interval,synced,division,modulation,bpm,bars,beat,running)
instance(phase,rate_hz,sr)
local(base,target,next_rate,period,position)
(
 base=synced ? uc_sync_rate(division,bpm,bars) : free_rate;
 target=max(synced ? 0.000001 : 0.02,min(synced ? 512 : 12,base*pow(2,modulation*4)));
 synced && running && abs(modulation)<0.0000001 ? (
  period=uc_sync_beats(division,bars);position=beat/period;
  next_rate=rate_hz+(target-rate_hz)*(1-exp(-interval/(0.01*sr)));
  phase=position-floor(position)-enabled*next_rate*interval/sr;
 );
 this.uc_matrix_lfo_process(enabled,target,target_depth,degrees,shape,interval);
);

function uc_sync_base(destination)
local(value)
(
 value=slider(VIS_IDS[destination]);
