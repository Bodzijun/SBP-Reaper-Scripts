  mask == 2^70 ? (sliderchange(slider71); slider_automate(slider71););
  mask == 2^71 ? (sliderchange(slider72); slider_automate(slider72););
  new_index=74;
  loop(14,
    mask==2^(new_index-1) ? (sliderchange(slider(new_index)); slider_automate(slider(new_index)););
    new_index+=1;
  );
  mask < 2^32 ? (
    sliderchange(mask);
    slider_automate(mask);
    ui_touch_mask |= mask;
  ) : ui_metal_touch = mask;
);

function reset_ui_parameter(index) (
  slider(index) != UI_DEFAULT[index-1] ? (
    slider(index)=UI_DEFAULT[index-1];
    notify_ui_slider(2^(index-1));
    slider_automate(slider(index), 1);
    sliderchange(-1);
  );
);

function panel_slider(index, lo, hi, step, x, y, width, label, unit, decimals)
local(value, next_value, norm, track_x, track_w, mask, value_x, label_w, label_h) (
  value = slider(index);
  track_x = x + 175;
  track_w = width - 195;
  value_x = x+104;
  index <= 3 || index == 13 || index == 86 ? (
    gfx_setfont(2, "Arial", 12);
    gfx_measurestr(label, label_w, label_h);
    value_x = x+label_w+8;
    track_x = value_x+60;
    track_w = max(24, x+width-18-track_x);
  );
  mouse_right_clicked && !mouse_down && mouse_x >= x && mouse_x <= track_x+track_w &&
    mouse_y >= y-4 && mouse_y <= y+17 ? (
    reset_ui_parameter(index);
    value=slider(index);
  );
  mouse_clicked && mouse_x >= track_x && mouse_x <= track_x+track_w &&
    mouse_y >= y-4 && mouse_y <= y+17 ? ui_extra_drag = index;
  mouse_down && ui_extra_drag == index ? (
    norm = max(0, min(1, (mouse_x-track_x)/track_w));
    index == 12 ? (
      norm=2*norm-1;
      next_value=hi*norm*norm*norm;
      next_value=floor(next_value/step+0.5)*step;
    ) : index == 25 ? (
      next_value=lo+(hi-lo)*norm*norm;
      next_value=lo+floor((next_value-lo)/step+0.5)*step;
    ) : index == 7 || index == 71 || index == 76 ? (
      next_value = lo*pow(hi/lo, norm);
      next_value = floor(next_value/step+0.5)*step;
    ) : next_value = lo + floor((hi-lo)*norm/step+0.5)*step;
    next_value = max(lo, min(hi, next_value));
    next_value != value ? (
      slider(index) = next_value;
      mask = 2^(index-1);
      notify_ui_slider(mask);
      value = next_value;
    );
  );
  norm = index == 7 || index == 71 || index == 76 ? log(max(lo,value)/lo)/log(hi/lo) : (value-lo)/(hi-lo);
  index==25 ? norm=sqrt(max(0,(value-lo)/(hi-lo)));
  index==12 ? norm=0.5+0.5*(value<0 ? -1 : 1)*pow(abs(value)/hi,1/3);
  norm = max(0, min(1, norm));
  gfx_setfont(2, "Arial", 12);
  gfx_set(0.70, 0.82, 0.93, 1);
  gfx_x=x; gfx_y=y; gfx_drawstr(label);
  gfx_set(0.16, 0.22, 0.29, 1);
  gfx_rect(track_x, y+5, track_w, 7, 1);
  gfx_set(ui_accent_r, ui_accent_g, ui_accent_b, 1);
  gfx_rect(track_x, y+5, track_w*norm, 7, 1);
  gfx_circle(track_x+track_w*norm, y+8.5, 4, 1);
  gfx_x=value_x; gfx_y=y;
  gfx_set(0.46, 0.65, 0.76, 1);
  (index==70 && value<=0) || (index==71 && value>=20000) ? gfx_drawstr("OFF") : (
    gfx_drawnumber(value, decimals); gfx_drawstr(unit);
  );
);

function panel_toggle(index, x, y) local(value)
(
  value = slider(index) > 0.5;
  mouse_clicked && mouse_x >= x && mouse_x <= x+58 &&
    mouse_y >= y && mouse_y <= y+22 ? (
    value = !value;
    slider(index) = value;
    notify_ui_slider(2^(index-1));
  );
  gfx_set(value ? ui_accent_r*0.65 : 0.12, value ? ui_accent_g*0.65 : 0.16, value ? ui_accent_b*0.65 : 0.20, 1);
  gfx_rect(x, y, 58, 22, 1);
  gfx_setfont(2, "Arial", 12, 'b'); gfx_set(0.93, 0.98, 1, 1);
  gfx_x=x+17; gfx_y=y+5;
  value ? gfx_drawstr("ON") : gfx_drawstr("OFF");
);

function panel_heading(x, y, width, label, r, g, b) (
  ui_accent_r = r; ui_accent_g = g; ui_accent_b = b;
  gfx_set(0.17, 0.21, 0.25, 1); gfx_rect(x, y-10, width, 1, 1);
  gfx_setfont(1, "Arial", 15, 'b'); gfx_set(r, g, b, 1);
  gfx_x=x; gfx_y=y; gfx_drawstr(label);
);

// Plot math uses gfx-owned coefficient memory, never the live audio state.
function uc_plot_prepare(center, spread, q, stages, rate)
local(i, position, frequency, omega, alpha, ptr) (
  i=0;
  loop(128,
    position=max(-1,min(1,2*i/max(1,stages-1)-1));
    stages<=1 ? position=0;
    frequency=max(20,min(rate*0.49,center*pow(2,position*spread/100)));
    omega=2*$pi*frequency/rate; alpha=sin(omega)/(2*max(0.1,q));
    ptr=242000+3*i;
    ptr[0]=(1-alpha)/(1+alpha); ptr[1]=-2*cos(omega)/(1+alpha); ptr[2]=frequency;
    i+=1;
  );
);

function uc_plot_db(frequency, rate, stages, subtract, tap_delay, fx_delay, mix, level)
local(w, c1, s1, c2, s2, i, ptr, nr, ni, dr, di, denom, ar, ai,
  hr, hi, next_r, next_i, weight, phase, fraction, tr, ti, fr, fi, real, imag) (
  w=2*$pi*frequency/rate;
  c1=cos(w); s1=-sin(w); c2=cos(2*w); s2=-sin(2*w);
  hr=1; hi=0; i=0;
  loop(min(128,ceil(stages)),
    ptr=242000+3*i;
    nr=ptr[0]+ptr[1]*c1+c2; ni=ptr[1]*s1+s2;
    dr=1+ptr[1]*c1+ptr[0]*c2; di=ptr[1]*s1+ptr[0]*s2;
    denom=max(0.00000000000000000001,dr*dr+di*di);
    ar=(nr*dr+ni*di)/denom; ai=(ni*dr-nr*di)/denom;
    next_r=hr*ar-hi*ai; next_i=hr*ai+hi*ar;
    weight=max(0,min(1,stages-i));
    hr+=(next_r-hr)*weight; hi+=(next_i-hi)*weight;
    i+=1;
  );
  hr-=subtract*max(0,min(1,stages));
  // Match the fractional linear interpolation used by both history taps.
  phase=-w*floor(tap_delay); fraction=tap_delay-floor(tap_delay);
  tr=cos(phase)*(1-fraction+fraction*c1)-sin(phase)*fraction*s1;
  ti=sin(phase)*(1-fraction+fraction*c1)+cos(phase)*fraction*s1;
  phase=-w*floor(fx_delay); fraction=fx_delay-floor(fx_delay);
  fr=cos(phase)*(1-fraction+fraction*c1)-sin(phase)*fraction*s1;
  fi=sin(phase)*(1-fraction+fraction*c1)+cos(phase)*fraction*s1;
  real=tr*(1-mix)+(fr*hr-fi*hi)*level*mix;
  imag=ti*(1-mix)+(fr*hi+fi*hr)*level*mix;
  10*log10(max(0.00000001,real*real+imag*imag));
);

function panel_disp_plot(x, y, width)
local(center, spread, q, stages, subtract, rate, tap_l, tap_r, fx, mix, level,
  high, span, plot_y, plot_h, plot_w, i, frequency, px, py, last_x, last_y,
  ptr, db, channel, marker, center_x, hover_hz, text_w, text_h) (
  center=max(20,atomic_get(ui_plot_center)); spread=slider9;
  q=slider8; stages=max(0,min(128,slider10)); subtract=slider11;
  rate=max(8000,srate); high=min(20000,rate*0.49); span=log(high/20);
  tap_l=slider28>0.5 ? max(1,atomic_get(ui_plot_tap_l)) : max(1,slider4*rate/1000);
  tap_r=slider28>0.5 ? max(1,atomic_get(ui_plot_tap_r)) : tap_l;
  fx=max(1,slider5*rate/1000); mix=slider3; level=slider13;
  uc_plot_prepare(center,spread,q,stages,rate);
  plot_y=y+16; plot_h=60; plot_w=max(1,width-1);
  gfx_setfont(2,"Arial",10); gfx_set(0.55,0.66,0.71,1);
  gfx_x=x; gfx_y=y;
  abs(atomic_get(ui_fs_active))>0.001 || slider14>0.5 || abs(slider12)>0.001 ?
    gfx_drawstr("NO SHIFT / NO FB") : gfx_drawstr("CORE / NO FB");
  gfx_x=x+width-58; gfx_drawstr("+6..-48 dB");
  gfx_set(0.04,0.065,0.08,1); gfx_rect(x,plot_y,width,plot_h,1);
  i=0;
  loop(4,
    frequency=20*pow(10,i);
    px=x+log(frequency/20)/span*plot_w;
    gfx_set(0.14,0.20,0.23,1); gfx_line(px,plot_y,px,plot_y+plot_h);
    i+=1;
  );
  gfx_line(x,plot_y+plot_h*6/54,x+plot_w,plot_y+plot_h*6/54);
  i=0;
  loop(ceil(stages),
    ptr=242000+3*i; marker=ptr[2];
    marker>=20 && marker<=high ? (
      px=x+log(marker/20)/span*plot_w;
      gfx_set(0.63,0.82,0.42,0.45); gfx_line(px,plot_y,px,plot_y+8);
    );
    i+=1;
  );
  channel=0;
  loop(abs(tap_l-tap_r)>0.01 ? 2 : 1,
    channel==0 ? gfx_set(0.26,0.83,0.89,1) : gfx_set(0.95,0.65,0.43,0.85);
    i=0;
    loop(193,
      frequency=20*exp(span*i/192);
      db=uc_plot_db(frequency,rate,stages,subtract,channel==0 ? tap_l : tap_r,fx,mix,level);
      px=x+plot_w*i/192; py=plot_y+plot_h*(6-max(-48,min(6,db)))/54;
      i>0 ? gfx_line(last_x,last_y,px,py);
      last_x=px; last_y=py; i+=1;
    );
    channel+=1;
  );
  center_x=x+max(0,min(1,log(center/20)/span))*plot_w;
  gfx_set(0.85,0.95,0.68,0.8); gfx_line(center_x,plot_y,center_x,plot_y+plot_h);
  gfx_set(0.55,0.66,0.71,1); gfx_x=x; gfx_y=plot_y+plot_h+3; gfx_drawstr("20 Hz");
  gfx_x=x+width-28; gfx_drawstr(high>=19999 ? "20k" : "Hz");
  mouse_x>=x && mouse_x<=x+plot_w && mouse_y>=plot_y && mouse_y<=plot_y+plot_h ? (
    hover_hz=20*exp(span*(mouse_x-x)/plot_w);
    gfx_set(0.9,0.95,1,0.5); gfx_line(mouse_x,plot_y,mouse_x,plot_y+plot_h);
    gfx_x=x+55; gfx_y=plot_y+plot_h+3;
    gfx_drawnumber(hover_hz,0); gfx_drawstr(" Hz  ");
    gfx_drawnumber(uc_plot_db(hover_hz,rate,stages,subtract,tap_l,fx,mix,level),1); gfx_drawstr(" dB L");
  );
);

function panel_route(x,y,width) local(slot,cell,module,choice,other,found,temp,rank,position,count) (
  route_decode_full(slider73+720*slider83,ROUTE_UI);
  gfx_set(0.12,0.23,0.23,1); gfx_rect(x,y,69,20,1);
  gfx_setfont(2,"Arial",11,'b'); gfx_set(0.52,0.88,0.87,1);
  gfx_x=x+12; gfx_y=y+4; gfx_drawstr("CORE");
  x+=72; width-=72;
  cell=width/7; slot=0;
  loop(7,
    module=ROUTE_UI[slot];
    module==0 ? strcpy(#route_label,"FREEZE");
    module==1 ? strcpy(#route_label,"PITCH");
    module==2 ? strcpy(#route_label,"DOUBLE");
    module==3 ? strcpy(#route_label,"RING");
    module==4 ? strcpy(#route_label,"METAL");
    module==5 ? strcpy(#route_label,"SAT");
    module==6 ? strcpy(#route_label,"FILTER");
    gfx_set(0.10,0.16,0.19,1); gfx_rect(x+slot*cell,y,cell-3,20,1);
    gfx_setfont(2,"Arial",11); gfx_set(0.70,0.82,0.93,1);
    gfx_x=x+slot*cell+5; gfx_y=y+4;
    gfx_drawnumber(slot+1,0); gfx_drawstr("  "); gfx_drawstr(#route_label);
    mouse_clicked && mouse_x>=x+slot*cell && mouse_x<x+(slot+1)*cell-3 && mouse_y>=y && mouse_y<=y+20 ? (
      gfx_x=x+slot*cell; gfx_y=y+20;
      choice=gfx_showmenu("Freeze|Pitch|Double|Ring|Metal|SAT|Filter");
      choice>0 ? (
        other=0; found=slot;
        loop(7,
          ROUTE_UI[other]==choice-1 ? found=other;
          other+=1;
        );
        temp=ROUTE_UI[slot]; ROUTE_UI[slot]=choice-1; ROUTE_UI[found]=temp;
        other=0; count=0; position=6;
        loop(7,
          ROUTE_UI[other]==6 ? position=other : (
            ROUTE_UI[count+8]=ROUTE_UI[other]; count+=1;
          );
          other+=1;
        );
        rank=route_encode(ROUTE_UI+8);
        rank!=slider73 ? (slider73=rank; sliderchange(slider73); slider_automate(slider73); slider_automate(slider73,1););
        position!=slider83 ? (slider83=position; sliderchange(slider83); slider_automate(slider83); slider_automate(slider83,1););
      );
    );
    mouse_right_clicked && mouse_x>=x && mouse_x<x+width && mouse_y>=y && mouse_y<=y+20 ? (
      slider73=0; sliderchange(slider73); slider_automate(slider73); slider_automate(slider73,1);
      slider83=6; sliderchange(slider83); slider_automate(slider83); slider_automate(slider83,1);
    );
    slot+=1;
  );
);

function panel_feedback_menu(x, y, width) local(mode, choice) (
  mode = slider84>0.5 ? 9 : slider59 > 0.5 ? (slider59 < 1.5 ? 1 : 3) : slider47 > 0.5 ? (
    slider47 < 1.5 ? 2 : slider47 < 2.5 ? 4 : slider47 < 3.5 ? 7 : 8;
  ) : (slider22 < 0.5 ? 0 : slider22 < 1.5 ? 5 : 6);
  mode == 0 ? strcpy(#fb_label, "PRE FX");
  mode == 1 ? strcpy(#fb_label, "POST FREEZE");
  mode == 2 ? strcpy(#fb_label, "POST PITCH");
  mode == 3 ? strcpy(#fb_label, "POST DOUBLE");
  mode == 4 ? strcpy(#fb_label, "POST RING");
  mode == 5 ? strcpy(#fb_label, "POST DISPERSER");
  mode == 6 ? strcpy(#fb_label, "POST SHIFT");
  mode == 7 ? strcpy(#fb_label, "POST METAL");
  mode == 8 ? strcpy(#fb_label, "POST SAT");
  mode == 9 ? strcpy(#fb_label, "POST FILTER");
  gfx_set(0.10, 0.15, 0.18, 1); gfx_rect(x, y, width, 22, 1);
  gfx_setfont(2, "Arial", 11, 'b'); gfx_set(0.82, 0.93, 0.95, 1);
  gfx_x=x+10; gfx_y=y+5; gfx_drawstr(#fb_label);
  gfx_x=x+width-18; gfx_drawstr("v");
  mouse_clicked && mouse_x >= x && mouse_x <= x+width && mouse_y >= y && mouse_y < y+22 ? (
    sprintf(#fb_menu, "%sPRE FX|%sPOST FREEZE|%sPOST PITCH|%sPOST DOUBLE|%sPOST RING|%sPOST DISPERSER|%sPOST SHIFT|%sPOST METAL|%sPOST SAT|%sPOST FILTER",
      mode == 0 ? "!" : "", mode == 1 ? "!" : "", mode == 2 ? "!" : "",
      mode == 3 ? "!" : "", mode == 4 ? "!" : "", mode == 5 ? "!" : "", mode == 6 ? "!" : "",
      mode == 7 ? "!" : "", mode == 8 ? "!" : "", mode == 9 ? "!" : "");
    gfx_x=x; gfx_y=y+22;
    choice = gfx_showmenu(#fb_menu)-1;
    choice >= 0 ? (
      slider84=choice==9; notify_ui_slider(2^83);
      choice<9 ? (
      slider59 = choice == 1 ? 1 : choice == 3 ? 2 : 0;
      choice == 0 || choice == 5 || choice == 6 ? (
        slider47 = 0;
        slider22 = choice == 0 ? 0 : choice == 5 ? 1 : 2;
        notify_ui_slider(2^21);
      ) : (choice != 1 && choice != 3 ? slider47 = choice == 2 ? 1 : choice == 4 ? 2 : choice == 7 ? 3 : 4;);
      );
      notify_ui_slider(2^46);
      notify_ui_slider(2^58);
    );
  );
);

function panel_choices(index, x, y, width, count, labels)
local(i, bx, bw, selected, text_width, text_height, text_length) (
  bw = width/count;
  i = 0;
  loop(count,
    bx = x+i*bw;
    mouse_clicked && mouse_x >= bx && mouse_x < bx+bw-3 &&
      mouse_y >= y && mouse_y < y+22 ? (
      index == 20 && count == 5 ? (
        slider14 = i > 0;
        i > 0 ? (
          slider20 = i-1;
          notify_ui_slider(2^19);
        );
        notify_ui_slider(2^13);
      ) : (
        slider(index) = i;
        notify_ui_slider(2^(index-1));
      );
    );
    selected = index == 20 && count == 5 ?
      (slider14 > 0.5 ? floor(slider20+0.5)+1 : 0) == i :
      floor(slider(index)+0.5) == i;
    gfx_set(selected ? ui_accent_r*0.55 : 0.10, selected ? ui_accent_g*0.55 : 0.13, selected ? ui_accent_b*0.55 : 0.17, 1);
    gfx_rect(bx, y, bw-3, 22, 1);
    gfx_setfont(2, "Arial", 11, 'b'); gfx_set(0.88, 0.93, 0.97, 1);
    text_length=9;
    while(text_length > 0 && str_getchar(labels, i*9+text_length-1) == 32) (text_length-=1;);
    strcpy_substr(#ui_choice_text, labels, i*9, text_length);
    gfx_measurestr(#ui_choice_text, text_width, text_height);
    gfx_x=bx+(bw-3-text_width)*0.5; gfx_y=y+5;
    gfx_drawstr(#ui_choice_text);
    i += 1;
  );
);

function ui_button(x, y, width, label, enabled) local(hit, tw, th) (
  hit = mouse_x >= x && mouse_x <= x+width && mouse_y >= y && mouse_y < y+22;
  gfx_set(enabled ? (hit ? 0.22 : 0.14) : 0.09, enabled ? 0.20 : 0.12, enabled ? 0.24 : 0.14, 1);
  gfx_rect(x, y, width, 22, 1);
  gfx_setfont(2, "Arial", 11, 'b');
  gfx_set(enabled ? 0.89 : 0.42, enabled ? 0.95 : 0.48, enabled ? 0.97 : 0.51, 1);
  gfx_measurestr(label, tw, th);
  gfx_x=x+(width-tw)*0.5; gfx_y=y+5; gfx_drawstr(label);
  mouse_clicked && hit && enabled;
);

function finish_bulk_touch() local(i) (
  i=0;
  loop(MORPH_COUNT,
    MORPH_CHANGED[i] ? slider_automate(slider(i+1), 1);
    MORPH_CHANGED[i]=0;
    i+=1;
  );
  ui_bulk_touch=0;
);

function store_morph_snapshot(destination) local(i) (
  i=0; loop(MORPH_COUNT, destination[i]=slider(i+1); i+=1;);
  destination == MORPH_A ? morph_a_ready=1 : morph_b_ready=1;
  morph_last_applied=slider65;
  sliderchange(-1);
);

function set_bulk_slider(index, value, publish) local(i, step) (
  i=index-1; step=MORPH_STEP[i];
  value = max(MORPH_LO[i], min(MORPH_HI[i], value));
  value = MORPH_LO[i]+floor((value-MORPH_LO[i])/step+0.5)*step;
  value = max(MORPH_LO[i], min(MORPH_HI[i], value));
  abs(value-slider(index)) > step*0.001 ? (
    slider(index)=value;
    sliderchange(slider(index));
    publish ? (
      slider_automate(slider(index));
      MORPH_CHANGED[i]=1; ui_bulk_touch=1;
    );
  );
);

function interpolate_parameter(index,a,b,position)
(
  MORPH_DISCRETE[index] ? (position<0.5 ? a : b) :
    MORPH_LOG[index] && a>0 && b>0 ? a*pow(b/a,position) : a+(b-a)*position;
);

// Matrix links retain their enum identity. Changed links fade out, switch at zero,
// then fade in; an identical link simply interpolates its signed Amount.
function morph_matrix_route(index,position,publish)
local(source_index,target_index,amount_index,polarity_index,same,endpoint,amount)
(
  source_index=matrix_source_id(index)-1; target_index=source_index+1; amount_index=source_index+2;polarity_index=171+index;
  (RANDOM_GROUP[source_index] & (2^slider188)) ? (
    same=(MORPH_A[source_index]==MORPH_B[source_index] && MORPH_A[target_index]==MORPH_B[target_index]) && MORPH_A[polarity_index]==MORPH_B[polarity_index];
    endpoint=position<0.5 ? MORPH_A : MORPH_B;
    amount=same ? MORPH_A[amount_index]+(MORPH_B[amount_index]-MORPH_A[amount_index])*position :
      position<0.5 ? MORPH_A[amount_index]*(1-2*position) : MORPH_B[amount_index]*(2*position-1);
    set_bulk_slider(source_index+1,endpoint[source_index],publish);
    set_bulk_slider(target_index+1,endpoint[target_index],publish);
    set_bulk_slider(polarity_index+1,endpoint[polarity_index],publish);
    set_bulk_slider(amount_index+1,amount,publish);
  );
);

function apply_morph(position, publish) local(i, value, group_mask) (
  morph_a_ready && morph_b_ready ? (
    morph_position=max(0, min(1, position));
    slider65=morph_position; morph_last_applied=morph_position;
    group_mask=2^slider188;
    i=0;
    loop(MORPH_COUNT,
      MORPH_ALLOWED[i] && (RANDOM_GROUP[i] & group_mask) && matrix_route_index(i+1)<0 ? (
        value=interpolate_parameter(i, MORPH_A[i], MORPH_B[i], morph_position);
        set_bulk_slider(i+1, value, publish);
      );
      i+=1;
    );
    i=0;loop(16,morph_matrix_route(i,morph_position,publish);i+=1;);
    notify_ui_slider(0);
    publish ? notify_ui_slider(2^64);
  );
);

function randomize_parameters() local(i,value,group_mask,active,route,source_index)
(
  random_strength=max(0,min(1,slider66));
  random_scope=max(0,min(21,floor(slider67+0.5)));
  group_mask=2^random_scope; i=0;
  loop(MORPH_COUNT,
    active=RANDOM_ALLOWED[i] && (RANDOM_GROUP[i] & group_mask);
    RANDOM_SYNC[i]>0 && slider(RANDOM_SYNC[i])<0.5 ? active=0;
    RANDOM_SYNC[i]<0 && slider(-RANDOM_SYNC[i])>0.5 ? active=0;
    slider113>0.5 && RANDOM_LEGACY[i] ? active=0;
    route=matrix_route_index(i+1);
    route>=0 ? (
      source_index=matrix_source_id(route);
      slider(source_index)<0.5 || slider(source_index+1)<0.5 ? active=0;
    );
    active && (random_strength>=0.5 || !MORPH_DISCRETE[i]) ? (
      value=MORPH_LOG[i] && RANDOM_LO[i]>0 ?
        RANDOM_LO[i]*pow(RANDOM_HI[i]/RANDOM_LO[i],rand(1)) :
        RANDOM_LO[i]+rand(1)*(RANDOM_HI[i]-RANDOM_LO[i]);
      MORPH_DISCRETE[i] ? value=floor(value+0.5);
      i==44 && slider113>0.5 ? value=(value<1 ? 0 : 2);
      value=interpolate_parameter(i,slider(i+1),value,random_strength);
      set_bulk_slider(i+1,value,1);
    );
    i+=1;
  );
  notify_ui_slider(0); finish_bulk_touch(); sliderchange(-1);
);

function panel_random_morph(x, y, width) local(bw, tx, tw, next_value) (
  random_strength=slider66; random_scope=floor(slider67+0.5); morph_position=slider65;
  panel_heading(x, y, width, "RANDOMIZE / MORPH", 0.73, 0.81, 0.94);
  bw=(width-12)/3;
  ui_button(x, y+28, bw, "STORE A", 1) ? store_morph_snapshot(MORPH_A);
  ui_button(x+bw+6, y+28, bw, "STORE B", 1) ? store_morph_snapshot(MORPH_B);
  ui_button(x+2*(bw+6), y+28, bw, "RANDOMIZE", random_strength > 0) ? randomize_parameters();
  gfx_setfont(2, "Arial", 11); gfx_set(0.70, 0.82, 0.93, 1);
  gfx_x=x; gfx_y=y+61; gfx_drawstr("SCOPE");
  random_scope == 0 ? strcpy(#random_scope_name, "ALL");
  random_scope == 1 ? strcpy(#random_scope_name, "PITCH");
  random_scope == 2 ? strcpy(#random_scope_name, "TONE");
  random_scope == 3 ? strcpy(#random_scope_name, "MOTION");
  ui_button(x+75, y+56, width-75, #random_scope_name, 1) ? (
    gfx_x=x+75; gfx_y=y+78;
    sprintf(#random_scope_menu, "%sALL|%sPITCH|%sTONE|%sMOTION",
      random_scope == 0 ? "!" : "", random_scope == 1 ? "!" : "",
      random_scope == 2 ? "!" : "", random_scope == 3 ? "!" : "");
    next_value=gfx_showmenu(#random_scope_menu)-1;
    next_value >= 0 ? (
      random_scope=next_value; slider67=next_value;
      notify_ui_slider(2^66); slider_automate(slider67, 1); sliderchange(-1);
    );
  );
  tx=x+150; tw=width-168;
  mouse_right_clicked && !mouse_down && mouse_x >= x && mouse_x <= tx+tw &&
    mouse_y >= y+82 && mouse_y < y+103 ? (
    reset_ui_parameter(66); random_strength=slider66;
  );
  gfx_x=x; gfx_y=y+87; gfx_drawstr("AMOUNT");
  gfx_x=x+90; gfx_drawnumber(random_strength*100, 0); gfx_drawstr("%");
  mouse_clicked && mouse_x >= tx && mouse_x <= tx+tw && mouse_y >= y+82 && mouse_y < y+103 ? ui_random_drag=1;
  ui_random_drag && mouse_down ? (
    next_value=max(0, min(1, (mouse_x-tx)/tw));
    abs(next_value-random_strength) > 0.0001 ? (
      random_strength=next_value; slider66=next_value; notify_ui_slider(2^65);
    );
  );
  gfx_set(0.16, 0.22, 0.29, 1); gfx_rect(tx, y+92, tw, 7, 1);
  gfx_set(0.73, 0.81, 0.94, 1); gfx_rect(tx, y+92, tw*random_strength, 7, 1);
  gfx_circle(tx+tw*random_strength, y+95.5, 4, 1);
  ui_button(x, y+112, 40, "A", morph_a_ready && morph_b_ready) ? (
    apply_morph(0, 1); finish_bulk_touch(); slider_automate(slider65, 1); sliderchange(-1);
  );
  ui_button(x+width-40, y+112, 40, "B", morph_a_ready && morph_b_ready) ? (
    apply_morph(1, 1); finish_bulk_touch(); slider_automate(slider65, 1); sliderchange(-1);
  );
  tx=x+54; tw=width-108;
  mouse_right_clicked && !mouse_down && mouse_x >= tx && mouse_x <= tx+tw &&
    mouse_y >= y+108 && mouse_y < y+136 ? (
    slider65=UI_DEFAULT[64];
    apply_morph(UI_DEFAULT[64], 1);
    notify_ui_slider(2^64);
    finish_bulk_touch(); slider_automate(slider65, 1);
    sliderchange(-1);
  );
  mouse_clicked && morph_a_ready && morph_b_ready && mouse_x >= tx && mouse_x <= tx+tw &&
    mouse_y >= y+108 && mouse_y < y+136 ? ui_morph_drag=1;
  ui_morph_drag && mouse_down ? (
    next_value=max(0, min(1, (mouse_x-tx)/tw));
    abs(next_value-morph_position) > 0.0001 ? apply_morph(next_value, 1);
  );
  gfx_set(0.16, 0.22, 0.29, 1); gfx_rect(tx, y+120, tw, 7, 1);
  gfx_set(morph_a_ready && morph_b_ready ? 0.73 : 0.35, 0.65, 0.87, 1);
  gfx_rect(tx, y+120, tw*morph_position, 7, 1);
  gfx_circle(tx+tw*morph_position, y+123.5, 4, 1);
  gfx_setfont(2, "Arial", 11); gfx_set(0.48, 0.60, 0.65, 1);
  gfx_x=x; gfx_y=y+144; gfx_drawstr(morph_a_ready ? "A: STORED" : "A: EMPTY");
  gfx_x=x+width-76; gfx_drawstr(morph_b_ready ? "B: STORED" : "B: EMPTY");
);


// Host controls stay outside the independently owned resonator.
function update_metal_coeffs() (
  ultra_metal.uc_metal_configure(atomic_get(ui_metal_size)*pow(2,slider113>0.5 ? MATRIX[7]*2 : env_metal*2),
    uc_mod_octaves(atomic_get(ui_metal_decay),25,3,0.03,3),uc_mod_linear(atomic_get(ui_metal_tone),26,1,0,1));
);

function panel_output_clip() local(choice,x) (
  x=gfx_w-374;
  gfx_setfont(2,"Arial",11,'b'); gfx_set(0.70,0.82,0.93,1);
  gfx_x=gfx_w-420; gfx_y=22; gfx_drawstr("CLIP");
  gfx_set(0.10,0.15,0.18,1); gfx_rect(x,15,60,22,1);
  gfx_set(0.88,0.93,0.97,1); gfx_x=x+9; gfx_y=20;
  gfx_drawstr(slider87>0.5 ? "SOFT" : "HARD");
  mouse_clicked && mouse_x>=x && mouse_x<=x+60 && mouse_y>=15 && mouse_y<37 ? (
    gfx_x=x; gfx_y=37; choice=gfx_showmenu("Hard|Soft")-1;
    choice>=0 ? (slider87=choice; notify_ui_slider(2^86););
  );
  mouse_right_clicked && mouse_x>=x && mouse_x<=x+60 && mouse_y>=15 && mouse_y<37 ? reset_ui_parameter(87);
  ui_accent_r=0.95; ui_accent_g=0.65; ui_accent_b=0.43;
  panel_slider(86,-24,0,0.1,gfx_w-300,18,210,"CEILING"," dB",1);
  panel_toggle(85,gfx_w-80,15);
);

function panel_utility(x,y,width) local(i,cell,hit) (
  gfx_set(0.16,0.22,0.25,1); gfx_line(x,y-10,x+width,y-10);
  ui_utility_view=min(1,max(0,ui_utility_view));
  cell=width/2; i=0;
  loop(2,
    i==0 ? strcpy(#utility_label,"FILTER");
    i==1 ? strcpy(#utility_label,"LFO");
    hit=mouse_x>=x+i*cell && mouse_x<x+(i+1)*cell-3 && mouse_y>=y && mouse_y<y+22;
    mouse_clicked && hit ? ui_utility_view=i;
    gfx_set(ui_utility_view==i ? 0.18 : 0.10,ui_utility_view==i ? 0.29 : 0.15,0.23,1);
    gfx_rect(x+i*cell,y,cell-3,22,1);
    gfx_setfont(2,"Arial",11,'b'); gfx_set(0.88,0.93,0.97,1);
    gfx_x=x+i*cell+5; gfx_y=y+5; gfx_drawstr(#utility_label);
    i+=1;
  );
  ui_accent_r=0.50; ui_accent_g=0.90; ui_accent_b=0.74;
  panel_choices(75,x,y+34,width-66,4,"LP       HP       BP       NOTCH    ");
  panel_toggle(74,x+width-58,y+34);
  ui_utility_view==0 ? (
    panel_slider(76,20,20000,1,x,y+64,width,"CUTOFF"," Hz",0);
    panel_slider(77,0,1,0.01,x,y+86,width,"RESONANCE","",2);
    panel_slider(78,0,24,0.1,x,y+108,width,"DRIVE"," dB",1);
    panel_slider(79,0,1,0.01,x,y+130,width,"MIX","",2);
  );
  ui_utility_view==1 ? (
    panel_choices(82,x,y+64,width,6,"NONE     SIN      TRI      SAW      SQR      RND      ");
    panel_slider(80,0.02,20,0.01,x,y+94,width,"RATE"," Hz",2);
    panel_slider(81,0,6,0.01,x,y+116,width,"DEPTH"," oct",2);
  );
    gfx_setfont(2,"Arial",11); gfx_set(0.55,0.66,0.71,1);
    gfx_x=x; gfx_y=y+152; gfx_drawstr("ACTIVE ");
    gfx_drawnumber(max(20,atomic_get(ui_filter_hz)),0); gfx_drawstr(" Hz");
);

