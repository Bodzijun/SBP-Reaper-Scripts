  mask == 2^50 ? (sliderchange(slider51); slider_automate(slider51););
  mask == 2^51 ? (sliderchange(slider52); slider_automate(slider52););
  mask == 2^52 ? (sliderchange(slider53); slider_automate(slider53););
  mask == 2^53 ? (sliderchange(slider54); slider_automate(slider54););
  mask == 2^54 ? (sliderchange(slider55); slider_automate(slider55););
  mask == 2^55 ? (sliderchange(slider56); slider_automate(slider56););
  mask == 2^56 ? (sliderchange(slider57); slider_automate(slider57););
  mask == 2^57 ? (sliderchange(slider58); slider_automate(slider58););
  mask == 2^58 ? (sliderchange(slider59); slider_automate(slider59););
  mask == 2^59 ? (sliderchange(slider60); slider_automate(slider60););
  mask == 2^60 ? (sliderchange(slider61); slider_automate(slider61););
  mask == 2^61 ? (sliderchange(slider62); slider_automate(slider62););
  mask == 2^62 ? (sliderchange(slider63); slider_automate(slider63););
  mask == 2^63 ? (sliderchange(slider64); slider_automate(slider64););
  mask == 2^64 ? (sliderchange(slider65); slider_automate(slider65););
  mask == 2^65 ? (sliderchange(slider66); slider_automate(slider66););
