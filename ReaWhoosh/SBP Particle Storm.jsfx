  ) : gfx_rect(cx+2,cy+17,max(2,(cw-4)*cv),6,1);
  gfx_set(0.90,0.95,1,1); gfx_x=cx+132; gfx_y=cy;
  ui_id == 0 ? (slider2 == 0 ? gfx_drawstr("DUST") : slider2 == 1 ? gfx_drawstr("SPRAY") : slider2 == 2 ? gfx_drawstr("CHIME") : gfx_drawstr("TRAIL")) : ui_id == 1 ? gfx_drawnumber(slider3,1) : ui_id == 2 ? gfx_drawnumber(slider4,2) : ui_id == 3 ? gfx_drawnumber(slider5,0) : ui_id == 4 ? gfx_drawnumber(slider6,0) : ui_id == 5 ? gfx_drawnumber(slider7,0) : ui_id == 6 ? gfx_drawnumber(slider8,0) : ui_id == 7 ? gfx_drawnumber(slider9,2) : ui_id == 8 ? gfx_drawnumber(slider10,1) : ui_id == 9 ? gfx_drawnumber(slider11,2) : ui_id == 10 ? gfx_drawnumber(slider12,1) : ui_id == 11 ? gfx_drawnumber(slider13,2) : ui_id == 12 ? gfx_drawnumber(slider14,2) : ui_id == 13 ? gfx_drawnumber(slider15,2) : ui_id == 14 ? gfx_drawnumber(slider17,2) : ui_id == 15 ? gfx_drawnumber(slider18,1) : ui_id == 16 ? gfx_drawnumber(slider20,2) : ui_id == 17 ? gfx_drawnumber(slider21,0) : ui_id == 19 ? gfx_drawnumber(slider22,0) : ui_id == 20 ? gfx_drawnumber(slider24,1) : (slider16 == 0 ? gfx_drawstr("ST") : gfx_drawstr("5.1"));
