// @description SBP Particle Storm
// @version 1.0.0
// @author SBP & AI
// @about
//   A transient-triggered particle tail for SBP ReaWhoosh.
//   One peak launches a decaying stream of independent grains: it is not a
//   repeated delay line. The display is a spatial map, not a decoration.
// @changelog
//   1.0.0 - Rebuilt around peak events, independent particles and a macro GUI.

desc:SBP Particle Storm (tail dress)
options:maxmem=4000000

// The controls are deliberately musical. The GUI exposes the same controls as
// macro knobs, while these sliders remain available to REAPER automation.
slider1:0<0,4,1{Manual,Dust,Spray,Chime,Trail}>Preset
slider2:0<0,3,1{Dust,Spray,Chime,Tail}>Material
slider3:-24<-48,-3,0.1>Trigger (dB)
slider4:0.55<0,1,0.01>Peak sensitivity
slider5:32<4,160,1>Density (particles/sec)
slider6:650<40,3000,1>Tail length (ms)
slider7:85<8,300,1>Grain size (ms)
slider8:90<0,600,1>Time scatter (ms)
slider9:0<-1,1,0.01>Tone (dark - bright)
slider10:0<-24,24,0.1>Pitch (semitones)
slider11:0.35<0,1,0.01>Variety
slider12:-5<-36,36,0.1>Gravity (semitones/sec)
slider13:0.45<0,1,0.01>Attraction to input
slider14:0.65<0,1,0.01>Space spread
slider15:0.38<0,1,0.01>Flight
slider20:-0.35<-1,1,0.01>Trajectory (trail - lead)
slider16:0<0,1,1{Stereo downmix,5.1 surround}>Output mode
slider17:0.60<0,1,0.01>Dry / wet
slider18:-3<-18,12,0.1>Output (dB)
slider19:0<0,1,1{Off,Reset}>Panic reset
slider21:60<10,500,1>Offset after peak (ms)
slider22:0<0,18000,10>Tail filter amount (Hz)
slider23:0<0,2,1{Off,LP,HP}>Tail filter mode
slider24:0<-24,24,0.1>Tail gravity (semitones)

in_pin:Front L
in_pin:Front R
in_pin:Center
in_pin:LFE
in_pin:Rear L
in_pin:Rear R

out_pin:Front L
out_pin:Front R
out_pin:Center
out_pin:LFE
out_pin:Rear L
out_pin:Rear R

@init
MAX_VOICES = 96;
MAX_BUF = 1000000;
buf_l = 0;
buf_r = 1050000;
write_pos = 0;
// JSFX memory is not a valid audio history until we write it. Explicitly clear
// both lanes so an early trigger can never granulate stale memory as white
// noise after a reload or an edit of the effect.
i = 0;
loop(MAX_BUF,
  buf_l[i] = 0;
  buf_r[i] = 0;
  i += 1;
);

// A separate lane for each particle property prevents accidental overlap with
// the source history. All properties are reset when a slot is re-used.
p_active = 2100000;
p_pos    = 2110000;
p_speed  = 2120000;
p_age    = 2130000;
p_dur    = 2140000;
p_att    = 2150000;
p_rel    = 2160000;
p_amp    = 2170000;
p_x      = 2180000;
p_y      = 2190000;
p_vx     = 2200000;
p_vy     = 2210000;
p_kind   = 2220000;
p_phase  = 2230000;
p_freq   = 2240000;

i = 0;
loop(MAX_VOICES,
  p_active[i] = 0;
  i += 1;
);

fast_env = slow_env = previous_fast = 0;
trigger_armed = 1;
storm_energy = 0;
tail_cloud_gain = 0;
emitter_shape = 0;
emitter_credit = 0;
pending_burst = 0;
tail_filter_phase = 0;
emitter_x = emitter_y = 0;
emitter_read_pos = 0;
event_read_pos = 0;
event_capture_samps = 0;
capture_pending = 0;
capture_countdown = 0;
// A storm is a moving stream, not a symmetric collection of independent dots.
// Its shared centre gives the ear a clear travelling gesture.
stream_x = stream_y = 0;
stream_vx = stream_vy = 0;
// Attraction follows the input only while it exists. Once the whoosh fades,
// this target remains at its last real coordinate instead of falling to the
// mathematical centre of an all-zero multichannel input.
attract_x = attract_y = 0;
attract_active = 0;
source_x = source_y = 0;
source_vx = source_vy = 0;
previous_source_x = previous_source_y = 0;
// The scope has its own fast observer: it displays the incoming panorama
// continuously, while source_x below remains the calmer motion controller.
scope_x = scope_y = 0;
scope_follow_hold = exp(-1/(srate*0.010));
// Spatial detection needs millisecond-scale energy integration, not a
// near-instant sample follower. These are separate from Flight momentum.
spatial_energy_hold = exp(-1/(srate*0.022));
spatial_follow_hold = exp(-1/(srate*0.038));
motion_vector_hold = exp(-1/(srate*0.055));
motion_energy_hold = exp(-1/(srate*0.075));
motion_vector_x = motion_vector_y = 0;
motion_energy_x = motion_energy_y = 0;
// Recent input motion in spatial coordinates. This is the physical impulse
// Flight carries into the tail once the whoosh itself is gone.
source_momentum_x = source_momentum_y = 0;
event_momentum_x = event_momentum_y = 0;
motion_memory = exp(-1/(srate*0.28));
pos_fl = pos_fr = pos_c = pos_rl = pos_rr = 0;
// ReaWhoosh may add a centred sub component to both front channels. Remove
// that low-frequency common energy from the *position detector* only; the
// audio path itself stays full-band.
spatial_lp_l = spatial_lp_r = spatial_lp_c = 0;
spatial_lp_ls = spatial_lp_rs = 0;
spatial_hp_coef = 1-exp(-2*$pi*140/srate);
ui_peak = 0;
// REAPER restores sliders before @init. Matching the stored preset here keeps
// the preset selector a one-shot starting point rather than a value that
// rewrites a user's hand-tweaks whenever the DSP is reinitialised.
active_preset = slider1;
// The custom GUI is the primary control surface. Keep only Panic in REAPER's
// standard slider list; every sound/output control has a GUI counterpart.
i=1;
loop(18,
  slider_show(2^(i-1), 0);
  i+=1;
);
slider_show(2^19 + 2^20, 0);
slider_show(2^21 + 2^22 + 2^23, 0);
lp_l = lp_r = lp_c = lp_lfe = lp_ls = lp_rs = 0;
hp_l = hp_r = hp_c = hp_lfe = hp_ls = hp_rs = 0;

// Creates one grain. Re-used slots always get a new age, envelope, trajectory
// and source offset: this is the key difference from the former repeat-delay.
function spawn_particle()
(
  slot = -1;
  i = 0;
  loop(MAX_VOICES,
    p_active[i] == 0 && slot < 0 ? slot = i;
    i += 1;
  );
  slot < 0 ? (
    // Quietest voice is safe to steal during unusually dense peak clusters.
    quiet = 1000000;
    i = 0;
    loop(MAX_VOICES,
      p_amp[i] < quiet ? (quiet = p_amp[i]; slot = i;);
      i += 1;
    );
  );

  // At zero, Variety is truly zero: useful for testing a transparent source.
  variety_semi = (rand(2)-1) * 15*variety;
  speed = pow(2, (base_pitch + variety_semi) / 12);
  // Materials remain recognisably made from the whoosh. They differ by the
  // way they traverse it, not by being four flavours of synthetic noise.
  material == 0 ? speed *= 0.72 + rand(0.24);  // Dust: slow, soft fragments
  material == 1 ? speed *= 1.0;                 // Spray: transparent source
  material == 2 ? speed *= 1.35 + rand(0.30);  // Chime: brighter, quicker cuts
  material == 3 ? speed *= 0.48 + rand(0.18);  // Trail: stretched after-image
  // The event is captured AFTER its peak. Choose a safe start inside that
  // post-peak window, then read forward; this preserves the attack/motion of
  // the whoosh rather than digging into its pre-trigger history.
  speed=max(0.25,min(4,speed));
  // We need only a small head-start, not a full grain of latency. A grain at
  // normal/slower speed safely reads the source while it continues arriving;
  // fast grains are capped just before they could catch the write head.
  duration=max(8,grain_samps);
  max_safe_speed=1+max(0,event_capture_samps-4)/duration;
  speed=min(speed,max_safe_speed);
  post_start_range=min(scatter_samps,max(0,event_capture_samps-4-duration*max(0,speed-1)));

  p_active[slot] = 1;
  p_pos[slot] = event_read_pos + rand(post_start_range);
  while(p_pos[slot] >= MAX_BUF) (
    p_pos[slot] -= MAX_BUF;
  );
  p_speed[slot] = speed;
  p_age[slot] = 0;
  p_dur[slot] = duration;
  // Long grains need proportionally longer raised-cosine fades. A fixed
  // 6–30 ms attack made a 300 ms capture arrive like a hard edit.
  fade_curve=0.10+0.16*sqrt(min(1,duration/(0.30*srate)));
  p_att[slot] = min(duration*0.42, max(0.004*srate,duration*fade_curve));
  p_rel[slot] = min(duration*0.48, max(0.006*srate,duration*(fade_curve+0.08)));
  p_amp[slot] = 0;
  p_kind[slot] = material;
  // Grains are born from the moving stream centre. Space Spread only adds
  // local width; Flight works at Spread=0 because the stream itself moves.
  p_x[slot] = stream_x + (rand(2)-1)*space_spread*0.045;
  p_y[slot] = stream_y + (rand(2)-1)*space_spread*0.030;
  p_vx[slot] = stream_vx + (rand(2)-1)*flight*(0.000004+space_spread*0.000016);
  p_vy[slot] = stream_vy + (rand(2)-1)*flight*(0.000003+space_spread*0.000011);
  p_x[slot] = max(-1, min(1, p_x[slot]));
  p_y[slot] = max(0, min(1, p_y[slot]));
);

// One source of truth for both REAPER's slider and the custom GUI. Calling it
// directly from @gfx avoids relying on a deferred @slider callback.
function apply_preset(preset)
(
  preset == 1 ? ( // Dust: soft and short, for air and texture
    slider2=0; slider3=-27; slider5=42; slider6=520; slider7=58; slider8=170;
    slider9=0.35; slider10=5; slider11=0.72; slider12=4; slider13=0.22; slider14=0.88; slider15=0.64; slider17=0.48;
    slider20=0.25; slider21=60; slider22=4500; slider23=1; slider24=3;
  ) : preset == 2 ? ( // Spray: the input stays recognisable
    slider2=1; slider3=-25; slider5=30; slider6=780; slider7=95; slider8=110;
    slider9=0.08; slider10=0; slider11=0.38; slider12=-3; slider13=0.48; slider14=0.58; slider15=0.38; slider17=0.58;
    slider20=-0.15; slider21=55; slider22=0; slider23=0; slider24=-2;
  ) : preset == 3 ? ( // Chime: small bright grains pulled into the source
    slider2=2; slider3=-29; slider5=18; slider6=1250; slider7=115; slider8=260;
    slider9=0.72; slider10=12; slider11=0.48; slider12=-9; slider13=0.78; slider14=0.72; slider15=0.34; slider17=0.52;
    slider20=-0.45; slider21=75; slider22=9000; slider23=2; slider24=-7;
  ) : preset == 4 ? ( // Trail: broad, low-energy after-image
    slider2=3; slider3=-24; slider5=38; slider6=1800; slider7=190; slider8=340;
    slider9=-0.25; slider10=-5; slider11=0.26; slider12=-12; slider13=0.55; slider14=0.82; slider15=0.22; slider17=0.65;
    slider20=0.55; slider21=90; slider22=6500; slider23=1; slider24=-12;
  );
);

@slider
// Presets are starting characters, not locked modes. Automation may take over
// immediately after a preset has been loaded.
slider1 != active_preset ? (
  active_preset = slider1;
  active_preset > 0 ? (
    apply_preset(active_preset);
    sliderchange(2^1+2^2+2^3+2^4+2^5+2^6+2^7+2^8+2^9+2^10+2^11+2^12+2^13+2^14+2^16+2^19+2^20+2^21+2^22+2^23);
  );
);

threshold = pow(10, slider3/20);
sensitivity = slider4;
density = slider5;
tail_samps = max(1, slider6*srate/1000);
grain_samps = max(8, slider7*srate/1000);
scatter_samps = slider8*srate/1000;
material = slider2;
base_pitch = slider10;
variety = slider11;
gravity_ratio = pow(2, slider12/(12*srate));
attraction = slider13 * 0.000028;
space_spread = slider14;
flight = slider15;
trajectory = slider20;
capture_after_samps = max(1, slider21*srate/1000);
tail_hp_rise = slider22;
tail_filter_mode = slider23;
tail_gravity_semis = slider24;
// Old code used 0.9992 per sample: at 48 kHz a particle effectively stopped
// in ~26 ms. This time-constant form keeps its movement alive for the tail.
// At full Flight, retained source momentum decays over several seconds rather
// than stopping halfway through a long tail.
flight_damping = exp(-1/(srate*(0.25 + 5.75*flight)));
mix = slider17;
out_gain = pow(10, slider18/20);

// Tone maps to two gentle global filters. It intentionally colours only the
// generated particles, leaving the dry whoosh intact.
tone = slider9;
// Centre is deliberately transparent. Tone to the right removes weight;
// Tone to the left darkens the particle material without touching the dry FX.
hp_hz = 20 + 3000*max(0,tone);
lp_hz = 20000 - 18500*max(0,-tone);
hp_coef = 1-exp(-2*$pi*hp_hz/srate);
lp_coef = 1-exp(-2*$pi*lp_hz/srate);

slider19 > 0 ? (
  i=0; loop(MAX_VOICES, p_active[i]=0; i+=1;);
  storm_energy=0; tail_cloud_gain=0; emitter_shape=0; emitter_credit=0; pending_burst=0; trigger_armed=1;
  tail_filter_phase=0;
  capture_pending=0; capture_countdown=0;
  stream_vx=stream_vy=0;
  source_momentum_x=source_momentum_y=0;
  event_momentum_x=event_momentum_y=0;
  source_vx=source_vy=0;
  scope_x=scope_y=0;
  motion_vector_x=motion_vector_y=0;
  motion_energy_x=motion_energy_y=0;
  pos_fl=pos_fr=pos_c=pos_rl=pos_rr=0;
  spatial_lp_l=spatial_lp_r=spatial_lp_c=spatial_lp_ls=spatial_lp_rs=0;
  slider19=0; sliderchange(2^18);
);

@sample
in_l=spl0; in_r=spl1; in_c=spl2; in_lfe=spl3; in_ls=spl4; in_rs=spl5;
mono_l = in_l + 0.707*in_c + 0.55*in_ls;
mono_r = in_r + 0.707*in_c + 0.55*in_rs;
buf_l[write_pos]=mono_l; buf_r[write_pos]=mono_r;
write_pos += 1; write_pos >= MAX_BUF ? write_pos=0;
input_peak=max(max(abs(in_l),abs(in_r)),max(abs(in_c),max(abs(in_ls),abs(in_rs))));

// Spatial decoder. Stereo uses the inverse of ReaWhoosh's cos/sin
// constant-power pan law, so its complete 180-degree L↔R path becomes -1..+1
// here. Surround uses energy vectors matching the FL/FR/RL/RR layout.
// 22 ms energy integration rejects waveform/detail flicker while still
// following an intentional ReaWhoosh pan as a continuous gesture.
spatial_lp_l+=(in_l-spatial_lp_l)*spatial_hp_coef; spatial_l=in_l-spatial_lp_l;
spatial_lp_r+=(in_r-spatial_lp_r)*spatial_hp_coef; spatial_r=in_r-spatial_lp_r;
spatial_lp_c+=(in_c-spatial_lp_c)*spatial_hp_coef; spatial_c=in_c-spatial_lp_c;
spatial_lp_ls+=(in_ls-spatial_lp_ls)*spatial_hp_coef; spatial_ls=in_ls-spatial_lp_ls;
spatial_lp_rs+=(in_rs-spatial_lp_rs)*spatial_hp_coef; spatial_rs=in_rs-spatial_lp_rs;
pos_fl=pos_fl*spatial_energy_hold+spatial_l*spatial_l*(1-spatial_energy_hold);
pos_fr=pos_fr*spatial_energy_hold+spatial_r*spatial_r*(1-spatial_energy_hold);
pos_c =pos_c *spatial_energy_hold+spatial_c*spatial_c*(1-spatial_energy_hold);
pos_rl=pos_rl*spatial_energy_hold+spatial_ls*spatial_ls*(1-spatial_energy_hold);
pos_rr=pos_rr*spatial_energy_hold+spatial_rs*spatial_rs*(1-spatial_energy_hold);
// The position follower is intentionally independent of the particle Trigger
// and raw peak level. Any non-silent smoothed channel energy is enough to
// establish L/R balance, so the source ball moves before the transient.
all_energy=pos_fl+pos_fr+pos_c+pos_rl+pos_rr;
spatial_valid=all_energy > 0.000000000001;
spatial_valid ? (
  surround_energy=pos_c+pos_rl+pos_rr;
  stereo_energy=pos_fl+pos_fr+0.000000000001;
  surround_energy > stereo_energy*0.015 ? (
    target_x=(0.55*(pos_fr-pos_fl)+0.90*(pos_rr-pos_rl))/(all_energy+0.000000000001);
    target_y=(pos_rl+pos_rr)/(all_energy+0.000000000001);
  ) : (
    // atan2 reconstructs p_x from L=cos(p_x*pi/2), R=sin(p_x*pi/2), then
    // maps p_x=0..1 to the spatial field's -1..+1.
    target_x=4*atan2(sqrt(pos_fr),sqrt(pos_fl))/$pi-1;
    target_y=0;
  );
);
// This path never waits for a particle trigger or for the tail state. It is
// deliberately faster than the physical controller so the GUI shows the
// leading, quiet part of a moving whoosh.
scope_x=scope_x*scope_follow_hold+target_x*(1-scope_follow_hold);
scope_y=scope_y*scope_follow_hold+target_y*(1-scope_follow_hold);
spatial_valid ? (
  source_x=source_x*spatial_follow_hold+target_x*(1-spatial_follow_hold);
  source_y=source_y*spatial_follow_hold+target_y*(1-spatial_follow_hold);
  raw_motion_x=source_x-previous_source_x;
  raw_motion_y=source_y-previous_source_y;
  motion_vector_x=motion_vector_x*motion_vector_hold+raw_motion_x*(1-motion_vector_hold);
  motion_vector_y=motion_vector_y*motion_vector_hold+raw_motion_y*(1-motion_vector_hold);
  motion_energy_x=motion_energy_x*motion_energy_hold+abs(raw_motion_x)*(1-motion_energy_hold);
  motion_energy_y=motion_energy_y*motion_energy_hold+abs(raw_motion_y)*(1-motion_energy_hold);
  // A weak opposite vector is normally energy jitter near a channel boundary.
  // Keep the established direction until the reversal is genuinely sustained.
  source_vx*motion_vector_x < 0 && abs(motion_vector_x) < motion_energy_x*0.70 ? source_vx*=motion_vector_hold : source_vx=motion_vector_x;
  source_vy*motion_vector_y < 0 && abs(motion_vector_y) < motion_energy_y*0.70 ? source_vy*=motion_vector_hold : source_vy=motion_vector_y;
  previous_source_x=source_x; previous_source_y=source_y;
) : (
  source_vx*=motion_vector_hold;
  source_vy*=motion_vector_hold;
);

fast_env=fast_env*0.72+input_peak*0.28;
slow_env=slow_env*0.997+input_peak*0.003;
onset=max(0,fast_env-slow_env);
// Do not update a spatial target from silence: a silent surround field is
// numerically balanced and therefore reports x=0 (centre), which is not an
// artistic instruction for a tail that was launched at the side.
input_peak > threshold*0.30 ? (
  attract_active=1;
  attract_x=source_x;
  attract_y=source_y;
  // Integrate roughly the last 280 ms of input motion. Unlike a single-frame
  // velocity reading, this survives slow panning and feels like momentum.
  source_momentum_x=source_momentum_x*motion_memory+source_vx;
  source_momentum_y=source_momentum_y*motion_memory+source_vy;
) : (
  attract_active=0;
  source_momentum_x*=motion_memory;
  source_momentum_y*=motion_memory;
);
// One peak creates one cloud. The emitter must re-arm below a lower threshold,
// so a sustained whoosh can never keep refilling the tail behind the listener.
fast_env < threshold*0.72 ? trigger_armed=1;
crossing=(fast_env >= threshold && previous_fast < threshold);
sharp=(fast_env >= threshold && onset > threshold*(0.06+0.32*(1-sensitivity)));
trigger_armed && (crossing || sharp) ? (
  emitter_x=source_x; emitter_y=source_y;
  // Mark the exact peak, then wait for actual post-peak source material.
  event_read_pos=write_pos-1;
  event_read_pos < 0 ? event_read_pos+=MAX_BUF;
  capture_countdown=capture_after_samps;
  capture_pending=1;
  event_momentum_x=source_momentum_x;
  event_momentum_y=source_momentum_y;
  trigger_armed=0;
);
previous_fast=fast_env;
ui_peak=max(ui_peak,fast_env);

capture_pending ? (
  capture_countdown-=1;
  capture_countdown <= 0 ? (
    event_capture_samps=capture_after_samps;
    capture_pending=0;
    storm_energy=1;
    tail_filter_phase=0;
    pending_burst=2+floor(3*sensitivity);
    stream_x=emitter_x; stream_y=emitter_y;
    // Flight is accumulated source momentum, not random drift. Negative
    // Trajectory leaves the stream behind; positive trajectory lets it lead.
    trajectory_scale=max(0,1+trajectory);
    stream_vx=event_momentum_x*flight*trajectory_scale*0.000070;
    stream_vy=event_momentum_y*flight*trajectory_scale*0.000050;
  );
);

// Tail is an exact duration, not an exponential time constant that can leave
// one late grain audible many seconds after the nominal Tail setting. Each
// material gets its own emission/fade character inside that fixed time.
storm_energy > 0 ? (
  tail_filter_phase=min(1,tail_filter_phase+1/tail_samps);
  tail_left=max(0,1-tail_filter_phase);
  material == 0 ? ( // Dust: a broad cloud that dissolves together
    emitter_shape=pow(tail_left,0.42); tail_cloud_gain=pow(tail_left,0.62);
  ) : material == 1 ? ( // Spray: a short burst, then a clean exit
    emitter_shape=pow(tail_left,1.45); tail_cloud_gain=pow(tail_left,1.10);
  ) : material == 2 ? ( // Chime: sparse late sparks, but no stranded tone
    emitter_shape=pow(tail_left,0.95); tail_cloud_gain=pow(tail_left,0.82);
  ) : ( // Trail: a cohesive, slow after-image
    emitter_shape=pow(tail_left,0.28); tail_cloud_gain=pow(tail_left,0.42);
  );
  storm_energy=tail_cloud_gain;
);
storm_energy > 0 ? (
  // Attraction bends the entire stream first, preserving a readable motion
  // instead of letting a symmetric particle cloud average itself to centre.
  // Attraction is a live tether, not a brake after the source disappears.
  attract_active ? (
    stream_vx+=(attract_x-stream_x)*attraction*0.18;
    stream_vy+=(attract_y-stream_y)*attraction*0.18;
  );
  stream_vx*=flight_damping; stream_vy*=flight_damping;
  stream_x+=stream_vx; stream_y+=stream_vy;
  // A tail dissipates at the edge; it must not ricochet back as a ping-pong.
  stream_x < -1 ? (stream_x=-1; stream_vx=0;);
  stream_x > 1 ? (stream_x=1; stream_vx=0;);
  stream_y < 0 ? (stream_y=0; stream_vy=0;);
  stream_y > 1 ? (stream_y=1; stream_vy=0;);
);
pending_burst > 0 ? (spawn_particle(); pending_burst-=1;);
emitter_credit += density*emitter_shape/srate;
while(emitter_credit >= 1) (spawn_particle(); emitter_credit-=1;);

sum_l=sum_r=sum_c=sum_lfe=sum_ls=sum_rs=0;
// Evaluate this once per sample, not once per active grain.
live_overlap=max(1,slider5*max(0.008,slider7/1000));
grain_energy_comp=1/sqrt(max(1,live_overlap/2.5));
i=0;
loop(MAX_VOICES,
  p_active[i] ? (
    pos=p_pos[i]; idx=floor(pos); frac=pos-idx;
    idx1=idx+1; idx1>=MAX_BUF ? idx1-=MAX_BUF;
    sig_l=buf_l[idx]*(1-frac)+buf_l[idx1]*frac;
    sig_r=buf_r[idx]*(1-frac)+buf_r[idx1]*frac;
    source_sig=(sig_l+sig_r)*0.5;
    side_sig=(sig_l-sig_r)*0.5;
    kind=p_kind[i];
    // No free-running noise is injected here. All four materials inherit the
    // whoosh's own spectral fingerprint, which is what makes this a "dress".
    kind == 0 ? particle_sig=source_sig*0.82;                    // Dust
    kind == 1 ? particle_sig=source_sig;                          // Spray
    kind == 2 ? particle_sig=source_sig*0.74+side_sig*0.34;      // Chime
    kind == 3 ? particle_sig=source_sig*0.96;                    // Trail

    age=p_age[i]; dur=p_dur[i]; att=p_att[i]; rel=p_rel[i];
    age < att ? env=0.5*(1-cos($pi*age/max(1,att))) : (
      remain=dur-age;
      remain < rel ? env=0.5*(1-cos($pi*max(0,remain)/max(1,rel))) : env=1;
    );
    p_amp[i]=env;

    // Pitch falls/rises continuously; motion is a damped physical trajectory
    // that can be pulled towards the current input position.
    p_speed[i]*=gravity_ratio;
    p_speed[i]=max(0.25,min(4,p_speed[i]));
    // Global tail gravity bends all wet grains together. It affects only
    // read speed/pitch; the fixed age clock preserves Tail duration.
    tail_gravity_factor=pow(2,(tail_gravity_semis*tail_filter_phase)/12);
    cur_spd=max(0.25,min(4,p_speed[i]*tail_gravity_factor));
    p_pos[i]+=cur_spd; p_pos[i]>=MAX_BUF ? p_pos[i]-=MAX_BUF;
    attract_active ? (
      p_vx[i]+=(attract_x-p_x[i])*attraction;
      p_vy[i]+=(attract_y-p_y[i])*attraction;
    );
    p_vx[i]*=flight_damping; p_vy[i]*=flight_damping;
    p_x[i]+=p_vx[i]; p_y[i]+=p_vy[i];
    p_x[i] < -1 ? (p_x[i]=-1; p_vx[i]=0;);
    p_x[i] > 1 ? (p_x[i]=1; p_vx[i]=0;);
    p_y[i] < 0 ? (p_y[i]=0; p_vy[i]=0;);
    p_y[i] > 1 ? (p_y[i]=1; p_vy[i]=0;);

    pan01=(p_x[i]+1)*0.5;
    gain_l=sqrt(1-pan01); gain_r=sqrt(pan01);
    rear=p_y[i]; gain_front=sqrt(1-rear); gain_rear=sqrt(rear);
    // Longer grains create more simultaneous voices at the same Density.
    // Compensate their statistical energy, so Grain changes texture rather
    // than causing a large loudness jump or clipping the wet bus.
    sample=particle_sig*env*0.58*grain_energy_comp*tail_cloud_gain;
    sum_l+=sample*gain_l*gain_front; sum_r+=sample*gain_r*gain_front;
    sum_ls+=sample*gain_l*gain_rear; sum_rs+=sample*gain_r*gain_rear;
    sum_c+=sample*0.5*gain_front; sum_lfe+=sample*0.16;
    p_age[i]+=1;
    p_age[i] >= dur ? p_active[i]=0;
  );
  i+=1;
);

// Tail filtering happens after all particles are summed. The whole wet cloud
// therefore follows one smooth tonal trajectory tied to Tail length.
filter_motion=pow(tail_filter_phase,1.5);
wet_hp_hz=hp_hz; wet_lp_hz=lp_hz;
tail_filter_mode == 1 ? wet_lp_hz=min(wet_lp_hz,max(100,20000-tail_hp_rise*filter_motion));
tail_filter_mode == 2 ? wet_hp_hz=max(wet_hp_hz,20+tail_hp_rise*filter_motion);
wet_hp_coef=1-exp(-2*$pi*wet_hp_hz/srate);
wet_lp_coef=1-exp(-2*$pi*wet_lp_hz/srate);
hp_l+=(sum_l-hp_l)*wet_hp_coef; sum_l-=hp_l; lp_l+=(sum_l-lp_l)*wet_lp_coef; sum_l=lp_l;
hp_r+=(sum_r-hp_r)*wet_hp_coef; sum_r-=hp_r; lp_r+=(sum_r-lp_r)*wet_lp_coef; sum_r=lp_r;
hp_c+=(sum_c-hp_c)*wet_hp_coef; sum_c-=hp_c; lp_c+=(sum_c-lp_c)*wet_lp_coef; sum_c=lp_c;
hp_lfe+=(sum_lfe-hp_lfe)*wet_hp_coef; sum_lfe-=hp_lfe; lp_lfe+=(sum_lfe-lp_lfe)*wet_lp_coef; sum_lfe=lp_lfe;
hp_ls+=(sum_ls-hp_ls)*wet_hp_coef; sum_ls-=hp_ls; lp_ls+=(sum_ls-lp_ls)*wet_lp_coef; sum_ls=lp_ls;
hp_rs+=(sum_rs-hp_rs)*wet_hp_coef; sum_rs-=hp_rs; lp_rs+=(sum_rs-lp_rs)*wet_lp_coef; sum_rs=lp_rs;

// These two are performance controls. Read the GUI sliders directly in the
// audio path instead of waiting for a later @slider pass after a stopped
// transport, so a drag is audible during the current playback immediately.
live_mix=max(0,min(1,slider17));
live_out_gain=pow(10,slider18/20);
out_l=in_l*(1-live_mix)+sum_l*live_mix*live_out_gain; out_r=in_r*(1-live_mix)+sum_r*live_mix*live_out_gain;
slider16 == 0 ? (
  out_l+=sum_ls*0.7*live_mix*live_out_gain; out_r+=sum_rs*0.7*live_mix*live_out_gain;
  out_c=out_lfe=out_ls=out_rs=0;
) : (
  out_c=in_c*(1-live_mix)+sum_c*live_mix*live_out_gain; out_lfe=in_lfe*(1-live_mix)+sum_lfe*live_out_gain;
  out_ls=in_ls*(1-live_mix)+sum_ls*live_mix*live_out_gain; out_rs=in_rs*(1-live_mix)+sum_rs*live_mix*live_out_gain;
);
spl0=max(-1,min(1,out_l)); spl1=max(-1,min(1,out_r)); spl2=max(-1,min(1,out_c));
spl3=max(-1,min(1,out_lfe)); spl4=max(-1,min(1,out_ls)); spl5=max(-1,min(1,out_rs));

@block
// GUI-originated slider writes are visible immediately, but some REAPER
// stopped-transport paths defer @slider. Rebuild every derived DSP value at
// block rate too, so the very first active block after a change uses the new
// Grain/Density/Force settings instead of a stale cached copy.
threshold = pow(10, slider3/20);
sensitivity = slider4;
density = slider5;
tail_samps = max(1, slider6*srate/1000);
grain_samps = max(8, slider7*srate/1000);
scatter_samps = slider8*srate/1000;
material = slider2;
base_pitch = slider10;
variety = slider11;
gravity_ratio = pow(2, slider12/(12*srate));
attraction = slider13*0.000028;
space_spread = slider14;
flight = slider15;
trajectory = slider20;
capture_after_samps = max(1,slider21*srate/1000);
tail_hp_rise=slider22;
tail_filter_mode=slider23;
tail_gravity_semis=slider24;
flight_damping = exp(-1/(srate*(0.25+5.75*flight)));
tone=slider9;
hp_hz=20+3000*max(0,tone);
lp_hz=20000-18500*max(0,-tone);
hp_coef=1-exp(-2*$pi*hp_hz/srate);
lp_coef=1-exp(-2*$pi*lp_hz/srate);
atomic_set(ui_peak,ui_peak); ui_peak=0;

@gfx 640 640
// A compact spatial instrument panel. Click the preset pill to cycle; drag a
// knob vertically. The particle field is the same x/front-rear coordinate
// system used by the audio renderer.
gfx_set(0.045,0.065,0.105,1); gfx_rect(0,0,gfx_w,gfx_h);
gfx_set(0.90,0.95,1,1); gfx_x=28; gfx_y=20; gfx_drawstr("SBP  PARTICLE STORM");
gfx_set(0.48,0.70,0.94,1); gfx_x=28; gfx_y=40; gfx_drawstr("TRANSIENT-TRIGGERED TAIL DRESS");

// Preset button
gfx_set(0.14,0.22,0.35,1); gfx_roundrect(gfx_w-160,18,130,32,8,1);
gfx_set(0.42,0.82,1,1); gfx_roundrect(gfx_w-160,18,130,32,8,0);
gfx_x=gfx_w-147; gfx_y=28; gfx_set(0.90,0.96,1,1); gfx_drawstr("PRESET: ");
slider1 == 0 ? gfx_drawstr("MANUAL") : slider1 == 1 ? gfx_drawstr("DUST") : slider1 == 2 ? gfx_drawstr("SPRAY") : slider1 == 3 ? gfx_drawstr("CHIME") : gfx_drawstr("TRAIL");

map_x=28; map_y=62; map_w=gfx_w-56; map_h=126;
gfx_set(0.085,0.125,0.19,1); gfx_roundrect(map_x,map_y,map_w,map_h,10,1);
gfx_set(0.24,0.36,0.52,1); gfx_roundrect(map_x,map_y,map_w,map_h,10,0);
space_cx=map_x+map_w*0.5; space_cy=map_y+map_h*0.5;
slider16 == 0 ? (
  // In Stereo, the horizontal axis is panorama and the vertical axis is pitch.
  // That makes this a readable particle field, not a fake surround diagram.
  gfx_set(0.14,0.23,0.34,1); gfx_line(map_x+18,space_cy,map_x+map_w-18,space_cy);
  gfx_set(0.50,0.64,0.80,1); gfx_x=map_x+12; gfx_y=map_y+11; gfx_drawstr("STEREO / L");
  gfx_x=map_x+map_w-70; gfx_y=map_y+11; gfx_drawstr("R");
  gfx_set(0.40,0.58,0.78,1); gfx_x=space_cx-35; gfx_y=map_y+11; gfx_drawstr("IN PAN "); gfx_drawnumber(target_x,2);
  gfx_set(0.34,0.47,0.66,1); gfx_x=map_x+12; gfx_y=map_y+28; gfx_drawstr("PITCH +");
  gfx_x=map_x+12; gfx_y=map_y+map_h-31; gfx_drawstr("PITCH -");
  // The scope is the decoded input itself: no emitter/trigger state sits
  // between target_x and the displayed locator.
  sx=map_x+(target_x+1)*0.5*map_w; sy=space_cy;
) : (
  // 5.1 is represented as a speaker perimeter rather than a misleading plane.
  ring_rx=map_w*0.37; ring_ry=map_h*0.36;
  gfx_set(0.14,0.23,0.34,1); ring_i=0; loop(32,
    ring_a1=ring_i*2*$pi/32; ring_a2=(ring_i+1)*2*$pi/32;
    gfx_line(space_cx+cos(ring_a1)*ring_rx,space_cy+sin(ring_a1)*ring_ry,space_cx+cos(ring_a2)*ring_rx,space_cy+sin(ring_a2)*ring_ry);
    ring_i+=1;
  );
  gfx_set(0.50,0.64,0.80,1); gfx_x=map_x+12; gfx_y=map_y+11; gfx_drawstr("5.1 SPEAKER RING");
  gfx_x=space_cx-ring_rx-14; gfx_y=space_cy-ring_ry-8; gfx_drawstr("FL"); gfx_x=space_cx+ring_rx; gfx_y=space_cy-ring_ry-8; gfx_drawstr("FR");
  gfx_x=space_cx-8; gfx_y=space_cy-ring_ry-14; gfx_drawstr("C"); gfx_x=space_cx-ring_rx-14; gfx_y=space_cy+ring_ry+4; gfx_drawstr("RL"); gfx_x=space_cx+ring_rx; gfx_y=space_cy+ring_ry+4; gfx_drawstr("RR");
  svx=target_x; svy=1-2*target_y; slen=sqrt(svx*svx+svy*svy); slen<0.001 ? (svx=0; svy=1; slen=1;);
  sx=space_cx+svx/slen*ring_rx; sy=space_cy-svy/slen*ring_ry;
);
peak_draw=min(1,atomic_get(ui_peak)*7);
gfx_set(0.15,0.58,1,0.30+peak_draw*0.65); gfx_circle(sx,sy,7+peak_draw*14,0);
gfx_set(0.45,0.84,1,1); gfx_circle(sx,sy,5,1);
// The Stereo field is a cone emitted from the input point. Its height maps to
// pitch (cool below / warm above); its width comes from Spread and Variety.
slider16 == 0 ? (
  cone_motion=abs(stream_vx)>0.000001 ? stream_vx : source_vx;
  cone_dir=cone_motion >= 0 ? 1 : -1;
  cone_depth=map_w*0.82;
  // Even a focused stream has a visible body; Spread/Variety open it right
  // across the scope instead of merely thickening the centre line.
  cone_width=map_h*(0.18+0.37*max(space_spread,variety));
  flow_x=sx; flow_y=sy; flow_dx=cone_dir;
) : (
  fvx=stream_x; fvy=1-2*stream_y; flen=sqrt(fvx*fvx+fvy*fvy); flen<0.001 ? (fvx=0; fvy=1; flen=1;);
  flow_x=space_cx+fvx/flen*ring_rx; flow_y=space_cy-fvy/flen*ring_ry;
  flow_dx=stream_vx*ring_rx;
);
storm_energy > 0.00015 ? (
  slider16 == 0 ? (
    flow_i=0; loop(34,
      // Two fixed seeds form a stable, full-area cloud rather than a blinking line.
      flow_seed=sin((flow_i+1)*71.83)*43758.545; flow_seed-=floor(flow_seed);
      flow_seed2=sin((flow_i+1)*19.17)*24634.635; flow_seed2-=floor(flow_seed2);
      flow_age=0.04+flow_seed*0.92;
      fx=sx-cone_dir*flow_age*cone_depth;
      fw=4+flow_age*cone_width;
      fy=space_cy+(flow_seed2-0.5)*2*fw;
      flow_semi=base_pitch+(flow_seed2-0.5)*variety*30+tail_gravity_semis*tail_filter_phase;
      flow_t=max(-1,min(1,flow_semi/24));
      flow_t < 0 ? (fr=0.22; fg=0.56+0.18*(1+flow_t); fb=1;) : (fr=0.58+0.42*flow_t; fg=0.76-0.34*flow_t; fb=1-0.72*flow_t;);
      fa=(1-flow_age)*storm_energy*0.28;
      gfx_set(fr,fg,fb,fa); gfx_circle(fx,fy,0.55+(1-flow_age)*1.6,1);
      flow_i+=1;
    );
  ) : (
    flow_i=0; loop(19,
      flow_seed=sin((flow_i+1)*71.83)*43758.545; flow_seed-=floor(flow_seed);
      flow_age=flow_i/18;
      fx=flow_x-flow_dx*flow_age*720+(flow_seed-0.5)*(5+space_spread*20);
      fy=flow_y+sin(flow_i*2.31)*(2.5+space_spread*5);
      fa=(1-flow_age)*storm_energy*0.48;
      gfx_set(0.22,0.72,1,fa); gfx_circle(fx,fy,0.7+(1-flow_age)*2.0,1);
      flow_i+=1;
    );
  );
  gfx_set(0.58,0.90,1,min(1,storm_energy)); gfx_circle(flow_x,flow_y,4+storm_energy*4,1);
);
i=0;
loop(MAX_VOICES,
  p_active[i] ? (
    particle_age=p_age[i]/max(1,p_dur[i]);
    particle_semi=12*log(max(0.25,p_speed[i]))/log(2)+tail_gravity_semis*tail_filter_phase;
    particle_t=max(-1,min(1,particle_semi/24));
    slider16 == 0 ? (
      // Grains travel away from the emitter through a widening cone. Pitch
      // places each grain vertically, with a little controlled Variety drift.
      px=sx-cone_dir*particle_age*cone_depth;
      particle_jitter=sin((i+1)*47.31)*0.5+0.5;
      py=space_cy-particle_t*(map_h*0.37)+(particle_jitter-0.5)*(4+particle_age*cone_width*0.32);
      py=max(map_y+18,min(map_y+map_h-18,py));
    ) : (
      pvx=p_x[i]; pvy=1-2*p_y[i]; plen=sqrt(pvx*pvx+pvy*pvy); plen<0.001 ? (pvx=0; pvy=1; plen=1;);
      px=space_cx+pvx/plen*ring_rx; py=space_cy-pvy/plen*ring_ry;
    );
    a=min(1,p_amp[i]*1.5);
    speed_t=min(1,abs(log(p_speed[i])/log(2))/2);
    p_kind[i] == 0 ? (cr=0.72;cg=0.88;cb=1;) : p_kind[i] == 1 ? (cr=0.35;cg=0.92;cb=0.82;) : p_kind[i] == 2 ? (cr=1;cg=0.72;cb=0.22;) : (cr=0.78;cg=0.50;cb=1;);
    slider16 == 0 ? (
      particle_t < 0 ? (pr=0.22; pg=0.58+0.18*(1+particle_t); pb=1;) : (pr=0.58+0.42*particle_t; pg=0.78-0.36*particle_t; pb=1-0.76*particle_t;);
    ) : (
      pr=cr+speed_t*(1-cr); pg=cg*(1-speed_t*0.3); pb=cb;
    );
    // Each grain points opposite its actual velocity, leaving a readable
    // micro-trail. Stereo trails are horizontal; 5.1 uses the local tangent.
    slider16 == 0 ? (tx=cone_dir*(5+particle_age*12); ty=(py-space_cy)*0.04;) : (
      tx=p_vx[i]*ring_rx*190; ty=-p_vy[i]*ring_ry*190;
    );
    // Dot trails retain the sense of inertia without painting a bright rigid
    // line over the Stereo axis.
    gfx_set(pr,pg,pb,a*0.20); gfx_circle(px-tx*0.35,py-ty*0.35,1.3,1);
    gfx_set(pr,pg,pb,a*0.12); gfx_circle(px-tx*0.70,py-ty*0.70,0.9,1);
    gfx_set(pr,pg,pb,a); gfx_circle(px,py,1.5+a*2.4,1);
  );
  i+=1;
);
gfx_set(0.65,0.76,0.90,1); gfx_x=map_x+12; gfx_y=map_y+map_h-17; gfx_drawstr("BLUE: INPUT  |  COLOURED: PARTICLES");

// PARTICLE SCORE: a time-view, deliberately separate from the spatial map.
// Lanes are grains; their length, start scatter, count and fading field map
// directly to Grain, Scatter, Density and Tail respectively.
score_x=28; score_y=202; score_w=gfx_w-56; score_h=118;
gfx_set(0.085,0.125,0.19,1); gfx_roundrect(score_x,score_y,score_w,score_h,8,1);
gfx_set(0.24,0.36,0.52,1); gfx_roundrect(score_x,score_y,score_w,score_h,8,0);
gfx_set(0.70,0.82,0.96,1); gfx_x=score_x+10; gfx_y=score_y+9; gfx_drawstr("PARTICLE SCORE  /  TIME AFTER PEAK");
axis_x=score_x+62; axis_y=score_y+score_h-15; axis_w=score_w-78;
gfx_set(0.18,0.29,0.42,1); gfx_line(axis_x,score_y+25,axis_x,axis_y); gfx_line(axis_x,axis_y,axis_x+axis_w,axis_y);
tail_w=min(axis_w, max(12, slider6/3000*axis_w));
ci=0; loop(18,
  fade=0.17*(1-ci/18); gfx_set(0.18,0.78,1,fade);
  gfx_rect(axis_x+ci*tail_w/18,score_y+27,tail_w/18+1,axis_y-score_y-28,1);
  ci+=1;
);
score_rows=min(17,max(4,floor(4+slider5*0.13)));
grain_w=max(5,slider7/300*axis_w*0.42);
scatter_w=min(axis_w-grain_w-8,slider8/600*axis_w*0.42);
row=0; loop(score_rows,
  pseudo=sin((row+1)*78.233)*43758.545; pseudo-=floor(pseudo);
  slider2 == 0 ? (px=axis_x+8+pseudo*scatter_w*0.70+row*2; draw_w=grain_w*0.62;) :
  slider2 == 1 ? (px=axis_x+8+pseudo*scatter_w+row*2; draw_w=grain_w;) :
  slider2 == 2 ? (px=axis_x+8+pseudo*scatter_w+row*3; draw_w=grain_w*0.72;) :
  (px=axis_x+8+pseudo*scatter_w*0.45+row*2; draw_w=grain_w*1.45;);
  py=score_y+34+row*(axis_y-score_y-43)/max(1,score_rows-1);
  alpha=0.95-row*0.62/max(1,score_rows-1);
  // Pitch is temperature: down = blue, centre = ice, up = amber. Variety
  // fans the lane colours, making detune visible even before listening.
  vis_pitch=max(-1,min(1,slider10/24+(pseudo-0.5)*2*slider11*0.68));
  vis_pitch < 0 ? (cr=0.25+0.42*(vis_pitch+1); cg=0.63+0.28*(vis_pitch+1); cb=1;) : (cr=0.70+0.30*vis_pitch; cg=0.92-0.42*vis_pitch; cb=1-0.70*vis_pitch;);
  gfx_set(cr,cg,cb,alpha);
  slider2 == 2 ? (
    // Chime is visibly articulated: small separated strikes in every grain.
    gfx_rect(px,py-2,draw_w*0.22,4,2); gfx_rect(px+draw_w*0.38,py-2,draw_w*0.22,4,2); gfx_rect(px+draw_w*0.76,py-2,draw_w*0.18,4,2);
  ) : gfx_rect(px,py-2,draw_w,4,2);
  gfx_set(cr,cg,cb,alpha*0.80); gfx_circle(px-5,py,1.5,1);
  row+=1;
);
gfx_set(1,0.72,0.30,1); gfx_line(axis_x,score_y+27,axis_x,axis_y,2);
// The Tail parameter lives where it is heard: drag this vertical end marker.
tail_handle_x=axis_x+tail_w;
gfx_set(0.25,0.86,1,1); gfx_line(tail_handle_x,score_y+27,tail_handle_x,axis_y,2);
gfx_set(0.72,0.94,1,1); gfx_circle(tail_handle_x,score_y+28,4,1); gfx_circle(tail_handle_x,axis_y,4,1);
gfx_set(0.55,0.68,0.82,1); gfx_x=axis_x+4; gfx_y=axis_y+3; gfx_drawstr("PEAK");
gfx_x=max(axis_x+8,axis_x+tail_w-28); gfx_y=score_y+22; gfx_set(0.47,0.88,1,1); gfx_drawstr("TAIL");
gfx_x=max(axis_x+8,axis_x+tail_w-21); gfx_y=score_y+34; gfx_set(0.76,0.94,1,1); gfx_drawnumber(slider6,0); gfx_drawstr(" ms");

// Grouped horizontal sliders: larger rails leave the bottom half readable.
// Explicit group surfaces keep scanning fast even in a compact REAPER panel.
gfx_set(0.075,0.115,0.18,1); gfx_roundrect(20,330,198,216,8,1); gfx_roundrect(222,330,198,216,8,1); gfx_roundrect(424,330,198,216,8,1); gfx_roundrect(20,564,602,58,8,1);
gfx_set(0.28,0.42,0.62,1); gfx_roundrect(20,330,198,216,8,0); gfx_roundrect(222,330,198,216,8,0); gfx_roundrect(424,330,198,216,8,0); gfx_roundrect(20,564,602,58,8,0);
gfx_set(0.68,0.84,1,1); gfx_x=28; gfx_y=338; gfx_drawstr("EMITTER");
gfx_x=230; gfx_y=338; gfx_drawstr("PARTICLES");
gfx_x=432; gfx_y=338; gfx_drawstr("ACTION / FORCES");
gfx_x=28; gfx_y=572; gfx_drawstr("OUTPUT");
mouse_down=(mouse_cap&1)!=0; mouse_clicked=mouse_down&&!was_down;
mouse_clicked && mouse_x>gfx_w-160 && mouse_x<gfx_w-30 && mouse_y>18 && mouse_y<50 ? (
  slider1=(slider1+1)%5;
  active_preset=slider1;
  slider1 > 0 ? apply_preset(slider1);
  // The following redraw reads the changed sliders immediately; the mask
  // also persists every preset value to REAPER and automation.
  sliderchange(1+2^1+2^2+2^3+2^4+2^5+2^6+2^7+2^8+2^9+2^10+2^11+2^12+2^13+2^14+2^16+2^19+2^20+2^21+2^22+2^23);
);
mouse_clicked && abs(mouse_x-tail_handle_x)<=10 && mouse_y>=score_y+20 && mouse_y<=axis_y+8 ? tail_drag=1;
mouse_down && tail_drag ? (
  slider6=max(40,min(3000,3000*(mouse_x-axis_x)/axis_w));
  sliderchange(2^5);
);
// Material is a choice, not a value on a continuous scale.
mouse_clicked && mouse_x>=28 && mouse_x<=210 && mouse_y>=352 && mouse_y<=376 ? (
  slider2=min(3,floor((mouse_x-28)/45));
  sliderchange(2);
);
// Tail filter mode is categorical. The adjacent slider sets its amount.
mouse_clicked && mouse_x>=230 && mouse_x<=412 && mouse_y>=352 && mouse_y<=376 ? (
  slider23=min(2,floor((mouse_x-230)/61));
  sliderchange(2^22);
);
mouse_clicked ? (
  slider_drag=0; ci=1;
  loop(19,
    ci < 6 ? (cx=28; cy=352+ci*32;) : ci < 11 ? (cx=230; cy=352+(ci-5)*32;) : ci < 17 ? (cx=432; cy=352+(ci-11)*32;) : (cx=28+(ci-17)*202; cy=586;);
    mouse_x>=cx && mouse_x<=cx+182 && mouse_y>=cy && mouse_y<=cy+21 ? slider_drag=ci+1;
    ci+=1;
  );
);
mouse_down && slider_drag ? (
  ci=slider_drag-1; ci < 6 ? cx=28 : ci < 11 ? cx=230 : ci < 17 ? cx=432 : cx=28+(ci-17)*202; nv=max(0,min(1,(mouse_x-cx)/182));
  ci == 0 ? ui_id=0 : ci == 1 ? ui_id=1 : ci == 2 ? ui_id=2 : ci == 3 ? ui_id=3 : ci == 4 ? ui_id=6 : ci == 5 ? ui_id=17 : ci == 6 ? ui_id=19 : ci == 7 ? ui_id=5 : ci == 8 ? ui_id=7 : ci == 9 ? ui_id=8 : ci == 10 ? ui_id=9 : ci == 11 ? ui_id=10 : ci == 12 ? ui_id=11 : ci == 13 ? ui_id=12 : ci == 14 ? ui_id=13 : ci == 15 ? ui_id=16 : ci == 16 ? ui_id=20 : ci == 17 ? ui_id=14 : ci == 18 ? ui_id=15 : ui_id=18;
  ui_id == 0 ? (slider2=floor(nv*3+0.5); sliderchange(2););
  ui_id == 1 ? (slider3=-48+45*nv; sliderchange(4););
  ui_id == 2 ? (slider4=nv; sliderchange(8););
  ui_id == 3 ? (slider5=4+156*nv; sliderchange(16););
  ui_id == 4 ? (slider6=40+2960*nv; sliderchange(32););
  ui_id == 5 ? (slider7=8+292*nv; sliderchange(64););
  ui_id == 6 ? (slider8=600*nv; sliderchange(128););
  ui_id == 7 ? (slider9=-1+2*nv; sliderchange(256););
  ui_id == 8 ? (slider10=-24+48*nv; sliderchange(512););
  ui_id == 9 ? (slider11=nv; sliderchange(1024););
  ui_id == 10 ? (slider12=-36+72*nv; sliderchange(2048););
  ui_id == 11 ? (slider13=nv; sliderchange(4096););
  ui_id == 12 ? (slider14=nv; sliderchange(8192););
  ui_id == 13 ? (slider15=nv; sliderchange(16384););
  ui_id == 14 ? (slider17=nv; sliderchange(65536););
  ui_id == 15 ? (slider18=-18+30*nv; sliderchange(131072););
  ui_id == 16 ? (slider20=-1+2*nv; sliderchange(524288););
  ui_id == 17 ? (slider21=10+490*nv; sliderchange(1048576););
  ui_id == 18 ? (slider16=floor(nv+0.5); sliderchange(32768););
  ui_id == 19 ? (slider22=18000*nv; sliderchange(2^21););
  ui_id == 20 ? (slider24=-24+48*nv; sliderchange(2^23););
);
!mouse_down ? (slider_drag=0; tail_drag=0;);
was_down=mouse_down;

// Four distinct material buttons also act as a legend for the Score patterns.
mi=0; loop(4,
  mx=28+mi*45; selected=slider2==mi;
  selected ? (gfx_set(0.18,0.55,0.80,1);) : (gfx_set(0.10,0.16,0.25,1););
  gfx_roundrect(mx,352,41,24,4,1);
  selected ? gfx_set(0.72,0.94,1,1) : gfx_set(0.55,0.67,0.82,1);
  gfx_roundrect(mx,352,41,24,4,0);
  gfx_setfont(1,"Arial",9);
  gfx_x=mx+3; gfx_y=360;
  mi==0 ? gfx_drawstr("DUST") : mi==1 ? gfx_drawstr("SPRAY") : mi==2 ? gfx_drawstr("CHIME") : gfx_drawstr("TRAIL");
  gfx_setfont(0,"Arial",12);
  mi+=1;
);
// Filter mode: the slider below is amount, these buttons choose its direction.
fi=0; loop(3,
  fx=230+fi*61; selected=slider23==fi;
  selected ? (gfx_set(fi==2 ? 0.28 : 0.16,fi==2 ? 0.62 : 0.42,fi==2 ? 0.90 : 0.72,1);) : gfx_set(0.10,0.16,0.25,1);
  gfx_roundrect(fx,352,57,24,4,1);
  selected ? gfx_set(0.84,0.95,1,1) : gfx_set(0.55,0.67,0.82,1);
  gfx_roundrect(fx,352,57,24,4,0);
  gfx_x=fx+(fi==0 ? 16 : 21); gfx_y=359;
  fi==0 ? gfx_drawstr("OFF") : fi==1 ? gfx_drawstr("LP") : gfx_drawstr("HP");
  fi+=1;
);

ci=1; loop(19,
  ci < 6 ? (cx=28; cy=352+ci*32;) : ci < 11 ? (cx=230; cy=352+(ci-5)*32;) : ci < 17 ? (cx=432; cy=352+(ci-11)*32;) : (cx=28+(ci-17)*202; cy=586;); cw=182;
  ci == 0 ? ui_id=0 : ci == 1 ? ui_id=1 : ci == 2 ? ui_id=2 : ci == 3 ? ui_id=3 : ci == 4 ? ui_id=6 : ci == 5 ? ui_id=17 : ci == 6 ? ui_id=19 : ci == 7 ? ui_id=5 : ci == 8 ? ui_id=7 : ci == 9 ? ui_id=8 : ci == 10 ? ui_id=9 : ci == 11 ? ui_id=10 : ci == 12 ? ui_id=11 : ci == 13 ? ui_id=12 : ci == 14 ? ui_id=13 : ci == 15 ? ui_id=16 : ci == 16 ? ui_id=20 : ci == 17 ? ui_id=14 : ci == 18 ? ui_id=15 : ui_id=18;
  ui_id == 0 ? cv=slider2/3 : ui_id == 1 ? cv=(slider3+48)/45 : ui_id == 2 ? cv=slider4 : ui_id == 3 ? cv=(slider5-4)/156 : ui_id == 4 ? cv=(slider6-40)/2960 : ui_id == 5 ? cv=(slider7-8)/292 : ui_id == 6 ? cv=slider8/600 : ui_id == 7 ? cv=(slider9+1)*0.5 : ui_id == 8 ? cv=(slider10+24)/48 : ui_id == 9 ? cv=slider11 : ui_id == 10 ? cv=(slider12+36)/72 : ui_id == 11 ? cv=slider13 : ui_id == 12 ? cv=slider14 : ui_id == 13 ? cv=slider15 : ui_id == 14 ? cv=slider17 : ui_id == 15 ? cv=(slider18+18)/30 : ui_id == 16 ? cv=(slider20+1)*0.5 : ui_id == 17 ? cv=(slider21-10)/490 : ui_id == 19 ? cv=slider22/18000 : ui_id == 20 ? cv=(slider24+24)/48 : cv=slider16;
  gfx_set(0.76,0.86,0.98,1); gfx_x=cx; gfx_y=cy; 
  ui_id == 0 ? gfx_drawstr("MATERIAL") : ui_id == 1 ? gfx_drawstr("TRIGGER") : ui_id == 2 ? gfx_drawstr("SENSE") : ui_id == 3 ? gfx_drawstr("DENSITY") : ui_id == 4 ? gfx_drawstr("TAIL") : ui_id == 5 ? gfx_drawstr("GRAIN") : ui_id == 6 ? gfx_drawstr("SCATTER") : ui_id == 7 ? gfx_drawstr("TONE") : ui_id == 8 ? gfx_drawstr("PITCH") : ui_id == 9 ? gfx_drawstr("VARIETY") : ui_id == 10 ? gfx_drawstr("GRAVITY") : ui_id == 11 ? gfx_drawstr("ATTRACT") : ui_id == 12 ? gfx_drawstr("SPREAD") : ui_id == 13 ? gfx_drawstr("FLIGHT") : ui_id == 14 ? gfx_drawstr("DRY / WET") : ui_id == 15 ? gfx_drawstr("OUTPUT") : ui_id == 16 ? gfx_drawstr("TRAJECTORY") : ui_id == 17 ? gfx_drawstr("OFFSET") : ui_id == 19 ? gfx_drawstr("TAIL FILTER") : ui_id == 20 ? gfx_drawstr("TAIL GRAVITY") : gfx_drawstr("MODE");
  gfx_set(0.045,0.075,0.12,1); gfx_roundrect(cx,cy+14,cw,12,3,1);
  gfx_set(0.25,0.38,0.56,1); gfx_roundrect(cx,cy+14,cw,12,3,0);
  ui_id == 7 || ui_id == 16 || ui_id == 20 ? (gfx_set(0.52,0.64,0.82,1); gfx_rect(cx+cw/2-1,cy+14,2,12,1););
  gfx_set(ui_id == 16 || ui_id == 20 ? 1 : 0.35, ui_id == 16 || ui_id == 20 ? 0.58 : 0.84, 1, 1);
  ui_id == 7 || ui_id == 16 || ui_id == 20 ? (
