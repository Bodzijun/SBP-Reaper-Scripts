  // by the window control. The interior source does not pass through a wall.
  window_mix=ms_bound(slider97,0,1);
  cabin_fc=i==0||i==9 ? 850 : i==1||i==2 ? 1450 : i==6||i==8 ? 1250 : i==10 ? 1000 : i==7 ? 3200 : i==11 ? 8000 : 1900;
  i!=11 ? fc=fc*(1-slider96)+min(fc,cabin_fc+(fc-cabin_fc)*window_mix*.82)*slider96;
  ms_filter_target[i]=1-exp(-2*$pi*fc/srate);
  state=slider(146+i);
  level=(state==1 || (ms_solo && state!=2)) ? 0 : pow(10,slider(104+i)/20);
  cabin_gain=i==11 ? .14+slider96*.86 :
    i==0||i==9 ? 1-slider96*(.70-.52*window_mix) :
    i==10 ? 1-slider96*(.90-.32*window_mix) :
    i==6||i==8 ? 1-slider96*(.55-.35*window_mix) :
    i==7 ? 1+slider96*.20 : 1-slider96*(.48-.28*window_mix);
  ms_gain_target[i]=level*cabin_gain*ms_distance_gain(distance)*(1-.6*shadow)*(1-.7*direction_loss);
  i==9 ? ms_gain_target[i]*=1+ms_pass_mix*(ms_backfire_pass_factor(distance)-1);
  ms_dry_target[i]=level;
  ms_send_target[i]=slider(118+i)*(1-shadow*.25);
);
// Read a time-varying propagation delay: moving closer shortens the delay and
// raises pitch, moving away lengthens it and lowers pitch. A 25 ms transition
// keeps enabling/disabling the pass smooth; dry stems retain the dry signal.
function ms_pass_signal(i,signal) local(base,pos,n,next,frac,delayed,step) (
  base=ms_pass_buffer+i*65536;
  base[ms_pass_write]=signal;
  ms_pass_delay[i]<0 ? ms_pass_delay[i]=ms_pass_delay_target[i];
  step=(ms_pass_delay_target[i]-ms_pass_delay[i])*ms_pass_delay_smooth;
  ms_pass_delay[i]+=ms_bound(step,-.8,.8);
  pos=ms_pass_write-ms_pass_delay[i];
  pos<0 ? pos+=65536;
  n=floor(pos); frac=pos-n; next=n+1; next>=65536 ? next=0;
  delayed=base[n]*(1-frac)+base[next]*frac;
