    ms_coast_coupled_rpm=min(limiter_rpm,base_idle_rpm+idle_speed_deadband+max(0,ms_coast_wheel)*abs(gear_ratio));
    gear!=0 && shift_timer<=0 && !speed_stop_hold ? target_rpm_phys=max(target_rpm_phys,base_idle_rpm+(ms_coast_coupled_rpm-base_idle_rpm)*ms_coast_blend);

    // Approach target with inertia (Flywheel simulation)
