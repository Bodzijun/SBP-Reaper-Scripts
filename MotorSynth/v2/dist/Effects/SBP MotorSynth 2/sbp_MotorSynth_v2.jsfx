// the existing chassis source so its gain, mute, perspective and sends apply.
ms_stone_y0=ms_stone_b0*(ms_stone_out-ms_stone_x2)-ms_stone_c0*ms_stone_y01-ms_stone_d0*ms_stone_y02;
ms_stone_y1=ms_stone_b1*(ms_stone_out-ms_stone_x2)-ms_stone_c1*ms_stone_y11-ms_stone_d1*ms_stone_y12;
ms_stone_x2=ms_stone_x1;ms_stone_x1=ms_stone_out;
ms_stone_y02=ms_stone_y01;ms_stone_y01=ms_stone_y0;
ms_stone_y12=ms_stone_y11;ms_stone_y11=ms_stone_y1;
ms_stone_res_level+=(slider181-ms_stone_res_level)*ms_smooth;
ms_stone_body=(ms_stone_y0*.65+ms_stone_y1*.35)*10*ms_stone_res_level*(.35+.65*ms_cabin_presence);
