    dry=(signal*rotation_mean+(event_mean+base_difference*surface_mean)*ms_wheel_scale)*ms_dry[6]*ms_volume*.70710678*4.284;
    spl14=dry; spl15=dry;
  );
  ms_source_peaks[6]=max(ms_source_peaks[6],max(abs(sum_l),abs(sum_r)));
  // Preserve the impact's presence after increasing the separate road bed.
