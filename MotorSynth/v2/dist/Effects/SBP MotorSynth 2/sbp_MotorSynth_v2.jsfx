  );
  ms_source_peaks[i]=max(ms_source_peaks[i],max(abs(left),abs(right)));
);
// Road source 6 is distributed around the actual wheelbase and body width.
// Shared low-frequency road body is complemented by independent, darkened
// contact variations. The four variations sum to zero before spatialization.
function ms_wheel_config(i,x,y) local(dx,dy,dz,distance,pan,shadow,fc,window_mix,level,cabin_gain) (
  dx=x*ms_car_sign+ms_pass_offset-slider92; dy=y*ms_car_sign-slider93; dz=.15-slider94;
  distance=sqrt(dx*dx+dy*dy+dz*dz);
  ms_pass_delay_target[14+i]=min(65530,distance*srate/343);
  pan=(dx*ms_yaw_sin-dy*ms_yaw_cos)/max(.5,distance);
  ms_wheel_pan_target[i]=ms_bound(pan*slider37*(1-slider96*.5),-.95,.95);
  shadow=1-(1-slider138)*(1-ms_body_shadow(x,y));
  fc=ms_shadow_cutoff(distance,shadow);
  window_mix=ms_bound(slider97,0,1);
  fc=fc*(1-slider96)+min(fc,1250+(fc-1250)*window_mix*.82)*slider96;
  ms_wheel_filter_target[i]=1-exp(-2*$pi*fc/srate);
  level=(slider152==1 || (ms_solo && slider152!=2)) ? 0 : pow(10,slider110/20);
  cabin_gain=1-slider96*(.55-.35*window_mix);
  ms_wheel_gain_target[i]=level*cabin_gain*ms_distance_gain(distance)*(1-.6*shadow);
);
// One stone hit on wheel i. Small stones (most hits) give a short metallic tick
// of random pitch; big ones are lower and longer and also start the body thud.
// Muffler drive: asymmetric soft clip after the muffler, blended in by the amount (0 = bypass).
function ms_muffler_drive(x) local(g,y) (
  ms_mdrive>.001 ? (
