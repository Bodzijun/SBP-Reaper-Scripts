  ms_bump_rear_distance-=max(0,slider101?slider8:veh_speed_norm*280)/(3.6*srate);
  ms_bump_rear_distance<=0 ? (ms_bump_rear_distance=-1;ms_bump_rear_hold=srate*.008;);
);
ms_bump_rear_hold=max(0,ms_bump_rear_hold-1);
ms_bump_rear_target=ms_bump_rear_hold>0;
ms_bump_rear_env+=(ms_bump_rear_target-ms_bump_rear_env)*(ms_bump_rear_target?ms_bump_attack:ms_bump_release);
ms_bump_hold=max(0,ms_bump_hold-1);
ms_bump_target=ms_bump_hold>0;
ms_bump_env+=(ms_bump_target-ms_bump_env)*(ms_bump_target?ms_bump_attack:ms_bump_release);
ms_bump_seed*=16807;ms_bump_seed-=floor(ms_bump_seed/2147483647)*2147483647;
ms_bump_noise=ms_bump_seed*(2/2147483647)-1;
ms_bump_lp+=(ms_bump_noise-ms_bump_lp)*ms_bump_filter;
// Weight the separate suspension impact toward a deeper thump, retaining
// filtered transient noise and smoothing the user-controlled level.
ms_bump_phase+=(64-slider13*16)/srate;ms_bump_phase>=1?ms_bump_phase-=1;
ms_bump_level+=(slider173-ms_bump_level)*ms_smooth;
// A short low-frequency pressure impulse gives the body a definite hit;
// retain only a small noise component for the contact texture.
ms_bump_thump_front+=(ms_bump_env-ms_bump_thump_front)*ms_bump_thump_coeff;
ms_bump_thump_rear+=(ms_bump_rear_env-ms_bump_thump_rear)*ms_bump_thump_coeff;
ms_bump_front=(ms_bump_env-ms_bump_thump_front)*1.6+
 (sin(ms_bump_phase*$pi*2)*.65+ms_bump_lp*.18)*ms_bump_env;
ms_bump_rear=(ms_bump_rear_env-ms_bump_thump_rear)*1.45+
 (sin(ms_bump_phase*$pi*2+.35)*.58+ms_bump_lp*.16)*ms_bump_rear_env;
// Dedicated event gain compensates its spatial and master attenuation.
ms_bump_out=(ms_bump_front+ms_bump_rear*.75)*ms_bump_level*4;
