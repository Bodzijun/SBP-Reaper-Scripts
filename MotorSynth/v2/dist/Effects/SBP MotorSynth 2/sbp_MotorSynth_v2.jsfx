ms_cabin_vibration_level+=(slider201-ms_cabin_vibration_level)*ms_smooth;
ms_cabin_vibration_presence+=(slider96-ms_cabin_vibration_presence)*ms_smooth;
ms_cabin_vibration=(ms_engine_body_lp2*.30*(1-sci_ev_mix)*ign_audio_env+
 ms_body_res*ms_wheel_scale*.08)*ms_cabin_vibration_level*ms_cabin_vibration_presence;
// A smoothed short motor event only while the window parameter is moving.
ms_window_hold=max(0,ms_window_hold-1);
ms_window_target=ms_window_hold>0;
ms_window_env+=(ms_window_target-ms_window_env)*(ms_window_target?ms_window_attack:ms_window_release);
ms_window_level+=(slider202-ms_window_level)*ms_smooth;
ms_window_phase+=(ms_window_direction>0?105:94)/srate;ms_window_phase>=1?ms_window_phase-=1;
// Quiet geared-servo tone: integer harmonics share a continuous phase.
ms_window_servo_lfo+=16/srate;ms_window_servo_lfo>=1?ms_window_servo_lfo-=1;
ms_window_motor=(sin(ms_window_phase*$pi*2)*.32+sin(ms_window_phase*$pi*4)*.13+
 sin(ms_window_phase*$pi*6)*.045)*(1+sin(ms_window_servo_lfo*$pi*2)*.06)*
 ms_window_env*ms_window_level;
ms_emit(11,bus_interior+ms_cabin_vibration+ms_window_motor);
ms_emit(12,bus_siren_horn); ms_emit(13,bus_electric);
ms_pass_write+=1; ms_pass_write>=65536 ? ms_pass_write=0;
// Distinct short reflections: engine bay, underbody and dashboard/cabin.
// Damping and a handful of taps supply body without a synthetic long tail.
ms_local_low0+=(ms_local_in0-ms_local_low0)*ms_local_damp;
ms_local_low1+=(ms_local_in1-ms_local_low1)*ms_local_damp;
ms_local_low2+=(ms_local_in2-ms_local_low2)*ms_local_damp;
ms_local_buffer[ms_local_pos]=ms_local_low0;
ms_local_buffer[8192+ms_local_pos]=ms_local_low1;
ms_local_buffer[16384+ms_local_pos]=ms_local_low2;
ms_local_smooth0+=(slider177-ms_local_smooth0)*ms_smooth;
ms_local_smooth1+=(slider178-ms_local_smooth1)*ms_smooth;
ms_local_smooth2+=(slider179-ms_local_smooth2)*ms_smooth;
ms_local_l=(ms_local_tap(0,.0027)*.42+ms_local_tap(0,.0063)*.25+ms_local_tap(0,.0121)*.16)*ms_local_smooth0
 +(ms_local_tap(1,.0041)*.35+ms_local_tap(1,.0097)*.25+ms_local_tap(1,.0181)*.15)*ms_local_smooth1
 +(ms_local_tap(2,.0037)*.37+ms_local_tap(2,.0113)*.28+ms_local_tap(2,.0217)*.18)*ms_local_smooth2;
ms_local_r=(ms_local_tap(0,.0033)*.42+ms_local_tap(0,.0077)*.25+ms_local_tap(0,.0143)*.16)*ms_local_smooth0
 +(ms_local_tap(1,.0053)*.35+ms_local_tap(1,.0119)*.25+ms_local_tap(1,.0211)*.15)*ms_local_smooth1
 +(ms_local_tap(2,.0051)*.37+ms_local_tap(2,.0137)*.28+ms_local_tap(2,.0253)*.18)*ms_local_smooth2;
ms_local_pos+=1;ms_local_pos>=8192?ms_local_pos=0;
// External early and late components react differently to listener distance.
ms_early_distance+=(ms_early_distance_target-ms_early_distance)*ms_smooth;
ms_early_buffer[ms_early_pos]=ms_room_in;
ms_early_l=(ms_early_tap(.009)*.55+ms_early_tap(.023)*.30);
ms_early_r=(ms_early_tap(.013)*.55+ms_early_tap(.029)*.30);
ms_early_pos+=1;ms_early_pos>=32768?ms_early_pos=0;
// Four-line orthogonal feedback network; no unbounded buffer operations.
ms_r0=ms_room0[ms_pos0];ms_r1=ms_room1[ms_pos1];
ms_r2=ms_room2[ms_pos2];ms_r3=ms_room3[ms_pos3];
ms_room_lp0+=(ms_r0-ms_room_lp0)*ms_room_damp;
ms_room_lp1+=(ms_r1-ms_room_lp1)*ms_room_damp;
ms_room_lp2+=(ms_r2-ms_room_lp2)*ms_room_damp;
ms_room_lp3+=(ms_r3-ms_room_lp3)*ms_room_damp;
ms_rsum=(ms_room_lp0+ms_room_lp1+ms_room_lp2+ms_room_lp3)*.5;
ms_room0[ms_pos0]=ms_bound(ms_room_in+(ms_room_lp0-ms_rsum)*ms_room_feedback0,-8,8);
ms_room1[ms_pos1]=ms_bound(ms_room_in+(ms_room_lp1-ms_rsum)*ms_room_feedback1,-8,8);
ms_room2[ms_pos2]=ms_bound(ms_room_in+(ms_room_lp2-ms_rsum)*ms_room_feedback2,-8,8);
ms_room3[ms_pos3]=ms_bound(ms_room_in+(ms_room_lp3-ms_rsum)*ms_room_feedback3,-8,8);
ms_pos0+=1;ms_pos0>=ms_room_len0?ms_pos0=0;
ms_pos1+=1;ms_pos1>=ms_room_len1?ms_pos1=0;
ms_pos2+=1;ms_pos2>=ms_room_len2?ms_pos2=0;
ms_pos3+=1;ms_pos3>=ms_room_len3?ms_pos3=0;
ms_room_amount+=(ms_room_target-ms_room_amount)*ms_smooth;
spl30=(ms_r0+ms_r2-ms_r1*.3)*ms_room_amount*(.65+.55*ms_early_distance)
 +ms_early_l*ms_room_amount*(1-.65*ms_early_distance)+ms_local_l;
spl31=(ms_r1+ms_r3-ms_r0*.3)*ms_room_amount*(.65+.55*ms_early_distance)
 +ms_early_r*ms_room_amount*(1-.65*ms_early_distance)+ms_local_r;
ms_mix_l+=spl30;ms_mix_r+=spl31;
// Fade the complete perspective mix, including room tails, at both ends.
ms_pass_edge=ms_bound((30-abs(ms_pass_offset))/8,0,1);
ms_pass_edge=ms_pass_edge*ms_pass_edge*(3-2*ms_pass_edge);
ms_pass_target=slider168?ms_pass_edge:1;
ms_pass_fade+=(ms_pass_target-ms_pass_fade)*ms_smooth;
ms_mix_l*=ms_pass_fade;ms_mix_r*=ms_pass_fade;
spl30*=ms_pass_fade;spl31*=ms_pass_fade;
slider100 ? (ms_i=2;loop(28,spl(ms_i)*=ms_pass_fade;ms_i+=1;););
slider162 ? (
  ms_mix_l=ms_mix_l/(1+abs(ms_mix_l)*.16)*1.1;
  ms_mix_r=ms_mix_r/(1+abs(ms_mix_r)*.16)*1.1;
);
spl0=ms_peak_guard(ms_mix_l);spl1=ms_peak_guard(ms_mix_r);
ms_peak=max(ms_peak,max(abs(spl0),abs(spl1)));
ms_clock+=1;


@serialize
reaweb_jsfx_serialize(0,0,0);
slider160=reaweb_jsfx_handshake(slider160);

@gfx 640 220
gfx_clear=$x171b21;
gfx_set(0.9,0.92,0.95,1);gfx_setfont(1,"Arial",24);
gfx_x=24;gfx_y=22;gfx_drawstr("SBP MotorSynth 2");
gfx_setfont(1,"Arial",15);gfx_y=66;gfx_x=24;
gfx_drawstr("WebUI requires ReaWebAPI. Native parameters remain available.");
gfx_y=96;gfx_x=24;gfx_drawstr("Use the REAPER parameter controls for ignition and throttle.");
gfx_y=140;gfx_x=24;gfx_drawstr("RPM ");gfx_drawnumber(cur_rpm,0);
gfx_x=210;gfx_drawstr("Gear ");gfx_drawnumber(gear,0);
gfx_x=340;gfx_drawstr("Speed ");gfx_drawnumber(veh_speed_norm*280,1);

