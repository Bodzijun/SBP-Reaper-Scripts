@init
// Memory ownership: legacy 0..9215; SDK 65536..98303; scene 100000..100511;
// room buffers 110000..241071. All fractional positions wrap without modulo.
function ms_rand(scale) (
  ms_seed=ms_seed*16807;
  ms_seed-=floor(ms_seed/2147483647)*2147483647;
  ms_seed*(scale/2147483647);
);
function ms_wrap(value,period) (value-floor(value/period)*period;);
function ms_bound(value,lo,hi) (min(hi,max(lo,value)););
// Limit exhaust events across all cylinders to irregular, distinct impacts.
// Anti-lag can shorten the gap, but it cannot merge into the firing train.
function ms_backfire_trigger(cylinder,amount) (
  ms_backfire_wait<=0 ? (
    cyl_crackle[cylinder]=max(cyl_crackle[cylinder],amount);
    ms_backfire_wait=srate*(.065-.025*ms_bound(target_als,0,1)+ms_rand(.065));
    1;
  ) : 0;
);
// Approximate aggregate friction: average the surface under the four wheels.
function ms_brake_friction(surface) (
  surface==0?1:surface==1?1.08:surface==2?.72:surface==3?.62:.52;
);
function ms_handbrake_friction(surface) (
  surface==0?1:surface==1?1.06:surface==2?.74:surface==3?.66:.55;
);
function ms_handbrake_body(surface) (
  surface==0?1:surface==1?.95:surface==2?1.25:surface==3?.82:.90;
);
function ms_surface_blend(a,b) local(mix) (
  mix=ms_bound((ms_surface_transition+1)*.5,0,1);
  a+(b-a)*mix;
);
// An adjustable acoustic-driving approximation, not a measured tire model.
// Wet grip has greater speed sensitivity; the dry endpoint stays unchanged.
function ms_wet_braking_factor(speed) local(wet) (
  wet=ms_surface_blend(surface_type==3?1:0,slider169==3?1:0);
  1-wet*(.18+.18*ms_bound(speed,0,1));
);
function ms_profile_step(table,stride,index,state) local(a,b,target) (
  a=table[(surface_type|0)*stride+index];
  b=table[(slider169|0)*stride+index];
  target=ms_surface_blend(a,b);
  state[index]+=(target-state[index])*ms_smooth;
  state[index];
);
// Calibrate near 3 m to the prior level, while making the near/far contrast
// between independently positioned sources substantially clearer.
function ms_distance_gain(distance) (1.8/(1+max(0,distance)*.8););
// Exhaust transients need a clearer near/far contrast during a pass. This
// multiplier is smooth, bounded and leaves the stationary perspective intact.
function ms_backfire_pass_factor(distance) local(d) (
  d=max(0,distance);
  1+2*exp(-d/3.5)-.5*d/(d+8);
);
function ms_shadow_cutoff(distance,shadow) (
  ms_bound(16000/(1+distance*.025)*pow(.025,ms_bound(shadow,0,1)),300,min(18000,srate*.42));
);
// Approximate the body as a rounded-down rectangle in the horizontal plane.
// The length of the source-to-listener segment through it controls shadow;
// cabin transmission is handled elsewhere, as are ambient wind/interior.
function ms_body_shadow(sx,sy) local(rx,ry,dx,dy,hx,hy,near,far,a,b,valid,path,height,edge,result) (
  // Transform listener into the vehicle-local frame before clipping.
  rx=(slider92-ms_pass_offset)*ms_car_sign;ry=slider93*ms_car_sign;
  hx=max(.1,slider163*.45);hy=max(.1,slider164*.43);
  result=0;
  !(abs(rx)<hx && abs(ry)<hy) ? (
    dx=rx-sx;dy=ry-sy;near=0;far=1;valid=1;
    abs(dx)<.000001 ? (abs(sx)>hx ? valid=0;) : (
      a=(-hx-sx)/dx;b=(hx-sx)/dx;
      near=max(near,min(a,b));far=min(far,max(a,b));
    );
    abs(dy)<.000001 ? (abs(sy)>hy ? valid=0;) : (
      a=(-hy-sy)/dy;b=(hy-sy)/dy;
      near=max(near,min(a,b));far=min(far,max(a,b));
    );
    valid && far>near ? (
      path=(far-near)*sqrt(dx*dx+dy*dy);
