  exh_rasp *= 0.22 + 0.88 * ext_focus;

  bus_exhaust = bus_exhaust * exh_grain * exh_chop_gain + exh_rasp;
) : (
  exh_grain = 1.0;
  exh_grain_tgt = 1.0;
  exh_grain_cnt = 0;
  exh_chop_env = 0.0;
