ms_openwind_env+=(ms_openwind_target-ms_openwind_env)*(ms_openwind_target?ms_openwind_attack:ms_openwind_release);
ms_openwind_noise=rand_noise();
ms_openwind_lp+=(ms_openwind_noise-ms_openwind_lp)*ms_openwind_hi_coeff;
ms_openwind_low+=(ms_openwind_lp-ms_openwind_low)*ms_openwind_lo_coeff;
ms_openwind=(ms_openwind_lp-ms_openwind_low*.72)*ms_wind_rate_gain*target_wind*8*
  sqrt(ms_openwind_speed)*ms_cabin_presence*ms_cabin_window*(.10+.90*ms_openwind_env);
ms_volume+=(vol_amp*.72-ms_volume)*ms_smooth;
ms_pass_mix+=((slider168?1:0)-ms_pass_mix)*ms_smooth;
// Modest source make-up before spatialization and the guarded mix output.
// Blend original layers smoothly; zero removes only that layer, not its scene source.
ms_original_engine+=(slider212-ms_original_engine)*ms_smooth;
ms_original_exhaust+=(slider213-ms_original_exhaust)*ms_smooth;
ms_original_mech+=(slider225-ms_original_mech)*ms_smooth;
ms_original_intake+=(slider226-ms_original_intake)*ms_smooth;
// EngineSim dry stems (mono, L channel of each pair) from track channels 33..46.
// Level is matched to the UI7 bench at Master Volume -6 dB.
ms_es_exhaust_l+=(slider215-ms_es_exhaust_l)*ms_smooth;
ms_es_engine_l+=(slider214-ms_es_engine_l)*ms_smooth;
ms_es_intake_g+=(slider220-ms_es_intake_g)*ms_smooth;
ms_es_block_g+=(slider221-ms_es_block_g)*ms_smooth;
ms_es_valve_g+=(slider222-ms_es_valve_g)*ms_smooth;
ms_es_starter_g+=(slider223-ms_es_starter_g)*ms_smooth;
ms_es_width+=(slider224-ms_es_width)*ms_smooth;
ms_es_mid=(spl34+spl36)*ms_es_makeup*ms_es_exhaust_l;
ms_es_side=(spl34-spl36)*ms_es_makeup*ms_es_exhaust_l;
// EngineSim exhaust gets the same pulse-gated rasp (Exhaust rasp) and muffler drive as MotorSynth.
ms_es_rasp_fol+=(abs(ms_es_mid)-ms_es_rasp_fol)*ms_rasp_kf;
ms_es_rasp_avg+=(abs(ms_es_mid)-ms_es_rasp_avg)*ms_rasp_ks;
ms_es_mid+=exh_rasp_m*min(4*ms_es_rasp_avg,ms_es_rasp_fol*ms_es_rasp_fol/(ms_es_rasp_avg+.0001))*target_exh_rasp*1.55;
ms_es_a=ms_muffler_drive(ms_es_mid+ms_es_side);ms_es_b=ms_muffler_drive(ms_es_mid-ms_es_side);
ms_es_mid=(ms_es_a+ms_es_b)*.5;ms_es_side=(ms_es_a-ms_es_b)*.5;
ms_es_block=spl40*ms_es_makeup*ms_es_engine_l*ms_es_block_g;
ms_es_mech=(spl42*ms_es_valve_g+spl44*ms_es_starter_g)*ms_es_makeup*ms_es_engine_l;
ms_es_intake=spl38*ms_es_makeup*ms_es_engine_l*ms_es_intake_g;
ms_es_peak=max(ms_es_peak,max(abs(ms_es_mid),max(abs(ms_es_block),max(abs(ms_es_mech),abs(ms_es_intake)))));
ms_emit(0,bus_exhaust*1.35*ms_original_exhaust+ms_es_mid); ms_emit(1,bus_engine*1.5*ms_original_engine+ms_es_block);
ms_emit(2,bus_mech*ms_original_mech+ms_es_mech);
// Exhaust A/B width: side signal shares exhaust gain, filter, mute/solo and
