    ms_wheel_noise_low[i]+=(n-ms_wheel_noise_low[i])*ms_road_low_coeff;
    ms_wheel_noise_low2[i]+=(ms_wheel_noise_low[i]-ms_wheel_noise_low2[i])*ms_road_low_coeff;
    ms_wheel_noise_mid[i]+=(n-ms_wheel_noise_mid[i])*ms_road_texture_coeff;
