    ms_wheel_pan[i]+=(ms_wheel_pan_target[i]-ms_wheel_pan[i])*ms_smooth;
    ms_wheel_filter[i]+=(ms_wheel_filter_target[i]-ms_wheel_filter[i])*ms_smooth;
