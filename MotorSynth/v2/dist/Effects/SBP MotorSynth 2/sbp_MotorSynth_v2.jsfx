  local_weight=(i==0||i==1) ? 1-ms_truck_tone_mix*.65 : 1;
  i==1||i==2||i==4||i==5||i==13 ? ms_local_in0+=filtered*local_weight :
  i==0||i==3||i==7||i==8||i==9 ? ms_local_in1+=filtered*local_weight :
  i==11||i==12 ? ms_local_in2+=filtered;
  i!=8 && i!=11 && i!=12 && i!=10 ? ms_local_in2+=filtered*local_weight*slider96*.65;
  ch=2+i*2;
