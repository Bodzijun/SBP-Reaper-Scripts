    ms_wheel_joint_hold[i]=max(0,ms_wheel_joint_hold[i]-1);
    joint_target=ms_wheel_joint_hold[i]>0 ? ms_wheel_joint_strength[i] : 0;
    ms_wheel_joint_env[i]+=(joint_target-ms_wheel_joint_env[i])*(joint_target>ms_wheel_joint_env[i]?ms_impact_attack:ms_impact_release);
    ms_wheel_scale>0 ? (
      ms_wheel_gravel_wait[i]-=1;
      ms_wheel_gravel_wait[i]<=0 ? (
        ms_wheel_gravel_wait[i]=srate*(.035+u*.10);
        ms_wheel_gravel_hold[i]=srate*(.012+u*.018);
