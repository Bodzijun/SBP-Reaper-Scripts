);
ms_airbrake_pulse*=ms_airbrake_decay;
ms_airbrake_env+=(ms_airbrake_pulse-ms_airbrake_env)*(ms_airbrake_pulse>ms_airbrake_env?ms_airbrake_attack:ms_airbrake_release);
ms_airbrake_seed*=16807;ms_airbrake_seed-=floor(ms_airbrake_seed/2147483647)*2147483647;
ms_airbrake_noise=ms_airbrake_seed*(2/2147483647)-1;
ms_airbrake_high+=(ms_airbrake_noise-ms_airbrake_high)*ms_airbrake_hicoeff;
ms_airbrake_low+=(ms_airbrake_noise-ms_airbrake_low)*ms_airbrake_locoef;
ms_airbrake_level+=(slider194-ms_airbrake_level)*ms_smooth;
ms_airbrake_out=(ms_airbrake_high-ms_airbrake_low)*ms_airbrake_env*ms_airbrake_level*.65;
ms_emit(7,bus_chassis+ms_stone_out+ms_bump_out+ms_stone_body);
ms_emit(8,bus_brakes*ms_hb_motion+ms_airbrake_out);
ms_skid_scale*=ms_hb_motion;ms_emit_skids(slip_brakes_add*ms_hb_motion);
ms_emit(9,bus_bangs); ms_emit(10,bus_wind);
// Structure-borne interior vibration follows existing engine and road
