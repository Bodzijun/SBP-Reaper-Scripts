);
// The ordinary brake mechanism remains on source 8; drift is distributed
// across wheel locations using the existing four slip oscillators.
function ms_skid_config(i,x,y) local(dx,dy,dz,distance,pan,shadow,fc,window_mix,level,cabin_gain) (
  dx=x*ms_car_sign+ms_pass_offset-slider92;dy=y*ms_car_sign-slider93;dz=.15-slider94;
  distance=sqrt(dx*dx+dy*dy+dz*dz);
  ms_pass_delay_target[18+i]=min(65530,distance*srate/343);
  pan=(dx*ms_yaw_sin-dy*ms_yaw_cos)/max(.5,distance);
  ms_skid_pan_target[i]=ms_bound(pan*slider37*(1-slider96*.5),-.95,.95);
  shadow=1-(1-slider140)*(1-ms_body_shadow(x,y));fc=ms_shadow_cutoff(distance,shadow);
  window_mix=ms_bound(slider97,0,1);
  fc=fc*(1-slider96)+min(fc,1250+(fc-1250)*window_mix*.82)*slider96;
  ms_skid_filter_target[i]=1-exp(-2*$pi*fc/srate);
  level=(slider183==1 || (ms_solo && slider183!=2))?0:pow(10,slider182/20);
  cabin_gain=1-slider96*(.55-.35*window_mix);
  ms_skid_gain_target[i]=level*cabin_gain*ms_distance_gain(distance)*(1-.6*shadow);
);
function ms_emit_skids(signal) local(i,mean,raw,dc,filtered,pan,left,right,sum_l,sum_r,sum_dry) (
  ms_skid_parts[0]=slip_wh1;ms_skid_parts[1]=slip_wh2;
  ms_skid_parts[2]=slip_wh3;ms_skid_parts[3]=slip_wh4;
  mean=(ms_skid_parts[0]+ms_skid_parts[1]+ms_skid_parts[2]+ms_skid_parts[3])*.25;
  i=0;sum_l=0;sum_r=0;sum_dry=0;
  ms_skid_dry+=((slider183==1 || (ms_solo && slider183!=2) ? 0 : pow(10,slider182/20))-ms_skid_dry)*ms_smooth;
  loop(4,
    raw=signal+(ms_skid_parts[i]-mean)*ms_skid_scale;
    dc=raw-ms_skid_dc_in[i]+dc_pole*ms_skid_dc_out[i];
    ms_skid_dc_in[i]=raw;ms_skid_dc_out[i]=dc;
    sum_dry+=dc*.25;
    ms_skid_gain[i]+=(ms_skid_gain_target[i]-ms_skid_gain[i])*ms_smooth;
    ms_skid_pan[i]+=(ms_skid_pan_target[i]-ms_skid_pan[i])*ms_smooth;
    ms_skid_filter[i]+=(ms_skid_filter_target[i]-ms_skid_filter[i])*ms_smooth;
    ms_skid_lp[i]+=(ms_pass_signal(18+i,dc)-ms_skid_lp[i])*ms_skid_filter[i];
    filtered=ms_skid_lp[i]*ms_skid_gain[i]*ms_volume*.25;
    ms_local_in2+=filtered*ms_cabin_wet;
    filtered*=ms_cabin_dry;
    pan=ms_skid_pan[i];left=filtered*sqrt(.5*(1-pan));right=filtered*sqrt(.5*(1+pan));
    sum_l+=left;sum_r+=right;ms_room_in+=filtered*ms_send[8]*.32;ms_local_in1+=filtered*.55;
    i+=1;
  );
  ms_mix_l+=sum_l;ms_mix_r+=sum_r;
  slider100 ? (spl18+=sum_l;spl19+=sum_r;) : (
    sum_dry*=ms_skid_dry*ms_volume*.70710678;spl18+=sum_dry;spl19+=sum_dry;
  );
  ms_source_peaks[8]=max(ms_source_peaks[8],max(abs(sum_l),abs(sum_r)));
);
function ms_peak_guard(x) local(a) (
  a=abs(x);
  a<=.9 ? x : sign(x)*(.9+.08*(1-exp(-(a-.9)/.08)));
);

// Three bounded FIR early-reflection spaces. No feedback or modulo arithmetic.
function ms_local_tap(group, seconds) local(p) (
  p=ms_local_pos-min(8191,max(1,floor(seconds*srate)));
  p<0?p+=8192;
  ms_local_buffer[group*8192+p];
);
function ms_early_tap(seconds) local(p) (
  p=ms_early_pos-min(32767,max(1,floor(seconds*srate)));
  p<0?p+=32768;
  ms_early_buffer[p];
);


function get_gear_ratio(g) (
  g == -1 ? 3.05 : g == 1 ? 3.16 : g == 2 ? 1.88 : g == 3 ? 1.29 :
  g == 4 ? 0.97 : g == 5 ? 0.73 : g == 6 ? 0.53 : 0.0;
);

// Constants
pi = 3.14159265359;
pi2 = 2.0 * pi;

// Smooth function
function smooth_param(target, current, time_ms) (
  coeff = 1.0 - exp(-samplesblock / (srate * max(0.001,time_ms / 1000.0)));
  current + (target - current) * coeff;
);

// Biquad struct/functions (Simple LPF for muffler)
function biquad_lpf(freq, q) instance(c0, c1, c2, b1, b2, a1, a2, z1, z2) (
  w0 = 2 * pi * freq / srate;
  alpha = sin(w0) / (2 * q);
  cos_w0 = cos(w0);
  
  a0 = 1 + alpha;
  c0 = (1 - cos_w0) / 2 / a0;
  c1 = (1 - cos_w0) / a0;
  c2 = (1 - cos_w0) / 2 / a0;
  b1 = -2 * cos_w0 / a0;
  b2 = (1 - alpha) / a0;
);

function biquad_process(x) instance(c0, c1, c2, b1, b2, a1, a2, z1, z2) (
  out = c0 * x + c1 * z1 + c2 * z2 - b1 * a1 - b2 * a2;
  z2 = z1; z1 = x;
  a2 = a1; a1 = out;
  out;
);

