    gravel=(surface_type==2?1-mix:0)+(slider169==2?mix:0);
    rain=(surface_type==3?1-mix:0)+(slider169==3?mix:0);
    foliage=(surface_type==4?1-mix:0)+(slider169==4?mix:0);
