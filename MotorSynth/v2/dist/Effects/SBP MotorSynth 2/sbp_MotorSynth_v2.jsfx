ms_load_target=engine_state==2 ? ms_bound(cur_throttle,0,1)*(gear!=0?1:.55) : 0;
ms_overrun_target=engine_state==2 && gear!=0 ? (1-ms_bound(cur_throttle,0,1))*ms_bound((ms_rpm-slider161-200)/1600,0,1) : 0;
