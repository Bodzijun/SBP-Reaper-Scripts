    ms_stone_hold[i]=max(0,ms_stone_hold[i]-1);
    stone_target=ms_stone_hold[i]>0 ? ms_stone_strength[i] : 0;
    ms_stone_env[i]+=(stone_target-ms_stone_env[i])*(stone_target>ms_stone_env[i]?ms_stone_attack:ms_stone_release);
    // Short low-frequency body plus a restrained noisy strike. Envelope and
