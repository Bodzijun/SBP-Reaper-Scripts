ms_es_side_lp+=(ms_es_side-ms_es_side_lp)*ms_filter[0];
ms_es_side_out=ms_es_side_lp*ms_gain[0]*ms_volume*ms_es_width*.5*(1-ms_pass_mix);
slider100 ? (spl2+=ms_es_side_out;spl3-=ms_es_side_out;);
ms_mix_l+=ms_es_side_out;ms_mix_r-=ms_es_side_out;
ms_emit(3,bus_gearbox); ms_emit(4,bus_air*ms_original_intake+ms_es_intake); ms_emit(5,bus_bov);
// Road and tire bed is 6 dB lower; chassis and individual impact controls stay separate.
ms_grip_gain+=(slider228-ms_grip_gain)*ms_smooth;
ms_road_original+=(slider229-ms_road_original)*ms_smooth;
ms_emit_wheels(bus_road*0.501187233627*ms_road_original);
// GRIP stereo fold-down shares the road source spatial mixer and ambience.
ms_emit(6,(spl62+spl63)*0.5*ms_grip_gain);
