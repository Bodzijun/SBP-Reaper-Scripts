function ms_road_surface_base(surface) (
  surface==0 ? ms_tire_body*.95+ms_contact*.60 :
  surface==1 ? ms_tire_body*1.05+ms_contact*.30 :
  surface==2 ? ms_tire_body*.75+ms_contact*1.0 :
  surface==3 ? ms_tire_body*.88+ms_rain_water*1.15 : ms_tire_body*.60+ms_water*2.4;
);
function ms_chassis_surface(surface) (
  surface==0 ? ms_body_res*.90+ms_tire_body*.28 :
  surface==1 ? ms_body_res*.88+ms_joint_env*ms_body_res*.95 :
  surface==2 ? ms_body_res*.90+ms_gravel_env*ms_body_res*.65 :
  surface==3 ? ms_body_res*.80+ms_tire_body*.18+ms_rain_water*.10 :
    ms_body_res*.80+ms_tire_body*.18+ms_water*.14;
);
function ms_config(i,x,y,z) local(dx,dy,dz,distance,pan,shadow,fc,state,level,cabin_gain,cabin_fc,window_mix,alignment,direction_loss) (
  dx=x*slider163/4.5*ms_car_sign+ms_pass_offset-slider92;
  dy=y*slider164/1.8*ms_car_sign-slider93;
  dz=z-slider94;
  distance=sqrt(dx*dx+dy*dy+dz*dz);
  ms_pass_delay_target[i]=min(65530,distance*srate/343);
  pan=(dx*ms_yaw_sin-dy*ms_yaw_cos)/max(.5,distance);
  ms_pan_target[i]=ms_bound(pan*slider37*(1-slider96*.5),-.95,.95);
  shadow=slider(132+i);
  i!=10 && i!=11 ? shadow=1-(1-shadow)*(1-ms_body_shadow(x*slider163/4.5,y*slider164/1.8));
  fc=ms_shadow_cutoff(distance,shadow);
  // Exhaust faces rearward; intake and BOV face forward. dx points from
  // listener to source, so the sign differs between those orientations.
  direction_loss=0;
  (i==0 || i==9 || i==4 || i==5) ? (
    alignment=ms_bound((i==0 || i==9 ? dx : -dx)*ms_car_sign/max(.5,distance),-1,1);
    direction_loss=(1-alignment)*.5*slider184*(1-slider96);
  );
  fc*=1-.45*direction_loss;
