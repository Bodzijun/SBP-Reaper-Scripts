  );
);
function ms_emit_wheels(signal) local(i,filtered,pan,left,right,sum_l,sum_r,dry,send,n,u,detail_mean,event_mean,surface_mean,rotation_mean,wet_weight,wet,rain,foliage,event_weight,wheel_signal,phase,offset,joint_target,gravel_target,mix,concrete,gravel,stone_target,base_difference,drop_target,air,turn,tread_texture,tread_gain) (
  i=0; sum_l=0; sum_r=0;
