    // The road bed remains continuous; only the separate tread events pulse.
    ms_wheel_rotation[i]=1;
    rotation_mean+=ms_wheel_rotation[i]*.25;
    surface_mean+=mix*ms_wheel_rotation[i]*.25;
    ms_wet_air[i]+=(n-ms_wet_air[i])*ms_wet_air_coeff;
    // The axle that follows reaches the same slab joint after wheelbase / speed.
