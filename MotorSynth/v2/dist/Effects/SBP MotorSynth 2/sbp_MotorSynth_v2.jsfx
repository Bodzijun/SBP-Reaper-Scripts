    );
    ms_wheel_gravel_hold[i]=max(0,ms_wheel_gravel_hold[i]-1);
    gravel_target=ms_wheel_gravel_hold[i]>0 ? ms_wheel_gravel_strength[i] : 0;
    ms_wheel_gravel_env[i]+=(gravel_target-ms_wheel_gravel_env[i])*(gravel_target>ms_wheel_gravel_env[i]?ms_impact_attack:ms_impact_release);
    ms_wheel_scale>0 && wet>.001 ? (
