        (gravel>.001 && u<.06*2^(slider235*4-2)) || (concrete>.001 && u<.0025*2^(slider235*4-2)) ? (
          ms_stone_hit(i,ms_rand(1)<(gravel>concrete ? .25 : .5),1);
          ms_stone_burst[i]=gravel>.001 && ms_rand(1)<.25 ? 1+floor(ms_rand(1.99)) : 0;
          ms_stone_gap[i]=srate*(.012+ms_rand(.05));
