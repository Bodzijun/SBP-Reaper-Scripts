  ms_tread_level+=(slider208-ms_tread_level)*ms_smooth;
  ms_tread_speed+=((ms_wheel_scale>0 ? max(0,norm_speed) : 0)-ms_tread_speed)*ms_tread_speed_coeff;
  base_difference=ms_road_surface_base(slider169)-ms_road_surface_base(surface_type);
