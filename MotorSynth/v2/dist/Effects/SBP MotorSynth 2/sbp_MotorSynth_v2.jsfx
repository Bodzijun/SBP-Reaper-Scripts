ms_openwind_active=ms_openwind_speed>.002 && ms_cabin_presence>.001 && ms_cabin_window>.001;
ms_openwind_active ? (
  ms_openwind_wait-=1;
  ms_openwind_wait<=0 ? (
    ms_openwind_wait=srate*(.32-.20*sqrt(ms_openwind_speed)+ms_rand(.09));
