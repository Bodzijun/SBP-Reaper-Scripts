  right=filtered*sqrt(.5*(1+pan));
  i==10 ? (
    ms_openwind_spatial_lp+=(ms_openwind-ms_openwind_spatial_lp)*ms_filter[i];
    window_sig=ms_openwind_spatial_lp*ms_gain[i]*ms_volume;
    window_left=sqrt(.5*(1-ms_openwind_pan));window_right=sqrt(.5*(1+ms_openwind_pan));
    left+=window_sig*window_left;right+=window_sig*window_right;
    ms_room_in+=window_sig*ms_send[i]*.32;
  );
  ms_mix_l+=left; ms_mix_r+=right;
