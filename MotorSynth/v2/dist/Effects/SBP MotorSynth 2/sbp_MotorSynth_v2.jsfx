);
ms_road_mass_target=ms_bound(sqrt((slider163*slider164)/(4.5*1.8)),.75,1.8);
slider102!=ms_last_reset ? (
  engine_state=0; cur_rpm=0; ms_rpm=0; phase_acc=0;
  thermal_norm=0; ms_seed=max(1,slider103); ms_volume=0;
  ms_manual_drift=0;ms_drift_speed_mem=0;ms_hb_motion=1;ms_hb_stop_latched=0;ms_coast_blend=0;ms_skid_noise_lp=0;ms_backfire_wait=0;ms_shift_ref_active=0;
  ms_bump_seed=ms_wrap(ms_seed+1047290,2147483646)+1;ms_bump_hold=0;ms_bump_env=0;ms_bump_lp=0;
  ms_bump_rear_distance=-1;ms_bump_rear_hold=0;ms_bump_rear_env=0;
  ms_bump_thump_front=ms_bump_thump_rear=0;
  ms_airbrake_seed=ms_wrap(ms_seed+32452843,2147483646)+1;
  ms_airbrake_held=0;ms_airbrake_peak=ms_airbrake_pulse=ms_airbrake_env=0;ms_airbrake_high=ms_airbrake_low=0;
  ms_wheel_i=0;loop(4,ms_wheel_seed[ms_wheel_i]=ms_wrap(ms_seed+104729*(ms_wheel_i+1),2147483646)+1;ms_wheel_i+=1;);
  memset(ms_wheel_noise_low,0,120);
  memset(ms_stone_env,0,112);
  memset(101000,0,64);
  ms_tread_speed=0;
  ms_stone_x1=ms_stone_x2=ms_stone_y01=ms_stone_y02=ms_stone_y11=ms_stone_y12=0;
  ms_wheel_i=0;loop(4,ms_wheel_last_phase[ms_wheel_i]=-1;ms_wheel_gravel_wait[ms_wheel_i]=srate*(.04+.02*ms_wheel_i);ms_wheel_rotation_phase[ms_wheel_i]=ms_wheel_i*.17;ms_drop_wait[ms_wheel_i]=srate*(.08+.04*ms_wheel_i);ms_wheel_i+=1;);
  memset(ms_cyl_noise,0,8); memset(ms_cyl_variation,0,8);
  ms_heavy_x1=ms_heavy_x2=ms_heavy_y01=ms_heavy_y02=ms_heavy_y11=ms_heavy_y12=0;
  ms_engine_body_lp=0; ms_engine_body_lp2=0;ms_diesel_noise_lp=0;ms_engine_load=ms_engine_overrun=ms_overrun_lp=0;ms_exhaust_low=ms_exhaust_low2=ms_exhaust_mid=0;
  memset(ms_bank_weight,0,8);ms_bank_prev0=ms_bank_prev1=ms_bank_dc_prev0=ms_bank_dc_prev1=0;
  ms_bank_lp0=ms_bank_lp1=0;memset(ms_bank_buffer0,0,65536);
  ms_intake_lp=ms_intake_pulse=0;memset(ms_intake_buffer,0,4096);
  ms_bov_body=ms_bov_flutter_phase=0;ms_whine_pitch=ms_whine_low=0;
  ms_window_last=slider97;ms_window_hold=ms_window_env=ms_window_servo_lfo=0;
  ms_openwind_lp=ms_openwind_low=ms_openwind_env=ms_openwind_wait=ms_openwind_hold=ms_openwind_spatial_lp=0;
  ms_road_low=0; ms_road_low2=0; ms_road_sub=0; ms_body_low=0; ms_body_low2=0; ms_road_texture_noise=0; ms_road_texture2=0; ms_road_weather=0; ms_road_weather2=0; ms_road_motion=0;
  ms_joint_phase=0; ms_joint_hold=0; ms_joint_env=0; ms_gravel_wait=0; ms_gravel_hold=0; ms_gravel_env=0;
  ms_last_reset=slider102;
);
ms_yaw_sin=sin(slider95*$pi/180);
ms_yaw_cos=cos(slider95*$pi/180);
// A short speed memory retains the wet-road release if X is moved to zero.
ms_drift_speed_mem=max(slider101?target_veh_speed_override:0,ms_drift_speed_mem*exp(-dt_block/.7));
ms_drift_wet=ms_surface_blend(surface_type==3?1:0,slider169==3?1:0);
ms_drift_release_tc=.07+ms_drift_wet*(.65+.90*ms_drift_speed_mem);
ms_drift_release_coeff=1-exp(-1/(srate*ms_drift_release_tc));
// Smooth block-rate host/GUI updates before calculating distances and delay.
slider168 ? (
  !ms_pass_active ? ms_pass_offset=slider167;
  ms_pass_offset+=(slider167-ms_pass_offset)*(1-exp(-dt_block/.16));
  ms_pass_active=1;
) : (ms_pass_offset=0;ms_pass_active=0;);
// During a pass only, orient the car and its emitters together.
ms_car_sign=slider168 && slider185 ? -1 : 1;
ms_solo=slider183==2; ms_i=0;
loop(14,slider(146+ms_i)==2 ? ms_solo=1; ms_i+=1;);
ms_config(0,-2.05,-.35,.3);
ms_config(1,1.25,0,.65);
ms_config(2,1.05,.2,.65);
ms_config(3,.25,0,.35);
ms_config(4,1.5,.35,.7);
ms_config(5,1.4,.35,.7);
ms_config(6,0,0,.15);
ms_config(7,0,0,.35);
ms_config(8,1.25,-.8,.25);
ms_config(9,-2.05,-.35,.3);
ms_config(10,.6,0,1.2);
ms_config(11,-.25,0,1);
ms_config(12,1.65,0,.65);
ms_config(13,.8,0,.45);
ms_wheel_config(0,slider165*.5,slider164*.5);
ms_wheel_config(1,slider165*.5,-slider164*.5);
ms_wheel_config(2,-slider165*.5,slider164*.5);
ms_wheel_config(3,-slider165*.5,-slider164*.5);
ms_skid_config(0,slider165*.5,slider164*.5);
ms_skid_config(1,slider165*.5,-slider164*.5);
ms_skid_config(2,-slider165*.5,slider164*.5);
ms_skid_config(3,-slider165*.5,-slider164*.5);
ms_rt60=slider98==0?.22:slider98==1?.7:slider98==2?1.3:slider98==3?.85:2.4;
ms_room_feedback0=exp(-6.907755*ms_room_len0/(srate*ms_rt60));
ms_room_feedback1=exp(-6.907755*ms_room_len1/(srate*ms_rt60));
ms_room_feedback2=exp(-6.907755*ms_room_len2/(srate*ms_rt60));
ms_room_feedback3=exp(-6.907755*ms_room_len3/(srate*ms_rt60));
ms_room_target=slider99*(slider98==0?.42:1);
// Distance shifts the balance toward diffuse late sound, not absolute loudness.
ms_listener_distance=sqrt((slider92-ms_pass_offset)*(slider92-ms_pass_offset)+slider93*slider93+slider94*slider94);
ms_early_distance_target=slider96?0:ms_bound((ms_listener_distance-2)/18,0,1);
// Host parameter updates provide a second, instance-local path for the two
// primary readouts when the WebUI audio stream is unavailable.
ms_grip_meter_clock+=samplesblock;
ms_grip_meter_clock>=srate*.2 ? (ms_grip_meter_clock=0; slider230=min(1,ms_grip_meter_peak); sliderchange(slider230); ms_grip_meter_peak=0;);
ms_readout_clock+=samplesblock;
ms_readout_clock>=srate/20 ? (
  ms_readout_clock=0;
  ms_readout_rpm=min(max(cur_rpm,0),9000);
  ms_readout_speed=min(max(slider101?slider8:veh_speed_norm*280,0),280);
  abs(ms_readout_rpm-slider50)>=1 ? (slider50=ms_readout_rpm; sliderchange(slider50););
  abs(ms_readout_speed-slider51)>=.2 ? (slider51=ms_readout_speed; sliderchange(slider51););
  ms_readout_temp=ms_bound(thermal_norm,0,1);
  (abs(ms_readout_temp-slider52)>=.002 || (ms_readout_temp<.001 && slider52!=0)) ? (
    slider52=ms_readout_temp<.001?0:ms_readout_temp;sliderchange(slider52);
  );
  ms_drift_readout=ms_bound(ms_manual_drift,0,1);
  (abs(ms_drift_readout-slider175)>=.002 || (ms_drift_readout<.001 && slider175!=0)) ? (
    slider175=ms_drift_readout<.001?0:ms_drift_readout;
    sliderchange(slider175);
  );
);
ms_packet_clock+=samplesblock;
ms_packet_clock>=srate/30 && reaweb_jsfx_stream_active(0) ? (
  ms_packet_clock=0;
  ms_telemetry[0]=1;
  ms_telemetry[1]=cur_rpm;
  ms_telemetry[2]=slider101?slider8:max(0,veh_speed_norm*280);
  ms_telemetry[3]=gear;
  ms_telemetry[4]=thermal_norm;
  ms_telemetry[5]=cur_throttle;
  ms_telemetry[6]=target_brake;
  ms_telemetry[7]=ms_peak;
  ms_i=0; loop(14,ms_telemetry[8+ms_i]=ms_source_peaks[ms_i];ms_source_peaks[ms_i]=0;ms_i+=1;);
  ms_telemetry[22]=srate;
  ms_telemetry[23]=engine_state;
  reaweb_jsfx_publish(0,ms_telemetry,24,1,max(0,ms_clock-24));
  ms_peak=0;
);
!reaweb_jsfx_stream_active(0) ? (ms_packet_clock=0;ms_peak=0;memset(ms_source_peaks,0,14););


// EngineSim control block (UI8). sbp_EngineSim_Link.jsfx, placed before the
// EngineSim CLAP, turns these values into MIDI. Spatial processing of the
// EngineSim stems is done here, by the same per-source engine as MotorSynth.
ms_es_base=3100000+floor(max(0,min(63,slider219)))*64;
ms_es_beat+=1;ms_es_beat>1000000?ms_es_beat=1;
gmem[ms_es_base]=ms_es_beat;
gmem[ms_es_base+1]=slider227>0;
gmem[ms_es_base+2]=min(9000,max(0,ms_rpm));
gmem[ms_es_base+3]=min(1,max(0,eff_throttle));
gmem[ms_es_base+4]=slider1>0 && slider75!=2;
gmem[ms_es_base+5]=slider1>0 && engine_state>0 && slider75!=2;
gmem[ms_es_base+6]=slider218>0;
gmem[ms_es_base+7]=max(0,min(8,slider217));
gmem[ms_es_base+8]=1; // EngineSim output gain multiplier (unity)
gmem[ms_es_base+9]=srate;
// GRIP prototype: normalized controls; one audio block of latency.
gmem[ms_es_base+10]=min(1,max(0,slider101?slider8/280:veh_speed_norm));
gmem[ms_es_base+11]=1-min(1,max(0,slip_env_smooth));
gmem[ms_es_base+12]=min(1,max(0,(slider170+1)*.5));
gmem[ms_es_base+13]=slider172;
gmem[ms_es_base+14]=1-slider96;
// Gear change in progress (automatic shift or manual lever): EngineSim releases its RPM hold meanwhile.
ms_es_shift_hold=max(0,ms_es_shift_hold-samplesblock/srate);
// value = how strongly EngineSim lets go of the load: comfort shifts stay loaded.
gmem[ms_es_base+15]=shift_timer>0 ? (ms_shift_style==0 ? .25 : 1) : ms_es_shift_hold>0;

// Ignition State Machine
engine_state == 0 && target_ignition == 1 ? (
  shutoff_seq_active = 0;
  // Capture the attempt settings; changing them affects the next attempt.
  ms_attempt_failure=slider218>0;
  ms_attempt_extra=max(0,slider217);
  // Turn Engine ON
  cold_start > 0.05 || ms_attempt_extra>0 || ms_attempt_failure ? (
    // Cold start mode
    engine_state = 1; // Cranking
    starter_timer = (ms_attempt_failure ? max(2,cold_start*2) : cold_start*2)+ms_attempt_extra;
    starter_phase = 0;ms_starter_whine_phase=ms_starter_load_phase=0;
    cur_rpm = 250; // Initial cranking speed
  ) : (
    // Instant start (warm)
    engine_state = 2; // Running
    cur_rpm = 800; // Jump to idle
  );
) : engine_state == 1 && target_ignition == 1 ? (
  // Currently Cranking
  starter_timer -= (samplesblock / srate); // timer decrement
  starter_timer <= 0.0 ? (
    ms_attempt_failure ? (
      engine_state=0;target_ignition=0;slider1=0;sliderchange(slider1);
    ) : (
    engine_state = 2; // Caught! Running
    // Keep near cranking RPM; post-start flare wave drives revs organically
    cur_rpm = 265 + ms_rand(40);
    post_start_nrevs    = 1 + (ms_rand(2)|0) + (target_size > 0.55 ? 1 : 0); // 1..3 (larger engine = more revs)
    post_start_idle_dur = (0.38 + target_size * 0.22) * post_start_nrevs + cold_start * 0.9;
    post_start_idle_timer = post_start_idle_dur;
    );
  ) : (
    // Modulate cranking RPM with compression resistance
    comp_freq = target_cylinders * 0.5;
    cur_rpm = 250 + sin(ms_starter_load_phase*pi2) * 40; 
    // Randomly "catch" a tiny bit towards the end to simulate starting
    starter_timer < cold_start ? cur_rpm += ms_rand(150);
  );
) : target_ignition == 0 ? ( // Shut off sequence
  shutoff_seq_active == 0 && engine_state > 0 ? (
    // One-shot shutdown sputter burst; larger engines cough longer/heavier
    shutoff_seq_active = 1;
    shutoff_pop_left = 2 + (target_size * 3.0) | 0;
    shutoff_pop_env = max(shutoff_pop_env, 0.35 + target_size * 0.35);
    shutoff_pop_gap = max(1, (srate * (0.028 + abs(rand_noise()) * 0.020)) | 0);
  );
  engine_state = 0;
  // Longer release while rolling, shorter when nearly stationary
  stop_speed_ref = max(speed_display_norm, coast_speed_norm);
  stop_release_sec = 0.55 + pow(min(max(stop_speed_ref, 0.0), 1.0), 0.90) * 3.80;
);

// Phase 8: fuel pump priming buzz on ignition rising edge.
target_ignition == 1 && prev_target_ignition == 0 ? (
  fuel_pump_timer = max(1, (srate * (0.18 + target_fuel_pump * 0.90)) | 0);
);
prev_target_ignition = target_ignition;

// Throttle override: Allow sputtering and "coughs" during cranking
engine_state == 0 ? (
  eff_throttle = 0;
) : engine_state == 1 ? (
  // Sputtering pulses to simulate cylinders barely firing
  rand_noise() > 0.8 ? sputter_t = 0.15 + abs(rand_noise()) * 0.15 : sputter_t *= 0.8;
  eff_throttle = sputter_t;
) : shift_timer > 0 ? (
  // Clutch pressed during shift.
  // Blip amount is chosen when the shift starts: soft downshift vs kickdown.
  eff_throttle = target_gear < gear ? (shift_intent_dir == -2 ? shift_blip_hold : target_throttle*.22) : target_throttle*(ms_shift_style==0 ? .8 : (ms_shift_style==2 ? 0 : .42));
) : post_start_idle_timer > 0 ? (
