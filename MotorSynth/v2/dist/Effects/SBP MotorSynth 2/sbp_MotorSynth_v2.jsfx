  // Random pitch per hit sounded like beeping. In the cabin the floor damps the ring: a third lower.
  ms_ping_base[i]<1 ? ms_ping_base[i]=900+ms_rand(600);
  ms_ping_base[i]+=(900+ms_rand(600)-ms_ping_base[i])*.1;
  ms_ping_freq[i]=ms_ping_base[i]*(big ? .4 : 2^(slider234*2-1))*(.94+ms_rand(.12))*(1-.33*slider96);
  ms_ping_amp[i]=amp*(big ? .55 : .3+ms_rand(.5));
  ms_ping_env[i]=1;
  ms_ping_decay[i]=exp(-1/(srate*(big ? .016+ms_rand(.012) : .004+ms_rand(.009))));
