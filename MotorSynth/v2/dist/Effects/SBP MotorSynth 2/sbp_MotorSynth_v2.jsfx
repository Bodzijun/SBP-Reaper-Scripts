// Exhaust topology presets.
// Note: higher exhaust_damp means stronger smoothing in the waveguide loop,
// so Stock should be the most damped and Straight Pipe the least damped.
exhaust_type == 0 ? (
  target_pipe_len = 0.020; exhaust_fb = 0.10; exhaust_damp = 0.78;
  exhaust_direct_mix = 0.82; exhaust_pipe_mix = 0.48; exhaust_presence = 0.88; exhaust_flange_guard = 0.10;
) : // Stock
exhaust_type == 1 ? (
  target_pipe_len = 0.011; exhaust_fb = 0.20; exhaust_damp = 0.50;
