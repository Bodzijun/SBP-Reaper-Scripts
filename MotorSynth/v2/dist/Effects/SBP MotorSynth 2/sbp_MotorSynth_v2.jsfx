        ms_drop_hold[i]=srate*.004;
        ms_drop_strength[i]=.5+.5*u;
      );
    );
    ms_drop_hold[i]=max(0,ms_drop_hold[i]-1);
    drop_target=ms_drop_hold[i]>0?ms_drop_strength[i]:0;
    ms_drop_env[i]+=(drop_target-ms_drop_env[i])*(drop_target>ms_drop_env[i]?ms_drop_attack:ms_drop_release);
    ms_rain_drop_env[i]+=(ms_drop_env[i]-ms_rain_drop_env[i])*ms_rain_smooth;
    air=(ms_wet_air[i]-ms_wheel_noise_mid2[i])*ms_road_rate_gain;
    ms_wheel_event[i]=concrete*ms_wheel_joint_env[i]*(ms_tire_body*2.7+ms_contact*.40)+
      gravel*ms_wheel_gravel_env[i]*(ms_tire_body*1.35+ms_contact*1.8+
        (ms_wheel_noise_mid[i]-ms_wheel_noise_low2[i])*ms_road_rate_gain*1.4)+
      foliage*air*(1.15+ms_drop_env[i]*3.0)+
      rain*air*(.55+ms_rain_drop_env[i]*.55)+
