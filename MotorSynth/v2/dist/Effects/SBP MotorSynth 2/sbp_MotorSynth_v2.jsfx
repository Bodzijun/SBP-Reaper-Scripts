);
function ms_emit(i,signal) local(pan,left,right,dry,filtered,ch,window_sig,window_left,window_right,window_dry,local_weight) (
  ms_gain[i]+=(ms_gain_target[i]-ms_gain[i])*ms_smooth;
  ms_pan[i]+=(ms_pan_target[i]-ms_pan[i])*ms_smooth;
  ms_filter[i]+=(ms_filter_target[i]-ms_filter[i])*ms_smooth;
  ms_dry[i]+=(ms_dry_target[i]-ms_dry[i])*ms_smooth;
  ms_send[i]+=(ms_send_target[i]-ms_send[i])*ms_smooth;
  ms_lowpass[i]+=(ms_pass_signal(i,signal)-ms_lowpass[i])*ms_filter[i];
  filtered=ms_lowpass[i]*ms_gain[i]*ms_volume;
  pan=ms_pan[i];
  // Brake direct sound is quieter behind the cabin barrier; feed reflections
