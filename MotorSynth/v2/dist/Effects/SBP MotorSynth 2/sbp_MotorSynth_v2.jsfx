ms_shift_fx=ms_shift_style==0 ? .35 : 1; // clank / scrape level
dt_block=samplesblock/srate;
ms_rasp_kf=1-exp(-1/(srate*.0008));ms_rasp_ks=1-exp(-1/(srate*.04));
ms_mdrive+=(slider236+(1-slider236)*.25*slider90-ms_mdrive)*min(1,dt_block*20); // rasp brings a little glue drive
